[SKIPSTART]
@キャラEXMOD_リスト化
キャラEXMOD_MOD名一覧:1 = 火々矢_ビッチ化


@キャラEXMOD_チェック(対象キャラ名)
#DIMS DYNAMIC 対象キャラ名
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC ExMOD数

ExMOD数 = VARSIZE("キャラEXMOD_MOD名一覧")
CALL キャラEXMOD_リスト化

FOR LCOUNT, 1, ExMOD数
    VARSET キャラマニュアル_置き換え
    キャラマニュアル置き換えあり = 0
    キャラEXMOD_MOD名 = 
    TRYCALLFORM キャラEXMOD_%キャラEXMOD_MOD名一覧:LCOUNT%(1)
    IF キャラEXMOD_ON && 対象キャラ名 == キャラEXMOD_キャラ名
        キャラEXMOD_MOD名 = %キャラEXMOD_MOD名一覧:LCOUNT%
        RETURN 1
    ENDIF
NEXT
VARSET キャラマニュアル_置き換え
RETURN 0
[SKIPEND]

