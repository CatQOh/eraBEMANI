@キャラEXMOD_火々矢_ビッチ化(チェックのみ, キャラEXMODオンオフ)
#DIM DYNAMIC チェックのみ
#DIM DYNAMIC キャラEXMODオンオフ

キャラEXMOD_キャラ名 = 火々矢
キャラEXMOD_内容 = ビッチ化
SIF MAP_GET("キャラEXMOD", "キャラEXMOD_火々矢_ビッチ化") == ""
	MAP_SET "キャラEXMOD", "キャラEXMOD_火々矢_ビッチ化", "オフ"

IF キャラEXMODオンオフ
	SELECTCASE MAP_GET("キャラEXMOD", "キャラEXMOD_火々矢_ビッチ化")
		CASE "オフ"
			MAP_SET "キャラEXMOD", "キャラEXMOD_火々矢_ビッチ化", "オン"
