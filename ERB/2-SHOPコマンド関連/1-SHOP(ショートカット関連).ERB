@ショートカットコマンド, コマンド番号
#DIM DYNAMIC コマンド番号
#DIMS DYNAMIC コマンド内容, 2
#DIM DYNAMIC 対象
#DIM DYNAMIC ロード番号

SPLIT LNK:コマンド番号, "/", コマンド内容

SELECTCASE コマンド内容:0
	CASE "対象選択", "助手選択", "調教", "居住部屋"
		IF ISNUMERIC(コマンド内容:1)
			対象 = GETCHARA(TOINT(コマンド内容:1))
		ELSE
			対象 = GETCHARANAME(コマンド内容:1)
		ENDIF
ENDSELECT

SELECTCASE コマンド内容:0
	CASE "対象選択"
		IF コマンド内容:1 == "-1"
			TARGET = -1
			RETURN
		ENDIF
		IF 対象 == -1
			PRINTFORMW %CSVNAMEF(TOINT(コマンド内容:1))%%I18N("は居ません")%
		ELSEIF !調教可能(対象)
			IF CFLAG:対象:キャラロスト
				SELECTCASE CSTR:対象:ロスト要因
					CASE "売却"
						PRINTFORMW %NAME:対象%%I18N("は売却済みです")%
					CASE "死亡"
						PRINTFORMW %NAME:対象%%I18N("は死亡しています")%
					CASE "自爆"
						PRINTFORMW %NAME:対象%%I18N("は自爆しました")%
					CASE "捕食"
						PRINTFORMW %NAME:対象%%I18N("は捕食されました")%
					CASE "鉱物化"
						PRINTFORMW %NAME:対象%%I18N("は鉱物化しました")%
				ENDSELECT
			ELSE
				PRINTFORMW %NAME:対象%%I18N("は現在調教できません")%
			ENDIF
		ELSE
			CALL ASSIGN_TARGET, 対象
		ENDIF
	CASE "助手選択"
		IF コマンド内容:1 == "-1"
			ASSI = -1
			RETURN
		ENDIF
		IF 対象 == -1
			PRINTFORMW %CSVNAMEF(TOINT(コマンド内容:1))%%I18N("は居ません")%
		ELSEIF !助手可能(対象)
			PRINTFORMW %NAME:対象%%I18N("は現在助手に指定できません")%
		ELSE
			CALL ASSIGN_ASSI, 対象
		ENDIF
	CASE "調教"
		IF 対象 == -1
			PRINTFORMW %CSVNAMEF(TOINT(コマンド内容:1))%%I18N("は居ません")%
		ELSEIF !調教可能(対象)
			PRINTFORMW %NAME:対象%%I18N("は現在調教できません")%
		ELSE
			CALL ASSIGN_TARGET, 対象
			CALL 調教開始
		ENDIF
	CASE "施設"
		SELECTCASE コマンド内容:1
			CASE "ゲームセンター"
				CALL STRATEGY_GC
			CASE "娼館"
				CALL STRATEGY_BROTHEL
			CASE "芸プロ"
				CALL STRATEGY_IDOL
			CASE "飲食店"
				CALL 飲食店経営
			CASEELSE
				CALLFORM %コマンド内容:1%
		ENDSELECT
	CASE "居住部屋"
		IF CFLAG:対象:居住 == 0
			IF LANGUAGE == "ENG"
				PRINTFORMW There is no free room for %NAME:対象%
			ELSE
				PRINTFORMW %NAME:対象%が住んでいる部屋はありません
			ENDIF
		ELSE
			CALL 居住部屋, CFLAG:対象:居住
		ENDIF
	CASE "セーブ"
		SAVEDATA TOINT(コマンド内容:1), セーブデータ情報()
		PRINTW セーブしました
	CASE "チェックポイント"
		SELECTCASE ターン
			CASE "昼"
				ロード番号 = (94+((DAY-1)*2%6)-1)
			CASE "夜"
				ロード番号 = (94+((DAY-1)*2%6+1)-1)
		ENDSELECT
		SIF ロード番号 == 93
			ロード番号 = 99
		IF CHKDATA(ロード番号) == 0
			PRINTFORMW 「%RESULTS%」%I18N("をロードします")%
			;STOPBGM
			LOADDATA ロード番号
		ELSE
			IF LANGUAGE == "ENG"
				PRINTFORMW cannot load save %コマンド内容:1%
			ELSE
				PRINTFORMW %コマンド内容:1%ターン前のセーブデータはロードできません
			ENDIF
		ENDIF
	CASE "ロード"
		IF CHKDATA(TOINT(コマンド内容:1)) == 0
			PRINTFORMW 「%RESULTS%」%I18N("をロードします")%
			;STOPBGM
			LOADDATA TOINT(コマンド内容:1)
		ELSE
			IF LANGUAGE == "ENG"
				PRINTFORMW cannot load save %コマンド内容:1%
			ELSE
				PRINTFORMW %コマンド内容:1%番のセーブデータはロードできません
			ENDIF
		ENDIF
ENDSELECT

@ショートカット登録
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC 登録番号
#DIM DYNAMIC LRESULT
#DIM DYNAMIC ページ数
{
#DIMS DYNAMIC 施設名 = 
"ゲームセンター",
"娼館",
"芸プロ",
"飲食店",
"医務室",
"監禁室",
"実験室",
"調理室",
"図書室",
"畜産",
"農産物",
"博物館",
"霊安室",
}
;上記施設を選択可能かの変数
#DIM DYNAMIC 選択可能, 20

DRAWLINE
PRINTFORML □%I18N("登録する番号を選んでください")%
FOR LCOUNT, 0, VARSIZE("LNK")
	IF LNK:LCOUNT == ""
		SETCOLORBYNAME gray
		PRINTFORMLC [{LCOUNT, 2}] - %I18N("登録する")%
		RESETCOLOR
	ELSE
		PRINTFORMLC [{LCOUNT, 2}] - %LNKCOM(LNK:LCOUNT)%
	ENDIF
NEXT
CALL NEWLINE
DRAWLINE
PRINTPLAINFORM 　%I18N("ショートカット")　
PRINTFORML [-1] - %I18N("戻る")%

BINPUT
登録番号 = RESULT
SELECTCASE 登録番号
	CASE -1
		RETURN 0
ENDSELECT

$コマンド選択
DRAWLINE
PRINTFORML □%I18N("コマンドの内容を選んでください")%
PRINTFORML 　[1] - %I18N("○○(キャラ)を調教する")%
PRINTFORML 　[2] - %I18N("○○(キャラ)を調教対象にする")%
PRINTFORML 　[3] - %I18N("○○(キャラ)を助手にする")%
PRINTFORML 　[4] - %I18N("○○(施設)の管理をする")%
PRINTFORML 　[5] - %I18N("○○(キャラ)の部屋に行く")%
PRINTFORML 　[6] - %I18N("セーブ関連")%
PRINTFORML 　[7] - %I18N("ロード関連")%

BINPUT
SELECTCASE RESULT
	CASE 1
		PAGING = 0
		CALL PAGING, 0, "", "TARGET"
		FOR PAGING, 1, CHARANUM
			CALL PAGING, PAGING > 0, "", "TARGET"
		NEXT
		SIF RESULT == -1
			GOTO コマンド選択
		LNK:登録番号 = 調教/{NOF(RESULT)}
	CASE 2
		PAGING = 0
		CALL PAGING, 0, "", "TARGET", "調教対象を外す"
		FOR PAGING, 1, CHARANUM
			CALL PAGING, PAGING > 0, "", "TARGET", "調教対象を外す"
		NEXT
		LRESULT = RESULT
		IF LRESULT == -1
			LNK:登録番号 = 対象選択/-1
		ELSE
			SIF !調教可能(LRESULT)
				CONTINUE
			LNK:登録番号 = 対象選択/{NOF(LRESULT)}
		ENDIF
	CASE 3
		PAGING = 0
		CALL PAGING, 0, "", "ASSI", "助手を外す"
		FOR PAGING, 1, CHARANUM
			CALL PAGING, CFLAG:PAGING:助手可能, "", "ASSI", "助手を外す"
		NEXT
		LRESULT = RESULT
		IF LRESULT == -1
			LNK:登録番号 = 助手選択/-1
		ELSE
			SIF !助手可能(LRESULT)
				CONTINUE
			LNK:登録番号 = 助手選択/{NOF(LRESULT)}
		ENDIF
	CASE 4
		FOR LCOUNT, 0, VARSIZE("施設名")
			SELECTCASE 施設名:LCOUNT
				CASE "ゲームセンター", "娼館"
					SIF !ITEM:風俗店営業許可証
						CONTINUE
				CASE "博物館"
					SIF !ITEM:博物館 || !MOD:STS
						CONTINUE
				CASE "医務室", "実験室", "図書室"
					SIF !ITEM:(施設名:LCOUNT)
						CONTINUE
				CASE "霊安室"
					SIF !MOD:STS
						CONTINUE
			ENDSELECT
			PRINTFORMLC [{LCOUNT}] %I18N(施設名:LCOUNT)%
		NEXT
		CALL NEWLINE
		BINPUT
		LNK:登録番号 = 施設/%施設名:RESULT%
	CASE 5
		FOR PAGING, 0, CHARANUM
			CALL PAGING, CFLAG:PAGING:居住, "", "ROOM"
		NEXT
		SIF RESULT == -1
			RESTART
		LNK:登録番号 = 居住部屋/{NOF(RESULT)}
	CASE 6
		$SAVE
		FOR LCOUNT, ページ数*20, ページ数*20+20
			IF LANGUAGE == "ENG"
				PRINTFORML 　[{LCOUNT, 2}] - save as {LCOUNT}
			ELSE
				PRINTFORML 　[{LCOUNT, 2}] - {LCOUNT}番にセーブ
			ENDIF
		NEXT
		DRAWLINE
		CALL PRINTSPACE, ページ数 > 0, @"　[101] %I18N("前ページ")%　"
		CALL PRINTSPACE, ページ数 < 3, @"[109] %I18N("次ページ")%"
		BINPUT
		SELECTCASE RESULT
			CASE 101
				ページ数--
				GOTO SAVE
			CASE 109
				ページ数++
				GOTO SAVE
		ENDSELECT
		LNK:登録番号 = セーブ/{RESULT}
	CASE 7
		$LOAD
		FOR LCOUNT, ページ数*20, ページ数*20+20
			IF LANGUAGE == "ENG"
				PRINTFORML 　[{LCOUNT, 2}] - Load {LCOUNT}
			ELSE
				PRINTFORML 　[{LCOUNT, 2}] - {LCOUNT}番のセーブデータをロード
			ENDIF
		NEXT
		DRAWLINE
		FOR LCOUNT, 1, 7
			IF LANGUAGE == "ENG"
				PRINTFORML 　[{LCOUNT+90, 2}] - Load save data from {LCOUNT} turns before
			ELSE
				PRINTFORML 　[{LCOUNT+90, 2}] - {LCOUNT}ターン前のセーブデータをロード
			ENDIF
		NEXT
		DRAWLINE
		CALL PRINTSPACE, ページ数 > 0, @"　[101] %I18N("前ページ")%　"
		CALL PRINTSPACE, ページ数 < 3, @"[109] %I18N("次ページ")%"
		BINPUT
		SELECTCASE RESULT
			CASE 101
				ページ数--
				GOTO LOAD
			CASE 109
				ページ数++
				GOTO LOAD
			CASE 0 TO 79
				LNK:登録番号 = ロード/{RESULT}
			CASE 91 TO 96
				LNK:登録番号 = チェックポイント/{RESULT-90}
		ENDSELECT
ENDSELECT
RESTART

@LNKCOM, コマンド内容
#FUNCTIONS
#DIMS DYNAMIC コマンド内容, 2

SPLIT コマンド内容, "/", コマンド内容

SELECTCASE コマンド内容:0
	CASE "対象選択"
		IF コマンド内容:1 == "-1"
			RETURNF I18N("調教対象を外す")
		ELSE
			RETURNF @"%CSVCALLNAMEF(TOINT(コマンド内容:1))%%I18N("を調教対象に指定")%"
		ENDIF
	CASE "助手選択"
		IF コマンド内容:1 == "-1"
			RETURNF I18N("助手を外す")
		ELSE
			RETURNF @"%CSVCALLNAMEF(TOINT(コマンド内容:1))%%I18N("を助手に指定")%"
		ENDIF
	CASE "調教"
		RETURNF @"%CSVCALLNAMEF(TOINT(コマンド内容:1))%%I18N("を調教")%"
	CASE "施設"
		IF LANGUAGE == "ENG"
			RETURNF @"manage %コマンド内容:1%"
		ELSE
			RETURNF @"%コマンド内容:1%の管理"
		ENDIF
	CASE "居住部屋"
		IF LANGUAGE == "ENG"
			RETURNF @"Visiting %CSVCALLNAMEF(TOINT(コマンド内容:1))%`s room"
		ELSE
			RETURNF @"%CSVCALLNAMEF(TOINT(コマンド内容:1))%の部屋に行く"
		ENDIF
	CASE "セーブ"
		IF LANGUAGE == "ENG"
			RETURNF @"Save into %コマンド内容:1% slot"
		ELSE
			RETURNF @"%コマンド内容:1%番にセーブ"
		ENDIF
	CASE "チェックポイント"
		IF LANGUAGE == "ENG"
			RETURNF @"Loading save data from %コマンド内容:1% turns ago"
		ELSE
			RETURNF @"%コマンド内容:1%ターン前のセーブデータをロード"
		ENDIF
	CASE "ロード"
		IF LANGUAGE == "ENG"
			RETURNF @"Loading save data %コマンド内容:1%
		ELSE
			RETURNF @"%コマンド内容:1%番のセーブデータをロード
		ENDIF
ENDSELECT


@ショートカット削除
#DIM DYNAMIC LCOUNT

DRAWLINE
FOR LCOUNT, 0, VARSIZE("LNK")
	SIF LNK:LCOUNT != ""
		PRINTFORMLC 　[{LCOUNT}] - %LNKCOM(LNK:LCOUNT)%
NEXT
IF MATCH(LNK, "") == VARSIZE("LNK")
	PRINTL 
	PRINTFORML 　%I18N("ショートカットはありません")%
	PRINTL 
ENDIF
CALL NEWLINE
DRAWLINE
PRINTPLAINFORM 　%I18N("ショートカット削除")%　
PRINTFORML [-1] - %I18N("戻る")%

DO
	INPUT
	SELECTCASE RESULT
		CASE -1
			RETURN
		CASE 0 TO VARSIZE("LNK")-1
			LNK:RESULT = 
			RESTART
	ENDSELECT
LOOP 1
