;オプション設定処理
[SKIPSTART]
@OPTION
#DIM DYNAMIC LRESULT

DRAWLINE
LOADGLOBAL
PRINTL □設定項目を選択してください
PRINTL 　[0] - テキスト設定
PRINTL 　[1] - 着衣関連設定
PRINTL 　[2] - イベント関連の設定
SIF TALENT:MASTER:ドラゴン使い
	PRINTL 　[3] - ドラゴンの名前変更
SIF !SP
	PRINTL 　[4] - サウンドオプション
PRINTFORML 　[5] - 能力表示画面のOPTION:顔グラ表示(現在:\@ OPTION:顔グラ表示 == 1 ? オン # オフ \@)
PRINTFORML 　[6] - ショートカットコマンドを使用する(現在:\@ ショートカット == 1 ? オン # オフ \@)
DRAWLINE
PRINTPLAIN 　OPTION　
PRINTL [100] - 戻る

RESTART
[SKIPEND]
;テキスト関連
@TEXT_SETTING
DRAWLINE
PRINTFORML □%I18N("口上・地の文関連")%
PRINTFORM 　%I18N("現在の設定")%：
IF OPTION:地の文表示 && OPTION:口上表示
	PRINTFORML 【%I18N("口上+地の文")%】
ELSEIF !OPTION:地の文表示 && OPTION:口上表示
	PRINTFORML 【%I18N("口上のみ")%】
ELSEIF OPTION:地の文表示 && !OPTION:口上表示
	PRINTFORML 【%I18N("地の文のみ")%】
ELSEIF !OPTION:地の文表示 && !OPTION:口上表示
	PRINTFORML 【%I18N("テキストを表示しない")%】
ENDIF
PRINT 　
IF ゲームモード() != "段位認定"
	PRINTFORM [ 0] - %I18N("口上+地の文")% 
	PRINTFORM [ 1] - %I18N("口上のみ")% 
ENDIF
PRINTFORM 　[ 2] - %I18N("地の文のみ")% 
PRINTFORML 　[ 3] - %I18N("テキストを表示しない")%

PRINTFORML 　[ 4] - %I18N("調教時のテキスト表示のウェイトを自動でスキップする")%(%I18N("現在:")%%ON_OFF(OPTION:調教時テキストスキップ)%)
PRINTFORML 　[ 5] - %I18N("汎用喘ぎ口上を使用する(現在:")%%ON_OFF(OPTION:汎用喘ぎ口上)%)

PRINTFORML □%I18N("数値・通貨関連")%
PRINTFORML 　[ 6] - %I18N("パセリ表示")%(%I18N("現在:")%%ON_OFF(OPTION:パセリ表示)%)
PRINTFORML 　[ 7] - %I18N("通貨単位設定")%
;(現在:\@ 通貨単位 == "" ? [未設定] # %通貨単位% \@)
IF LANGUAGE == "ENG"
	PRINTFORML 　[ 8] - Show number display settings in training (Now:\@ OPTIONS:数値表示設定 == "" ? No setting # %OPTIONS:数値表示設定% \@)
ELSE
	PRINTFORML 　[ 8] - 調教画面とお金の数値表示の設定(現在:\@ OPTIONS:数値表示設定 == "" ? 設定無し # %OPTIONS:数値表示設定% \@)
ENDIF

PRINTFORML □%I18N("キャラ関連")%
IF !ORIGIN || FINDCHARA(CFLAG:グリム, 1)
	PRINTFORM 　[ 9] - %I18N("グリムキャラの名前表示設定(現在:")%
	SELECTCASE FLAG:グリムコンフィグ
		CASE 0
			PRINTFORML %I18N("通常表示")%)
		CASE 1
			PRINTFORML 名前の先頭に「グリム・」を付ける)
	ENDSELECT
ENDIF
PRINTFORML 　[10] - %I18N("性別不明キャラの性別自動選択設定")%

PRINTFORML □%I18N("システム関連")%
SIF !ORIGIN
	PRINTFORML 　[11] - %I18N("実績解除時のメッセージ")%(%I18N("現在")%:\@ 実績メッセージ ? オン # オフ \@)
SIF !SP
	PRINTFORML 　[12] - %I18N("ツールチップ(マウスカーソルを当てた時に表示されるポップアップ)の設定")%
PRINTFORML 　[13] - %I18N("PAGING関数でのキャラ表示数(現在")%:{PAGING表示数}%I18N("人")%)
DRAWLINE
PRINTPLAIN 　TEXT　
PRINTFORML [100] - %I18N("戻る")%
BINPUT
SELECTCASE RESULT
	CASE 0
		PRINTFORML 【%I18N("口上+地の文")%】%I18N("に設定しました")%
		OPTION:地の文表示 = 1
		OPTION:口上表示 = 1
	CASE 1
		PRINTFORML 【%I18N("口上のみ")%】%I18N("に設定しました")%
		OPTION:地の文表示 = 0
		OPTION:口上表示 = 1
	CASE 2
		PRINTFORML 【%I18N("地の文のみ")%】%I18N("に設定しました")%
		OPTION:地の文表示 = 1
		OPTION:口上表示 = 0
	CASE 3
		PRINTFORML 【%I18N("テキストを表示しない")%】%I18N("に設定しました")%
		OPTION:地の文表示 = 0
		OPTION:口上表示 = 0
	CASE 4
		INVERTBIT OPTION:調教時テキストスキップ, 0
	CASE 5
		INVERTBIT OPTION:汎用喘ぎ口上, 0
	CASE 6
		INVERTBIT OPTION:パセリ表示, 0
	CASE 7
		$通貨単位設定
		CALL PASELIL, @"通貨単位設定 現在の表示例:1980000＄"
		IF LANGUAGE == "ENG"
			PRINTFORML [0] - Currency unit change(Now:\@ 通貨単位 == "" ? [Not set] # %通貨単位% \@)
			PRINTFORML [1] - %I18N("通貨単位の位置変更")%
			PRINTFORML [2] - Reduce number of digits(Now:\@ OPTION:桁数下げ > 0 ? {OPTION:桁数下げ} digits down # No change \@)
			PRINTFORML [3] - Display with decimals(Now:\@ OPTION:ゼロ表示 ? Display # Not display \@)
		ELSE
			PRINTFORML [0] - 通貨単位変更(現在:\@ 通貨単位 == "" ? [未設定] # %通貨単位% \@)
			PRINTFORML [1] - 通貨単位の位置変更
			PRINTFORML [2] - 桁数を下げる(現在:\@ OPTION:桁数下げ > 0 ? {OPTION:桁数下げ}桁下げ # 変更なし \@)
			PRINTFORML [3] - 小数点以下がゼロでの表示(現在:\@ OPTION:ゼロ表示 ? 表示あり # 表示なし \@)
		ENDIF
		PRINTFORML [4] - %I18N("戻る")%
		BINPUT
		SELECTCASE RESULT
			CASE 0
				PRINTFORML %I18N("通貨単位を入力してください")%
				PRINTBUTTON @"[%I18N("変更しない")%]", "変更しない"
				PRINTFORML 
				INPUTS
				SIF RESULTS == "変更しない"
					RESTART
				通貨単位 = %RESULTS%
			CASE 1
				PRINTFORML %I18N("通貨単位の位置変更")%
				PRINTFORML [0] - %I18N("数値の後ろに付ける")%
				PRINTFORML [1] - %I18N("数値の前に付ける")%
				PRINTFORML [2] - %I18N("小数点の位置につける")%
				BINPUT
				OPTION:通貨単位位置 = RESULT
			CASE 2
				PRINTFORML %I18N("下げる桁数を入力してください")%(0～12)
				PRINTFORML  %I18N("例:2桁下げの場合")%、5980→59.80
				INPUT
				OPTION:桁数下げ = LIMIT(RESULT, 0, 12)
			CASE 3
				PRINTFORML %I18N("小数点以下がゼロでの表示(桁数下げがあるときのみ有効)")%
				PRINTFORML [0] - %I18N("表示しない")%
				PRINTFORML [1] - %I18N("表示する")%
				BINPUT
				OPTION:ゼロ表示 = RESULT
			CASE 4
				RESTART
		ENDSELECT
		SAVEGLOBAL
		GOTO 通貨単位設定
	CASE 8
		PRINTFORML %I18N("調教画面とお金の数値表示の設定")%
		PRINTFORML [0] - %I18N("通常表示")%
		PRINTFORML [1] - %I18N("3桁区切りで表示")%
		PRINTFORML [2] - %I18N("漢字で桁を表示する")%
		BINPUT
		SELECTCASE RESULT
			CASE 0
				OPTIONS:数値表示設定 = 
			CASE 1
				OPTIONS:数値表示設定 = 3桁区切り
			CASE 2
				OPTIONS:数値表示設定 = 漢字桁表示
		ENDSELECT

	CASE 9
		PRINTFORML %I18N("グリムキャラの名前表示")%
		PRINTFORML [0] - %I18N("通常の名前で表示する")%
		PRINTFORML [1] - %I18N("名前の先頭に「グリム・」を付ける")%
		BINPUT
		FLAG:グリムコンフィグ = RESULT
	CASE 10
		CALL 性別自動選択
	CASE 11
		INVERTBIT 実績メッセージ, 0
	CASE 12
		$TOOLTIP
		PRINTFORML %I18N("ツールチップ設定")%
		PRINTFORML [0] - %I18N("ツールチップ表示")%(%I18N("現在")%:%ON_OFF(ツールチップ非表示)%
		IF LANGUAGE == "ENG"
			PRINTFORML [1] - Tooltip display time(Now:\@ ツールチップ表示時間 == 0 || ツールチップ表示時間 == 10000 ? 10 seconds (default) # {ツールチップ表示時間/1000}.{ツールチップ表示時間%1000} Seconds \@)
			PRINTFORML [2] - Tooltip display delay(Now:\@ ツールチップディレイ == 0 ? None (default) # {ツールチップディレイ/1000}.{ツールチップディレイ%1000} Seconds \@)
		ELSE
			PRINTFORML [1] - ツールチップ表示時間(現在:\@ ツールチップ表示時間 == 0 || ツールチップ表示時間 == 10000 ? 10秒(デフォルト) # {ツールチップ表示時間/1000}.{ツールチップ表示時間%1000}秒 \@)
			PRINTFORML [2] - ツールチップ表示ディレイ(現在:\@ ツールチップディレイ == 0 ? 無し(デフォルト) # {ツールチップディレイ/1000}.{ツールチップディレイ%1000}秒 \@)
		ENDIF
		PRINTFORML [3] - %I18N("戻る")%
		BINPUT
		SELECTCASE RESULT
			CASE 0
				INVERTBIT ツールチップ非表示, 0
			CASE 1
				PRINTFORML %I18N("ツールチップ表示時間を入力してください(ミリ秒)")%
				PRINTFORML %I18N("1000ミリ秒=1秒 最大30000ミリ秒=30秒 デフォルトは10000ミリ秒=10秒")%
				INPUT
				ツールチップ表示時間 = LIMIT(RESULT, 1, 30000)
				TOOLTIP_SETDURATION ツールチップ表示時間
			CASE 2
				PRINTFORML %I18N("ツールチップの表示ディレイ時間を入力してください(ミリ秒)")%
				PRINTFORM %I18N("1000ミリ秒=1秒 最低500ミリ秒=0.5秒 最大30000ミリ秒=30秒 デフォルトは0=ディレイ無し")%
				INPUT
				IF RESULT == 0
					ツールチップディレイ = 0
				ELSE
					ツールチップディレイ = LIMIT(RESULT, 500, 30000)
				ENDIF
				TOOLTIP_SETDELAY ツールチップディレイ
			CASE 3
				RESTART
		ENDSELECT
		SAVEGLOBAL
		GOTO TOOLTIP
	CASE 13
		PRINTFORML %I18N("表示数を選んでください 30人までが実用的だと思います")%
		PRINTFORML [10][20][30][40][50]
		BINPUT
		PAGING表示数 = RESULT
	CASE 100
		RETURN 0
ENDSELECT

SAVEGLOBAL
RESTART

;初期着衣設定
