RESTART

@CHARA_CLOTHES_SETTING, 対象 = -1
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC 選択部位
#DIM DYNAMIC 対象
#DIM DYNAMIC LTARGET
#DIM DYNAMIC CSTR位置
#DIM DYNAMIC 衣服文字数 = 20
#DIMS DYNAMIC フラグ名
#DIMS DYNAMIC 表示用
#DIM DYNAMIC 変更不可
#DIM DYNAMIC 全身上着変更不可
#DIM DYNAMIC 下半身上着変更不可

IF 対象 != -1
	LTARGET = TARGET
	TARGET = 対象
ENDIF

FOR LCOUNT, GETNUM(CSTR, "特殊"), GETNUM(CSTR, "足元")+1
	衣服文字数 = MAX(STRLENS(CSTR:LCOUNT), 衣服文字数)
NEXT

DRAWLINE
PRINTFORML □%NAME:TARGET%%I18N("の服装設定")%
FOR LCOUNT, 0, 7
	CSTR位置 = GETNUM(CSTR, "特殊")+LCOUNT
	IF !CFLAG:@"%CSTRNAME:CSTR位置%着衣不可"
		CALL DISABLE, @"服変更_%CSTRNAME:CSTR位置%", TARGET
		変更不可 = RESULT
		SELECTCASE CSTRNAME:CSTR位置
			CASE "下半身上着"
				下半身上着変更不可 = 変更不可
			CASE "全身上着"
				全身上着変更不可 = 変更不可
		ENDSELECT
		
		IF 変更不可
			SETCOLORBYNAME gray
			PRINT 　[-] 
		ELSE
			PRINTFORM 　[{LCOUNT}] 
		ENDIF
		PRINTFORM %CSTRNAME:CSTR位置, 10, LEFT%：
		IF ゲームモード() == "学園モード"
			PRINTFORM %学園用服装:(CSTRNAME:CSTR位置), 衣服文字数+2, LEFT%
		ELSE
			PRINTFORM %CSTR:(CSTRNAME:CSTR位置), 衣服文字数+2, LEFT%
		ENDIF
		
		IF MOD:着衣パイズリ && CSTR:(CSTRNAME:CSTR位置) != "" && GROUPMATCH(CSTRNAME:CSTR位置, "全身上着", "上半身上着", "上半身下着")
			IF CSTRNAME:CSTR位置 == "全身上着"
				フラグ名 = 全身上着パイズリ
			ELSE
				フラグ名 = %SUBSTRINGU(CSTRNAME:CSTR位置, 3, -1)%パイズリ
			ENDIF
			SIF !変更不可
				PRINTFORM [{LCOUNT+100}] 
			PRINTFORM %パイズリフラグ説明(CFLAG:フラグ名, TARGET)%
			SELECTCASE CFLAG:フラグ名/10
				CASE 1
					PRINTFORM (%I18N("水着")%)
				CASE 2
					PRINTFORM (%I18N("ぴっちりスーツ")%)
			ENDSELECT
		ENDIF
		PRINTL 
		RESETCOLOR
	ELSE
		CALL PRINTCOLORL, @"　[-] %CSTRNAME:CSTR位置, 10, LEFT%：%I18N("着衣不可")%", "gray"
	ENDIF
NEXT

;下半身上着もしくは全身上着を着用時、挿入可フラグの変更ができる
IF CSTR:下半身上着 == "" && CSTR:全身上着 == ""
	表示用 = 
ELSE
	表示用 = \@ CFLAG:挿入可 ? 可能 # 不可能 \@
ENDIF
;これでちゃんと判定されるのか微妙
IF 表示用 != "" && !(下半身上着変更不可 && CSTR:下半身上着 != "") && !(全身上着変更不可 && CSTR:全身上着 != "" && GROUPMATCH(CFLAG:着衣併用, 0, 2))
	PRINTFORML 　[7] %I18N("着衣状態での性行為可否の変更(現在")%:%I18N("表示用")%)
ELSE
	IF LANGUAGE == "ENG"
		CALL PRINTCOLORL, @"　[-] Changing the ability to have sex while clothed \@ 表示用 != "" ? (Now:%表示用%) #\@", "gray"
	ELSE
		CALL PRINTCOLORL, @"　[-] 着衣状態での性行為可否の変更\@ 表示用 != "" ? (現在:%表示用%) #\@", "gray"
	ENDIF
ENDIF

;全身上着の着用時、全身上着の性質の変更ができる
IF CSTR:全身上着 == ""
	表示用 = 
ELSE
	SELECTCASE CFLAG:着衣併用
		CASE 0
			表示用 = 上着として着用
		CASE 1
			表示用 = 上着の上から着用
		CASE 2
			表示用 = 下着として着用
	ENDSELECT
ENDIF
IF LANGUAGE == "ENG"
	IF 表示用 != "" && !全身上着変更不可
		PRINTFORM 　[8] Change the settings of %CSTR:全身上着%(Now:%表示用%)
	ELSE
		CALL PRINTCOLORL, @"　[-] Change the settings of fully clothed\@ 表示用 != "" ? (Now:%I18N("表示用")%) #\@", "gray"
	ENDIF
ELSE
	IF 表示用 != "" && !全身上着変更不可
		PRINTFORM 　[8] %CSTR:全身上着%の性質の変更(現在:%表示用%)
	ELSE
		CALL PRINTCOLORL, @"　[-] 全身上着の性質の変更\@ 表示用 != "" ? (現在:%表示用%) #\@", "gray"
	ENDIF
ENDIF

IF NOF(TARGET) < 10000
	CALL DISABLE, "服変更_初期化", TARGET
	SIF !RESULT
		PRINTFORML 　[9] %I18N("着衣設定の初期化")%
ENDIF
DRAWLINE
PRINTPLAIN 　COORDINATE　
PRINTFORML [10] %I18N("戻る")%
BINPUT
SELECTCASE RESULT
	CASE 0 TO 6
		選択部位 = %CSTRNAME:(GETNUM(CSTR, "特殊")+RESULT)%
		CALL CHARA_CLOTHES_SETTINGNEXT, 選択部位
	CASE 7
		INVERTBIT CFLAG:挿入可, 0
	CASE 8
		PRINTFORML □%CSTR:全身上着%%I18N("の性質を選択してください")%
		PRINTFORML 　[0] - %I18N("通常の全身上着(上半身上着、下半身上着との併用が不可)")%
		PRINTFORML 　[1] - %I18N("上着の上に着用するもの(上半身上着、下半身上着との併用が可能)")%
		PRINTFORML 　[2] - %I18N("肌着も兼ねるもの(上半身上着、下半身上着、及び下着との併用が不可能)")%
		BINPUT
		CFLAG:着衣併用 = RESULT
	CASE 9
		CALL 服装初期化, TARGET
		PRINTFORMW ＜%NAME:TARGET%%I18N("の服装を初期化しました")%＞
	CASE 10
		SIF 対象 != -1
			TARGET = LTARGET
		RETURN 0
	CASE 100 TO 107
		CSTR位置 = GETNUM(CSTR, "特殊")+(RESULT-100)
		IF CSTRNAME:CSTR位置 == "全身上着"
			フラグ名 = 全身上着パイズリ
		ELSE
			フラグ名 = %SUBSTRINGU(CSTRNAME:CSTR位置, 3, -1)%パイズリ
		ENDIF
		PRINTFORML □%CSTRNAME:CSTR位置%%I18N("の性質を選択してください")%
		FOR LCOUNT, 0, 30
			SIF パイズリフラグ説明(LCOUNT) == ""
				CONTINUE
			IF LCOUNT == 10
				PRINTFORML 【%I18N("水着系")%】
			ELSEIF LCOUNT == 20
				PRINTFORML 【%I18N("ぴっちりスーツ系")%】
			ENDIF
			SIF LCOUNT >= 10
				PRINT 　
			PRINTFORML 　[{LCOUNT, 2}] %パイズリフラグ説明(LCOUNT, TARGET)% 
		NEXT
		PRINTFORML 　[-1] %I18N("戻る")%
		BINPUT
		SIF RESULT >= 0
			CFLAG:フラグ名 = RESULT
ENDSELECT

RESTART

@服装初期化, 対象
#DIM DYNAMIC 対象
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LTARGET

LTARGET = TARGET
TARGET = 対象

;対象が「あなた」
IF NOF(TARGET) == 0
	IF ゲームモード() == "学園モード"
		SELECTCASE SEX(TARGET)
			CASE 0
				CSTR:上半身上着 = 制服
				CSTR:下半身上着 = ズボン
