		SAVEGLOBAL
	CASE 4
		PRINTFORML □%I18N("調教開始時の着衣設定を選んでください")%
		PRINTFORML 　[0] - %I18N("着衣プレイはエロいから着せたまま始める")%
		PRINTFORML 　[1] - %I18N("さっさとヤりたいので脱がせてから始める")%
		BINPUT
		DOPTION:着衣オプション = RESULT
		SAVEGLOBAL
	CASE 5
		DRAWLINE
		VARLINE = LINECOUNT
		$SOUNDOPTION
		CLEARLINE LINECOUNT-VARLINE
		PRINTFORML □%I18N("現在の設定 サウンド再生機能")%:%YES_NO(サウンド)% %I18N("BGM音量")%:{BGM音量} %I18N("SE音量")%:{SOUND音量}
		PRINTFORML 　[0] - %I18N("サウンド再生機能(現在")%:%YES_NO(サウンド)%)
		PRINTFORML 　[1] - %I18N("BGMの音量を上げる")%
		PRINTFORML 　[2] - %I18N("BGMの音量を下げる")%
		PRINTFORML 　[3] - %I18N("SEの音量を上げる")%
		PRINTFORML 　[4] - %I18N("SEの音量を下げる")%
		DRAWLINE
		PRINTPLAIN 　SOUND　
		PRINTFORML [100] - %I18N("戻る")%
		BINPUT
		SELECTCASE RESULT
			CASE 0
				INVERTBIT サウンド, 0
				SELECTCASE サウンド
					CASE 0
						SETBGMVOLUME 0
						SETSOUNDVOLUME 0
					CASE 1
						SETBGMVOLUME BGM音量
						SETSOUNDVOLUME SOUND音量
				ENDSELECT
			CASE 1
				BGM音量 += 10
				CALL SETMIN(BGM音量, 100)
				SETBGMVOLUME BGM音量
			CASE 2
				BGM音量 -= 10
				CALL SETMAX(BGM音量, 0)
				SETBGMVOLUME BGM音量
			CASE 3
