RESTART

;着衣変更 きせかえ
@CLOTHES_SETTING_USUALLY
#DIM DYNAMIC LTARGET
DRAWLINE
PRINTL □%I18N("着衣の設定をするキャラを選択してください")%
FOR PAGING, 0, CHARANUM
	CALL PAGING, 1
NEXT

SIF RESULT == -1
	RETURN 0

LTARGET = TARGET
TARGET = RESULT
