		ARRAYCOPY "ITEM", "アイテム保持用"

		表示数 = 0

		IF EXPNAME:参照経験 == "射精経験"
			PRINTFORML □%I18N("EXPNAME:参照経験", "EXP")%%I18N("が上昇するコマンド一覧 ()内は対象者")%
		ELSE
			PRINTFORML □%I18N("EXPNAME:参照経験", "EXP")%%I18N("が上昇するコマンド一覧 ()内は上昇値")%
		ENDIF
		FOR LCOUNT, 0, VARSIZE("TRAINNAME")
			SIF LCOUNT == VARSIZE("TRAINNAME")/2
				AWAIT
			IF TRAINNAME:LCOUNT != ""
				;表示を飛ばす
				SKIPDISP 1
				SELECTCOM = LCOUNT
				SELECTCOMS = %TRAINNAME:LCOUNT%
				VARSET TEQUIP
				VARSET TEQUIP:MASTER:0
				SIF ASSI >= 0
					VARSET TEQUIP:ASSI:0
				VARSET TFLAG
				VARSET EXP:0
				VARSET EX:0
				VARSET NOWEX:0
				VARSET NOWEX:ASSI:0
				VARSET NOWEX:MASTER:0
				VARSET PALAM:0
				VARSET SOURCE:0
				CVARSET BASE, GETNUM(BASE, "射精"), 0
				CFLAG:残数 = 100
				CFLAG:ASSI:残数 = 100
				CFLAG:MASTER:残数 = 100
				TFLAG:実行判定無視 = 1
				TRYCALLFORM COM_%TRAINNAME:LCOUNT%
				;コマンドの属性を判別する
				SIF SOURCE:快C
					SETBIT コマンド属性:LCOUNT, FINDELEMENTF(喘ぎBIT, "Ｃ")
				SIF SOURCE:快V
					SETBIT コマンド属性:LCOUNT, FINDELEMENTF(喘ぎBIT, "Ｖ")
				SIF SOURCE:快A
					SETBIT コマンド属性:LCOUNT, FINDELEMENTF(喘ぎBIT, "Ａ")
				SIF SOURCE:快B
					SETBIT コマンド属性:LCOUNT, FINDELEMENTF(喘ぎBIT, "Ｂ")
				SIF SOURCE:苦痛 >= 1000
					SETBIT コマンド属性:LCOUNT, FINDELEMENTF(喘ぎBIT, "苦痛2")
				SIF 属性記録
					CONTINUE
				SKIPDISP 0
				IF EXPNAME:参照経験 == "射精経験"
					IF BASE:MASTER:射精 > 0 || BASE:射精 > 0 || BASE:ASSI:射精 > 0
						表示用 '= @"　%I18N("TRAINNAME:LCOUNT", "TRAIN")%("
						SIF BASE:PLAYER:射精 > 0
							表示用 += @"%I18N("主人")%, "
						SIF BASE:射精 > 0
							表示用 += @"%I18N("調教対象")%, "
						SIF BASE:ASSI:射精 > 0
							表示用 += I18N("助手")
						表示用 += ")"
						PRINTFORMLC %表示用%
						;DEBUGPRINTFORML {BASE:射精}
						表示数++
					ENDIF
				ELSE
					IF EXP:参照経験 > 0
						PRINTFORMLC 　%TRAINNAME:LCOUNT%({EXP:参照経験})
						;非ボタンではPRINTC系がうまく動かないので変数使う
						表示数++
					ENDIF
				ENDIF
				SIF 表示数 != 0 && 表示数%4 == 0
					CALL NEWLINE
			ENDIF
		NEXT
		;保持用MASTERで元に戻す
		SWAPCHARA MASTER, CHARANUM-1
		;用済みになった3人を消す
		DELCHARA CHARANUM-1
		DELCHARA ASSI
		DELCHARA TARGET
		TARGET = LTARGET
		ASSI = LASSI
		PLAYER = LPLAYER
		MONEY = LMONEY
		VARSET SELECTCOMS
		ARRAYCOPY "アイテム保持用", "ITEM"

		TFLAG:実行判定無視 = 0
		SIF 属性記録
			RETURN

		CALL NEWLINE
		DRAWLINE
		WAIT
ENDSELECT

