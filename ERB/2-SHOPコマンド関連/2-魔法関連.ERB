@SPELLCAST
DRAWLINE
PRINTL □魔法を詠唱するキャラを選んでください
IF TARGET > 0 && TALENT:魔法使い
	IF CFLAG:助手可能
		PRINTFORML [0] %NAME:TARGET% %I18N("魔力")%%BARSTR(BASE:魔力, MAXBASE:魔力, 32)% %I18N("魔法技能", "ABL")%LV{ABL:魔法技能}
	ELSE
		CALL PRINTCOLORL, @"[-] %NAME:TARGET% %I18N("魔力")%%BARSTR(BASE:魔力, MAXBASE:魔力, 32)% %I18N("魔法技能", "ABL")%LV{ABL:魔法技能}(%I18N("助手可能でないと魔法の詠唱を許可できません")%)", "gray"
	ENDIF
ENDIF
SIF TALENT:MASTER:魔法使い
	PRINTFORML [1] %NAME:MASTER% %I18N("魔力")%%BARSTR(BASE:MASTER:魔力, MAXBASE:MASTER:魔力, 32)% %I18N("魔法技能", "ABL")%LV{ABL:MASTER:魔法技能}
SIF ASSI > 0 && TALENT:ASSI:魔法使い
	PRINTFORML [2] %NAME:ASSI% %I18N("魔力")%%BARSTR(BASE:ASSI:魔力, MAXBASE:ASSI:魔力, 32)% %I18N("魔法技能", "ABL")%LV{ABL:ASSI:魔法技能}
SIF ASSI:1 > 0 && TALENT:(ASSI:1):魔法使い
	PRINTFORML [3] %NAME:(ASSI:1)% %I18N("魔力")%%BARSTR(BASE:(ASSI:1):魔力, MAXBASE:(ASSI:1):魔力, 32)% %I18N("魔法技能", "ABL")%LV{ABL:(ASSI:1):魔法技能}
PRINTFORML [10] %I18N("戻る")%

BINPUT

SELECTCASE RESULT
	CASE 0
		CALL SELECT_SPELL, TARGET
		SIF RESULT
			RETURN 1
	CASE 1
		CALL SELECT_SPELL, MASTER
		SIF RESULT
			RETURN 1
	CASE 2
		CALL SELECT_SPELL, ASSI
		SIF RESULT
			RETURN 1
	CASE 3
		CALL SELECT_SPELL, ASSI:1
		SIF RESULT
			RETURN 1
	CASE 10
		RETURN 0
ENDSELECT

RESTART

@SELECT_SPELL, 詠唱者
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC スキル
#DIM DYNAMIC 対象, 2
#DIMS DYNAMIC 使用スペル名
#DIM DYNAMIC 日数, 2
#DIM DYNAMIC コスト
#DIM DYNAMIC 詠唱者
#DIM DYNAMIC 表示
#DIM DYNAMIC 必要レベル
#DIM DYNAMIC ミゼラン, 2
;#DIM DYNAMIC 詠唱可能, 50
;魔法名, 必要レベル
{
#DIMS DYNAMIC 魔法一覧 = 
"0は欠番", "",
"フリージングアトモスフィア", "3" ,
"バーニンザフロア", "3",
"ストームバスター", "4",
"スウィートレイン", "4",
"スノープリズム", "4",
"ビーストモード", "5",
"ビーストモードtype2", "5",
"ジュエリーストーム", "5",
"リ：ジェネレーション", "6",
"ジェントルストレス", "6",
"ハニーバニー", "6",
"クロノダイブ", "7",
"ヒプノティッククライシス", "7",
"ティル・ナ・ノーグ", "7",
"エナジードライブ", "8",
"ポゼッション", "9",
"ミラクル・スイート・スイーツ・マジック！！", "10",
"バック・トゥ・クロノス", "10",
"スウィートイリュージョン", "10",
}

スキル = ABL:詠唱者:魔法技能
DRAWLINE
PRINTFORML □%I18N("魔法一覧")% %I18N("詠唱者")%:%NAME:詠唱者% %I18N("魔法技能")%LV{スキル}
PRINTFORML 　%NAME:詠唱者%%I18N("の")%%I18N("魔力")%%BARSTR(BASE:詠唱者:魔力, MAXBASE:詠唱者:魔力, 32)%({BASE:詠唱者:魔力}/{MAXBASE:詠唱者:魔力})
;魔力消費量は単純に詠唱可能レベル*1000
;詠唱可能レベルから1上昇する度に魔力消費量は10%減
FOR LCOUNT, 1, VARSIZE("魔法一覧")/2
	使用スペル名 = %魔法一覧:(LCOUNT*2)%
	必要レベル = TOINT(魔法一覧:(LCOUNT*2+1))
	CALLFORM DISABLE, "CAST_" + 使用スペル名, 詠唱者
	SIF RESULT
		CONTINUE
	SELECTCASE 使用スペル名
		;天土と緋浮美は作中で使ってるので魔法技能無しで詠唱可能
		CASE "ビーストモード", "ビーストモードtype2"
			SIF CHARANUM < 2
				CONTINUE
			SIF GROUPMATCH(CHARANAMEF(詠唱者), "梅桐 天土", "梅桐 緋浮美")
				GOTO OK
		;クロノスとカイロスとノルニルは無条件で使える
		CASE "クロノダイブ"
			SIF GROUPMATCH(CHARANAMEF(詠唱者), "クロノス", "カイロス", "赤ノルニル", "黄ノルニル", "青ノルニル")
				GOTO OK
		;ヒプノティッククライシスは主人が女性じゃないと実行できない
		CASE "ヒプノティッククライシス"
			SIF SEX(MASTER) != 2
				CONTINUE
		;まり花のみレベル8から使用可能
		CASE "ミラクル・スイート・スイーツ・マジック！！"
			SIF CHARANUM < 2
				CONTINUE
			SIF CHARANAMEF(詠唱者) == "山形 まり花" && ABL:詠唱者:魔法技能 >= 8
				GOTO OK
		;ロザリー、塵、アサギス、キャスは魔法技能無しで使える
		CASE "ジュエリーストーム"
			SIF CHARANUM < 2
				CONTINUE
			;要STS
			SIF !MOD:STS
				CONTINUE
			SIF GROUPMATCH(CHARANAMEF(詠唱者), "ロザリー", "塵", "アサギス", "キャスメラ")
				GOTO OK
		;要STS 柚子はレベル8から使える
		CASE "スウィートイリュージョン"
			SIF CHARANUM < 2
				CONTINUE
			SIF !MOD:STS
				CONTINUE
			SIF GROUPMATCH(CHARANAMEF(詠唱者), "藤沢 柚子") && ABL:詠唱者:魔法技能 >= 8
				GOTO OK
		;マゼランはマゼラン星人の技術力で無条件で使える
		CASE "ハニーバニー"
			SIF CHARANUM < 2
				CONTINUE
			SIF CHARANAMEF(詠唱者) == "マゼラン・マゼラン"
				GOTO OK
		CASE "ジェントルストレス", "ティル・ナ・ノーグ", "ポゼッション"
			SIF CHARANUM < 2
				CONTINUE
		;マッドラットとネズミの神さまとノルニルはレベル8から使える
		CASE "バック・トゥ・クロノス"
			SIF GROUPMATCH(CHARANAMEF(詠唱者), "マッドラット", "ネズミの神さま", "赤ノルニル", "黄ノルニル", "青ノルニル") && ABL:詠唱者:魔法技能 >= 8
				GOTO OK
	ENDSELECT
	SIF ABL:詠唱者:魔法技能 < 必要レベル
		CONTINUE
	$OK
	PRINTFORML 　[{LCOUNT, 2}] - %使用スペル名%（魔力消費量{魔力消費量(必要レベル, スキル)}）
	;詠唱可能:LCOUNT = 1
	SELECTCASE 魔法一覧:(LCOUNT*2)
		;Freezing atomosphere
		CASE "フリージングアトモスフィア"
			PRINTFORML 　　　　 %I18N("気温の低下")% %I18N("魔法技能に応じて効果持続")%
		;BURNIN' THE FLOOR
		CASE "バーニンザフロア"
			PRINTFORML 　　　　 %I18N("気温の上昇")% %I18N("魔法技能に応じて効果持続")%
		;Storm Buster
		CASE "ストームバスター"
			PRINTFORML 　　　　 %I18N("天気を晴れにする")% %I18N("魔法技能に応じて効果持続")%
		;Sweet Rain
		CASE "スウィートレイン"
			PRINTFORML 　　　　 %I18N("天気を雨にする")% %I18N("魔法技能に応じて効果持続")%
		;snow prism
		CASE "スノープリズム"
			PRINTFORML 　　　　 %I18N("天気を雪にする")% %I18N("魔法技能に応じて効果持続")%
		;Beast Mode
		CASE "ビーストモード"
			IF LANGUAGE == "ENG"
				PRINTFORML 　　　　 Temporary changes the target race into animal one, adding [%I18N("動物耳", "TALENT")%] with [%I18N("尻尾", "TALENT")%]. %I18N("魔法技能に応じて効果持続")%
			ELSE
				PRINTFORML 　　　　 任意のキャラに対して一時的に素質[%I18N("動物耳", "TALENT")%][%I18N("尻尾", "TALENT")%]を与え、種族を獣人にする %I18N("魔法技能に応じて効果持続")%
			ENDIF
		CASE "ビーストモードtype2"
			IF LANGUAGE == "ENG"
				PRINTFORML 　　　　 Beast mode plus quality, transform target into a full [%I18N("ファーリー", "TALENT")%]
			ELSE
				PRINTFORML 　　　　 ビーストモードに加え素質[%I18N("ファーリー", "TALENT")%]を与える
			ENDIF
		;Re:GENERATION
		CASE "リ：ジェネレーション"
			PRINTFORML 　　　　 %I18N("キャラ全員の回復量上昇")% %I18N("魔法技能に応じて効果持続")%
		;gentle stress
		CASE "ジェントルストレス"
			PRINTFORML 　　　　 %I18N("任意のキャラのストレスが上昇しなくなる")%。%I18N("魔法技能に応じて効果持続")%
		;CHRONO DIVER
		CASE "クロノダイブ"
			PRINTFORML 　　　　 %I18N("任意の年月日にタイムリープする")%
		;HYPNΦTIC CRISIS 主人が女性じゃないとダメ
		CASE "ヒプノティッククライシス"
			PRINTFORML 　　　　 %I18N("女性主人による色仕掛けの成功率が上がる")% %I18N("魔法技能に応じて効果持続")%
		;Tir na n'Og
		CASE "ティル・ナ・ノーグ"
			IF LANGUAGE == "ENG"
			PRINTFORML 　　　　 Temporary removes [%I18N("小人体型", TALENT)%] talent %I18N("魔法技能に応じて効果持続")%
			ELSE
			PRINTFORML 　　　　 素質[%I18N("小人体型", TALENT)%]を一時的に消滅させる %I18N("魔法技能に応じて効果持続")%
			ENDIF
		CASE "エナジードライブ"
			IF LANGUAGE == "ENG"
				PRINTFORML 　　　　 Temporarily increases master total ABL by {スキル-7} and also increases masters energy. %I18N("魔法技能に応じて効果持続")%
			ELSE
				PRINTFORML 　　　　 主人の全ABLを一時的に{スキル-7}主人の全ABLを一時的に7上昇させ、精力も上昇する %I18N("魔法技能に応じて効果持続")%
			ENDIF
		;POSESSION
		CASE "ポゼッション"
			IF LANGUAGE == "ENG"
				PRINTFORML 　　　　 Temporarily make the ABL of any character the same as the caster. %I18N("魔法技能に応じて効果持続")% Not available to the owner
			ELSE
				PRINTFORML 　　　　 任意のキャラのABLを一時的に詠唱者と同じにする %I18N("魔法技能に応じて効果持続")% 主人には使用不可
			ENDIF
		;ミラクル・スイート・スイーツ・マジック！！
		CASE "ミラクル・スイート・スイーツ・マジック！！"
			IF LANGUAGE == "ENG"
				PRINTL 　　　　 Increase the compatibility between any two characters. The caster cannot be targeted. 500% max
			ELSE
				PRINTL 　　　　 任意の2キャラ間の相性を上昇させる 詠唱者は対象にできない 最大500%
			ENDIF
		;Back to chronos
		CASE "バック・トゥ・クロノス"
			PRINTFORML 　　　　 %I18N("現在の状態を維持したまま期限・日にちを1日分戻す")%
		;JEWELLERY STORM
		CASE "ジュエリーストーム"
			PRINTFORML 　　　　 %I18N("対象を鉱物に変える キャラロスト扱いで元に戻すことはできない")%
		;Sweet Illusion
		CASE "スウィートイリュージョン"
			PRINTFORML 　　　　 %I18N("対象をお菓子に変えて他キャラに食べさせる 食べられたキャラはロストする")%
		;Hunny Bunny
		CASE "ハニーバニー"
			IF LANGUAGE == "ENG"
				PRINTFORML 　　　　 Temporary changes targets [%I18N("恋心", "TALENT")%][%I18N("既婚者", "TALENT")%] target to master. %I18N("魔法技能に応じて効果持続")%
			ELSE
				PRINTFORML 　　　　 調教中、キャラの持つ[%I18N("恋心", "TALENT")%][%I18N("既婚者", "TALENT")%]の対象を一時的に主人に変える %I18N("魔法技能に応じて効果持続")%
			ENDIF
	ENDSELECT
NEXT

DRAWLINE
PRINTPLAIN 　SPELL　
PRINTFORML [0] - %I18N("戻る")%

BINPUT

SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASEELSE
		使用スペル名 = %魔法一覧:(RESULT*2)%
		必要レベル = TOINT(魔法一覧:(RESULT*2+1))
		コスト = BASE:詠唱者:魔力 - 魔力消費量(必要レベル, スキル)
		IF コスト < 0
			IF 詠唱者 == MASTER
				PRINTFORMW %I18N("主人は魔力の限界を越えた詠唱はできません")%
				RESTART
			ELSE
				IF LANGUAGE == "ENG"
					PRINTFORML Not enoug magic power。If you will use it, you cannot use it again to {ABS(コスト/100)+1} turn due the drawback
				ELSE
					PRINTFORML 魔力が不足しています。このまま詠唱すると反動で{ABS(コスト/100)+1}ターン使用不可状態になります
				ENDIF
			ENDIF
		ENDIF
		対象 = -1
		対象:1 = -1
		VARSET クロノダイブ
		;独自の入力が必要なもの
		SELECTCASE 使用スペル名
			CASE "ビーストモード", "ビーストモードtype2"
				PRINTFORML □%使用スペル名%%I18N("で獣人化する対象を選んでください")%
				FOR PAGING, 0, CHARANUM
					表示 = 0
					;既に付与素質全部あるキャラは無理
					IF 使用スペル名 == "ビーストモードtype2"
						SIF !TALENT:PAGING:尻尾 || !TALENT:PAGING:動物耳 || !TALENT:PAGING:ファーリー
							表示 = 1
					ELSE
						SIF !TALENT:PAGING:尻尾 || !TALENT:PAGING:動物耳
							表示 = 1
					ENDIF
					;ビーストモード発動中のキャラは無理
					SIF ビーストモード:PAGING:0
						表示 = 0
					;詠唱者も無理
					SIF PAGING == 詠唱者
						表示 = 0
					;霊体も無理
					SIF TALENT:PAGING:霊体
						表示 = 0
					CALLFORM DISABLE, "RECIEVE_" + 使用スペル名, PAGING
					CALL PAGING, !RESULT && 表示, @"%CSTR:PAGING:種族%"
				NEXT
				SIF RESULT == -1
					RESTART
				対象 = RESULT
			CASE "ジェントルストレス"
				PRINTFORML □%I18N("ジェントルストレスでストレスを抑える対象を選んでください")%
				表示 = 0
				SIF TALENT:MASTER:孔雀の瞳 || 助手素質("孔雀の瞳") || TALENT:詠唱者:孔雀の瞳
					表示 = 1
				FOR PAGING, 0, CHARANUM
					CALLFORM DISABLE, "RECIEVE_" + 使用スペル名, PAGING
					CALL PAGING, !RESULT && 詠唱者 != PAGING, @"\@ 表示 ? %I18N("ストレス値")%:{CFLAG:PAGING:ストレス値} #  \@"
				NEXT
				SIF RESULT == -1
					RESTART
				対象 = RESULT
			CASE "クロノダイブ"
				$BTTF
				PRINTFORML □%I18N("移動先の日付を入力してください")%
				PRINTFORM 　[0] - {クロノダイブ:0}%I18N("年")% 
				PRINTFORM [1] - {クロノダイブ:1}%I18N("月")% 
				PRINTFORML [2] - {クロノダイブ:2}%I18N("日")%
				PRINTFORM 　[3] - %I18N("確定")% 
				PRINTFORML [4] - %I18N("キャンセル")%
				BINPUT
				SELECTCASE RESULT
					CASE 0
						PRINTFORM %I18N("移動先の西暦を入力してください")%
						INPUT
						クロノダイブ:0 = RESULT
						GOTO BTTF
					CASE 1
						CALL TWO_DIGIT, 12, "月", 1
						クロノダイブ:1 = RESULT
						GOTO BTTF
					CASE 2
						CALL TWO_DIGIT, 31, "日", 1
						クロノダイブ:2 = RESULT
						GOTO BTTF
					CASE 3
						IF !EXIST_DAY(クロノダイブ:0, クロノダイブ:1, クロノダイブ:2)
							IF LANGUAGE == "ENG"
								PRINTFORMW Year{クロノダイブ:0} Month{クロノダイブ:1} Day{クロノダイブ:2} is not exist
							ELSE
								PRINTFORMW {クロノダイブ:0}年{クロノダイブ:1}月{クロノダイブ:2}日は存在しません
							ENDIF
							GOTO BTTF
						ENDIF
					CASE 4
						RESTART
				ENDSELECT
			CASE "ティル・ナ・ノーグ"
				PRINTFORML □%I18N("ティル・ナ・ノーグで体を大きくする対象を選んでください")%
				FOR PAGING, 0, CHARANUM
					CALLFORM DISABLE, "RECIEVE_" + 使用スペル名, PAGING
					CALL PAGING, !RESULT && TALENT:PAGING:小人体型
				NEXT
				SIF RESULT == -1
					RESTART
				対象 = RESULT
			CASE "エナジードライブ"
				IF エナジードライブ > 0
					PRINTFORMW %I18N("エナジードライブは既に発動中です")%
					RESTART
				ENDIF
			CASE "ポゼッション"
				PRINTFORML □%I18N("憑依する相手を選んでください")%
				FOR PAGING, 0, CHARANUM
					CALLFORM DISABLE, "RECIEVE_" + 使用スペル名, PAGING
					CALL PAGING, !RESULT && PAGING != 詠唱者 && PAGING != MASTER
				NEXT
				SIF RESULT == -1
					RESTART
				対象 = RESULT
			CASE "ミラクル・スイート・スイーツ・マジック！！"
				$MSSM
				PRINTFORML □%I18N("仲良しにする2人を選んでください")%
				IF 対象 == -1
					PRINTFORM 　[0] %I18N("選択する")%
				ELSE
					PRINTFORM 　[0] %NAME:対象%
				ENDIF
				PRINTPLAIN ×
				IF 対象:1 == -1
					PRINTFORML [1] %I18N("選択する")%
				ELSE
					PRINTFORML [1] %NAME:(対象:1)%
				ENDIF
				PRINT 　
				SIF 対象 >= 0 && 対象:1 >= 0 && 対象 != 対象:1
					PRINTFORM [2] %I18N("確定")% 
				PRINTFORML [3] %I18N("キャンセル")%
				BINPUT
				SELECTCASE RESULT
					CASE 0
						FOR PAGING, 0, CHARANUM
							CALLFORM DISABLE, "RECIEVE_" + 使用スペル名, PAGING
							CALL PAGING, !RESULT && PAGING != 詠唱者 && PAGING != 対象:1
						NEXT
						SIF RESULT == -1
							GOTO MSSM
						対象 = RESULT
						GOTO MSSM
					CASE 1
						FOR PAGING, 0, CHARANUM
							CALLFORM DISABLE, "RECIEVE_" + 使用スペル名, PAGING
							CALL PAGING, !RESULT && PAGING != 詠唱者 && PAGING != 対象
						NEXT
						SIF RESULT == -1
							GOTO MSSM
						対象:1 = RESULT
						GOTO MSSM
					;CASE 2
					CASE 3
						RESTART
				ENDSELECT
			CASE "ジュエリーストーム"
				PRINTFORML □ジュエリーストームの対象を選んでください
				FOR PAGING, 0, CHARANUM
					CALLFORM DISABLE, "RECIEVE_" + 使用スペル名, PAGING
					CALL PAGING, !RESULT && PAGING != MASTER && PAGING != 詠唱者 && CSTR:PAGING:種族 != "機械" && !TALENT:PAGING:無機物 && !TALENT:PAGING:霊体 && (パートナー != "" && CHARANAMEF(PAGING) != パートナー || パートナー == "")
				NEXT
				SIF RESULT == -1
					RESTART
				対象 = RESULT
			CASE "スウィートイリュージョン"
				VARSET 対象, -1
				$SWEET
				PRINTFORML %CALLNAME:詠唱者%%I18N("にスウィートイリュージョンを詠唱させます。誰を対象にしますか")%？
				PRINTFORML [0] - %I18N("お菓子に変えるキャラ")%(\@ 対象 >= 0 ? %NAME:対象% # %I18N("無し")% \@)
				PRINTFORML [1] - %I18N("それを食べるキャラ")%(\@ 対象:1 >= 0 ? %NAME:(対象:1)% # %I18N("無し")% \@)
				SIF 対象 >= 0 && 対象:1 >= 0
					PRINTFORML [2] - %I18N("これで決定")%
				PRINTFORML [3] - %I18N("やめる")%
				BINPUT
				SELECTCASE RESULT
					CASE 3
						RESTART
					CASE 0
						FOR PAGING, 0, CHARANUM
							CALLFORM DISABLE, "RECIEVE_" + 使用スペル名, PAGING
							CALL PAGING, !RESULT && PAGING != MASTER && PAGING != 詠唱者 && CSTR:PAGING:種族 != "機械" && !TALENT:PAGING:無機物 && !TALENT:PAGING:霊体 && (パートナー != "" && CHARANAMEF(PAGING) != パートナー || パートナー == "")
						NEXT
						対象 = RESULT
						GOTO SWEET
					CASE 1
						FOR PAGING, 0, CHARANUM
							CALLFORM DISABLE, "EAT_" + 使用スペル名, PAGING
							CALL PAGING, !RESULT && PAGING != 対象
						NEXT
						対象:1 = RESULT
						GOTO SWEET
					CASE 2
						TFLAG:キャスター = 詠唱者
				ENDSELECT
			CASE "ハニーバニー"
				PRINTFORML □%I18N("ハニーバニーで気を引く対象を選んでください")%
				ミゼラン = GETCHARANAME("ミゼラン・ミゼラン")
				IF ミゼラン >= 0 && TRANCEFLAG:ミゼラン:ミゼラン専用 == 10000
					FOR LCOUNT, 0, CHARANUM
						SIF !ミゼラン変身中:LCOUNT:0
							CONTINUE
						ミゼラン:1 = LCOUNT
						BREAK
					NEXT
				ENDIF
				FOR PAGING, 1, CHARANUM
					表示 = 0
					;恋心か既婚者が対象
					SIF TALENT:PAGING:恋心 || TALENT:PAGING:既婚者
						表示 = 1
					;ミゼランの変身は併用不可
					SIF PAGING == ミゼラン:1
						表示 = 0
					SIF ミゼラン >= 0 && GROUPMATCH(CSVNAME(TRANCEFLAG:ミゼラン:ミゼラン専用), CSTR:PAGING:恋心, CSTR:PAGING:既婚者)
						表示 = 0
					CALLFORM DISABLE, "RECIEVE_" + 使用スペル名, PAGING
					CALL PAGING, !RESULT && 表示 && PAGING != 詠唱者 && PAGING > 0
				NEXT
				SIF RESULT == -1
					RESTART
				対象 = RESULT
		ENDSELECT
		PRINTFORM \@ 詠唱者 ? %CALLNAME:詠唱者%に #  \@
		IF 使用スペル名 == "クロノダイブ"
			IF LANGUAGE == "ENG"
				PRINTFORM Use %I18N(使用スペル名)% that aimed at Year{クロノダイブ:0} Month{クロノダイブ:1} Day{クロノダイブ:2} 
			ELSE
				PRINTFORM {クロノダイブ:0}年{クロノダイブ:1}月{クロノダイブ:2}日を目標した%使用スペル名%
			ENDIF
		ELSEIF 対象 >= 0 && 対象:1 >= 0 && 使用スペル名 != "スウィートイリュージョン"
			IF LANGUAGE == "ENG"
				PRINTFORM %CALLNAME:対象% and %CALLNAME:(対象:1)% are targets for %使用スペル名%
			ELSE
				PRINTFORM %CALLNAME:対象%と%CALLNAME:(対象:1)%を対象にした%使用スペル名%
			ENDIF
		ELSEIF 対象 >= 0
			PRINTFORM %CALLNAME:対象%%I18N("を対象にした")%%使用スペル名%
		ELSE
			PRINTFORM %使用スペル名%
		ENDIF
		IF LANGUAGE == "ENG"
			PRINTFORML \@ 詠唱者 ? make someone to chant# chant youself\@。Are you sure？
		ELSE
			PRINTFORML を詠唱\@ 詠唱者 ? させます # します \@。よろしいですか？
		ENDIF
		PRINTFORML [0] - %I18N("はい")%
		PRINTFORML [1] - %I18N("いいえ")%
		BINPUT
		SIF RESULT == 1
			RESTART
		詠唱魔法 = %使用スペル名%
		SIF 詠唱魔法 == "ジュエリーストーム"
			GOTO JEWEL
		SIF 詠唱魔法 == "スウィートイリュージョン"
			GOTO OKASHI

		;口上の処理は全て口上制御関数に
		CALL KOJO_MESSAGE_SPELL, 詠唱者, 対象:0, 対象:1

		CALL EXPUP, "詠唱経験", 必要レベル, 詠唱者
		;魔法の効果処理
		SELECTCASE 使用スペル名
			CASE "フリージングアトモスフィア"
				フリージングアトモスフィア = スキル
				SIF ターン == "昼"
					FLAG:気温 -= フリージングアトモスフィア*30
			CASE "バーニンザフロア"
				バーニンザフロア = スキル
				SIF ターン == "昼"
					FLAG:気温 += バーニンザフロア*30
			CASE "ストームバスター"
				ストームバスター = スキル
				スウィートレイン = 0
				スノープリズム = 0
				FLAG:天気 = 天気TOINT("晴れ")
			CASE "スウィートレイン"
				ストームバスター = 0
				スウィートレイン = スキル
				スノープリズム = 0
				FLAG:天気 = 天気TOINT("雨")
			CASE "スノープリズム"
				ストームバスター = 0
				スウィートレイン = 0
				スノープリズム = スキル
				FLAG:天気 = 天気TOINT("雪")
			CASE "ビーストモード", "ビーストモードtype2"
				;ビーストモード:0=効果時間 1=耳の有無 2=尻尾の有無 3=ファーリーの有無
				;ビーストモードS=元の種族名
				ビーストモード:対象:0 = スキル
				SIF !TALENT:対象:動物耳
					ビーストモード:対象:1 = 1
				SIF !TALENT:対象:尻尾
					ビーストモード:対象:2 = 1
				ビーストモードS:対象:0 = %CSTR:対象:種族%
				TALENT:対象:動物耳 = 1
				TALENT:対象:尻尾 = 1
				CSTR:対象:種族 = 獣人
				IF 使用スペル名 == "ビーストモードtype2"
					SIF !TALENT:対象:ファーリー
						ビーストモード:対象:3 = 1
					TALENT:対象:ファーリー = 1
				ENDIF
			CASE "リ：ジェネレーション"
				リジェネレーション = スキル
			CASE "ジェントルストレス"
				ジェントルストレス:対象:0 = スキル
				ジェントルストレス:対象:1 = CFLAG:対象:ストレス値
			CASE "クロノダイブ"
				IF LANGUAGE == "ENG"
					CALL プレイログ記録, @"Time travel to Year{クロノダイブ:0} Month{クロノダイブ:1} Day{クロノダイブ:2}"
				ELSE
					CALL プレイログ記録, @"クロノダイブで{クロノダイブ:0}年{クロノダイブ:1}月{クロノダイブ:2}日にタイムリープ"
				ENDIF
				YEAR = クロノダイブ:0
				MONTH = クロノダイブ:1
				DAYS = クロノダイブ:2
				;気温や月齢など
				CALL TEMPERATURE
				CALL WEATHER
				CALL 月齢逆算, 30, -1
				日数 = GETDAYS(YEAR, MONTH, DAYS) - GETDAYS(RESULT, RESULT:1, RESULT:2)
				SELECTCASE 日数
					CASE IS <= 30
						月齢 = 日数*100
					CASEELSE
						日数:1 = 日数-(日数%30)
						月齢 = ((日数:1*100000)%2953059)/1000
						月齢 += (日数%30)*100
				ENDSELECT
				月齢 %= 3000
				SIF YEAR == 1998 && MONTH == 9 && DAYS == 28
					CALL 実績解除, "ポップンタイムトリップ"
			CASE "ヒプノティッククライシス"
				ヒプノティッククライシス = スキル
			CASE "ティル・ナ・ノーグ"
				ティルナノーグ:対象:0 = スキル
				TALENT:対象:小人体型 = 0
				;TALENT:対象:小柄体型 = 1
			CASE "エナジードライブ"
				エナジードライブ = スキル
				エナジードライブ:1 = スキル-7
				FOR LCOUNT, 0, VARSIZE("ABL")
					SIF ABLNAME:LCOUNT != ""
						ABL:MASTER:LCOUNT += スキル-7
				NEXT
			CASE "ポゼッション"
				FOR LCOUNT, 0, 30
					SIF ABLNAME:LCOUNT == "魔法技能"
						CONTINUE
					ポゼッション:対象:LCOUNT = ABL:対象:LCOUNT
					ABL:対象:LCOUNT = ABL:詠唱者:LCOUNT
				NEXT
				CFLAG:対象:ポゼ = スキル
			CASE "ミラクル・スイート・スイーツ・マジック！！"
				CALL 相性加算, 対象, 対象:1, 20
				CALL 相性加算, 対象:1, 対象, 20
				SIF CHARANAMEF(詠唱者) == "山形 まり花"
					CALL 実績解除, "「絶対大丈夫だよっ！」"
			CASE "バック・トゥ・クロノス"
				CALL プレイログ記録, @"%I18N("バック・トゥ・クロノス詠唱")%"
				DO
					DAYS--
					IF DAYS <= 0
						MONTH--
						IF MONTH <= 0
							YEAR--
							MONTH = 12
						ENDIF
						DAYS = 31
					ENDIF
				LOOP !EXIST_DAY(YEAR, MONTH, DAYS)
				DAY--
				;気温や月齢など
				CALL TEMPERATURE
				CALL WEATHER
				CALL 月齢逆算, 30, -1
				日数 = GETDAYS(YEAR, MONTH, DAYS) - GETDAYS(RESULT, RESULT:1, RESULT:2)
				SELECTCASE 日数
					CASE IS <= 30
						月齢 = 日数*100
					CASEELSE
						日数:1 = 日数-(日数%30)
						月齢 = ((日数:1*100000)%2953059)/1000
						月齢 += (日数%30)*100
				ENDSELECT
				月齢 %= 3000
			CASE "ジュエリーストーム"
				$JEWEL
				VARLINE = LINECOUNT
				CALL ジュエリーストーム, 対象, 詠唱者
				SIF RESULT == 0
					RESTART
				;被詠唱者のID<詠唱者のIDの場合はキャラロストで1ずれるので戻す
				;SIF 対象 < 詠唱者
				;	詠唱者--
			CASE "スウィートイリュージョン"
				$OKASHI
				CALL 捕食, 対象:1, 対象, 1
			CASE "ハニーバニー"
				ハニーバニー:対象:0 = スキル
				SIF CHARANAMEF(詠唱者) == "マゼラン・マゼラン"
					CALL 実績解除, "ラブとエネミー狙い撃ち"
			CASEELSE
				CONTINUE
		ENDSELECT
ENDSELECT

WAIT
BASE:詠唱者:魔力 = コスト
IF コスト < 0
	PRINTFORMW %CALLNAME:詠唱者%%I18N("は魔力の反動でひどく疲れてしまったようだ。少し休ませてあげよう")%……
	CFLAG:詠唱者:使用不可 = ABS(コスト/100+1)
	CALL 配属解除, 詠唱者
ENDIF
SIF !GROUPMATCH(使用スペル名 , "クロノダイブ")
	RETURN 1

@魔力消費量, 詠唱可能レベル, 詠唱者レベル
#FUNCTION
#DIM DYNAMIC 詠唱可能レベル
#DIM DYNAMIC 詠唱者レベル
#DIM DYNAMIC コスト割合
;基礎値は詠唱可能レベル×1000
;詠唱者レベルが詠唱可能レベルより1高くなるごとに10%減少
コスト割合 = MAX(0, 10+詠唱可能レベル-詠唱者レベル)

RETURNF 100*コスト割合

@ジュエリーストーム, 対象, 詠唱者
#DIM DYNAMIC 対象
#DIM DYNAMIC 詠唱者
#DIM DYNAMIC 作品価値
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC 空き変数
#DIM DYNAMIC 色保存用
IF LANGUAGE == "ENG"
	PRINTFORML □Select %CALLNAME:対象%'s mineral color
ELSE
	PRINTFORML □%CALLNAME:対象%を鉱物化する際の色を設定してください
ENDIF
CALL RGBBAR, CFLAG:対象:タグ色/0x10000, CFLAG:対象:タグ色%0x10000/0x100, CFLAG:対象:タグ色%0x100, , 対象

色保存用 = RESULT

SIF RESULT == 0
	RETURN 0

詠唱魔法 = ジュエリーストーム

;優先度は詠唱者の口上→対象の口上→地の文
;ただし地の文は口上側で管理するようになる
IF OPTION:口上表示
	TRYCCALLFORM SPELLCAST_%CSVNAMERPS(詠唱者)%, 詠唱者, 対象
	CATCH
		TRYCCALLFORM RECIEVE_SPELLCAST_%CSVNAMERPS(対象)%, 詠唱者, 対象
		CATCH
			SIF OPTION:地の文表示
				CALL SPELLCAST_地の文, 詠唱者, 対象
		ENDCATCH
	ENDCATCH
ELSEIF OPTION:地の文表示
	CALL SPELLCAST_地の文, 詠唱者, 対象
ENDIF
CALL EXPUP, "詠唱経験", 5, 詠唱者

;価値は1000は保証
作品価値 = 1000

FOR LCOUNT, 0, VARSIZE("TALENT")
	SIF !TALENT:対象:LCOUNT
		CONTINUE
	SELECTCASE TALENTNAME:LCOUNT
		CASE "体格"
			SELECTCASE TALENT:対象:LCOUNT
				CASE 1
					作品価値 += 600
				CASE 2
					作品価値 += 300
				CASE 4
					作品価値 += 300
			ENDSELECT
		CASE "狐", "妖狐", "戦士", "ファーリー", "尻尾", "動物耳", "羽", "ふたなり", "恋慕", "淫乱", "服従"
			作品価値 += 500
		CASE "魅力", "魅惑", "足使用不可", "スライム", "溶ける快", "親愛", "淫魔", "隷属"
			作品価値 += 1000
		CASE "謎の魅力", "人気", "妊娠"
			作品価値 += 1500
		CASE "バストサイズ"
			SELECTCASE TALENT:対象:バストサイズ
				CASE IS >= 4
					作品価値 += (TALENT:対象:バストサイズ-3)*100
			ENDSELECT
	ENDSELECT
NEXT

;タトゥーでも微増
SIF CSTR:対象:右腕の印 != ""
	作品価値 += 100
SIF CSTR:対象:左腕の印 != ""
	作品価値 += 100
SIF CSTR:対象:右足の印 != ""
	作品価値 += 100
SIF CSTR:対象:左足の印 != ""
	作品価値 += 100
SIF CSTR:対象:背中の印 != ""
	作品価値 += 200
SIF CSTR:対象:胴体の印 != ""
	作品価値 += 300
;人気度を加算
作品価値 += 人気度:(NOF(対象))

;崩壊が付いてると激減
SIF TALENT:対象:崩壊
	作品価値 /= 10

FOR LCOUNT, 1, VARSIZE("MUSEUM", 1)
	IF MUSEUM:LCOUNT:種類 == ""
		空き変数 = LCOUNT
		BREAK
	ENDIF
NEXT

;#;SIF 空き変数 == 0
;#;	THROW 変数「MUSEUM」に空きがありません

MUSEUM:空き変数:種類 = 鉱物

MUSEUM:空き変数:名前 = %NAME:対象%
SIF ISSLIME(対象) && !CSVTALENT(NO:対象, GETNUM(TALENT, "スライム")) && !CSVTALENT(NO:対象, GETNUM(TALENT, "溶ける快"))
	MUSEUM:空き変数:名前 += @"(%I18N("スライム", "TALENT")%)"

;陥落の種類で鉱物の名称変化
IF LANGUAGE == "ENG"
	IF TALENT:対象:恋慕
		MUSEUM:空き変数:名前 '= MUSEUM:空き変数:名前 + " statue with a gentle smile"
	ELSEIF TALENT:対象:親愛
		MUSEUM:空き変数:名前 '= MUSEUM:空き変数:名前 + " statue full of happiness"
	ELSEIF TALENT:対象:淫乱
		MUSEUM:空き変数:名前 '= "Indecent " + MUSEUM:空き変数:名前 + " nude statue"
	ELSEIF TALENT:対象:淫魔
		MUSEUM:空き変数:名前 '= "Nude statue of " + MUSEUM:空き変数:名前 + " that full of lust"
	ELSEIF TALENT:対象:服従
		MUSEUM:空き変数:名前 '= "Statue of " + MUSEUM:空き変数:名前 + " that dedicated as furniture"
	ELSEIF TALENT:対象:隷属
		MUSEUM:空き変数:名前 '= MUSEUM:空き変数:名前 + " that became an ethernal object"
	ELSEIF TALENT:対象:崩壊
		MUSEUM:空き変数:名前 '= MUSEUM:空き変数:名前 + " statue that embrace to destiny"
	ELSE
		MUSEUM:空き変数:名前 '= "Mineralized " + MUSEUM:空き変数:名前
	ENDIF
ELSE
	IF TALENT:対象:恋慕
		MUSEUM:空き変数:名前 '= "穏やかに微笑む" + MUSEUM:空き変数:名前 + "の彫像"
	ELSEIF TALENT:対象:親愛
		MUSEUM:空き変数:名前 '= "幸福に満ちた" + MUSEUM:空き変数:名前 + "の彫像"
	ELSEIF TALENT:対象:淫乱
		MUSEUM:空き変数:名前 '= "淫らな" + MUSEUM:空き変数:名前 + "の裸婦像"
	ELSEIF TALENT:対象:淫魔
		MUSEUM:空き変数:名前 '= "色欲に溺れた" + MUSEUM:空き変数:名前 + "の裸婦像"
	ELSEIF TALENT:対象:服従
		MUSEUM:空き変数:名前 '= "調度品として身を捧げた" + MUSEUM:空き変数:名前
	ELSEIF TALENT:対象:隷属
		MUSEUM:空き変数:名前 '= "永遠の晒し物となった" + MUSEUM:空き変数:名前
	ELSEIF TALENT:対象:崩壊
		MUSEUM:空き変数:名前 '= "今にも朽ちそうな" + MUSEUM:空き変数:名前 + "の像"
	ELSE
		MUSEUM:空き変数:名前 '= "鉱物化した" + MUSEUM:空き変数:名前
	ENDIF
ENDIF

MUSEUM:空き変数:キャラナンバー = {NOF(対象)}
MUSEUM:空き変数:価値 = {作品価値}
MUSEUM:空き変数:色 = {色保存用}
MUSEUM:空き変数:血縁コード = {CFLAG:対象:血縁コード}
MUSEUM:空き変数:オリジナルナンバー = {CFLAG:対象:複製}
MUSEUM:空き変数:集客力 = 100
MUSEUM:空き変数:汚れ = 0

CALL プレイログ記録, @"%NAME:対象%%I18N("が鉱物化する")%"
CSTR:対象:ロスト要因 = 鉱物化
CSTR:対象:ロスト詳細 = ジュエリーストームによって鉱物となる
CALL CLEAR_CHARA, 対象, 0, 1

RETURN 1

