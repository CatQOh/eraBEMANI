SPRITECREATE "SAMPLEBAR", 3

PRINT 　[
PRINT_IMG "SAMPLEBAR"
PRINTL ]
IF DEFAULT
	PRINTFORML 　[10] %I18N("デフォルト色にする")%
ELSE
	PRINTFORML □%I18N("プリセットから選ぶ")%
	PRINT 　
	FOR LCOUNT, 0, VARSIZE("色プリセット")
		IF 色プリセット:LCOUNT == ""
			PRINTL 
			PRINT 　
			CONTINUE
		ENDIF
		PRINTBUTTON @"[%色プリセット:LCOUNT%]", 色プリセット:LCOUNT
	NEXT

	PRINTL 
	PRINT 　
	PRINTBUTTON @"[%I18N("ランダム")%]", "ランダム"
	SIF NOF(対象) < 10000 && Gタグ色:NOF(対象)
		PRINTBUTTON @"[%I18N("グローバル")%]", "グローバル"
	SIF CFLAG:対象:複製 && Gタグ色:(CFLAG:対象:複製)
		PRINTBUTTON @"[%I18N("オリジナルに合わせる")%]", "オリジナルに合わせる"
	PRINTL 
ENDIF

DRAWLINE
PRINTPLAIN 　RGB　
PRINTBUTTON @"[0] - %I18N("戻る")% ", "0"
PRINTBUTTON @"[1] - %I18N("決定")% ", "1"
SIF 対象 >= 0 && NOF(対象) < 10000 && !DEFAULT
	PRINTBUTTON @"[2] - %I18N("グローバル色設定")% ", "2"
PRINTL 

ONEINPUTS

SELECTCASE RESULTS
	CASE "0"
		GDISPOSE 0
		GDISPOSE 1
		GDISPOSE 2
		GDISPOSE 3
		RETURN 0
	CASE "1"
		GDISPOSE 0
		GDISPOSE 1
		GDISPOSE 2
		GDISPOSE 3
		SIF Gタグ色保存設定 && 対象 > 0
			Gタグ色:NOF(対象) = COLOR_FROMRGB(INT_R, INT_G, INT_B)
		SAVEGLOBAL
		RETURN COLOR_FROMRGB(INT_R, INT_G, INT_B)
	CASE "2"
		IF NOF(対象) < 10000 && !DEFAULT
			PRINTFORML %I18N("グローバルに保存された色設定はキャラを購入した際などに全セーブデータで自動的に反映されます")%
			PRINTFORML [0] %I18N("現在の色をグローバルに保存して決定")%
			PRINTFORML [1] %I18N("全キャラのタグ色を一括でグローバルに保存して決定")%
			PRINTFORML [2] %I18N("色決定時に自動でグローバルにも保存する")%（%I18N("現在")%：%ON_OFF(Gタグ色保存設定)%）
			PRINTFORML [3] %I18N("このキャラのグローバル色設定をクリア")%
			PRINTFORML [4] %I18N("全キャラのグローバル色設定をクリア")%
			PRINTFORML [100] %I18N("戻る")%
			BINPUT
			SELECTCASE RESULT
				CASE 0
					GDISPOSE 0
					GDISPOSE 1
					GDISPOSE 2
					GDISPOSE 3
					Gタグ色:NOF(対象) = COLOR_FROMRGB(INT_R, INT_G, INT_B)
					SAVEGLOBAL
					RETURN COLOR_FROMRGB(INT_R, INT_G, INT_B)
				CASE 1
					PRINTFORML %I18N("現在購入済のキャラの色設定を全てグローバルに保存します。よろしいですか")%？
					PRINTFORML [0] %I18N("はい")%
					PRINTFORML [1] %I18N("いいえ")%
					BINPUT
					IF RESULT == 0
						FOR LCOUNT, 0, CHARANUM
							SIF NOF(LCOUNT) < 10000 && CFLAG:LCOUNT:タグ色
								Gタグ色:NOF(LCOUNT) = CFLAG:LCOUNT:タグ色
						NEXT
						Gタグ色:NOF(対象) = COLOR_FROMRGB(INT_R, INT_G, INT_B)
						SAVEGLOBAL
						RETURN COLOR_FROMRGB(INT_R, INT_G, INT_B)
					ENDIF
				CASE 2
					INVERTBIT Gタグ色保存設定, 0
					PRINTFORML %I18N("設定を変更しました")%
					SIF Gタグ色保存設定
						PRINTFORML （%I18N("以降タグ色を決定すると自動でグローバルにも保存されます")%）
					SAVEGLOBAL
					WAIT
				CASE 3
					PRINTFORML %CALLNAME:対象%%I18N("のグローバル色設定をクリアします。よろしいですか")%？
					PRINTFORML [0] %I18N("はい")%
					PRINTFORML [1] %I18N("いいえ")%
					BINPUT
					IF RESULT == 0
							Gタグ色:NOF(対象) = 0
							PRINTFORMW %I18N("設定をクリアしました")%
					ENDIF
					SAVEGLOBAL
				CASE 4
					PRINTFORML %I18N("全キャラのグローバル色設定をクリアします。よろしいですか？（元に戻せません）")%
					PRINTFORML [0] %I18N("はい")%
					PRINTFORML [1] %I18N("いいえ")%
					BINPUT
					IF RESULT == 0
							VARSET Gタグ色
							PRINTFORMW %I18N("設定をクリアしました")%
					ENDIF
					SAVEGLOBAL
			ENDSELECT
		ENDIF
	CASE "10"
		INT_R = DEFAULT/0x10000
		INT_G = DEFAULT/0x100%0x100
		INT_B = DEFAULT%0x100
	CASE "E", "e"
		INT_R--
	CASE "R", "r"
		INT_R++
	CASE "F", "f"
		INT_G--
	CASE "G", "g"
		INT_G++
	CASE "V", "v"
		INT_B--
	CASE "B", "b"
		INT_B++
	CASE "SET_R", "SET_G", "SET_B"
		PRINTFORML %I18N("数値を入力してください")%（0～255）
		INPUT
		SELECTCASE RESULTS
			CASE "SET_R"
				INT_R = RESULT
			CASE "SET_G"
				INT_G = RESULT
			CASE "SET_B"
				INT_B = RESULT
		ENDSELECT
	CASE "ルビー"
		INT_R = 0xC7
		INT_G = 0x00
		INT_B = 0x67
	CASE "サファイア"
		INT_R = 0x00
		INT_G = 0x54
		INT_B = 0xA6
	CASE "エメラルド"
		INT_R = 0x00
		INT_G = 0xA9
		INT_B = 0x68
	CASE "アメジスト"
		INT_R = 0x9E
		INT_G = 0x76
		INT_B = 0xB4
	CASE "トパーズ"
		INT_R = 0xFF
		INT_G = 0xCD
		INT_B = 0x00
	CASE "ペリドット"
		INT_R = 0xA0
		INT_G = 0xDC
		INT_B = 0x32
	CASE "クリスタル"
		INT_R = 0x00
		INT_G = 0xFF
		INT_B = 0xFF
	CASE "コーラル"
		INT_R = 0xFF
		INT_G = 0x7D
		INT_B = 0xC8
	CASE "ゴールド"
		INT_R = 0xF0
		INT_G = 0xAA
		INT_B = 0x00
	CASE "シルバー"
		INT_R = 0xC8
		INT_G = 0xCD
		INT_B = 0xCF
	CASE "カッパー"
		INT_R = 0xE1
		INT_G = 0x82
		INT_B = 0x46
	CASE "ブロンズ"
		INT_R = 0x5A
		INT_G = 0xB4
		INT_B = 0xAA
	CASE "ブラス"
		INT_R = 0xCD
		INT_G = 0xAF
		INT_B = 0x32
	CASE "石"
		INT_R = 0x80
		INT_G = 0x80
		INT_B = 0x80
	CASE "黒曜石"
		INT_R = 0x55
		INT_G = 0x4B
		INT_B = 0x5F
	CASE "ランダム"
		INT_R = RAND:256
		INT_G = RAND:256
		INT_B = RAND:256
	CASE "グローバル"
		INT_R = (Gタグ色:NOF(対象))/0x10000
		INT_G = (Gタグ色:NOF(対象))/0x100%0x100
		INT_B = (Gタグ色:NOF(対象))%0x100
	CASE "オリジナルに合わせる"
		INT_R = (Gタグ色:(CFLAG:対象:複製))/0x10000
		INT_G = (Gタグ色:(CFLAG:対象:複製))/0x100%0x100
		INT_B = (Gタグ色:(CFLAG:対象:複製))%0x100
ENDSELECT

INT_R = LIMIT(INT_R, 0, 255)
INT_G = LIMIT(INT_G, 0, 255)
INT_B = LIMIT(INT_B, 0, 255)

RESTART

;;;対象に魔法強化がかかっているかの判定
@ISENCHANT, 対象
#FUNCTION
#DIM DYNAMIC 対象
SIF 対象 < 0
	RETURNF 0

SIF ビーストモード:対象:0
	RETURNF 1
SIF ジェントルストレス:対象:0
	RETURNF 1
SIF ティルナノーグ:対象:0
	RETURNF 1
SIF CFLAG:対象:ポゼ
	RETURNF 1
SIF ハニーバニー:対象:0
	RETURNF 1

RETURNF 0

@TURNEND_魔法効果
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNT2

IF フリージングアトモスフィア > 0
	SIF --フリージングアトモスフィア == 0
		PRINTFORMW [%I18N("フリージングアトモスフィア")%]%I18N("の効果が切れました")%
ENDIF
IF バーニンザフロア > 0
	SIF --バーニンザフロア == 0
		PRINTFORMW [%I18N("バーニンザフロア")%]%I18N("の効果が切れました")%
ENDIF
IF ストームバスター > 0
	SIF --ストームバスター == 0
		PRINTFORMW [%I18N("ストームバスター")%]%I18N("の効果が切れました")%
ENDIF
IF スウィートレイン > 0
	SIF --スウィートレイン == 0
		PRINTFORMW [%I18N("スウィートレイン")%]%I18N("の効果が切れました")%
ENDIF
IF スノープリズム > 0
	SIF --スノープリズム == 0
		PRINTFORMW [%I18N("スノープリズム")%]%I18N("の効果が切れました")%
ENDIF
IF リジェネレーション > 0
	SIF --リジェネレーション == 0
		PRINTFORMW [%I18N("リ：ジェネレーション")%]%I18N("の効果が切れました")%
ENDIF
IF ヒプノティッククライシス > 0
	SIF --ヒプノティッククライシス == 0
		PRINTFORMW [%I18N("ヒプノティッククライシス")%]%I18N("の効果が切れました")%
ENDIF
IF エナジードライブ > 0
	IF --エナジードライブ == 0
		PRINTFORMW %CALLNAME:MASTER%%I18N("にかけられた")%[%I18N("エナジードライブ")%]%I18N("の効果が切れました")%
		FOR LCOUNT, 0, VARSIZE("ABL")
			SIF ABLNAME:LCOUNT != ""
				ABL:MASTER:LCOUNT -= エナジードライブ:1
		NEXT
		VARSET エナジードライブ
	ENDIF
ENDIF
FOR LCOUNT, 0, CHARANUM
	SIF CFLAG:LCOUNT:キャラロスト
		CONTINUE
	IF ビーストモード:LCOUNT:0 > 0
		IF --ビーストモード:LCOUNT:0 == 0
			CALL KOJO_MESSAGE_SPELLEND, "ビーストモード", LCOUNT
			SIF !RESULT
				PRINTFORMW %CALLNAME:LCOUNT%%I18N("にかけられた")%[%I18N("ビーストモード")%]%I18N("の効果が切れました")%
			SIF ビーストモード:LCOUNT:1
				TALENT:LCOUNT:動物耳 = 0
			SIF ビーストモード:LCOUNT:2
				TALENT:LCOUNT:尻尾 = 0
			SIF ビーストモード:LCOUNT:3
				TALENT:LCOUNT:ファーリー = 0
			CSTR:LCOUNT:種族 = %ビーストモードS:LCOUNT:0%
			VARSET ビーストモード:LCOUNT:0
			VARSET ビーストモードS:LCOUNT:0
		ENDIF
	ENDIF
	IF ジェントルストレス:LCOUNT:0 > 0
		IF --ジェントルストレス:LCOUNT:0 == 0
			CALL KOJO_MESSAGE_SPELLEND, "ジェントルストレス", LCOUNT
			SIF !RESULT
				PRINTFORMW %CALLNAME:LCOUNT%%I18N("にかけられた")%%I18N("ジェントルストレス")%%I18N("の効果が切れました")%
			ジェントルストレス:LCOUNT:1 = 0
		ENDIF
	ENDIF
	IF ティルナノーグ:LCOUNT:0 > 0
		IF --ティルナノーグ:LCOUNT:0 == 0
			CALL KOJO_MESSAGE_SPELLEND, "ティル・ナ・ノーグ", LCOUNT
			SIF !RESULT
				PRINTFORMW %CALLNAME:LCOUNT%%I18N("にかけられた")%[%I18N("ティル・ナ・ノーグ")%]%I18N("の効果が切れました")%
			TALENT:LCOUNT:小人体型 = 1
		ENDIF
	ENDIF
	IF CFLAG:LCOUNT:ポゼ
		IF --CFLAG:LCOUNT:ポゼ == 0
			CALL KOJO_MESSAGE_SPELLEND, "ポゼッション", LCOUNT
			SIF !RESULT
				PRINTFORMW %CALLNAME:LCOUNT%%I18N("にかけられた")%[%I18N("ポゼッション")%]%I18N("の効果が切れました")%
			FOR LCOUNT2, 0, 30
				SIF ABLNAME:LCOUNT2 == "魔法技能"
					CONTINUE
				ABL:LCOUNT:LCOUNT2 = ポゼッション:LCOUNT:LCOUNT2
			NEXT
			VARSET ポゼッション:LCOUNT:0
		ENDIF
	ENDIF
	IF ハニーバニー:LCOUNT:0 > 0
		IF -- ハニーバニー:LCOUNT:0 == 0
			CALL KOJO_MESSAGE_SPELLEND, "ハニーバニー", LCOUNT
			SIF !RESULT
				PRINTFORMW %CALLNAME:LCOUNT%%I18N("にかけられた")%[%I18N("ハニーバニー")%]%I18N("の効果が切れました")%
		ENDIF
	ENDIF
NEXT

@SPELLCAST_地の文, 詠唱者, 対象:0, 対象:1
#DIM DYNAMIC 詠唱者
#DIM DYNAMIC 対象, 2

SELECTCASE 詠唱魔法
	CASE "フリージングアトモスフィア"
		IF LANGUAGE == "ENG"
			PRINTFORML %CALLNAME:詠唱者% casts %詠唱魔法%
			PRINTFORML Suddenly it feels like there is getting chilly outside……
		ELSE
			PRINTFORML %CALLNAME:詠唱者%は%詠唱魔法%を唱えた
			PRINTFORML 突然、外が寒くなった気がする……
		ENDIF
	CASE "バーニンザフロア"
		IF LANGUAGE == "ENG"
			PRINTFORML %CALLNAME:詠唱者% casts %詠唱魔法%
			PRINTFORML Suddenly %HE_SHE(詠唱者)% feels like there is getting warmer outside……
		ELSE
			PRINTFORML %CALLNAME:詠唱者%は%詠唱魔法%を唱えた
			PRINTFORML 突然、外が暖かくなった気がする……
		ENDIF
	CASE "ストームバスター"
		IF LANGUAGE == "ENG"
			PRINTFORML %CALLNAME:詠唱者% casts %詠唱魔法%
		ELSE
			PRINTFORML %CALLNAME:詠唱者%は%詠唱魔法%を唱えた
		ENDIF
		SELECTCASE 天気()
			CASE "晴れ"
				IF ターン == "昼"
					PRINTFORML %I18N("日差しが強くなり、雲ひとつない青空が天に広がった")%……
				ELSE
					PRINTFORML %I18N("月明かりと星明かりがよりいっそう強くなった気がする")%……
				ENDIF
			CASEELSE
				IF ターン == "昼"
					PRINTFORML %I18N("数刻が過ぎると、空は快晴となった")%……
				ELSE
					PRINTFORML %I18N("数刻が過ぎると、空には綺麗な星空が広がっていた")%……
				ENDIF
		ENDSELECT
	CASE "スウィートレイン"
		IF LANGUAGE == "ENG"
			PRINTFORML %CALLNAME:詠唱者% casts %詠唱魔法%
		ELSE
			PRINTFORML %CALLNAME:詠唱者%は%詠唱魔法%を唱えた
		ENDIF
		SELECTCASE 天気()
			CASE "雨", "大雨", "雷雨"
				;全然スウィートじゃない
				PRINTFORML %I18N("雨はさらに強くなり、風がうなり始めた")%……
			CASE "雪", "大雪"
				PRINTFORML %I18N("雪は突然、雨と変わり、ざぁざぁと音を立てて降り始めた")%……
			CASEELSE
				PRINTFORML %I18N("ぽつぽつと雨が降り始めた")%……
		ENDSELECT
	CASE "スノープリズム"
		IF LANGUAGE == "ENG"
			PRINTFORML %CALLNAME:詠唱者% casts %詠唱魔法%
		ELSE
			PRINTFORML %CALLNAME:詠唱者%は%詠唱魔法%を唱えた
		ENDIF
		SELECTCASE 天気()
			CASE "雨", "大雨", "雷雨"
				PRINTFORML %I18N("雨は突如、雹のつぶてになり、やがて白く柔らかい雪へと変わった")%……
			CASE "雪", "大雪"
				PRINTFORML %I18N("降雪はさらに勢いを増し、外の風景を真っ白に染め上げた")%……
			CASEELSE
				PRINTFORML %I18N("空模様は変わらないまま雪が降ってきた")%……
		ENDSELECT
	CASE "ビーストモード", "ビーストモードtype2"
		IF LANGUAGE == "ENG"
			PRINTFORML %CALLNAME:詠唱者% cast beast mode on %CALLNAME:対象%
			PRINTFORM Suddenly, 
			SIF !TALENT:対象:動物耳
				PRINT animal ears
			SIF !TALENT:対象:動物耳 && !TALENT:対象:尻尾
				PRINT and 
			SIF !TALENT:対象:尻尾
				PRINT tail 
			PRINTFORML appears on %CALLNAME:対象%
			SIF 詠唱魔法 == "ビーストモードtype2"
				PRINTFORM , and %HIS_HER(対象)% whole body is covered with fur
			PRINTL ……
		ELSE
			PRINTFORML %CALLNAME:詠唱者%は%CALLNAME:対象%に対してビーストモードを唱えた
			PRINTFORM %CALLNAME:対象%に
			SIF !TALENT:対象:動物耳
				PRINT 動物耳
			SIF !TALENT:対象:動物耳 && !TALENT:対象:尻尾
				PRINT と
			SIF !TALENT:対象:尻尾
				PRINT 尻尾
			PRINT が生え
			SIF 詠唱魔法 == "ビーストモードtype2"
				PRINT 、全身が体毛に覆われ
			PRINTL た……
		ENDIF
	CASE "リ：ジェネレーション"
		IF LANGUAGE == "ENG"
		PRINTFORML %CALLNAME:詠唱者% casts %I18N("リ：ジェネレーション")%
			PRINTFORML A magic circle vaguely appeared around the mansion, and your mind with body feel relief……
		ELSE
		PRINTFORML %CALLNAME:詠唱者%はリ：ジェネレーションを唱えた
		PRINTFORML 館の周囲にぼんやりと魔法陣が浮かび上がり、少しだけ心身が安らかになった……
		ENDIF
	CASE "ジェントルストレス"
		IF LANGUAGE == "ENG"
			PRINTFORML %CALLNAME:詠唱者% casts %I18N("に対してジェントルストレスを唱えた")% on %CALLNAME:対象% 
			PRINTFORML %CALLNAME:対象% became very calm……
		ELSE
			PRINTFORML %CALLNAME:詠唱者%は%CALLNAME:対象%に対してジェントルストレスを唱えた
			PRINTFORML %CALLNAME:対象%の感情はとても穏やかになった……
		ENDIF
	CASE "クロノダイブ"
		IF LANGUAGE == "ENG"
			PRINTFORML %CALLNAME:詠唱者% casts %I18N("クロノダイブ")%
			PRINTFORML Violent ground rumbling and earthquakes echoed, and when you left the mansion, a different landscape than before spread outside……
		ELSE
			PRINTFORML %CALLNAME:詠唱者%はクロノダイブを唱えた
			PRINTFORML 激しい地鳴りと地震が響き渡り、館を出ると今までとは違う風景が外に広がっていた……
		ENDIF
	CASE "ヒプノティッククライシス"
		IF LANGUAGE == "ENG"
			PRINTFORML %CALLNAME:詠唱者% casts %I18N("ヒプノティッククライシス")%
			PRINTFORML %CALLNAME:MASTER% eyes have enchanted with magical power and looking more even more… captivating……
		ELSE
			PRINTFORML %CALLNAME:詠唱者%はヒプノティッククライシスを唱えた
			PRINTFORML %CALLNAME:MASTER%の瞳は見るものを虜にする魔力を得て、よりいっそう魅力的になった……
		ENDIF
	CASE "ティル・ナ・ノーグ"
		IF LANGUAGE == "ENG"
			PRINTFORML %CALLNAME:詠唱者% casts %I18N("ティル・ナ・ノーグ")% on %CALLNAME:対象%
			PRINTFORML %CALLNAME:対象%はまばゆい光に包まれ、人間と比べても遜色の無い大きさの身体になった……
		ELSE
			PRINTFORML %CALLNAME:詠唱者%は%CALLNAME:対象%に対してティル・ナ・ノーグを唱えた
			PRINTFORML %CALLNAME:対象%はまばゆい光に包まれ、人間と比べても遜色の無い大きさの身体になった……
		ENDIF
	CASE "エナジードライブ"
		IF LANGUAGE == "ENG"
			PRINTFORML %CALLNAME:詠唱者% casts %I18N("エナジードライブ")%
			PRINTFORML %CALLNAME:MASTER%の身体はさらなる活力を得た……
		ELSE
			PRINTFORML %CALLNAME:詠唱者%はエナジードライブを唱えた
			PRINTFORML %CALLNAME:MASTER%の身体はさらなる活力を得た……
		ENDIF
	CASE "ポゼッション"
		IF LANGUAGE == "ENG"
			PRINTFORML %CALLNAME:詠唱者% casts %I18N("ポゼッション")% on %CALLNAME:対象%
			PRINTFORML %CALLNAME:対象% loses consciousness, and confused by the discomfort in her body whan wakes up……
		ELSE
			PRINTFORML %CALLNAME:詠唱者%は%CALLNAME:対象%に対してポゼッションを唱えた
			PRINTFORML %CALLNAME:対象%は意識を失い、再び目が覚めると自身の体の違和感に困惑している……
		ENDIF
	CASE "ミラクル・スイート・スイーツ・マジック！！"
		IF LANGUAGE == "ENG"
