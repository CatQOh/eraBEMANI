"異種族融和",
"薬効増強",
"過剰分泌",
"ナルコレプシー",
}

{
#DIMS DYNAMIC スカ特質 =
"胃腸過敏",
"過剰排泄"
}

DRAWLINE

SELECTCASE 対象部位
	CASE "背中の印"
		効果倍率 = 15
	CASE "胴体の印"
		効果倍率 = 20
	CASEELSE
		効果倍率 = 10
ENDSELECT

IF マニュアル
	効果倍率 = 10
	GOTO 強化のタトゥー
ELSE
	CALL LOOP_CLEARLINE
ENDIF
IF LANGUAGE == "ENG"
	PRINTFORML □Select a stat to make a tatoo on %対象部位%(Bodypart effect:{効果倍率/10}.{効果倍率%10} times)
ELSE
	PRINTFORML □%対象部位%に刻む特質を選択してください(この部位の効果:{効果倍率/10}.{効果倍率%10}倍)
ENDIF
SELECTCASE CSTR:対象部位
	CASE "強化のタトゥー"
		$強化のタトゥー
		IF !マニュアル
			PRINTFORML 　%I18N("体力")%%BARBASE("体力")%
			PRINTFORML 　%I18N("気力")%%BARBASE("気力")%
