;;;各部位の効果倍率の和を返す
@特質, 特質名, 対象 = -1
#FUNCTION
#DIMS DYNAMIC 特質名
#DIM DYNAMIC 対象
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC 倍率合計

SIF 対象 == -1
	対象 = TARGET
;屍姦睡眠中はアイテム壊さないようにしつけ同等の効果があることにする
SIF 特質名 == "しつけ" && (TEQUIP:睡眠 || CFLAG:死亡)
	倍率合計++

FOR LCOUNT, GETNUM(CSTR, "右腕の特質"), GETNUM(CSTR, "胴体の特質")+1
	IF CSTR:対象:LCOUNT == 特質名
		SELECTCASE CSTRNAME:LCOUNT
			CASE "背中の特質"
				倍率合計 += 15
			CASE "胴体の特質"
				倍率合計 += 20
			CASEELSE
				倍率合計 += 10
		ENDSELECT
	ENDIF
NEXT

RETURNF 倍率合計

