@RITUAL_OF_SIGN
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC 刻印部位
#DIM DYNAMIC LTARGET
#DIM DYNAMIC 変数番号
#DIM DYNAMIC LRESULT

DRAWLINE

PRINTFORML □%I18N("印を刻むキャラを選択してください")%
FOR PAGING, 1, CHARANUM
	刻印部位 = 
	SIF CSTR:PAGING:右腕の印 != ""
		刻印部位 += @"[%I18N("右腕")%:%CSTR:PAGING:右腕の印%(\@ CSTR:PAGING:右腕の特質 == "" ? %I18N("特質無し")% # %CSTR:PAGING:右腕の特質% \@)]"
	SIF CSTR:PAGING:左腕の印 != ""
		刻印部位 += @"[%I18N("左腕")%:%CSTR:PAGING:左腕の印%(\@ CSTR:PAGING:左腕の特質 == "" ? %I18N("特質無し")% # %CSTR:PAGING:左腕の特質% \@)]"
	SIF CSTR:PAGING:右足の印 != ""
		刻印部位 += @"[%I18N("右足")%:%CSTR:PAGING:右足の印%(\@ CSTR:PAGING:右足の特質 == "" ? %I18N("特質無し")% # %CSTR:PAGING:右足の特質% \@)]"
	SIF CSTR:PAGING:左足の印 != ""
		刻印部位 += @"[%I18N("左足")%:%CSTR:PAGING:左足の印%(\@ CSTR:PAGING:左足の特質 == "" ? %I18N("特質無し")% # %CSTR:PAGING:左足の特質% \@)]"
	IF CSTR:PAGING:背中の印 != ""
		IF GROUPMATCH(CSTR:PAGING:背中の印, "奴隷の焼印", "淫売の焼印")
			刻印部位 += @"[%I18N("背中")%:%CSTR:PAGING:背中の印%]"
		ELSE
			刻印部位 += @"[%I18N("背中")%:%CSTR:PAGING:背中の印%(\@ CSTR:PAGING:背中の特質 == "" ? %I18N("特質無し")% # %CSTR:PAGING:背中の特質% \@)]"
		ENDIF
	ENDIF
	SIF CSTR:PAGING:胴体の印 != ""
		刻印部位 += @"[%I18N("胴体")%:%CSTR:PAGING:胴体の印%(\@ CSTR:PAGING:胴体の特質 == "" ? %I18N("特質無し")% # %CSTR:PAGING:胴体の特質% \@)]"
	;DISABLEチェック
	CALLFORM DISABLE, "EVENT_印の儀", PAGING
	CALL PAGING, !RESULT && PAGING > 0, @"\@ 刻印部位 != "" ? %刻印部位% #\@", "印の儀"
NEXT

SELECTCASE RESULT
	CASE -1
		RETURN 0
ENDSELECT

LTARGET = TARGET
TARGET = RESULT

DRAWLINE

$部位選択

IF LANGUAGE == "ENG"
	PRINTFORML □What would you do with %CALLNAME:TARGET%？\@ !ORIGIN ? (It costs 1 experience point to engrave a mark. Current experience level:{FLAG:経験値})#\@
ELSE
	PRINTFORML □%CALLNAME:TARGET%に何をしますか？\@ !ORIGIN ? (印を刻むには経験値を1消費します 現在の経験値:{FLAG:経験値})#\@
ENDIF
FOR LCOUNT, GETNUM(CSTR, "右腕の印"), GETNUM(CSTR, "胴体の印")+1
	IF CSTR:LCOUNT == ""
		IF GROUPMATCH(CSTRNAME:LCOUNT, "右足の印", "左足の印") && TALENT:足使用不可
			CALL PRINTCOLORL, @"　[-] - %CSTRNAME:LCOUNT% %I18N("使用不可")%", "gray"
		ELSE
			IF LANGUAGE == "ENG"
				PRINTFORML 　[{LCOUNT%10}] - manage %CSTRNAME:LCOUNT% 
			ELSE
				PRINTFORML 　[{LCOUNT%10}] - %CSTRNAME:LCOUNT%を施す
			ENDIF
		ENDIF
	ELSEIF CSTRNAME:LCOUNT == "背中の印" && GROUPMATCH(CSTR:背中の印, "淫売の焼印", "奴隷の焼印")
		PRINTFORML 　[-] - %I18N("背中の印")%(%CSTR:背中の印%)
	ELSE
		IF LANGUAGE == "ENG"
			PRINTFORML 　[{LCOUNT%10}] - Change %CSTR:LCOUNT% stats(%I18N("現在の特質")%:\@ CSTR:(LCOUNT+10) == "" ? %I18N("無し")% # %CSTR:(LCOUNT+10)% \@)
		ELSE
			PRINTFORML 　[{LCOUNT%10}] - %CSTR:LCOUNT%の特質を変更する(%I18N("現在の特質")%:\@ CSTR:(LCOUNT+10) == "" ? %I18N("無し")% # %CSTR:(LCOUNT+10)% \@)
		ENDIF
	ENDIF
NEXT
DRAWLINE
PRINTPLAINFORM 　%I18N("印の儀")%　
PRINTFORML [10] - %I18N("キャラを変更する")% [11] - %I18N("儀式をやめる")%
BINPUT
SELECTCASE RESULT
	CASE 10
		TARGET = LTARGET
		RESTART
	CASE 11
		TARGET = LTARGET
		RETURN 0
	CASE 0 TO 6
		LRESULT = RESULT
		変数番号 = GETNUM(CSTR, "右腕の印")
		IF CSTR:(変数番号+LRESULT) == ""
			IF FLAG:経験値 < 1 && !ORIGIN
				PRINTFORMW %I18N("経験値が足りません")%
				GOTO 部位選択
			ENDIF
			CALL 印を刻む, CSTRNAME:(変数番号+LRESULT)
		ELSE
			CALL 特質を刻む, CSTRNAME:(変数番号+LRESULT)
		ENDIF
		IF RESULT
			TARGET = LTARGET
			RETURN 1
		ELSE
			GOTO 部位選択
		ENDIF
ENDSELECT

@印を刻む, 対象部位
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC 対象部位
#DIM DYNAMIC 魔法使いあり
#DIM DYNAMIC ネクロマンサーあり
#DIM DYNAMIC 価額低下
#DIM DYNAMIC 選択可, 10

SELECTCASE 対象部位
	CASE "背中の印"
		価額低下 = 15
	CASE "胴体の印"
		価額低下 = 20
	CASEELSE
		価額低下 = 10
ENDSELECT

DRAWLINE

VARSET 選択可
IF LANGUAGE == "ENG"
	PRINTFORML □Carve %対象部位% on %CALLNAME:TARGET%(１ turn consumption \@ !ORIGIN ? The sale price decreases depending on the mark:{価額低下}\%#\@)
ELSE
	PRINTFORML □%CALLNAME:TARGET%に%対象部位%を刻みます(１ターン消費 \@ !ORIGIN ? 印によって下がる売却額:{価額低下}\%#\@)
ENDIF
SIF TALENT:MASTER:魔法使い || 助手素質("魔法使い")
	魔法使いあり = 1
SIF TALENT:MASTER:ネクロマンサー || 助手素質("ネクロマンサー")
	ネクロマンサーあり = 1

IF 魔法使いあり
	PRINTFORML 　[1] - %I18N("強化のタトゥー(身体能力を強化する特質を宿す)")%
	選択可:1 = 1
ELSE
	IF LANGUAGE == "ENG"
		CALL PRINTCOLORL, @"　[-] - Enchanting tattoo ([%I18N("魔法使い")%] is required for master or assistant)", "gray"
	ELSE
		CALL PRINTCOLORL, @"　[-] - 強化のタトゥー(主人もしくは助手に[魔法使い]が必要)", "gray"
	ENDIF
ENDIF
IF ネクロマンサーあり
	PRINTFORML 　[2] - %I18N("制御のタトゥー(行動を制御する特質を宿す)")%
	選択可:2 = 1
ELSE
	IF LANGUAGE == "ENG"
		CALL PRINTCOLORL, @"　[-] - Tatoo of control(主人もしくは助手に[%I18N("ネクロマンサー")%]が必要)", "gray"
	ELSE
		CALL PRINTCOLORL, @"　[-] - 制御のタトゥー([Necromancer] is required for master or assistant)", "gray"
	ENDIF
ENDIF
PRINTFORML 　[3] - %I18N("異質のタトゥー(体質が変化する特質を宿す)")%
選択可:3 = 1
IF 対象部位 == "背中の印"
	CALLFORM DISABLE, "EVENT_印の儀_淫売の焼印", TARGET
	IF !RESULT
		IF GROUPMATCH(FALLTYPE(TARGET), 0, 2)
			IF LANGUAGE == "ENG"
				PRINTFORML 　[4] - A brand of prositution (Unfallen characters, or only [%I18N("淫乱", "TALENT")%] or [%I18N("淫魔", "TALENT")%] can be selected. Cannot obtain fallen types othar than [%I18N("淫乱", "TALENT")%] and [%I18N("淫魔", "TALENT")%])
			ELSE
				PRINTL 　[4] - 淫売の焼印(未陥落、もしくは[淫乱][淫魔]のみ選択可 [淫乱][淫魔]以外の陥落素質が得られなくなる)
			ENDIF
			選択可:4 = 1
		ELSE
			IF LANGUAGE == "ENG"
				CALL PRINTCOLORL, @"　[4] - A brand of prositution (Unfallen characters, or only [%I18N("淫乱", "TALENT")%] or [%I18N("淫魔", "TALENT")%] can be selected. Cannot obtain fallen types othar than [%I18N("淫乱", "TALENT")%] and [%I18N("淫魔", "TALENT")%])"
			ELSE
				CALL PRINTCOLORL, "　[-] - 淫売の焼印(未陥落、もしくは[淫乱][淫魔]のみ選択可 [淫乱][淫魔]以外の陥落素質が得られなくなる)", "gray"
			ENDIF
		ENDIF
	ENDIF
	CALLFORM DISABLE, "EVENT_印の儀_奴隷の焼印", TARGET
	IF !RESULT
		IF GROUPMATCH(FALLTYPE(TARGET), 0, 3)
			IF LANGUAGE == "ENG"
				PRINTFORML 　[5] - A brand of slave(Unfallen characters, or can only select the ones with [%I18N("服従", "TALENT")%] or [%I18N("隷属", "TALENT")%] traits.  Cannot obtain other fallen types than [%I18N("服従", "TALENT")%] and [%I18N("隷属", "TALENT")%])
			ELSE
				PRINTL 　[5] - 奴隷の焼印(未陥落、もしくは[服従][隷属]のみ選択可 [服従][隷属]以外の陥落素質が得られなくなる)
			ENDIF
			選択可:5 = 1
		ELSE
			IF LANGUAGE == "ENG"
				CALL PRINTCOLORL, @"　[5] - A brand of slave(Unfallen characters, or can only select the ones with [%I18N("服従", "TALENT")%] or [%I18N("隷属", "TALENT")%] traits.  Cannot obtain other fallen types than [%I18N("服従", "TALENT")%] and [%I18N("隷属", "TALENT")%])"
			ELSE
			CALL PRINTCOLORL, "　[-] - 奴隷の焼印(未陥落、もしくは[服従][隷属]のみ選択可 [服従][隷属]以外の陥落素質が得られなくなる)", "gray"
			ENDIF
		ENDIF
	ENDIF
ENDIF

IF MOD:SCAT
	PRINTFORML 　[6] - %I18N("スカのタトゥー(体質が変化する特質を宿す)")%
	選択可:6 = 1
ENDIF

DRAWLINE

PRINTPLAINFORM 　%対象部位%　
PRINTFORML [0] - %I18N("戻る")% [10] - %I18N("特質一覧を見る")%

BINPUT

SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE 10
		CALL 特質を刻む, 対象部位, 1
		RESTART
	CASE 1
		SIF !選択可:1
			RESTART
		IF LANGUAGE == "ENG"
			PRINTFORML \@ !ORIGIN ? Consume 1 experience level to #\@ Paint a 「%I18N("強化のタトゥー")%」%SUBSTRINGU(対象部位, 0, 2)% on %CALLNAME:TARGET%？
		ELSE
			PRINTFORML \@ !ORIGIN ? 経験値を1消費して#\@%CALLNAME:TARGET%の%SUBSTRINGU(対象部位, 0, 2)%に「強化のタトゥー」を刻みます。よろしいですか？
		ENDIF
		PRINTFORML [0] - %I18N("はい")%
		PRINTFORML [1] - %I18N("いいえ")%
		BINPUT
		SIF RESULT
			RESTART
		IF LANGUAGE == "ENG"
			PRINTFORMW 「%I18N("強化のタトゥー")%」%SUBSTRINGU(対象部位, 0, 2)% was painted on %CALLNAME:TARGET%
			CALL プレイログ記録, @"「%I18N("強化のタトゥー")%」%SUBSTRINGU(対象部位, 0, 2)% was painted on %CALLNAME:TARGET%"
		ELSE
			PRINTFORMW %CALLNAME:TARGET%の%SUBSTRINGU(対象部位, 0, 2)%に「強化のタトゥー」を刻みました
			CALL プレイログ記録, @"%CALLNAME:TARGET%の%SUBSTRINGU(対象部位, 0, 2)%に「強化のタトゥー」を刻む"
		ENDIF
		CSTR:対象部位 = 強化のタトゥー
		FLAG:経験値--
		RETURN 1
	CASE 2
		SIF !選択可:2
			RESTART
		IF LANGUAGE == "ENG"
			PRINTFORML \@ !ORIGIN ? Consume 1 experience level to #\@ Paint a 「%I18N("制御のタトゥー")%」%SUBSTRINGU(対象部位, 0, 2)% on %CALLNAME:TARGET%？
		ELSE
			PRINTFORML \@ !ORIGIN ? 経験値を1消費して#\@%CALLNAME:TARGET%の%SUBSTRINGU(対象部位, 0, 2)%に「制御のタトゥー」を刻みます。よろしいですか？
		ENDIF
		PRINTFORML [0] - %I18N("はい")%
		PRINTFORML [1] - %I18N("いいえ")%
		BINPUT
		SIF RESULT
			RESTART
		IF LANGUAGE == "ENG"
			PRINTFORMW 「%I18N("制御のタトゥー")%」%SUBSTRINGU(対象部位, 0, 2)% was painted on %CALLNAME:TARGET%
			CALL プレイログ記録, @"「%I18N("制御のタトゥー")%」%SUBSTRINGU(対象部位, 0, 2)% was painted on %CALLNAME:TARGET%"
		ELSE
			PRINTFORMW %CALLNAME:TARGET%の%SUBSTRINGU(対象部位, 0, 2)%に「制御のタトゥー」を刻みました
			CALL プレイログ記録, @"%CALLNAME:TARGET%の%SUBSTRINGU(対象部位, 0, 2)%に「制御のタトゥー」を刻む"
		ENDIF
		CSTR:対象部位 = 制御のタトゥー
		FLAG:経験値--
		RETURN 1
	CASE 3
		SIF !選択可:3
			RESTART
		IF LANGUAGE == "ENG"
			PRINTFORML \@ !ORIGIN ? Consume 1 experience level to #\@ Paint a「%I18N("異質のタトゥー")%」%SUBSTRINGU(対象部位, 0, 2)% on %CALLNAME:TARGET%？
		ELSE
			PRINTFORML \@ !ORIGIN ? 経験値を1消費して#\@%CALLNAME:TARGET%の%SUBSTRINGU(対象部位, 0, 2)%に「異質のタトゥー」を刻みます。よろしいですか？
		ENDIF
		PRINTFORML [0] - %I18N("はい")%
		PRINTFORML [1] - %I18N("いいえ")%
		BINPUT
		SIF RESULT
			RESTART
		IF LANGUAGE == "ENG"
			PRINTFORMW 「%I18N("異質のタトゥー")%」%SUBSTRINGU(対象部位, 0, 2)% was painted on %CALLNAME:TARGET%
			CALL プレイログ記録, @"「%I18N("異質のタトゥー")%」%SUBSTRINGU(対象部位, 0, 2)% was painted on %CALLNAME:TARGET%"
		ELSE
			PRINTFORMW %CALLNAME:TARGET%の%SUBSTRINGU(対象部位, 0, 2)%に「異質のタトゥー」を刻みました
			CALL プレイログ記録, @"%CALLNAME:TARGET%の%SUBSTRINGU(対象部位, 0, 2)%に「異質のタトゥー」を刻む"
		ENDIF
		CSTR:対象部位 = 異質のタトゥー
		FLAG:経験値--
		RETURN 1
	CASE 4
		SIF !選択可:4
			RESTART
		IF LANGUAGE == "ENG"
			PRINTFORML Are you sure to engrave a 「%I18N("淫売の焼印")%」%SUBSTRINGU(対象部位, 0, 2)% on %CALLNAME:TARGET%？
		ELSE
			PRINTFORML %CALLNAME:TARGET%の%SUBSTRINGU(対象部位, 0, 2)%に「淫売の焼印」を押します。よろしいですか？
		ENDIF
		PRINTFORML [0] - %I18N("はい")%
		PRINTFORML [1] - %I18N("いいえ")%
		BINPUT
		SIF RESULT
			RESTART
		IF LANGUAGE == "ENG"
			PRINTFORMW %CALLNAME:TARGET% has been claimed by「%I18N("淫売の焼印")%」%SUBSTRINGU(対象部位, 0, 2)%
			CALL プレイログ記録, @"%CALLNAME:TARGET% has been claimed by「%I18N("淫売の焼印")%」%SUBSTRINGU(対象部位, 0, 2)%"
		ELSE
			PRINTFORMW %CALLNAME:TARGET%の%SUBSTRINGU(対象部位, 0, 2)%に「淫売の焼印」を押しました
			CALL プレイログ記録, @"%CALLNAME:TARGET%の%SUBSTRINGU(対象部位, 0, 2)%に「淫売の焼印」を押す"
		ENDIF
		CSTR:対象部位 = 淫売の焼印
		FLAG:経験値--
		RETURN 1
	CASE 5
		SIF !選択可:5
			RESTART
		IF LANGUAGE == "ENG"
			PRINTFORML Are you sure to claim %CALLNAME:TARGET% with 「%I18N("奴隷の焼印")%」 %SUBSTRINGU(対象部位, 0, 2)%？
		ELSE
			PRINTFORML %CALLNAME:TARGET%の%SUBSTRINGU(対象部位, 0, 2)%に「奴隷の焼印」を押します。よろしいですか？
		ENDIF
		PRINTFORML [0] - %I18N("はい")%
		PRINTFORML [1] - %I18N("いいえ")%
		BINPUT
		SIF RESULT
			RESTART
		IF LANGUAGE == "ENG"
			PRINTFORMW %CALLNAME:TARGET% has been claimed by 「%I18N("奴隷の焼印")%」 %SUBSTRINGU(対象部位, 0, 2)%
			CALL プレイログ記録, @"%CALLNAME:TARGET% has been claimed by 「%I18N("奴隷の焼印")%」 %SUBSTRINGU(対象部位, 0, 2)%"
		ELSE
			PRINTFORMW %CALLNAME:TARGET%の%SUBSTRINGU(対象部位, 0, 2)%に「奴隷の焼印」を押しました
			CALL プレイログ記録, @"%CALLNAME:TARGET%の%SUBSTRINGU(対象部位, 0, 2)%に「奴隷の焼印」を押す"
		ENDIF
		CSTR:対象部位 = 奴隷の焼印
		FLAG:経験値--
		RETURN 1
	CASE 6
		SIF !選択可:6
			RESTART
		IF LANGUAGE == "ENG"
			PRINTFORML \@ !ORIGIN ? Consume 1 experience level to #\@ Point a 「%I18N("スカのタトゥー")%」%SUBSTRINGU(対象部位, 0, 2)% on %CALLNAME:TARGET%？
		ELSE
			PRINTFORML \@ !ORIGIN ? 経験値を1消費して#\@%CALLNAME:TARGET%の%SUBSTRINGU(対象部位, 0, 2)%に「スカのタトゥー」を刻みます。よろしいですか？
		ENDIF
		PRINTFORML [0] - %I18N("はい")%
		PRINTFORML [1] - %I18N("いいえ")%
		BINPUT
		SIF RESULT
			RESTART
		IF LANGUAGE == "ENG"
			PRINTFORMW %CALLNAME:TARGET% has been claimed by 「%I18N("スカのタトゥー")%」 %SUBSTRINGU(対象部位, 0, 2)%
			CALL プレイログ記録, @"%CALLNAME:TARGET% has been claimed by 「%I18N("スカのタトゥー")%」 %SUBSTRINGU(対象部位, 0, 2)%"
		ELSE
			PRINTFORMW %CALLNAME:TARGET%の%SUBSTRINGU(対象部位, 0, 2)%に「スカのタトゥー」を刻みました
			CALL プレイログ記録, @"%CALLNAME:TARGET%の%SUBSTRINGU(対象部位, 0, 2)%に「スカのタトゥー」を刻む"
		ENDIF
		CSTR:対象部位 = スカのタトゥー
		FLAG:経験値--
		RETURN 1
ENDSELECT

PRINTL 

