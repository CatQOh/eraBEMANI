;----------------------------------------------------------------
;段位認定システム　チュートリアル
;----------------------------------------------------------------
@TEST_TUTORIAL
DRAWLINE
IF LANGUAGE == "ENG"
	PRINTL Welcome to the Dan rating System.
	PRINTL 当モードはThis mode was created with reference to the 「beatmaniaIIDX」 dan rating exam.
	PRINTL 
	PRINTL [1] Basic overview of the dan system
	PRINTL [2] Clear conditions and failure conditions
	PRINTL [3] Explanation of unique elements of the dan system
	PRINTL [4] About the dan edit function
	DRAWLINE
	PRINTL [0] Finish the tutorial 

	BINPUT
	SELECTCASE RESULT
		CASE 0
			RETURN 0
		CASE 1
			PRINTL The tier system is a mode in which you can conquer「Four people」determined in each tier。
			PRINTL Unlike traditional currencies, this system uses a 「Grade gauge」 as the key to various functions。
			PRINTL When the tier gauge reaches 0, the game is over, and purchasing items also consumes the tier gauge。
			PRINTFORMW You can clear the game by making those four characters until they「%I18N("売却可能")%」before grade gauge depletes first。
		CASE 2
			PRINTFORML Clear condition is make all 4 characters 「%I18N("売却可能")%」or「Can be assistant」, and clearing will determined at the end of the day。
			PRINTL Even if you sell a character, that character can be cleared as 「Satisfied the sale conditions」。
			PRINTW Conversely, the condition for a game over is when the unique to this mod resource 「Grade gauge」,reaches 0。
		CASE 3
			PRINTL In this mode, the 「Grade gauge」 is important。
			PRINTL The tier gauge is a gauge that can be used to purchase items, and when it reaches 0, the game is over。
			CALL PASELIL, @"The initial value is「100\%」, and you can recover by converting the money obtained by selling characters into a gauge at「4000＄ × 2\%」rate。"
			PRINTL If the percentage of gold in your possession exceeds the maximum gauge amount, the amount will decrease but the gauge will not recover。
			PRINTW Also, when purchasing items, the required gauge will differ depending on the item, so you need to plan it wisely。
		CASE 4
			PRINTL This is a mode where you can choose your favorite four characters and create a tier。
			PRINTW Normally, Dan rating mode progresses at NORMAL difficulty level, but you can also select the difficulty level in EDIT。
	ENDSELECT
ELSE
	PRINTL 段位認定システムへようこそ。
	PRINTL 当モードは「beatmaniaIIDX」の段位認定試験を参考に作られたものです
	PRINTL 
	PRINTL [1] 段位システムの基本的な概要
	PRINTL [2] クリア条件と失敗条件
	PRINTL [3] 段位システム独自要素の説明
	PRINTL [4] 段位エディット機能について
	DRAWLINE
	PRINTL [0] チュートリアルを終了する 

	BINPUT
	SELECTCASE RESULT
		CASE 0
			RETURN 0
		CASE 1
			PRINTL 段位システムは段位ごとに決められた「四人」のキャラを攻略するモードです。
			PRINTL 当システムは従来の通貨とは異なり「段位ゲージ」が様々な鍵になります。
			PRINTL 段位ゲージが0になるとゲームオーバーで、アイテムを購入するにも段位ゲージを消費します。
			PRINTW 段位ゲージが0になる前に、その四人のキャラを「売却可能」にするとクリアです。
		CASE 2
			PRINTL クリア条件は決められた四人のキャラを「売却可能」または「助手可能」にすることで、一日の終了時にクリア判定がされます。
			PRINTL キャラを売却した場合も、そのキャラは「売却条件を満たした」として、クリアすることができます。
			PRINTW 逆にゲームオーバーになる条件は、当モードの独自システムである「段位ゲージ」が0になることでゲームオーバー扱いになります。
		CASE 3
			PRINTL 当モードでは「段位ゲージ」が重要になります。
			PRINTL 段位ゲージとは、それを消費してアイテムを購入したり、0になるとゲームオーバーになるゲージです。
			CALL PASELIL, @"初期値は「100\%」で、キャラを売却することで得た所持金を「4000＄ × 2\%」でゲージに換算して回復出来ます。"
			PRINTL 所持金の割合がゲージ最大量を超えた場合は、金額は減りますがゲージは回復しません。
			PRINTW また、アイテムを購入する際にも、物によって必要なゲージが違うので計画的に購入しましょう。
		CASE 4
			PRINTL 自分で好きなキャラを4人選んで段位を作るモードです。
			PRINTW 通常、段位認定モードは難易度NORMALで進行しますが、EDITでは難易度も選ぶことができます。
	ENDSELECT
ENDIF

RESTART

;----------------------------------------------------------------
;段位認定　受験段位選択
;----------------------------------------------------------------
@段位ボタン表示, DANNI
#DIMS DYNAMIC DANNI
SELECTCASE 段位名:DANNI
	CASE 3
		SETCOLORBYNAME gold
	CASE 2
		SETCOLORBYNAME lightslategray
	CASE 1
		SETCOLORBYNAME chocolate
ENDSELECT
PRINTFORM \@ 段位名:DANNI ? ★ # 　 \@
RESETCOLOR
PRINTFORML [{GETNUM(段位名, DANNI)}] %DANNI%

@段位認定
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LVARLINE
#DIMS DYNAMIC 段位ページ

SIF 段位ページ == ""
	段位ページ = 緑段位
LVARLINE = LINECOUNT

DRAWLINE
PRINTFORML □%I18N("遊びたいモードを選んでください")%

SELECTCASE 段位ページ
	CASE "緑段位"
		FOR LCOUNT, GETNUM(段位名, "七級"), GETNUM(段位名, "一級")+1
			CALL 段位ボタン表示, ERDNAME(段位名, LCOUNT)
		NEXT
	CASE "青段位"
		FOR LCOUNT, GETNUM(段位名, "初段"), GETNUM(段位名, "八段")+1
			CALL 段位ボタン表示, ERDNAME(段位名, LCOUNT)
		NEXT
	CASE "赤段位"
		PRINTL 
		PRINTL 
		CALL 段位ボタン表示, "九段"
		PRINTL 
		CALL 段位ボタン表示, "十段"
		PRINTL 
		PRINTL 
	CASE "金段位"
		PRINTL 
		CALL 段位ボタン表示, "中伝"
		PRINTL 
		;中伝以上で表示
		SIF 段位 >= GETNUM(段位名, "中伝")
			CALL 段位ボタン表示, "皆伝"
		PRINTL 
		PRINTL 
		;皆伝以上で表示
		SIF 段位 >= GETNUM(段位名, "皆伝")
			CALL 段位ボタン表示, "overjoy"
		PRINTL 
		PRINTL 
ENDSELECT

DRAWLINE
PRINTFORML 　[98] %I18N("オリジナルコース")%　[99] EDIT　[100] %I18N("チュートリアル")%
DRAWLINE

SIF 段位ページ == "緑段位"
	SETCOLORBYNAME lime
SIF 段位ページ == "青段位"
	SETCOLORBYNAME blue
SIF 段位ページ == "赤段位"
	SETCOLORBYNAME red
SIF 段位ページ == "金段位"
	SETCOLORBYNAME gold
PRINTPLAINFORM 　%段位ページ%　　
RESETCOLOR
CALL PRINTSPACE, 段位ページ != "緑段位", @"[44] %I18N("緑段位")% "
CALL PRINTSPACE, 段位ページ != "青段位" && 段位 >= 7, @"[55] %I18N("青段位")% "
CALL PRINTSPACE, 段位ページ != "赤段位" && 段位 >= 18, @"[66] %I18N("赤段位")% "
CALL PRINTSPACE, 段位ページ != "金段位" && 段位 >= 20, @"[77] %I18N("金段位")% "
PRINTL 

BINPUT
FLAG:選択段位 = RESULT
SELECTCASE RESULT
	CASE 44
		CLEARLINE LINECOUNT-LVARLINE
		段位ページ = 緑段位
	CASE 55
		CLEARLINE LINECOUNT-LVARLINE
		段位ページ = 青段位
	CASE 66
		CLEARLINE LINECOUNT-LVARLINE
		段位ページ = 赤段位
	CASE 77
		CLEARLINE LINECOUNT-LVARLINE
		段位ページ = 金段位
	CASE 98
		CALL ORIGINAL_COURSE
		SIF RESULT
			RETURN 0
	CASE 100
		CALL TEST_TUTORIAL
	CASEELSE
		CALL 段位内容, RESULT
		SIF RESULT
			RETURN 0
ENDSELECT
RESTART

@ORIGINAL_COURSE
#DIM DYNAMIC ページ数
#DIM CONST 最大ページ数 = 1
#DIM DYNAMIC LVARLINE
LVARLINE = LINECOUNT

PRINTFORML □%I18N("遊びたいコースを選んでください")%
SETCOLOR GETBGCOLOR()
PRINTFORML 　[ 0] %I18N("段位認定")% %I18N("裏七級")%
RESETCOLOR

SELECTCASE ページ数
	CASE 0
		PRINTFORML 　[ 1] %I18N("ドキッ！淫乱ピンクだらけの調教大会！")%
		PRINTFORML 　[ 2] %I18N("九尾狐夜行")%
		PRINTFORML 　[ 3] %I18N("TWINS")%
		PRINTFORML 　[ 4] %I18N("アダルトゲーム「日向美ビタースイーツ♪」")%
		PRINTFORML 　[ 5] %I18N("FOXHOUND")%
		PRINTFORML 　[ 6] %I18N("ぅゎょぅι゛ょェﾛぃ")%
		PRINTFORML 　[ 7] %I18N("Robotics Expert Course")%
		PRINTFORML 　[ 8] %I18N("ツンデレ五人斬り")%
		PRINTFORML 　[ 9] %I18N("えっちなお姉さんたちが教えてア・ゲ・ル♪")%
		PRINTFORML 　[10] %I18N("貧乳はステータスだ 希少価値だ")%
		PRINTFORML 　[11] %I18N("INSANIO")%
		PRINTFORML 　[12] %I18N("神よ、ニャンコを与えたまえ!")%
		PRINTFORML 　[13] %I18N("戦う誇りを胸に Natus Vincere")%
		PRINTFORML 　[14] %I18N("Roll on spring!")%
		PRINTFORML 　[15] %I18N("少女達の芳香は艶やかに、猛き賓客を癒し惑わす。")%
		PRINTFORML 　[16] %I18N("魅惑のサバト")%
		PRINTFORML 　[17] %I18N("くノ一忍法帖")%
		PRINTFORML 　[18] %I18N("シュレーディンガーのネコ")%
		PRINTFORML 　[19] %I18N("HELL CHARGE NOTES")%
		PRINTFORML 　[20] %I18N("アダルトゲーム「忍々七鍵伝」")%
	CASE 1
		PRINTFORML 　[21] %I18N("メスガキわからせる")%
		PRINTFORML 　[22] %I18N("炎の孕ませポップン学園")%
		PRINTFORML 　[23] %I18N("BisCoのEX-HARD☆大作戦")%
		PRINTFORML 　[24] %I18N("えっちなお姉さんたちが教えてア・ゲ・ル♪ ～Girl's Side～")%
		PRINTFORML 　[25] %I18N("Girls vs Tentacles in eraBEMANI")%
		PRINTFORML 　[26] %I18N("重婚烈風刀くん")%
		PRINTFORML 　[27] %I18N("わくわく乳搾り")%
		PRINTFORML 　[28] %I18N("THE 房中術")%
		PRINTFORML 　[29] %I18N("何かを間違えた房中術")%
		CALL PRINTCOLORL, @"　[30] %I18N("ヤンデレの音ゲーキャラに死ぬほど愛されて眠れないコース")%", "red"
		PRINTFORML 　[31] %I18N("いちかのアダルトチャンネル")%
		PRINTFORML 　[32] %I18N("よく躾けられたメイドさんは要りませんか？")%
		PRINTFORML 　[33] %I18N("ワガママ姫たちの接待調教プログラム")%
ENDSELECT

DRAWLINE
PRINT 　
CALL PRINTSPACE, ページ数 > 0, @"[101] %I18N("前ページ")% "
CALL PRINTSPACE, ページ数 < 最大ページ数, @"[109] %I18N("次ページ")% "
PRINTFORML [98] %I18N("段位コース")% [99] EDIT [100] %I18N("チュートリアル")% 
DRAWLINE
PRINTPLAINFORM 　%I18N("オリジナルコース")%　
PRINTL

BINPUT
SELECTCASE RESULT
	CASE 101
		CLEARLINE LINECOUNT-LVARLINE
		ページ数--
	CASE 109
		CLEARLINE LINECOUNT-LVARLINE
		ページ数++
	CASE 98
		RETURN
	CASE 99
		CALL 段位内容, RESULT
		SIF RESULT
			RETURN 1
	CASE 100
		CALL TEST_TUTORIAL
	CASEELSE
		FLAG:選択段位 = RESULT+50
		CALL 段位内容, FLAG:選択段位
		SIF RESULT
			RETURN 1
ENDSELECT
RESTART
