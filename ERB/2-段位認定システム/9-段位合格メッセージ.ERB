
@段位認定対象, 段位番号
#FUNCTION
#DIM DYNAMIC 段位番号
SIF INRANGE(段位番号, 0, 30) || GROUPMATCH(段位番号, 573, 999)
	RETURNF 1
RETURNF 0

@TEST_CLEAR
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC 換金
#DIM DYNAMIC ボーナス
#DIM DYNAMIC クリアマーク用
#DIM DYNAMIC 売却人数
#DIM DYNAMIC 陥落人数
#DIM DYNAMIC 未クリアあり
PRINTL ………………
PRINTL …………
PRINTW ……

IF 段位認定対象(FLAG:選択段位) || ERDNAME(段位名, FLAG:選択段位) == "EDIT"
	PRINTFORM %I18N("段位認定")%%ERDNAME(段位名, FLAG:選択段位)%
ELSE
	PRINTFORM %I18N("オリジナルコース")%
ENDIF
IF LANGUAGE == "ENG"
	PRINTFORML Congratulations。You have passed the challenge。
ELSE
	PRINTFORML に合格しました。おめでとうございます。
ENDIF
IF 段位認定対象(FLAG:選択段位)
	LOADGLOBAL
	IF LANGUAGE == "ENG"
		SIF FLAG:選択段位 == 7 && 段位 < 7
			PRINTL Starting from the next challenge, you will be able to take the green dan one。
		SIF FLAG:選択段位 == 18 && 段位 < 18
			PRINTL Starting from the next challenge, you will be able to take the red dan one。
		SIF FLAG:選択段位 == 20 && 段位 < 20
			PRINTL Chuden will be available to take the exam from next time。
		SIF FLAG:選択段位 == 30 && 段位 < 30
			PRINTL Starting next time, you will be able to take the Kaiden challenge。
	ELSE
		SIF FLAG:選択段位 == 7 && 段位 < 7
			PRINTL 次回から青段位が受験可能になりました。
		SIF FLAG:選択段位 == 18 && 段位 < 18
			PRINTL 次回から赤段位が受験可能になりました。
		SIF FLAG:選択段位 == 20 && 段位 < 20
			PRINTL 次回から中伝が受験可能になりました。
		SIF FLAG:選択段位 == 30 && 段位 < 30
			PRINTL 次回から皆伝が受験可能になりました。
	ENDIF
ENDIF
WAIT
IF ERDNAME(段位名, FLAG:選択段位) == "EDIT"
	IF LANGUAGE == "ENG"
		PRINTL If you think that 「This EDIT was fun」 , feel free to report it in the thread。
	ELSE
		PRINTL 「このEDIT楽しかったな」って思ったらぜひスレ等に報告してみてください。
	ENDIF
ELSEIF FLAG:選択段位 == 999
	IF LANGUAGE == "ENG"
		PRINTL If you have done all of the challenges so far, there is nothing that you cannot train。
		PRINTL If you think this is not enough, we are looking for the new ideas。
	ELSE
		PRINTL 段位認定をここまで攻略したあなたにはもう調教できないものなどありません。
		PRINTL これでも物足りないと思ったあなた、ぜひ新たなアイディアを募集しています。
	ENDIF
ELSEIF FLAG:選択段位 == 573
	IF LANGUAGE == "ENG"
		PRINTL You deserve to call yourself a master of this game。
		PRINTL Thank you for playing this far。
		PRINTL Thank you for your continued support of eraBEMANI！
	ELSE
		PRINTL あなたにはこのゲームをマスターしたことを名乗る資格があります。
		PRINTL ここまで遊んでいただいてありがとうございます。
		PRINTL これからもeraBEMANIをよろしくお願いします！
	ENDIF
ELSEIF 段位認定対象(FLAG:選択段位)
	FOR LCOUNT, FLAG:選択段位+1, 573+1
		SIF !段位認定対象(LCOUNT)
			CONTINUE
		SIF ERDNAME(段位名, LCOUNT) == ""
			CONTINUE
		IF LANGUAGE == "ENG"
			PRINTFORML Try %ERDNAME(段位名, LCOUNT)% next time。
		ELSE
			PRINTFORML 是非次回は%ERDNAME(段位名, LCOUNT)%に挑戦してみてください。
		ENDIF
		BREAK
	NEXT
ENDIF
WAIT

;実績「段位認定皆伝をクリアする」
SIF FLAG:選択段位 == 573
	CALL 実績解除, "皆伝？これからもよろしくな"

;先にボーナスを計算
クリアマーク用 = 1
FOR LCOUNT, 0, CHARANUM
	SIF CFLAG:LCOUNT:キャラロスト
		売却人数++
	SIF 陥落(LCOUNT)
		陥落人数++
NEXT
IF !売却人数
	IF 陥落人数
		;ALL JUSTに相当(全員未売却で1人以上陥落)
		クリアマーク用 = 3
		IF FLAG:段位ゲージ == 1
			;ボーダークリア
			ボーナス = 133333
		ELSE
			ボーナス = 50000
		ENDIF
	ELSE
		;PERFECTに相当(全員未売却)
		クリアマーク用 = 2
		IF FLAG:段位ゲージ == 1
			;ボーダークリア
			ボーナス = 11900
		ELSE
			ボーナス = 3110
		ENDIF
	ENDIF
ELSEIF FLAG:段位ゲージ == 1
	;ボーダークリアのみ
	ボーナス = 5730
ENDIF

PRINTL 
LOADGLOBAL
IF LANGUAGE == "ENG"
	PRINTW Save rank information。
ELSE
	PRINTW 段位情報をセーブします。
ENDIF
SIF 段位 < FLAG:選択段位 && !INRANGE(FLAG:選択段位, 50, 99)
	段位 = FLAG:選択段位
SIF 段位名:(FLAG:選択段位) < クリアマーク用 && FLAG:選択段位 != 999
	段位名:(FLAG:選択段位) = クリアマーク用
SAVEGLOBAL
IF LANGUAGE == "ENG"
	PRINTW Save completed。
ELSE
	PRINTW セーブが完了しました。
ENDIF
FOR LCOUNT, 0, VARSIZE("段位名")
	SIF !段位認定対象(LCOUNT)
		CONTINUE
	SIF !段位名:LCOUNT
		未クリアあり = 1
NEXT
SIF !未クリアあり
	CALL 実績解除, "クリアマークに希望と涙を添えて"
IF LANGUAGE == "ENG"
	PRINTL Do you want to continue playing the game？
	PRINTL After that, a tier gauge will be converted into cash,
	PRINTL And u can pick a difficulty level,all abilities will be transferred to PREMIUM FREE
	PRINTL 
	PRINTL [0] - Continue
	PRINTL [1] - End
ELSE
	PRINTL ゲームを続けますか？
	PRINTL 続ける場合、段位ゲージを所持金に換算したあとに、
	PRINTL 難易度を選択し全能力を引き継いでPREMIUM FREEに移行します
	PRINTL 
	PRINTL [0] - 続行する
	PRINTL [1] - 終了する
ENDIF
BINPUT
IF RESULT == 0
	IF LANGUAGE == "ENG"
		PRINTL Convert current tier gauge to money
	ELSE
		PRINTL 段位ゲージを所持金に換算します
	ENDIF
	CALL PASELIL, @"%I18N("段位ゲージ")%{FLAG:段位ゲージ*2}\% × 2000 ＝ {FLAG:段位ゲージ * 4000}＄"
	換金 = FLAG:段位ゲージ * 4000
	;オリジナルコースでない場合、ボーナスを加算
	IF 段位認定対象(FLAG:選択段位)
		換金 += ボーナス
		SELECTCASE ボーナス
			CASE 133333
				SETCOLOR 0xFA5AFA
				CALL PASELIL, @"PERFECT + BORDER  {ボーナス}＄"
				RESETCOLOR
				;実績「段位認定で133333パセリのボーナスを得る」
				CALL 実績解除, "この実績が達成できてしまったあなたは立派なビーマー"
			CASE 50000
				SETCOLOR 0xFA5AFA
				CALL PASELIL, @"PERFECT  {ボーナス}＄"
				RESETCOLOR
			CASE 11900
				CALL PASELIL, @"PERFECT + BORDER  {ボーナス}＄"
			CASE 3110
				CALL PASELIL, @"PERFECT  {ボーナス}＄"
			CASE 5730
				CALL PASELIL, @"BORDER  {ボーナス}＄"
		ENDSELECT
	ENDIF
	CALL PASELIW, @"{換金}＄%I18N("に換算しました")%"
	CALL PAYMENT, 換金, "段位ゲージ換金"
	売却禁止 = 0
	IF LANGUAGE == "ENG"
		PRINTL Select a difficulty level
	ELSE
		PRINTL 難易度を選択してください
	ENDIF
	PRINTL 
	PRINTL [1] - NORMAL
	PRINTL [2] - HYPER
	PRINTL [3] - ANOTHER
	PRINTL [4] - LEGGENDARIA
	BINPUT
	FLAG:難易度 = RESULT
	IF LANGUAGE == "ENG"
		PRINTW PREMIUM FREE mode is now on
		CALL プレイログ記録, @"Passed Rank「%受験段位名%」"
	ELSE
		PRINTW PREMIUM FREEに移行します
		CALL プレイログ記録, @"段位認定「%受験段位名%」合格"
	ENDIF
	FLAG:ゲームモード = 9
	JUMP SHOP画面
ELSE
	IF LANGUAGE == "ENG"
	PRINTW Exit the game。 Thank you for your hard work。
	ELSE
	PRINTW ゲームを終了します。おつかれさまでした。
	ENDIF
	QUIT
ENDIF

@TEST_FAILED
PRINTL ………………
PRINTL …………
PRINTW ……
IF LANGUAGE == "ENG"
	PRINTL The challenge failed because the gauge became 0%。
	PRINTW We look forward to your next challenge。
	PRINTL [0] - Return to title
	PRINTL [1] - give up
ELSE
	PRINTL ゲージが0%になってしまったため、段位認定は不合格です。
	PRINTW またの挑戦をお待ちしております。
	PRINTL [0] - タイトルに戻る
	PRINTL [1] - 諦める
ENDIF
BINPUT
SELECTCASE RESULT
	CASE 0
		CALL RESET_DATA
		;RESETDATAではTARGETが1になってるので-1にする
		TARGET = -1
		BEGIN TITLE
	CASE 1
		CALL THANKYOUFORPLAYING
		QUIT
ENDSELECT
