;@ロケーション_保健室
;CALL ロケーション_学校

@学校_コマンド
#DIM DYNAMIC LRESULT
#DIM DYNAMIC 学校ID

CALL COLUMNSHOP_SCHOOL

CALL COLUMNDRAWLINE, 0
CALL COLUMNPRINTL, 0, "□何をしよう？"

学校ID = FINDELEMENT(学校名, CSTR:PLAYER:現在地, 0, 学校数上限, 1)
授業中_現在地 = 授業中:学校ID

IF !授業中_現在地
	CALL COLUMNPRINTL, 0, "　次の授業:自習"
	CALL COLUMNPRINTL, 0, "　担当教師:なし"
ELSE
	IF 性教育レベル:学校ID > 0 && CSTR:授業中_現在地:担当科目 == "保健"
		CALL COLUMNPRINTL, 0, "　次の授業:性教育"
	ELSE
		CALL COLUMNPRINTL, 0, @"　次の授業:%CSTR:授業中_現在地:担当科目%"
	ENDIF
	CALL COLUMNPRINTL, 0, @"　担当教師:%NAME:授業中_現在地%先生"
ENDIF
;自分の通う学校にいるとき
IF CSTR:PLAYER:在校 == CSTR:PLAYER:現在地
	IF !授業中_現在地
		CALL COLUMNPRINTL, 0, @"　[---] - \@ ターン == "朝" ? 午前 # 午後 \@の授業は自習です", "gray"
	ELSE
		授業参加フラグ = 1
		CALL COLUMNPRINTL, 0, @"　[100] - きちんと準備をして\@ ターン == "朝" ? 午前 # 午後 \@の授業を受ける"
		;CFLAG:授業中:授業回数++
	ENDIF
;他校にいるとき
ELSE
	IF !授業中_現在地
		CALL COLUMNPRINTL, 0, @"　[---] - \@ ターン == "朝" ? 午前 # 午後 \@の授業は自習です", "gray"
	ELSE
		CALL COLUMNPRINTL, 0, "　[---] - 授業に紛れ込むのは難しそうだ", "gray"
	ENDIF
ENDIF

CALL COLUMNPRINTL, 0, "　[101] - 校内を散策する"
SIF ターン == "昼"
	CALL COLUMNPRINTL, 0, "　[102] - 友人を昼食に誘う"
CALL COLUMNPRINTL, 0, "　[500] - データベース"


@学校_コマンド_INPUT
SELECTCASE CRESULT:1
	CASE 100
		CALL 授業を受ける
	CASE 101
		CALL 校内を散策する
	CASE 102
		CALL 友人を昼食に誘う
	CASE 500
		CALL 学園データベース
ENDSELECT
;ターンが終わるような行動をとったときRESULTは1を返す(そうでないなら0)

SIF RESULT
	CALL TURNEND_学園


;;;在籍している教師(校長と理事長を除く)からランダムに選出しキャラ登録番号を返す
@教師ランダム, 学校
#FUNCTION
#DIM DYNAMIC 教師一覧, 50
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC 返り値
#DIMS DYNAMIC 学校

SIF 学校 == ""
	RETURNF 0

FOR LCOUNT, 1, CHARANUM
	SIF CSTR:LCOUNT:在任 == 学校 && CSTR:LCOUNT:担当科目 != "校長" && CSTR:LCOUNT:担当科目 != "理事長"
		ARRAYSHIFT 教師一覧, 1, LCOUNT
NEXT
SIF 教師一覧:0 == 0
	RETURNF 0

DUMPRAND
;授業を受けられるのは朝と昼
IF ターン == "朝"
	RANDOMIZE DAY*2
ELSE
	RANDOMIZE DAY*2+1
ENDIF
返り値 = 教師一覧:(RAND:(FINDELEMENT(教師一覧, 0)))

INITRAND

RETURNF 返り値
