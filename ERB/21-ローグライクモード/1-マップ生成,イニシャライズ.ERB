@PLMAP生成
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY
#DIM DYNAMIC XSPRITE
#DIM DYNAMIC YSPRITE
#DIM DYNAMIC サイズ = 100
#DIM DYNAMIC CM, 5, 5

GDISPOSE 3000
GCREATE 3000, サイズ*21, サイズ*21

;視界範囲外を暗くするカラーマトリクス
CM:0:0 = 0x80, 0, 0, 0, 0
CM:1:0 = 0, 0x80, 0, 0, 0
CM:2:0 = 0, 0, 0x80, 0, 0
CM:3:0 = 0, 0, 0, 0x80, 0
CM:4:0 = 0, 0, 0, 0, 0

FOR LCOUNTX, PL:XPOS-10, PL:XPOS+11
	FOR LCOUNTY, PL:YPOS-10, PL:YPOS+11
		IF !INRANGE(LCOUNTX, 0, VARSIZE("RLMAP", 1)-1) || !INRANGE(LCOUNTY, 0, VARSIZE("RLMAP", 2)-1) || RLMAP:LCOUNTX:LCOUNTY == 0
			GDRAWSPRITE 3000, "　", XSPRITE*サイズ, YSPRITE*サイズ
		ELSEIF !RLMAP_EXPLORED:LCOUNTX:LCOUNTY
			GDRAWSPRITE 3000, "　", XSPRITE*サイズ, YSPRITE*サイズ
		ELSEIF PL:XPOS == LCOUNTX && PL:YPOS == LCOUNTY
			GDRAWSPRITE 3000, "＠", XSPRITE*サイズ, YSPRITE*サイズ
		ELSEIF RLMAP_ENEMY:LCOUNTX:LCOUNTY
			IF PL_VISIBLE:LCOUNTX:LCOUNTY
				TARGET = RLMAP_ENEMY:LCOUNTX:LCOUNTY
				IF INRANGE(NOF(TARGET), 0, 9999)
					IF CSTRRL:行動パターン == "中立"
						GDRAWSPRITE 3000, @"%TOFULL(CHARATU(CALLNAME:TARGET, 0))%_中立", XSPRITE*サイズ, YSPRITE*サイズ
					ELSE
						GDRAWSPRITE 3000, TOFULL(CHARATU(CALLNAME:TARGET, 0)), XSPRITE*サイズ, YSPRITE*サイズ
					ENDIF
				ELSE
					GDRAWSPRITE 3000, "敵", XSPRITE*サイズ, YSPRITE*サイズ
				ENDIF
			ELSE
				GOTO 通常フロア
			ENDIF
		ELSEIF STAIR:XPOS == LCOUNTX &&  STAIR:YPOS == LCOUNTY
			IF PL_VISIBLE:LCOUNTX:LCOUNTY
				GDRAWSPRITE 3000, "％", XSPRITE*サイズ, YSPRITE*サイズ
			ELSE
				GDRAWSPRITE 3000, "％", XSPRITE*サイズ, YSPRITE*サイズ, サイズ, サイズ, CM:0:0
			ENDIF
		ELSEIF RLMAP_ITEM:LCOUNTX:LCOUNTY
			IF PL_VISIBLE:LCOUNTX:LCOUNTY
				GDRAWSPRITE 3000, "＊", XSPRITE*サイズ, YSPRITE*サイズ
			ELSE
				GOTO 通常フロア
			ENDIF
		ELSEIF INRANGE(RLMAP:LCOUNTX:LCOUNTY, 1, 2)
			$通常フロア
			IF PL_VISIBLE:LCOUNTX:LCOUNTY
				GDRAWSPRITE 3000, "■", XSPRITE*サイズ, YSPRITE*サイズ
			ELSE
				GDRAWSPRITE 3000, "■", XSPRITE*サイズ, YSPRITE*サイズ, サイズ, サイズ, CM:0:0
			ENDIF
		ELSEIF RLMAP:LCOUNTX:LCOUNTY == 3
			IF PL_VISIBLE:LCOUNTX:LCOUNTY
				GDRAWSPRITE 3000, "壁", XSPRITE*サイズ, YSPRITE*サイズ
			ELSE
				GDRAWSPRITE 3000, "壁", XSPRITE*サイズ, YSPRITE*サイズ, サイズ, サイズ, CM:0:0
			ENDIF
		ELSE
			GDRAWSPRITE 3000, "　", XSPRITE*サイズ, YSPRITE*サイズ
		ENDIF
		;SIF INRANGE(LCOUNTX, 0, VARSIZE("RLMAP", 1)-1) && INRANGE(LCOUNTY, 0, VARSIZE("RLMAP", 2)-1) && PL_VISIBLE:LCOUNTX:LCOUNTY
		;	GDRAWSPRITE 3000, "視", XSPRITE*サイズ, YSPRITE*サイズ
		SIF 見渡し && 見渡し座標:XPOS == LCOUNTX & 見渡し座標:YPOS == LCOUNTY
			GDRAWSPRITE 3000, "◇", XSPRITE*サイズ, YSPRITE*サイズ

		YSPRITE++
	NEXT
	XSPRITE++
	YSPRITE = 0
NEXT

GSAVE 3000, 1

SPRITECREATE "PLMAP", 3000

@PL視界生成, 移動後
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY
#DIM DYNAMIC LCOUNTX2
#DIM DYNAMIC LCOUNTY2
#DIM DYNAMIC X_DIFF
#DIM DYNAMIC Y_DIFF
#DIM DYNAMIC ライン数
#DIM DYNAMIC 射線, 8, 2
#DIM DYNAMIC 射線数
#DIM DYNAMIC 移動後
#DIM DYNAMIC 一時保存変数, 60, 60

ARRAYCOPY "PL_VISIBLE", "一時保存変数"

VARSET PL_VISIBLE
VARSET PL_VISIBLE_MOVED

;めちゃくちゃ簡略化する
FOR LCOUNTX, PL:XPOS-VISIBLE_RANGE, PL:XPOS+VISIBLE_RANGE+1
	FOR LCOUNTY, PL:YPOS-VISIBLE_RANGE, PL:YPOS+VISIBLE_RANGE+1
		;PLの周囲1マスは問答無用で見れる
		IF INRANGE(LCOUNTX, PL:XPOS-1, PL:XPOS+1) && INRANGE(LCOUNTY, PL:YPOS-1, PL:YPOS+1)
			PL_VISIBLE:LCOUNTX:LCOUNTY = 1
		ELSE
			SIF !INRANGE(LCOUNTX, 0, VARSIZE("RLMAP", 1)) || !INRANGE(LCOUNTY, 0, VARSIZE("RLMAP", 2))
				CONTINUE
			X_DIFF = ABS(LCOUNTX-PL:XPOS)
			Y_DIFF = ABS(LCOUNTY-PL:YPOS)

			SELECTCASE 座標方向判別(PL:XPOS, PL:YPOS, LCOUNTX, LCOUNTY)
				CASE "上"
					FOR LCOUNTY2, LCOUNTY+1, PL:YPOS
						SIF 壁判定(LCOUNTX, LCOUNTY2)
							GOTO NOTVISIBLE
					NEXT
					PL_VISIBLE:LCOUNTX:LCOUNTY = 1
				CASE "下"
					FOR LCOUNTY2, PL:YPOS, LCOUNTY
						SIF 壁判定(LCOUNTX, LCOUNTY2)
							GOTO NOTVISIBLE
					NEXT
					PL_VISIBLE:LCOUNTX:LCOUNTY = 1
				CASE "左"
					FOR LCOUNTX2, LCOUNTX+1, PL:XPOS
						SIF 壁判定(LCOUNTX2, LCOUNTY)
							GOTO NOTVISIBLE
					NEXT
					PL_VISIBLE:LCOUNTX:LCOUNTY = 1
				CASE "右"
					FOR LCOUNTX2, PL:XPOS, LCOUNTX
						SIF 壁判定(LCOUNTX2, LCOUNTY)
							GOTO NOTVISIBLE
					NEXT
					PL_VISIBLE:LCOUNTX:LCOUNTY = 1
				CASE "左上"
					FOR LCOUNTX2, PL:XPOS, LCOUNTX, -1
						SIF 壁判定(LCOUNTX2, PL:YPOS)
							GOTO NOTVISIBLE
						FOR LCOUNTY2, PL:YPOS, LCOUNTY, -1
							SIF 壁判定(LCOUNTX2, LCOUNTY2)
								GOTO NOTVISIBLE
						NEXT
					NEXT
					PL_VISIBLE:LCOUNTX:LCOUNTY = 1
				CASE "右上"
					FOR LCOUNTX2, PL:XPOS, LCOUNTX
						SIF 壁判定(LCOUNTX2, PL:YPOS)
							GOTO NOTVISIBLE
						FOR LCOUNTY2, PL:YPOS, LCOUNTY, -1
							SIF 壁判定(LCOUNTX2, LCOUNTY2)
								GOTO NOTVISIBLE
						NEXT
					NEXT
					PL_VISIBLE:LCOUNTX:LCOUNTY = 1
				CASE "左下"
					FOR LCOUNTX2, PL:XPOS, LCOUNTX, -1
						SIF 壁判定(LCOUNTX2, PL:YPOS)
							GOTO NOTVISIBLE
						FOR LCOUNTY2, PL:YPOS, LCOUNTY
							SIF 壁判定(LCOUNTX2, LCOUNTY2)
								GOTO NOTVISIBLE
						NEXT
					NEXT
					PL_VISIBLE:LCOUNTX:LCOUNTY = 1
				CASE "右下"
					FOR LCOUNTX2, PL:XPOS, LCOUNTX
						SIF 壁判定(LCOUNTX2, PL:YPOS)
							GOTO NOTVISIBLE
						FOR LCOUNTY2, PL:YPOS, LCOUNTY
							SIF 壁判定(LCOUNTX2, LCOUNTY2)
								GOTO NOTVISIBLE
						NEXT
					NEXT
					PL_VISIBLE:LCOUNTX:LCOUNTY = 1
			ENDSELECT
		ENDIF
		$NOTVISIBLE
	NEXT
NEXT

IF 移動後
	ARRAYCOPY "PL_VISIBLE", "PL_VISIBLE_MOVED"
	ARRAYCOPY "一時保存変数", "PL_VISIBLE"
ENDIF

[SKIPSTART]
FOR LCOUNTX, PL:XPOS-視界マス数, PL:XPOS+視界マス数+1
	FOR LCOUNTY, PL:YPOS-視界マス数, PL:YPOS+視界マス数+1
		;PLの周囲1マスは問答無用で見れる
		IF INRANGE(LCOUNTX, PL:XPOS-1, PL:XPOS+1) && INRANGE(LCOUNTY, PL:YPOS-1, PL:YPOS+1)
			PL_VISIBLE:LCOUNTX:LCOUNTY = 1
		ELSE
			SIF !INRANGE(LCOUNTX, 0, VARSIZE("RLMAP", 1)) || !INRANGE(LCOUNTY, 0, VARSIZE("RLMAP", 2))
				CONTINUE
			X_DIFF = ABS(LCOUNTX-PL:XPOS)
			Y_DIFF = ABS(LCOUNTY-PL:YPOS)

			SELECTCASE 座標方向判別(PL:XPOS, PL:YPOS, LCOUNTX, LCOUNTY)
				CASE "上"
					FOR LCOUNTY2, LCOUNTY+1, PL:YPOS
						SIF 壁判定(LCOUNTX, LCOUNTY2)
							GOTO NOTVISIBLE
					NEXT
					PL_VISIBLE:LCOUNTX:LCOUNTY = 1
				CASE "下"
					FOR LCOUNTY2, PL:YPOS, LCOUNTY
						SIF 壁判定(LCOUNTX, LCOUNTY2)
							GOTO NOTVISIBLE
					NEXT
					PL_VISIBLE:LCOUNTX:LCOUNTY = 1
				CASE "左"
					FOR LCOUNTX2, LCOUNTX+1, PL:XPOS
						SIF 壁判定(LCOUNTX2, LCOUNTY)
							GOTO NOTVISIBLE
					NEXT
					PL_VISIBLE:LCOUNTX:LCOUNTY = 1
				CASE "右"
					FOR LCOUNTX2, PL:XPOS, LCOUNTX
						SIF 壁判定(LCOUNTX2, LCOUNTY)
							GOTO NOTVISIBLE
					NEXT
					PL_VISIBLE:LCOUNTX:LCOUNTY = 1
				CASE "左上"
					;東北東
					IF ABS(LCOUNTX-PL:XPOS) > ABS(LCOUNTY-PL:YPOS)
					;北北東
					ELSEIF ABS(LCOUNTX-PL:XPOS) < ABS(LCOUNTY-PL:YPOS)
					;完全に斜め左上
					ELSE
						射線数 = 0
						FOR LCOUNTX2, LCOUNTX+1, PL:XPOS
							FOR LCOUNTY2, LCOUNTY+1, PL:YPOS
								IF ABS(LCOUNTX2-PL:XPOS) == ABS(LCOUNTY2-PL:YPOS)
									射線:射線数:0 = LCOUNTX2
									射線:射線数:1 = LCOUNTY2
									射線数++
								ENDIF
							NEXT
						NEXT
					ENDIF
					FOR LCOUNT, 視界マス数-1, 0, -1
						SIF 壁判定(射線:LCOUNT:0, 射線:LCOUNT:1)
							GOTO NOTVISIBLE
					NEXT
					PL_VISIBLE:LCOUNTX:LCOUNTY = 1
			ENDSELECT
		ENDIF
		$NOTVISIBLE
	NEXT
NEXT
[SKIPEND]
