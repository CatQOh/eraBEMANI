@ローグライクモードデバッグ

;イニシャライズ
CALL RLスプライト生成

DT_CREATE "RLITEMLIST"
DT_COLUMN_ADD "RLITEMLIST", "アイテム名", "string"
DT_COLUMN_ADD "RLITEMLIST", "分類", "string"
DT_COLUMN_ADD "RLITEMLIST", "ダイスロール", "string"
DT_COLUMN_ADD "RLITEMLIST", "命中率", "int64"
DT_COLUMN_ADD "RLITEMLIST", "使用回数", "int64"
DT_COLUMN_ADD "RLITEMLIST", "重さ", "int64"
DT_COLUMN_ADD "RLITEMLIST", "アイテムスキル", "string"
DT_COLUMN_ADD "RLITEMLIST", "説明", "string"

CALL COLUMNCREATE, 1
CALL COLUMNRESIZE, 1, 4200, 4200
CALL COLUMNMOVE, 1, -500, 1800

CALL COLUMNCREATE, 2
CALL COLUMNRESIZE, 2, 4200, 4200
CALL COLUMNMOVE, 2, -500, -2200

CALL COLUMNCREATE, 3
CALL COLUMNRESIZE, 3, 4200, 4200
CALL COLUMNMOVE, 3, 3800, 1200

CALL COLUMNCREATE, 4
CALL COLUMNRESIZE, 4, 3000, 3000
CALL COLUMNMOVE, 4, 0, 1700

CALL COLUMNCREATE, 5
CALL COLUMNRESIZE, 5, 3000, 3000
CALL COLUMNMOVE, 5, 3800, 1800

SETSOUNDVOLUME 30

$RL_NEWGAME
DT_CLEAR "RLITEMLIST"
RL_GAMEOVER = 0
VARSET RLLOG
RLターン数 = 0

PRINTL □プレイヤーキャラを選んでください
CALL CHARA_LIST, "RL"
CALL CHARA_ADD, RESULT

;タイトル画面で2人追加してるのでSWAPCHARAする
SWAPCHARA 0, CHARANUM-1

;β版の暫定調整
CFLAGRL:PLAYER:HP = BASE:PLAYER:体力/100*2
CFLAGRL:PLAYER:MAXHP = MAXBASE:PLAYER:体力/100*2

CALL ローグライクモード

SIF RESULT
	GOTO RL_NEWGAME

@ローグライクモード
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY
;現状は正方形のみ
#DIM CONST RLMAP_CONST = VARSIZE("RLMAP", 1)
#DIM DYNAMIC 生成キャラ
#DIM DYNAMIC ランセレ, 10000

CALL ダンジョン生成

VARSET 出現敵イニシャル

;RAND:10000でやると各機種先頭キャラに偏るので一度別変数に入れてから決める
VARSET ランセレ
FOR LCOUNT, 0, 10000
	;SIF NO:PLAYER == LCOUNT
	;	CONTINUE
	SIF EXISTCSV(LCOUNT) && !撃破済み:LCOUNT
		ランセレ:FINDELEMENT(ランセレ, 0) = LCOUNT
NEXT

ARRAYCOPY "RLMAP_CREATE", "RLMAP"

;プレイヤー配置
DO
	LCOUNTX = RAND:RLMAP_CONST
	LCOUNTY = RAND:RLMAP_CONST
	IF RLMAP:LCOUNTX:LCOUNTY == 1
		PL:XPOS = LCOUNTX
		PL:YPOS = LCOUNTY
		BREAK
	ENDIF
LOOP 1
;階段配置
DO
	LCOUNTX = RAND:RLMAP_CONST
	LCOUNTY = RAND:RLMAP_CONST
	IF RLMAP:LCOUNTX:LCOUNTY == 1 && PL:XPOS != LCOUNTX && PL:YPOS != LCOUNTY
		STAIR:XPOS = LCOUNTX
		STAIR:YPOS = LCOUNTY
		BREAK
	ENDIF
LOOP 1

;アイテム配置等
ENEMY_COUNT = 0
FOR LCOUNTX, 0, RLMAP_CONST
	FOR LCOUNTY, 0, RLMAP_CONST
		IF RLMAP:LCOUNTX:LCOUNTY == 1
			;アイテム配置
			IF RAND:250 == 0
				;ここでアイテムを生成してDTに入れた後にRLMAP_ITEMにはIDを入れる
				CALL RLアイテム生成
				RLMAP_ITEM:LCOUNTX:LCOUNTY = RESULT
			ENDIF
			;敵配置
			IF RAND:250 == 0
				;敵味方全部キャラデータとして扱う
				DO
					;AWAIT 1000
					生成キャラ = ランセレ:(RAND:FINDELEMENT(ランセレ, 0))
					;PRINTFORML %CSVNAME(生成キャラ)%生成中 {GETCHARA(生成キャラ)} {FINDELEMENTF(出現敵イニシャル, CHARATU(CSVNAME(生成キャラ), 0))}
					SIF GETCHARA(生成キャラ) > 0
						CONTINUE
					;一文字タイルなのでイニシャルが被ったキャラも諦める
					SIF FINDELEMENTF(出現敵イニシャル, CHARATU(CSVCALLNAME(生成キャラ), 0)) > 0
						CONTINUE
					
					ADDCHARA 生成キャラ
					TARGET = CHARANUM-1
					RLMAP_ENEMY:LCOUNTX:LCOUNTY = TARGET
					CFLAGRL:HP = BASE:体力/100
					CFLAGRL:MAXHP = MAXBASE:体力/100
					CSTRRL:立場 = 敵
					出現敵イニシャル:FINDELEMENTF(出現敵イニシャル, "") = SUBSTRINGU(NAME:TARGET, 0, 1)
					;PRINTFORMW 生成成功
					BREAK
				LOOP 1
			ENDIF
		ENDIF
	NEXT
NEXT

CALL ダンジョン描写

SIF RL_GAMEOVER
	RETURN 1

SIF RESULT
	RESTART

@ダンジョン描写
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY
#DIM CONST RLMAP_CONST = VARSIZE("RLMAP", 1)
#DIM DYNAMIC 全体マップ
#DIM DYNAMIC 移動先X
#DIM DYNAMIC 移動先Y

CLEARLINE LINECOUNT

CALL PL視界生成

CVARSET CFLAGRL, GETNUM(CFLAGRL, "移動済み"), 0

FOR LCOUNTX, PL:XPOS-10, PL:XPOS+11
	FOR LCOUNTY, PL:YPOS-10, PL:YPOS+11
		SIF INRANGE(LCOUNTX, 0, VARSIZE("RLMAP", 1)-1) && INRANGE(LCOUNTY, 0, VARSIZE("RLMAP", 2)-1) && PL_VISIBLE:LCOUNTX:LCOUNTY == 1
			RLMAP_EXPLORED:LCOUNTX:LCOUNTY = 1
	NEXT
NEXT

IF 全体マップ
	;IF EXPLORED
	FOR LCOUNTY, 0, RLMAP_CONST
		FOR LCOUNTX, 0, RLMAP_CONST
			SELECTCASE RLMAP_CREATE:LCOUNTX:LCOUNTY
				CASE 0
					PRINT 　
				CASE 3
					SETCOLORBYNAME peru
					PRINT ■
					RESETCOLOR
				CASEELSE
					IF PL:XPOS == LCOUNTX && PL:YPOS == LCOUNTY
						SETCOLORBYNAME deepskyblue
						PRINT ＠
						RESETCOLOR
					ELSEIF STAIR:XPOS == LCOUNTX &&  STAIR:YPOS == LCOUNTY
						SETCOLORBYNAME lime
						PRINT ％
						RESETCOLOR
					ELSEIF RLMAP_ENEMY:LCOUNTX:LCOUNTY
						SETCOLORBYNAME coral
						PRINTFORM %TOFULL(CHARATU(CALLNAME:(RLMAP_ENEMY:LCOUNTX:LCOUNTY), 0))%
						RESETCOLOR
					ELSEIF RLMAP_ITEM:LCOUNTX:LCOUNTY
						SETCOLORBYNAME gold
						PRINT ＊
						RESETCOLOR
					ELSEIF RLMAP:LCOUNTX:LCOUNTY == 2
						SETCOLORBYNAME blue
						PRINT ■
						RESETCOLOR
					ELSE
						PRINT ■
					ENDIF
			ENDSELECT
		NEXT
		PRINTL
	NEXT
ELSE
	CALL RLREDRAW
ENDIF

IF 階段判定()
	;PRINTL 階段がある >で登る
ELSE
	;PRINTL 5で終了 Xで全体マップ
ENDIF

移動先X = -1
移動先Y = -1

ONEINPUTS

SELECTCASE RESULTS
	CASE "7"
		移動先X = PL:XPOS-1
		移動先Y = PL:YPOS-1
		;IF !壁判定(PL:XPOS-1, PL:YPOS-1)
		;	PL:XPOS--
		;	PL:YPOS--
		;ENDIF
	CASE "8"
		移動先X = PL:XPOS
		移動先Y = PL:YPOS-1
		;IF !壁判定(PL:XPOS, PL:YPOS-1)
		;	PL:YPOS--
		;ENDIF
	CASE "9"
		移動先X = PL:XPOS+1
		移動先Y = PL:YPOS-1
		;IF !壁判定(PL:XPOS+1, PL:YPOS-1)
		;	PL:XPOS++
		;	PL:YPOS--
		;ENDIF
	CASE "4"
		移動先X = PL:XPOS-1
		移動先Y = PL:YPOS
		;IF !壁判定(PL:XPOS-1, PL:YPOS)
		;	PL:XPOS--
		;ENDIF
	CASE "6"
		移動先X = PL:XPOS+1
		移動先Y = PL:YPOS
		;IF !壁判定(PL:XPOS+1, PL:YPOS)
		;	PL:XPOS++
		;ENDIF
	CASE "1"
		移動先X = PL:XPOS-1
		移動先Y = PL:YPOS+1
		;IF !壁判定(PL:XPOS-1, PL:YPOS+1)
		;	PL:XPOS--
		;	PL:YPOS++
		;ENDIF
	CASE "2"
		移動先X = PL:XPOS
		移動先Y = PL:YPOS+1
		;IF !壁判定(PL:XPOS, PL:YPOS+1)
		;	PL:YPOS++
		;ENDIF
	CASE "3"
		移動先X = PL:XPOS+1
		移動先Y = PL:YPOS+1
		;IF !壁判定(PL:XPOS+1, PL:YPOS+1)
		;	PL:XPOS++
		;	PL:YPOS++
		;ENDIF
	CASE "5"
		CALL HP自然回復, PLAYER, 2
	CASE "-"
		RETURN 0
	CASE ">"
		IF 階段判定()
			CALL SE再生, 階段SE
			RETURN 1
		ENDIF
	CASE "X"
		INVERTBIT 全体マップ, 0
		RESTART
	;Get
	CASE "g", "G"
		CALL アイテム拾得, PL:XPOS, PL:YPOS
	;Inventory
	CASE "i", "I"
		CALL インベントリ一覧
		RESTART
	;Swing/Slash
	CASE "s", "S"
		CALL 近接武器一覧
		RESTART
	;Fire
	CASE "f", "F"
		CALL 遠距離武器一覧
		RESTART
	;Read
	CASE "r", "R"
		CALL 巻物一覧
		RESTART
	;Quaff
	CASE "q", "Q"
		CALL ポーション一覧
		RESTART
	;Eat
	CASE "e", "E"
		CALL 食料一覧
		RESTART
ENDSELECT

;移動方向のフラグが必要かも
IF 中立判定(移動先X, 移動先Y)
	CALL RL中立キャラ, PLAYER, 中立判定(移動先X, 移動先Y)
	RESTART
ELSEIF 敵判定(移動先X, 移動先Y)
	CALL RL攻撃, PLAYER, 敵判定(移動先X, 移動先Y), "格闘"
ELSEIF !壁判定(移動先X, 移動先Y)
	PL:XPOS = 移動先X
	PL:YPOS = 移動先Y
	SIF 階段判定()
		CALL RLLOG, "階段がある >で登る"
	SIF RLMAP_ITEM:移動先X:移動先Y
		CALL RLLOG, @"%RLITEMDT(RLMAP_ITEM:移動先X:移動先Y, "アイテム名")%がある gで拾う"
ENDIF

;敵の行動フェーズ
CALL 敵行動フェーズ

IF RL_GAMEOVER
	CALL RLREDRAW
	FORCEWAIT
	RETURN 1
ENDIF

FOR LCOUNT, 0, CHARANUM
	CALL HP自然回復, LCOUNT
NEXT

RLターン数++

RESTART

[SKIPSTART]
SELECTCASE GETKEY()
	CASE "VK_NUMPAD7"
		IF RLMAP:(PL:XPOS-1):(PL:YPOS-1) != 0
			PL:XPOS--
			PL:YPOS--
		ENDIF
		RESTART
	CASE "VK_NUMPAD8"
		IF RLMAP:(PL:XPOS):(PL:YPOS-1) != 0
			PL:YPOS--
		ENDIF
		RESTART
	CASE "VK_NUMPAD9"
		IF RLMAP:(PL:XPOS+1):(PL:YPOS-1) != 0
			PL:XPOS++
			PL:YPOS--
		ENDIF
		RESTART
	CASE "VK_NUMPAD4"
		IF RLMAP:(PL:XPOS-1):(PL:YPOS) != 0
			PL:XPOS--
		ENDIF
		RESTART
	CASE "VK_NUMPAD6"
		IF RLMAP:(PL:XPOS+1):(PL:YPOS) != 0
			PL:XPOS++
		ENDIF
		RESTART
	CASE "VK_NUMPAD1"
		IF RLMAP:(PL:XPOS-1):(PL:YPOS+1) != 0
			PL:XPOS--
			PL:YPOS++
		ENDIF
	CASE "VK_NUMPAD2"
		IF RLMAP:(PL:XPOS):(PL:YPOS+1) != 0
			PL:YPOS++
		ENDIF
	CASE "VK_NUMPAD3"
		IF RLMAP:(PL:XPOS+1):(PL:YPOS+1) != 0
			PL:XPOS++
			PL:YPOS++
		ENDIF
	CASE "VK_NUMPAD5"
		RETURN 0
	CASE 
ENDSELECT
[SKIPEND]

;そのうちアイテム交換とか実装予定
@RL中立キャラ, INTERACTID, TARGETID
#DIM DYNAMIC INTERACTID
#DIM DYNAMIC TARGETID

CALL RLLOG, @"%CALLNAME:INTERACTID%は%CALLNAME:TARGETID%に挨拶した"

CALL RLREDRAW
