@ローグライクモードデバッグ
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY
;現状は正方形のみ
#DIM CONST RLMAP_CONST = VARSIZE("RLMAP", 1)

CALL ダンジョン生成

ARRAYCOPY "RLMAP_CREATE", "RLMAP"

;プレイヤー配置
DO
	LCOUNTX = RAND:RLMAP_CONST
	LCOUNTY = RAND:RLMAP_CONST
	IF RLMAP:LCOUNTX:LCOUNTY == 1
		PL:XPOS = LCOUNTX
		PL:YPOS = LCOUNTY
		BREAK
	ENDIF
LOOP 1
;階段配置
DO
	LCOUNTX = RAND:RLMAP_CONST
	LCOUNTY = RAND:RLMAP_CONST
	IF RLMAP:LCOUNTX:LCOUNTY == 1 && PL:XPOS != LCOUNTX && PL:YPOS != LCOUNTY
		STAIR:XPOS = LCOUNTX
		STAIR:YPOS = LCOUNTY
		BREAK
	ENDIF
LOOP 1

;アイテム配置等
ENEMY_COUNT = 0
FOR LCOUNTX, 0, RLMAP_CONST
	FOR LCOUNTY, 0, RLMAP_CONST
		IF RLMAP:LCOUNTX:LCOUNTY == 1
			;アイテム配置
			SIF RAND:250 == 0
				;ここでアイテムを生成してDTに入れた後にRLMAP_ITEMにはIDを入れる
				RLMAP_ITEM:LCOUNTX:LCOUNTY = 1
			;敵配置
			IF RAND:250 == 0
				;敵味方全部キャラデータとして扱う
				ADDVOIDCHARA
				TARGET = CHARANUM-1
				RLMAP_ENEMY:LCOUNTX:LCOUNTY = TARGET
				CSTRRL:立場 = 敵
			ENDIF
		ENDIF
	NEXT
NEXT

CALL ダンジョン描写

SIF RESULT
	RESTART

@ダンジョン描写
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY
#DIM CONST RLMAP_CONST = VARSIZE("RLMAP", 1)

CLEARLINE LINECOUNT

FOR LCOUNTY, 0, RLMAP_CONST
	FOR LCOUNTX, 0, RLMAP_CONST
		SELECTCASE RLMAP_CREATE:LCOUNTX:LCOUNTY
			CASE 0
				PRINT 　
			CASEELSE
				IF PL:XPOS == LCOUNTX && PL:YPOS == LCOUNTY
					SETCOLORBYNAME deepskyblue
					PRINT ＠
					RESETCOLOR
				ELSEIF STAIR:XPOS == LCOUNTX &&  STAIR:YPOS == LCOUNTY
					SETCOLORBYNAME lime
					PRINT ％
					RESETCOLOR
				ELSEIF RLMAP_ITEM:LCOUNTX:LCOUNTY
					SETCOLORBYNAME gold
					PRINT ＊
					RESETCOLOR
				ELSEIF RLMAP_ENEMY:LCOUNTX:LCOUNTY
					SETCOLORBYNAME coral
					PRINT 敵
					RESETCOLOR
				ELSE
					PRINT ■
				ENDIF
		ENDSELECT
	NEXT
	PRINTL
NEXT

IF 階段判定()
	PRINTL 階段がある >で登る
ELSE
	PRINTL 5で終了
ENDIF

ONEINPUTS

SELECTCASE RESULTS
	CASE "7"
		IF RLMAP:(PL:XPOS-1):(PL:YPOS-1) != 0
			PL:XPOS--
			PL:YPOS--
		ENDIF
	CASE "8"
		IF RLMAP:(PL:XPOS):(PL:YPOS-1) != 0
			PL:YPOS--
		ENDIF
	CASE "9"
		IF RLMAP:(PL:XPOS+1):(PL:YPOS-1) != 0
			PL:XPOS++
			PL:YPOS--
		ENDIF
	CASE "4"
		IF RLMAP:(PL:XPOS-1):(PL:YPOS) != 0
			PL:XPOS--
		ENDIF
	CASE "6"
		IF RLMAP:(PL:XPOS+1):(PL:YPOS) != 0
			PL:XPOS++
		ENDIF
	CASE "1"
		IF RLMAP:(PL:XPOS-1):(PL:YPOS+1) != 0
			PL:XPOS--
			PL:YPOS++
		ENDIF
	CASE "2"
		IF RLMAP:(PL:XPOS):(PL:YPOS+1) != 0
			PL:YPOS++
		ENDIF
	CASE "3"
		IF RLMAP:(PL:XPOS+1):(PL:YPOS+1) != 0
			PL:XPOS++
			PL:YPOS++
		ENDIF
	CASE "5"
		RETURN 0
	CASE ">"
		SIF 階段判定()
			RETURN 1
ENDSELECT

RESTART

