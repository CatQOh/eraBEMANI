@ローグライクモードデバッグ

;イニシャライズ
CALL RLスプライト生成
CALL ローグライクモード

@ローグライクモード
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY
;現状は正方形のみ
#DIM CONST RLMAP_CONST = VARSIZE("RLMAP", 1)


CALL ダンジョン生成

ARRAYCOPY "RLMAP_CREATE", "RLMAP"

;プレイヤー配置
DO
	LCOUNTX = RAND:RLMAP_CONST
	LCOUNTY = RAND:RLMAP_CONST
	IF RLMAP:LCOUNTX:LCOUNTY == 1
		PL:XPOS = LCOUNTX
		PL:YPOS = LCOUNTY
		BREAK
	ENDIF
LOOP 1
;階段配置
DO
	LCOUNTX = RAND:RLMAP_CONST
	LCOUNTY = RAND:RLMAP_CONST
	IF RLMAP:LCOUNTX:LCOUNTY == 1 && PL:XPOS != LCOUNTX && PL:YPOS != LCOUNTY
		STAIR:XPOS = LCOUNTX
		STAIR:YPOS = LCOUNTY
		BREAK
	ENDIF
LOOP 1

;アイテム配置等
ENEMY_COUNT = 0
FOR LCOUNTX, 0, RLMAP_CONST
	FOR LCOUNTY, 0, RLMAP_CONST
		IF RLMAP:LCOUNTX:LCOUNTY == 1
			;アイテム配置
			SIF RAND:250 == 0
				;ここでアイテムを生成してDTに入れた後にRLMAP_ITEMにはIDを入れる
				RLMAP_ITEM:LCOUNTX:LCOUNTY = 1
			;敵配置
			IF RAND:250 == 0
				;敵味方全部キャラデータとして扱う
				ADDVOIDCHARA
				TARGET = CHARANUM-1
				RLMAP_ENEMY:LCOUNTX:LCOUNTY = TARGET
				CSTRRL:立場 = 敵
			ENDIF
		ENDIF
	NEXT
NEXT

CALL ダンジョン描写

SIF RESULT
	RESTART

@ダンジョン描写
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY
#DIM CONST RLMAP_CONST = VARSIZE("RLMAP", 1)
#DIM DYNAMIC 全体マップ

CLEARLINE LINECOUNT

CALL PL視界生成

FOR LCOUNTX, PL:XPOS-10, PL:XPOS+11
	FOR LCOUNTY, PL:YPOS-10, PL:YPOS+11
		SIF INRANGE(LCOUNTX, 0, VARSIZE("RLMAP", 1)-1) && INRANGE(LCOUNTY, 0, VARSIZE("RLMAP", 2)-1) && PL_VISIBLE:LCOUNTX:LCOUNTY == 1
			RLMAP_EXPLORED:LCOUNTX:LCOUNTY = 1
	NEXT
NEXT

IF 全体マップ
	;IF EXPLORED
	FOR LCOUNTY, 0, RLMAP_CONST
		FOR LCOUNTX, 0, RLMAP_CONST
			SELECTCASE RLMAP_CREATE:LCOUNTX:LCOUNTY
				CASE 0
					PRINT 　
				CASE 3
					SETCOLORBYNAME peru
					PRINT ■
					RESETCOLOR
				CASEELSE
					IF PL:XPOS == LCOUNTX && PL:YPOS == LCOUNTY
						SETCOLORBYNAME deepskyblue
						PRINT ＠
						RESETCOLOR
					ELSEIF STAIR:XPOS == LCOUNTX &&  STAIR:YPOS == LCOUNTY
						SETCOLORBYNAME lime
						PRINT ％
						RESETCOLOR
					ELSEIF RLMAP_ITEM:LCOUNTX:LCOUNTY
						SETCOLORBYNAME gold
						PRINT ＊
						RESETCOLOR
					ELSEIF RLMAP_ENEMY:LCOUNTX:LCOUNTY
						SETCOLORBYNAME coral
						PRINT 敵
						RESETCOLOR
					ELSE
						PRINT ■
					ENDIF
			ENDSELECT
		NEXT
		PRINTL
	NEXT
ELSE
	CALL COLUMNCREATE, 1
	CALL COLUMNRESIZE, 1, 4200, 4200
	CALL COLUMNMOVE, 1, -500, 1000
	CALL PLMAP生成

	CALL COLUMNIMG, 1, "PLMAP", 4200, 4200
	CALL COLUMNPRINTL, 1, ""
	CALL COLUMNSHOW

ENDIF

IF 階段判定()
	PRINTL 階段がある >で登る
ELSE
	PRINTL 5で終了 Xで全体マップ
ENDIF

ONEINPUTS

SELECTCASE RESULTS
	CASE "7"
		IF !壁判定(PL:XPOS-1, PL:YPOS-1)
			PL:XPOS--
			PL:YPOS--
		ENDIF
	CASE "8"
		IF !壁判定(PL:XPOS, PL:YPOS-1)
			PL:YPOS--
		ENDIF
	CASE "9"
		IF !壁判定(PL:XPOS+1, PL:YPOS-1)
			PL:XPOS++
			PL:YPOS--
		ENDIF
	CASE "4"
		IF !壁判定(PL:XPOS-1, PL:YPOS)
			PL:XPOS--
		ENDIF
	CASE "6"
		IF !壁判定(PL:XPOS+1, PL:YPOS)
			PL:XPOS++
		ENDIF
	CASE "1"
		IF !壁判定(PL:XPOS-1, PL:YPOS+1)
			PL:XPOS--
			PL:YPOS++
		ENDIF
	CASE "2"
		IF !壁判定(PL:XPOS, PL:YPOS+1)
			PL:YPOS++
		ENDIF
	CASE "3"
		IF !壁判定(PL:XPOS+1, PL:YPOS+1)
			PL:XPOS++
			PL:YPOS++
		ENDIF
	CASE "5"
		RETURN 0
	CASE ">"
		SIF 階段判定()
			RETURN 1
	CASE "X"
		INVERTBIT 全体マップ, 0
ENDSELECT

RESTART

[SKIPSTART]
SELECTCASE GETKEY()
	CASE "VK_NUMPAD7"
		IF RLMAP:(PL:XPOS-1):(PL:YPOS-1) != 0
			PL:XPOS--
			PL:YPOS--
		ENDIF
		RESTART
	CASE "VK_NUMPAD8"
		IF RLMAP:(PL:XPOS):(PL:YPOS-1) != 0
			PL:YPOS--
		ENDIF
		RESTART
	CASE "VK_NUMPAD9"
		IF RLMAP:(PL:XPOS+1):(PL:YPOS-1) != 0
			PL:XPOS++
			PL:YPOS--
		ENDIF
		RESTART
	CASE "VK_NUMPAD4"
		IF RLMAP:(PL:XPOS-1):(PL:YPOS) != 0
			PL:XPOS--
		ENDIF
		RESTART
	CASE "VK_NUMPAD6"
		IF RLMAP:(PL:XPOS+1):(PL:YPOS) != 0
			PL:XPOS++
		ENDIF
		RESTART
	CASE "VK_NUMPAD1"
		IF RLMAP:(PL:XPOS-1):(PL:YPOS+1) != 0
			PL:XPOS--
			PL:YPOS++
		ENDIF
	CASE "VK_NUMPAD2"
		IF RLMAP:(PL:XPOS):(PL:YPOS+1) != 0
			PL:YPOS++
		ENDIF
	CASE "VK_NUMPAD3"
		IF RLMAP:(PL:XPOS+1):(PL:YPOS+1) != 0
			PL:XPOS++
			PL:YPOS++
		ENDIF
	CASE "VK_NUMPAD5"
		RETURN 0
	CASE 
ENDSELECT
