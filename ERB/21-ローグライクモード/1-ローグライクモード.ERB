@ローグライクモードデバッグ

;イニシャライズ
CALL RLスプライト生成

CALL COLUMNCREATE, 1
CALL COLUMNRESIZE, 1, 4200, 4200
CALL COLUMNMOVE, 1, -500, 1700

CALL COLUMNCREATE, 2
CALL COLUMNRESIZE, 2, 4200, 4200
CALL COLUMNMOVE, 2, -500, -2200

CALL ローグライクモード

@ローグライクモード
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY
;現状は正方形のみ
#DIM CONST RLMAP_CONST = VARSIZE("RLMAP", 1)


CALL ダンジョン生成

ARRAYCOPY "RLMAP_CREATE", "RLMAP"

;プレイヤー配置
DO
	LCOUNTX = RAND:RLMAP_CONST
	LCOUNTY = RAND:RLMAP_CONST
	IF RLMAP:LCOUNTX:LCOUNTY == 1
		PL:XPOS = LCOUNTX
		PL:YPOS = LCOUNTY
		BREAK
	ENDIF
LOOP 1
;階段配置
DO
	LCOUNTX = RAND:RLMAP_CONST
	LCOUNTY = RAND:RLMAP_CONST
	IF RLMAP:LCOUNTX:LCOUNTY == 1 && PL:XPOS != LCOUNTX && PL:YPOS != LCOUNTY
		STAIR:XPOS = LCOUNTX
		STAIR:YPOS = LCOUNTY
		BREAK
	ENDIF
LOOP 1

;アイテム配置等
ENEMY_COUNT = 0
FOR LCOUNTX, 0, RLMAP_CONST
	FOR LCOUNTY, 0, RLMAP_CONST
		IF RLMAP:LCOUNTX:LCOUNTY == 1
			;アイテム配置
			SIF RAND:250 == 0
				;ここでアイテムを生成してDTに入れた後にRLMAP_ITEMにはIDを入れる
				RLMAP_ITEM:LCOUNTX:LCOUNTY = 1
			;敵配置
			IF RAND:250 == 0
				;敵味方全部キャラデータとして扱う
				ADDVOIDCHARA
				TARGET = CHARANUM-1
				RLMAP_ENEMY:LCOUNTX:LCOUNTY = TARGET
				CFLAGRL:HP = 20
				CFLAGRL:MAXHP = 20
				CSTRRL:立場 = 敵
			ENDIF
		ENDIF
	NEXT
NEXT

CALL ダンジョン描写

SIF RESULT
	RESTART

@ダンジョン描写
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY
#DIM CONST RLMAP_CONST = VARSIZE("RLMAP", 1)
#DIM DYNAMIC 全体マップ
#DIM DYNAMIC 移動先X
#DIM DYNAMIC 移動先Y

CALL PL視界生成

CVARSET CFLAGRL, GETNUM(CFLAGRL, "移動済み"), 0

FOR LCOUNTX, PL:XPOS-10, PL:XPOS+11
	FOR LCOUNTY, PL:YPOS-10, PL:YPOS+11
		SIF INRANGE(LCOUNTX, 0, VARSIZE("RLMAP", 1)-1) && INRANGE(LCOUNTY, 0, VARSIZE("RLMAP", 2)-1) && PL_VISIBLE:LCOUNTX:LCOUNTY == 1
			RLMAP_EXPLORED:LCOUNTX:LCOUNTY = 1
	NEXT
NEXT

IF 全体マップ
	;IF EXPLORED
	FOR LCOUNTY, 0, RLMAP_CONST
		FOR LCOUNTX, 0, RLMAP_CONST
			SELECTCASE RLMAP_CREATE:LCOUNTX:LCOUNTY
				CASE 0
					PRINT 　
				CASE 3
					SETCOLORBYNAME peru
					PRINT ■
					RESETCOLOR
				CASEELSE
					IF PL:XPOS == LCOUNTX && PL:YPOS == LCOUNTY
						SETCOLORBYNAME deepskyblue
						PRINT ＠
						RESETCOLOR
					ELSEIF STAIR:XPOS == LCOUNTX &&  STAIR:YPOS == LCOUNTY
						SETCOLORBYNAME lime
						PRINT ％
						RESETCOLOR
					ELSEIF RLMAP_ITEM:LCOUNTX:LCOUNTY
						SETCOLORBYNAME gold
						PRINT ＊
						RESETCOLOR
					ELSEIF RLMAP_ENEMY:LCOUNTX:LCOUNTY
						SETCOLORBYNAME coral
						PRINT 敵
						RESETCOLOR
					ELSEIF RLMAP:LCOUNTX:LCOUNTY == 2
						SETCOLORBYNAME blue
						PRINT ■
						RESETCOLOR
					ELSE
						PRINT ■
					ENDIF
			ENDSELECT
		NEXT
		PRINTL
	NEXT
ELSE
	CALL RLREDRAW
ENDIF

IF 階段判定()
	;PRINTL 階段がある >で登る
ELSE
	;PRINTL 5で終了 Xで全体マップ
ENDIF

ONEINPUTS

SELECTCASE RESULTS
	CASE "7"
		移動先X = PL:XPOS-1
		移動先Y = PL:YPOS-1
		;IF !壁判定(PL:XPOS-1, PL:YPOS-1)
		;	PL:XPOS--
		;	PL:YPOS--
		;ENDIF
	CASE "8"
		移動先X = PL:XPOS
		移動先Y = PL:YPOS-1
		;IF !壁判定(PL:XPOS, PL:YPOS-1)
		;	PL:YPOS--
		;ENDIF
	CASE "9"
		移動先X = PL:XPOS+1
		移動先Y = PL:YPOS-1
		;IF !壁判定(PL:XPOS+1, PL:YPOS-1)
		;	PL:XPOS++
		;	PL:YPOS--
		;ENDIF
	CASE "4"
		移動先X = PL:XPOS-1
		移動先Y = PL:YPOS
		;IF !壁判定(PL:XPOS-1, PL:YPOS)
		;	PL:XPOS--
		;ENDIF
	CASE "6"
		移動先X = PL:XPOS+1
		移動先Y = PL:YPOS
		;IF !壁判定(PL:XPOS+1, PL:YPOS)
		;	PL:XPOS++
		;ENDIF
	CASE "1"
		移動先X = PL:XPOS-1
		移動先Y = PL:YPOS+1
		;IF !壁判定(PL:XPOS-1, PL:YPOS+1)
		;	PL:XPOS--
		;	PL:YPOS++
		;ENDIF
	CASE "2"
		移動先X = PL:XPOS
		移動先Y = PL:YPOS+1
		;IF !壁判定(PL:XPOS, PL:YPOS+1)
		;	PL:YPOS++
		;ENDIF
	CASE "3"
		移動先X = PL:XPOS+1
		移動先Y = PL:YPOS+1
		;IF !壁判定(PL:XPOS+1, PL:YPOS+1)
		;	PL:XPOS++
		;	PL:YPOS++
		;ENDIF
	CASE "5"
		RETURN 0
	CASE ">"
		SIF 階段判定()
			RETURN 1
	CASE "X"
		INVERTBIT 全体マップ, 0
ENDSELECT

;移動方向のフラグが必要かも
IF 敵判定(移動先X, 移動先Y)
	CALL RL攻撃, PLAYER, 敵判定(移動先X, 移動先Y), "格闘"
ELSEIF !壁判定(移動先X, 移動先Y)
	PL:XPOS = 移動先X
	PL:YPOS = 移動先Y
ENDIF

;敵の行動フェーズ
CALL 敵行動フェーズ

RESTART

[SKIPSTART]
SELECTCASE GETKEY()
	CASE "VK_NUMPAD7"
		IF RLMAP:(PL:XPOS-1):(PL:YPOS-1) != 0
			PL:XPOS--
			PL:YPOS--
		ENDIF
		RESTART
	CASE "VK_NUMPAD8"
		IF RLMAP:(PL:XPOS):(PL:YPOS-1) != 0
			PL:YPOS--
		ENDIF
		RESTART
	CASE "VK_NUMPAD9"
		IF RLMAP:(PL:XPOS+1):(PL:YPOS-1) != 0
			PL:XPOS++
			PL:YPOS--
		ENDIF
		RESTART
	CASE "VK_NUMPAD4"
		IF RLMAP:(PL:XPOS-1):(PL:YPOS) != 0
			PL:XPOS--
		ENDIF
		RESTART
	CASE "VK_NUMPAD6"
		IF RLMAP:(PL:XPOS+1):(PL:YPOS) != 0
			PL:XPOS++
		ENDIF
		RESTART
	CASE "VK_NUMPAD1"
		IF RLMAP:(PL:XPOS-1):(PL:YPOS+1) != 0
			PL:XPOS--
			PL:YPOS++
		ENDIF
	CASE "VK_NUMPAD2"
		IF RLMAP:(PL:XPOS):(PL:YPOS+1) != 0
			PL:YPOS++
		ENDIF
	CASE "VK_NUMPAD3"
		IF RLMAP:(PL:XPOS+1):(PL:YPOS+1) != 0
			PL:XPOS++
			PL:YPOS++
		ENDIF
	CASE "VK_NUMPAD5"
		RETURN 0
	CASE 
ENDSELECT
[SKIPEND]

@RL攻撃, ATTACKERID, TARGETID, 攻撃手段
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC ATTACKERID
#DIM DYNAMIC TARGETID
#DIMS DYNAMIC 攻撃手段
#DIM DYNAMIC ダイス数
#DIM DYNAMIC ダイス面
#DIM DYNAMIC ダイス結果, 10
#DIMS DYNAMIC ダメージテキスト
#DIM DYNAMIC 命中率
#DIM DYNAMIC ダメージ値

;命中判定 スキルとかいろいろ見るよね
SELECTCASE 攻撃手段
	CASE "格闘"
		命中率 = 70
		SIF RLスキル(ATTACKERID, "集中攻撃（格闘）")
			命中率 = RLスキル(ATTACKERID, "集中攻撃（格闘）")
	;武器名かDTのIDを見る？
	CASEELSE
ENDSELECT

;ここで攻撃力を見る とりあえず格闘の2d4でテスト
SELECTCASE 攻撃手段
	CASE "格闘"
		ダイス数 = 2
		IF RLスキル(ATTACKERID, "格闘")
			ダイス数 += RLスキル(ATTACKERID, "格闘")
			ダメージテキスト += @"格闘スキルLv{RLスキル(ATTACKERID, "格闘")}発動 "
		ENDIF
		ダイス面 = 4
	CASEELSE
ENDSELECT

ダメージテキスト += @"{ダイス数}d{ダイス面} "

FOR LCOUNT, 0, ダイス数
	ダイス結果:LCOUNT = RAND(1, ダイス面+1)
	ダメージテキスト += @"{ダイス結果:LCOUNT}+"
NEXT

;末尾の+を取る
ダメージテキスト = %SUBSTRING(ダメージテキスト, 0, STRLENS(ダメージテキスト)-1)%

ダメージ値 = SUMARRAY(ダイス結果)

ダメージテキスト += @"={ダメージ値}"

CALL RLLOG, @"@は%攻撃手段%で敵を攻撃した！(%ダメージテキスト%)"

CALL SE再生, 格闘SE
RLWAIT = 100

CALL RLREDRAW

CFLAGRL:TARGETID:HP -= ダメージ値

IF CFLAGRL:TARGETID:HP <= 0
	CALL RLLOG, @"敵を倒した！"
	CALL 敵撃破, ATTACKERID, TARGETID
	CALL SE再生, 敵撃破SE
	RLWAIT = 100
	CALL RLREDRAW
ENDIF

@敵撃破, ATTACKERID, TARGETID
#DIM DYNAMIC ATTACKERID
#DIM DYNAMIC TARGETID
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY

;経験値処理やドロップアイテム処理とか

FOR LCOUNTX, 0, RLMAP広さ
	FOR LCOUNTY, 0, RLMAP広さ
		IF RLMAP_ENEMY:LCOUNTX:LCOUNTY == TARGETID
			RLMAP_ENEMY:LCOUNTX:LCOUNTY = 0
		ENDIF
	NEXT
NEXT

@敵行動フェーズ
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY
#DIM DYNAMIC LCOUNTXE
#DIM DYNAMIC LCOUNTYE
#DIM DYNAMIC MOVEX
#DIM DYNAMIC MOVEY

;この時点でVISIBLE範囲はPLの移動前なので、移動で視界外に出ても敵は追従してくる
FOR LCOUNTX, 0, RLMAP広さ
	FOR LCOUNTY, 0, RLMAP広さ
		IF RLMAP_ENEMY:LCOUNTX:LCOUNTY > 0 && !CFLAGRL:(RLMAP_ENEMY:LCOUNTX:LCOUNTY):移動済み
			TARGET = RLMAP_ENEMY:LCOUNTX:LCOUNTY
			;視界内かどうかで動きが変わる
			IF PL_VISIBLE:LCOUNTX:LCOUNTY
				;SELECTCASE 座標距離判別, LCOUNTX, LCOUNTY, PL:XPOS, PL:YPOS
					;9ならちょうど視界から外れてるので視界に入るように動く
					;CASE 9
					;一旦行動パターンを単純にしてみる
						SELECTCASE 座標方向判別(LCOUNTX, LCOUNTY, PL:XPOS, PL:YPOS)
							CASE "左上"
								;既に敵が居たら時計回りにずらす
								IF RLMAP_ENEMY:(LCOUNTX-1):(LCOUNTY-1) > 0
									;その先にも居たら諦める
									IF RLMAP_ENEMY:(LCOUNTX):(LCOUNTY+1) > 0
										RETURN
									ELSE
										CALL 敵移動, TARGET, LCOUNTX, LCOUNTY+1
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY-1
								ENDIF
							CASE "上"
								;既に敵が居たら時計回りにずらす
								IF RLMAP_ENEMY:(LCOUNTX):(LCOUNTY-1) > 0
									;その先にも居たら諦める
									IF RLMAP_ENEMY:(LCOUNTX+1):(LCOUNTY-1) > 0
										RETURN
									ELSE
										CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY-1
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX, LCOUNTY-1
								ENDIF
							CASE "右上"
								;既に敵が居たら時計回りにずらす
								IF RLMAP_ENEMY:(LCOUNTX+1):(LCOUNTY-1) > 0
									;その先にも居たら諦める
									IF RLMAP_ENEMY:(LCOUNTX+1):(LCOUNTY) > 0
										RETURN
									ELSE
										CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY-1
								ENDIF
							CASE "左"
								;既に敵が居たら時計回りにずらす
								IF RLMAP_ENEMY:(LCOUNTX-1):(LCOUNTY) > 0
									;その先にも居たら諦める
									IF RLMAP_ENEMY:(LCOUNTX-1):(LCOUNTY+1) > 0
										RETURN
									ELSE
										CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY+1
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY
								ENDIF
							CASE "右"
								;既に敵が居たら時計回りにずらす
								IF RLMAP_ENEMY:(LCOUNTX+1):(LCOUNTY) > 0
									;その先にも居たら諦める
									IF RLMAP_ENEMY:(LCOUNTX+1):(LCOUNTY+1) > 0
										RETURN
									ELSE
										CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY+1
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY
								ENDIF
							CASE "左下"
								;既に敵が居たら時計回りにずらす
								IF RLMAP_ENEMY:(LCOUNTX-1):(LCOUNTY+1) > 0
									;その先にも居たら諦める
									IF RLMAP_ENEMY:(LCOUNTX-1):(LCOUNTY) > 0
										RETURN
									ELSE
										CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY+1
								ENDIF
							CASE "下"
								;既に敵が居たら時計回りにずらす
								IF RLMAP_ENEMY:(LCOUNTX):(LCOUNTY+1) > 0
									;その先にも居たら諦める
									IF RLMAP_ENEMY:(LCOUNTX-1):(LCOUNTY+1) > 0
										RETURN
									ELSE
										CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY+1
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX, LCOUNTY+1
								ENDIF
							CASE "右下"
								;既に敵が居たら時計回りにずらす
								IF RLMAP_ENEMY:(LCOUNTX+1):(LCOUNTY+1) > 0
									;その先にも居たら諦める
									IF RLMAP_ENEMY:(LCOUNTX-1):(LCOUNTY+1) > 0
										RETURN
									ELSE
										CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY+1
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY+1
								ENDIF
						ENDSELECT
					;CASEELSE


			;視界外ならランダムウォーク
			ELSE
				;通路なら移動方向を決める
				IF RLMAP:LCOUNTX:LCOUNTY == 2
					IF CSTRRL:移動方向 == ""
						DO
							SELECTCASE RAND:4
								CASE 0
									IF GROUPMATCH(RLMAP:(LCOUNTX-1):LCOUNTY, 1, 2)
										CSTRRL:移動方向 = 左
										CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY
										BREAK
									ENDIF
								CASE 1
									IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY-1), 1, 2)
										CSTRRL:移動方向 = 上
										CALL 敵移動, TARGET, LCOUNTX, LCOUNTY-1
										BREAK
									ENDIF
								CASE 2
									IF GROUPMATCH(RLMAP:(LCOUNTX+1):LCOUNTY, 1, 2)
										CSTRRL:移動方向 = 右
										CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY
										BREAK
									ENDIF
								CASE 3
									IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY+1), 1, 2)
										CSTRRL:移動方向 = 下
										CALL 敵移動, TARGET, LCOUNTX, LCOUNTY+1
										BREAK
									ENDIF
							ENDSELECT
						LOOP 1
					ELSE
						SELECTCASE CSTRRL:移動方向
							CASE "左"
								;左に進めない場合は上か下に動く
								IF !GROUPMATCH(RLMAP:(LCOUNTX-1):LCOUNTY, 1, 2)
									FOR LCOUNT, 0, 1000
										SELECTCASE RAND:2
											CASE 0
												IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY-1), 1, 2)
													CSTRRL:移動方向 = 上
													CALL 敵移動, TARGET, LCOUNTX, LCOUNTY-1
													BREAK
												ENDIF
											CASE 1
												IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY+1), 1, 2)
													CSTRRL:移動方向 = 下
													CALL 敵移動, TARGET, LCOUNTX, LCOUNTY+1
													BREAK
												ENDIF
										ENDSELECT
									NEXT
									;万が一どちらにも動けなかったら来た道を戻る
									IF LCOUNT == 999
										CSTRRL:移動方向 = 右
										CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY
								ENDIF
							CASE "右"
								;右もほぼ同じ
								IF !GROUPMATCH(RLMAP:(LCOUNTX+1):LCOUNTY, 1, 2)
									FOR LCOUNT, 0, 1000
										SELECTCASE RAND:2
											CASE 0
												IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY-1), 1, 2)
													CSTRRL:移動方向 = 上
													CALL 敵移動, TARGET, LCOUNTX, LCOUNTY-1
													BREAK
												ENDIF
											CASE 1
												IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY+1), 1, 2)
													CSTRRL:移動方向 = 下
													CALL 敵移動, TARGET, LCOUNTX, LCOUNTY+1
													BREAK
												ENDIF
										ENDSELECT
									NEXT
									;万が一どちらにも動けなかったら来た道を戻る
									IF LCOUNT == 999
										CSTRRL:移動方向 = 左
										CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY
								ENDIF
							CASE "上"
								;上に進めない場合は左か右に動く
								IF !GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY-1), 1, 2)
									FOR LCOUNT, 0, 1000
										SELECTCASE RAND:2
											CASE 0
												IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY-1), 1, 2)
													CSTRRL:移動方向 = 左
													CALL 敵移動, TARGET, (LCOUNTX-1), LCOUNTY
													BREAK
												ENDIF
											CASE 1
												IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY+1), 1, 2)
													CSTRRL:移動方向 = 右
													CALL 敵移動, TARGET, (LCOUNTX+1), LCOUNTY
													BREAK
												ENDIF
										ENDSELECT
									NEXT
									;万が一どちらにも動けなかったら来た道を戻る
									IF LCOUNT == 999
										CSTRRL:移動方向 = 下
										CALL 敵移動, TARGET, LCOUNTX, LCOUNTY+1
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX, LCOUNTY-1
								ENDIF
							CASE "下"
								;下もほぼ同じ
								IF !GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY+1), 1, 2)
									FOR LCOUNT, 0, 1000
										SELECTCASE RAND:2
											CASE 0
												IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY-1), 1, 2)
													CSTRRL:移動方向 = 左
													CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY
													BREAK
												ENDIF
											CASE 1
												IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY+1), 1, 2)
													CSTRRL:移動方向 = 右
													CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY
													BREAK
												ENDIF
										ENDSELECT
									NEXT
									;万が一どちらにも動けなかったら来た道を戻る
									IF LCOUNT == 999
										CSTRRL:移動方向 = 上
										CALL 敵移動, TARGET, LCOUNTX, LCOUNTY-1
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX, LCOUNTY+1
								ENDIF
						ENDSELECT
					ENDIF
				;ランダムウォーク
				ELSE
					CSTRRL:移動方向 = 
					DO
						MOVEX = RAND:3-1
						MOVEY = RAND:3-1
						IF GROUPMATCH(RLMAP:(LCOUNTX+MOVEX):(LCOUNTY+MOVEY), 1, 2)
							CALL 敵移動, TARGET, LCOUNTX+MOVEX, LCOUNTY+MOVEY
							BREAK
						ENDIF
					LOOP 1
				ENDIF
			ENDIF
			CFLAGRL:移動済み = 1
		ENDIF
	NEXT
NEXT

@敵移動, TARGET, X_POS, Y_POS
#DIMS DYNAMIC 方向
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY

;一応確認はしてるけど移動不可能だったら何もせず終了
SIF !GROUPMATCH(RLMAP:X_POS:Y_POS, 1, 2)
	RETURN
;PLと同じマスなら攻撃が優先されるはずなので終了
SIF X_POS == PL:XPOS && Y_POS == PL:YPOS
	RETURN

FOR LCOUNTX, 0, RLMAP広さ
	FOR LCOUNTY, 0, RLMAP広さ
		IF RLMAP_ENEMY:LCOUNTX:LCOUNTY == TARGET
			SWAP RLMAP_ENEMY:LCOUNTX:LCOUNTY, RLMAP_ENEMY:X_POS:Y_POS
			;PRINTFORMW {TARGET} %CSTRRL:移動方向% {X_POS} {Y_POS}
			RETURN
		ENDIF
	NEXT
NEXT
