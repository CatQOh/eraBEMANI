@ローグライクモードデバッグ

;イニシャライズ
CALL RLスプライト生成

DT_CREATE "RLITEMLIST"
DT_COLUMN_ADD "RLITEMLIST", "アイテム名", "string"
DT_COLUMN_ADD "RLITEMLIST", "分類", "string"
DT_COLUMN_ADD "RLITEMLIST", "ダイスロール", "string"
DT_COLUMN_ADD "RLITEMLIST", "命中率", "int64"
DT_COLUMN_ADD "RLITEMLIST", "使用回数", "int64"
DT_COLUMN_ADD "RLITEMLIST", "重さ", "int64"
DT_COLUMN_ADD "RLITEMLIST", "アイテムスキル", "string"
DT_COLUMN_ADD "RLITEMLIST", "説明", "string"
DT_COLUMN_ADD "RLITEMLIST", "ドロップ専用", "int64"
DT_COLUMN_ADD "RLITEMLIST", "レア度", "int64"
DT_COLUMN_ADD "RLITEMLIST", "固定アーティファクト", "int64"
DT_COLUMN_ADD "RLITEMLIST", "アイテム効果", "string"

CALL COLUMNCREATE, 1
CALL COLUMNRESIZE, 1, 4200, 4200
CALL COLUMNMOVE, 1, -500, 1800

CALL COLUMNCREATE, 2
CALL COLUMNRESIZE, 2, 8000, 8000
CALL COLUMNMOVE, 2, -500, -2200

CALL COLUMNCREATE, 3
CALL COLUMNRESIZE, 3, 4200, 42000
CALL COLUMNMOVE, 3, 3800, 1200

CALL COLUMNCREATE, 4
CALL COLUMNRESIZE, 4, 4000, 3000
CALL COLUMNMOVE, 4, 0, 1700

CALL COLUMNCREATE, 5
CALL COLUMNRESIZE, 5, 3000, 3000
CALL COLUMNMOVE, 5, 3800, 2000

SETSOUNDVOLUME 30

$RL_NEWGAME
CALL FADEOUTBGM

DT_CLEAR "RLITEMLIST"
RL_GAMEOVER = 0
VARSET RLLOG
RLターン数 = 0
RL階層 = 1
RLクリア階層 = 30
VARSET インベントリ

PRINTL □プレイヤーキャラを選んでください
CALL CHARA_LIST, "RL"
CALL CHARA_ADD, RESULT

;タイトル画面で2人追加してるのでSWAPCHARAする
SWAPCHARA 0, CHARANUM-1

;β版の暫定調整
CFLAGRL:PLAYER:HP = BASE:PLAYER:体力/100*2
CFLAGRL:PLAYER:MAXHP = MAXBASE:PLAYER:体力/100*2
CFLAGRL:PLAYER:HP初期値 = CFLAGRL:PLAYER:MAXHP
CFLAGRL:PLAYER:レベル = 1

TARGET = PLAYER
TRYCALLFORM RL_%CSVNAMERPS(NOF(PLAYER))%
;表示上は1/100
CFLAGRL:満腹度最大値 = 10099
SIF RLスキル(PLAYER, "過食")
	CFLAGRL:満腹度最大値 = 20099
;初期値は変わらない（暫定）
CFLAGRL:満腹度 = 10099

SIF CSTRRL:初期アイテム != ""
	CALL 初期アイテム処理, PLAYER

;CALL BGM再生, RLBGM
CALL ローグライクモード

SIF RESULT
	GOTO RL_NEWGAME

@ローグライクモード
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY
;現状は正方形のみ
#DIM CONST RLMAP_CONST = VARSIZE("RLMAP", 1)
#DIM DYNAMIC 生成キャラ
#DIM DYNAMIC ランセレ, 10000
#DIM DYNAMIC 試行回数

CALL ダンジョン生成

VARSET 出現敵イニシャル

;RAND:10000でやると各機種先頭キャラに偏るので一度別変数に入れてから決める
VARSET ランセレ
FOR LCOUNT, 0, 10000
	;SIF NO:PLAYER == LCOUNT
	;	CONTINUE
	SIF EXISTCSV(LCOUNT) && !撃破済み:LCOUNT
		ランセレ:FINDELEMENT(ランセレ, 0) = LCOUNT
NEXT

ARRAYCOPY "RLMAP_CREATE", "RLMAP"

;プレイヤー配置
DO
	LCOUNTX = RAND:RLMAP_CONST
	LCOUNTY = RAND:RLMAP_CONST
	IF RLMAP:LCOUNTX:LCOUNTY == 1
		PL:XPOS = LCOUNTX
		PL:YPOS = LCOUNTY
		BREAK
	ENDIF
LOOP 1
;階段配置
DO
	LCOUNTX = RAND:RLMAP_CONST
	LCOUNTY = RAND:RLMAP_CONST
	IF RLMAP:LCOUNTX:LCOUNTY == 1 && PL:XPOS != LCOUNTX && PL:YPOS != LCOUNTY
		STAIR:XPOS = LCOUNTX
		STAIR:YPOS = LCOUNTY
		BREAK
	ENDIF
LOOP 1

;アイテム配置等
ENEMY_COUNT = 0
FOR LCOUNTX, 0, RLMAP_CONST
	FOR LCOUNTY, 0, RLMAP_CONST
		IF RLMAP:LCOUNTX:LCOUNTY == 1
			;アイテム配置
			IF RAND:(250-RLスキル(PLAYER, "幸運")*30) == 0
				;ここでアイテムを生成してDTに入れた後にRLMAP_ITEMにはIDを入れる
				CALL RLアイテム生成
				RLMAP_ITEM:LCOUNTX:LCOUNTY = RESULT
			ENDIF
			;敵配置
			IF RAND:(250-RL階層*5) == 0
				;敵味方全部キャラデータとして扱う
				試行回数 = 0
				DO
					;AWAIT 1000
					生成キャラ = ランセレ:(RAND:FINDELEMENT(ランセレ, 0))
					;PRINTFORML %CSVNAME(生成キャラ)%生成中 {GETCHARA(生成キャラ)} {FINDELEMENTF(出現敵イニシャル, CHARATU(CSVNAME(生成キャラ), 0))}
					SIF GETCHARA(生成キャラ) >= 0
						CONTINUE
					;一文字タイルなのでイニシャルが被ったキャラも諦める
					SIF FINDELEMENTF(出現敵イニシャル, CHARATU(CSVCALLNAME(生成キャラ), 0)) > 0
						CONTINUE
					SIF 撃破済み:生成キャラ
						CONTINUE
					
					ADDCHARA 生成キャラ
					TARGET = CHARANUM-1
					TRYCALLFORM RL_%CSVNAMERPS(NOF(TARGET))%
					RLMAP_ENEMY:LCOUNTX:LCOUNTY = TARGET
					;デバッグ用
					;CSTRRL:攻撃方法 = ピストル
					;CSTRRL:ドロップアイテム = 天下無双刀
					CFLAGRL:HP = BASE:体力/100
					CFLAGRL:MAXHP = MAXBASE:体力/100
					CFLAGRL:HP初期値 = CFLAGRL:MAXHP
					CFLAGRL:レベル = 1
					SIF RLスキル(PLAYER, "スパイ") && RANDPER(5)
						CSTRRL:行動パターン = 中立
					SIF RLスキル(PLAYER, "犬飼い") && RL属性(TARGET, "犬")
						CSTRRL:行動パターン = 中立
					SIF RLスキル(PLAYER, "猫語話者") && RL属性(TARGET, "猫")
						CSTRRL:行動パターン = 中立
					SIF RLスキル(PLAYER, "お狐同盟") && RL属性(TARGET, "狐")
						CSTRRL:行動パターン = 中立
					;CSTRRL:立場 = 敵
					出現敵イニシャル:FINDELEMENTF(出現敵イニシャル, "") = %CHARATU(CALLNAME:TARGET, 0)%
					;PRINTFORMW 生成成功
					BREAK
					試行回数++
				LOOP 試行回数 < 100
			ENDIF
		ENDIF
	NEXT
NEXT

CALL ダンジョン描写

SIF RL_GAMEOVER
	RETURN 1

SIF RESULT
	RESTART

@ダンジョン描写
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY
#DIM CONST RLMAP_CONST = VARSIZE("RLMAP", 1)
#DIM DYNAMIC 全体マップ
#DIM DYNAMIC 移動先X
#DIM DYNAMIC 移動先Y

CLEARLINE LINECOUNT

CALL PL視界生成

CVARSET CFLAGRL, GETNUM(CFLAGRL, "移動済み"), 0

FOR LCOUNTX, PL:XPOS-10, PL:XPOS+11
	FOR LCOUNTY, PL:YPOS-10, PL:YPOS+11
		SIF INRANGE(LCOUNTX, 0, VARSIZE("RLMAP", 1)-1) && INRANGE(LCOUNTY, 0, VARSIZE("RLMAP", 2)-1) && PL_VISIBLE:LCOUNTX:LCOUNTY == 1
			RLMAP_EXPLORED:LCOUNTX:LCOUNTY = 1
	NEXT
NEXT

IF 全体マップ
	;IF EXPLORED
	FOR LCOUNTY, 0, RLMAP_CONST
		FOR LCOUNTX, 0, RLMAP_CONST
			SELECTCASE RLMAP_CREATE:LCOUNTX:LCOUNTY
				CASE 0
					PRINT 　
				CASE 3
					SETCOLORBYNAME peru
					PRINT ■
					RESETCOLOR
				CASEELSE
					IF PL:XPOS == LCOUNTX && PL:YPOS == LCOUNTY
						SETCOLORBYNAME deepskyblue
						PRINT ＠
						RESETCOLOR
					ELSEIF STAIR:XPOS == LCOUNTX &&  STAIR:YPOS == LCOUNTY
						SETCOLORBYNAME lime
						PRINT ％
						RESETCOLOR
					ELSEIF RLMAP_ENEMY:LCOUNTX:LCOUNTY
						SETCOLORBYNAME coral
						PRINTFORM %TOFULL(CHARATU(CALLNAME:(RLMAP_ENEMY:LCOUNTX:LCOUNTY), 0))%
						RESETCOLOR
					ELSEIF RLMAP_ITEM:LCOUNTX:LCOUNTY
						SETCOLORBYNAME gold
						PRINT ＊
						RESETCOLOR
					ELSEIF RLMAP:LCOUNTX:LCOUNTY == 2
						SETCOLORBYNAME blue
						PRINT ■
						RESETCOLOR
					ELSE
						PRINT ■
					ENDIF
			ENDSELECT
		NEXT
		PRINTL
	NEXT
ELSE
	CALL RLREDRAW
ENDIF

IF 階段判定()
	;PRINTL 階段がある >で登る
ELSE
	;PRINTL 5で終了 Xで全体マップ
ENDIF

移動先X = -1
移動先Y = -1

ONEINPUTS

SELECTCASE RESULTS
	CASE "7"
		IF 見渡し
			移動先X = 見渡し座標:XPOS-1
			移動先Y = 見渡し座標:YPOS-1
		ELSE
			移動先X = PL:XPOS-1
			移動先Y = PL:YPOS-1
		ENDIF
		;IF !壁判定(PL:XPOS-1, PL:YPOS-1)
		;	PL:XPOS--
		;	PL:YPOS--
		;ENDIF
	CASE "8"
		IF 見渡し
			移動先X = 見渡し座標:XPOS
			移動先Y = 見渡し座標:YPOS-1
		ELSE
			移動先X = PL:XPOS
			移動先Y = PL:YPOS-1
		ENDIF
		;IF !壁判定(PL:XPOS, PL:YPOS-1)
		;	PL:YPOS--
		;ENDIF
	CASE "9"
		IF 見渡し
			移動先X = 見渡し座標:XPOS+1
			移動先Y = 見渡し座標:YPOS-1
		ELSE
			移動先X = PL:XPOS+1
			移動先Y = PL:YPOS-1
		ENDIF
		;IF !壁判定(PL:XPOS+1, PL:YPOS-1)
		;	PL:XPOS++
		;	PL:YPOS--
		;ENDIF
	CASE "4"
		IF 見渡し
			移動先X = 見渡し座標:XPOS-1
			移動先Y = 見渡し座標:YPOS
		ELSE
			移動先X = PL:XPOS-1
			移動先Y = PL:YPOS
		ENDIF
		;IF !壁判定(PL:XPOS-1, PL:YPOS)
		;	PL:XPOS--
		;ENDIF
	CASE "6"
		IF 見渡し
			移動先X = 見渡し座標:XPOS+1
			移動先Y = 見渡し座標:YPOS
		ELSE
			移動先X = PL:XPOS+1
			移動先Y = PL:YPOS
		ENDIF
		;IF !壁判定(PL:XPOS+1, PL:YPOS)
		;	PL:XPOS++
		;ENDIF
	CASE "1"
		IF 見渡し
			移動先X = 見渡し座標:XPOS-1
			移動先Y = 見渡し座標:YPOS+1
		ELSE
			移動先X = PL:XPOS-1
			移動先Y = PL:YPOS+1
		ENDIF
		;IF !壁判定(PL:XPOS-1, PL:YPOS+1)
		;	PL:XPOS--
		;	PL:YPOS++
		;ENDIF
	CASE "2"
		IF 見渡し
			移動先X = 見渡し座標:XPOS
			移動先Y = 見渡し座標:YPOS+1
		ELSE
			移動先X = PL:XPOS
			移動先Y = PL:YPOS+1
		ENDIF
		;IF !壁判定(PL:XPOS, PL:YPOS+1)
		;	PL:YPOS++
		;ENDIF
	CASE "3"
		IF 見渡し
			移動先X = 見渡し座標:XPOS+1
			移動先Y = 見渡し座標:YPOS+1
		ELSE
			移動先X = PL:XPOS+1
			移動先Y = PL:YPOS+1
		ENDIF
		;IF !壁判定(PL:XPOS+1, PL:YPOS+1)
		;	PL:XPOS++
		;	PL:YPOS++
		;ENDIF
	CASE "v"
		SIF 見渡し
			CALL RL詳細表示, 見渡し座標:XPOS, 見渡し座標:YPOS
		RESTART
	CASE "x"
		INVERTBIT 見渡し, 0
		SIF 見渡し
			CALL RLLOG, "vで詳細表示"
		見渡し座標:XPOS = PL:XPOS
		見渡し座標:YPOS = PL:YPOS
		RESTART
	CASEELSE
		見渡し = 0
		SELECTCASE RESULTS
			CASE "?"
				CALL RL操作説明
			CASE "5", "."
				CALL RLターン終了処理, PLAYER, 2
			CASE "-"
				RETURN 0
			CASE ">"
				IF 階段判定()
					CALL SE再生, 階段SE
					RL階層++
					IF RL階層 >= RLクリア階層
						CALL RLゲームクリア
						RETURN 0
					ENDIF
					RETURN 1
				ENDIF
			CASE "X"
				INVERTBIT 全体マップ, 0
				RESTART
			;Get
			CASE "g", "G"
				CALL アイテム拾得, PL:XPOS, PL:YPOS
				SIF !RESULT
					RESTART
			;Inventory
			CASE "i", "I"
				CALL インベントリ一覧
				SIF !RESULT
					RESTART
			;Swing/Slash
			CASE "s", "S"
				SIF RLスキル(PLAYER, "武器使用不可")
					RESTART
				CALL 近接武器一覧
				SIF !RESULT
					RESTART
			;Fire
			CASE "f", "F"
				SIF RLスキル(PLAYER, "武器使用不可")
					RESTART
				CALL 遠距離武器一覧
				SIF !RESULT
					RESTART
			;Read
			CASE "r", "R"
				CALL 巻物一覧
				SIF !RESULT
					RESTART
			;Quaff
			CASE "q", "Q"
				CALL ポーション一覧
				SIF !RESULT
					RESTART
			;Eat
			CASE "e", "E"
				CALL 食料一覧
				SIF !RESULT
					RESTART
			;Throw
			CASE "t", "T"
				SIF RLスキル(PLAYER, "武器使用不可")
					RESTART
				CALL 投擲アイテム一覧
				SIF !RESULT
					RESTART
			CASE "@"
				CALL RLステータス表示, PLAYER
				RESTART
			CASEELSE
				RESTART
		ENDSELECT
ENDSELECT

SIF 移動先X == -1
	見渡し = 0

IF 見渡し
	IF PL_VISIBLE:移動先X:移動先Y
		見渡し座標:XPOS = 移動先X
		見渡し座標:YPOS = 移動先Y
	ENDIF
	RESTART
ELSE
	;移動方向のフラグが必要かも
	IF 中立判定(移動先X, 移動先Y)
		CALL RL中立キャラ, PLAYER, 中立判定(移動先X, 移動先Y)
		RESTART
	ELSEIF 敵判定(移動先X, 移動先Y)
		CALL RL攻撃, PLAYER, 敵判定(移動先X, 移動先Y), "格闘"
	ELSEIF !壁判定(移動先X, 移動先Y)
		PL:XPOS = 移動先X
		PL:YPOS = 移動先Y
		SIF 階段判定()
			CALL RLLOG, "階段がある >で登る"
		SIF RLMAP_ITEM:移動先X:移動先Y
			CALL RLLOG, @"%RLITEMDT(RLMAP_ITEM:移動先X:移動先Y, "アイテム名")%がある gで拾う"
	ENDIF
ENDIF

;敵の行動フェーズ
CALL 敵行動フェーズ

IF RL_GAMEOVER
	CALL RLREDRAW
	FORCEWAIT
	RETURN 1
ENDIF

RESULTS = 
FOR LCOUNT, 0, CHARANUM
	CALL RLターン終了処理, LCOUNT
	IF RL_GAMEOVER
		CALL RLREDRAW
		FORCEWAIT
		RETURN 1
	ENDIF
NEXT

RLターン数++

RESTART

[SKIPSTART]
SELECTCASE GETKEY()
	CASE "VK_NUMPAD7"
		IF RLMAP:(PL:XPOS-1):(PL:YPOS-1) != 0
			PL:XPOS--
			PL:YPOS--
		ENDIF
		RESTART
	CASE "VK_NUMPAD8"
		IF RLMAP:(PL:XPOS):(PL:YPOS-1) != 0
			PL:YPOS--
		ENDIF
		RESTART
	CASE "VK_NUMPAD9"
		IF RLMAP:(PL:XPOS+1):(PL:YPOS-1) != 0
			PL:XPOS++
			PL:YPOS--
		ENDIF
		RESTART
	CASE "VK_NUMPAD4"
		IF RLMAP:(PL:XPOS-1):(PL:YPOS) != 0
			PL:XPOS--
		ENDIF
		RESTART
	CASE "VK_NUMPAD6"
		IF RLMAP:(PL:XPOS+1):(PL:YPOS) != 0
			PL:XPOS++
		ENDIF
		RESTART
	CASE "VK_NUMPAD1"
		IF RLMAP:(PL:XPOS-1):(PL:YPOS+1) != 0
			PL:XPOS--
			PL:YPOS++
		ENDIF
	CASE "VK_NUMPAD2"
		IF RLMAP:(PL:XPOS):(PL:YPOS+1) != 0
			PL:YPOS++
		ENDIF
	CASE "VK_NUMPAD3"
		IF RLMAP:(PL:XPOS+1):(PL:YPOS+1) != 0
			PL:XPOS++
			PL:YPOS++
		ENDIF
	CASE "VK_NUMPAD5"
		RETURN 0
	CASE 
ENDSELECT
[SKIPEND]

;そのうちアイテム交換とか実装予定
@RL中立キャラ, INTERACTID, TARGETID
#DIM DYNAMIC INTERACTID
#DIM DYNAMIC TARGETID

IF NAME:TARGETID == "東雲 つむぎ" && TALENT:INTERACTID:体格 >= 3
	CALL RLLOG, @"%CALLNAME:INTERACTID%は%CALLNAME:TARGETID%に挨拶した つむぎは防犯ブザーを鳴らした！"
ELSE
	CALL RLLOG, @"%CALLNAME:INTERACTID%は%CALLNAME:TARGETID%に挨拶した"
ENDIF

CALL RLREDRAW
