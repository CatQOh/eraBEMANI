@ローグライクモードデバッグ
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY

CALL ダンジョン生成

ARRAYCOPY "RLMAP_CREATE", "RLMAP"

DO
	LCOUNTX = RAND:(VARSIZE("RLMAP", 1))
	LCOUNTY = RAND:(VARSIZE("RLMAP", 2))
	IF RLMAP:LCOUNTX:LCOUNTY == 1
		PL:XPOS = LCOUNTX
		PL:YPOS = LCOUNTY
		BREAK
	ENDIF
LOOP 1

CALL ダンジョン描写

@ダンジョン描写
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY

CLEARLINE LINECOUNT

FOR LCOUNTY, 0, VARSIZE("RLMAP_CREATE", 1)
	FOR LCOUNTX, 0, VARSIZE("RLMAP_CREATE", 2)
		SELECTCASE RLMAP_CREATE:LCOUNTX:LCOUNTY
			CASE 0
				PRINT 　
			CASEELSE
				IF PL:XPOS == LCOUNTX && PL:YPOS == LCOUNTY
					SETCOLORBYNAME deepskyblue
					PRINT ＠
					RESETCOLOR
				ELSE
					PRINT ■
				ENDIF
		ENDSELECT
	NEXT
	PRINTL
NEXT

PRINTL 5で終了

ONEINPUT

SELECTCASE RESULT
	CASE 7
		IF RLMAP:(PL:XPOS-1):(PL:YPOS-1) != 0
			PL:XPOS--
			PL:YPOS--
		ENDIF
	CASE 8
		IF RLMAP:(PL:XPOS):(PL:YPOS-1) != 0
			PL:YPOS--
		ENDIF
	CASE 9
		IF RLMAP:(PL:XPOS+1):(PL:YPOS-1) != 0
			PL:XPOS++
			PL:YPOS--
		ENDIF
	CASE 4
		IF RLMAP:(PL:XPOS-1):(PL:YPOS) != 0
			PL:XPOS--
		ENDIF
	CASE 6
		IF RLMAP:(PL:XPOS+1):(PL:YPOS) != 0
			PL:XPOS++
		ENDIF
	CASE 1
		IF RLMAP:(PL:XPOS-1):(PL:YPOS+1) != 0
			PL:XPOS--
			PL:YPOS++
		ENDIF
	CASE 2
		IF RLMAP:(PL:XPOS):(PL:YPOS+1) != 0
			PL:YPOS++
		ENDIF
	CASE 3
		IF RLMAP:(PL:XPOS+1):(PL:YPOS+1) != 0
			PL:XPOS++
			PL:YPOS++
		ENDIF
	CASE 5
		RETURN
ENDSELECT

RESTART
