;;;体力バーなどを表示
@RL_PLINFO
#DIM DYNAMIC LCOUNT

CALL COLUMNPRINTL, 5, @"プレイヤーキャラ %NAME:PLAYER%"
CALL COLUMNPRINTL, 5, @"HP:%IMGTOTAG(GBAR(CFLAGRL:PLAYER:HP, CFLAGRL:PLAYER:MAXHP, 20, "coral", "gray", @"{CFLAGRL:PLAYER:HP}/{CFLAGRL:PLAYER:MAXHP}", "black"))%"
CALL COLUMNPRINTL, 5, @"MP:%IMGTOTAG(GBAR(CFLAGRL:PLAYER:MP, CFLAGRL:PLAYER:MAXMP, 20, "deepskyblue", "gray", @"{CFLAGRL:PLAYER:MP}/{CFLAGRL:PLAYER:MAXMP}", "black"))%"
CALL COLUMNPRINTL, 5, @"経過ターン:{RLターン数}"

@RLLOG, TEXT
#DIMS DYNAMIC TEXT
#DIM DYNAMIC LCOUNT

ARRAYSHIFT RLLOG, 1, ""

RLLOG:0 = %TEXT%

;CALL COLUMNLOGRESET, 2
;
;FOR LCOUNT, 5, -1, -1
;	CALL COLUMNPRINTL, 2, RLLOG:LCOUNT
;NEXT

;CALL COLUMNSHOW

@RLLOGADD, TEXT
#DIMS DYNAMIC TEXT

RLLOG += TEXT

@RLREDRAW
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY

CLEARLINE LINECOUNT

CALL PLMAP生成

CALL COLUMNIMG, 1, "PLMAP", 4200, 4200
CALL COLUMNPRINTL, 1, ""
CALL COLUMNLOGRESET, 2
CALL COLUMNLOGRESET, 3
CALL COLUMNLOGRESET, 5

FOR LCOUNT, 10, -1, -1
	CALL COLUMNPRINTL, 2, RLLOG:LCOUNT
NEXT

CALL RL_PLINFO

FOR LCOUNTX, 0, RLMAP広さ
	FOR LCOUNTY, 0, RLMAP広さ
		SIF !PL_VISIBLE:LCOUNTX:LCOUNTY
			CONTINUE
		IF RLMAP_ENEMY:LCOUNTX:LCOUNTY
			TARGET = RLMAP_ENEMY:LCOUNTX:LCOUNTY
			IF CSTRRL:行動パターン == "中立"
				CALL COLUMNPRINT, 3, @"%CHARATU(CALLNAME:TARGET, 0)%", "lime"
				CALL COLUMNPRINTL, 3, @"=%NAME:TARGET%(中立)"
			ELSE
				CALL COLUMNPRINT, 3, @"%CHARATU(CALLNAME:TARGET, 0)%", "coral"
				CALL COLUMNPRINTL, 3, @"=%NAME:TARGET%"
			ENDIF
		ENDIF
	NEXT
NEXT

CALL COLUMNSHOW
;SEを鳴らすためのウェイトを入れる予定 オプションで変更可能にする
IF RLWAIT
	;PRINTL 
	TWAIT RLWAIT, 1
	;CLEARLINE 1
	RLWAIT = 0
ENDIF
