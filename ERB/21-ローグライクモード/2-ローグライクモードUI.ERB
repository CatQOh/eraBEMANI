;;;体力バーなどを表示
@RL_PLINFO
#DIM DYNAMIC LCOUNT

CALL COLUMNPRINTL, 5, @"プレイヤーキャラ %NAME:PLAYER%"
CALL COLUMNPRINTL, 5, @"HP:%IMGTOTAG(GBAR(CFLAGRL:PLAYER:HP, CFLAGRL:PLAYER:MAXHP, 20, "coral", "gray", @"{CFLAGRL:PLAYER:HP}/{CFLAGRL:PLAYER:MAXHP}", "black"))%"
CALL COLUMNPRINTL, 5, @"MP:%IMGTOTAG(GBAR(CFLAGRL:PLAYER:MP, CFLAGRL:PLAYER:MAXMP, 20, "deepskyblue", "gray", @"{CFLAGRL:PLAYER:MP}/{CFLAGRL:PLAYER:MAXMP}", "black"))%"
CALL COLUMNPRINTL, 5, @"経過ターン:{RLターン数}"

@RLLOG, TEXT
#DIMS DYNAMIC TEXT
#DIM DYNAMIC LCOUNT

ARRAYSHIFT RLLOG, 1, ""

RLLOG:0 = %TEXT%

;CALL COLUMNLOGRESET, 2
;
;FOR LCOUNT, 5, -1, -1
;	CALL COLUMNPRINTL, 2, RLLOG:LCOUNT
;NEXT

;CALL COLUMNSHOW

@RLLOGADD, TEXT
#DIMS DYNAMIC TEXT

RLLOG += TEXT

@RLREDRAW
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY

CLEARLINE LINECOUNT

CALL PLMAP生成

CALL COLUMNIMG, 1, "PLMAP", 4200, 4200
CALL COLUMNPRINTL, 1, ""
CALL COLUMNLOGRESET, 2
CALL COLUMNLOGRESET, 3
CALL COLUMNLOGRESET, 5

FOR LCOUNT, 10, -1, -1
	CALL COLUMNPRINTL, 2, RLLOG:LCOUNT
NEXT

CALL RL_PLINFO

FOR LCOUNTX, 0, RLMAP広さ
	FOR LCOUNTY, 0, RLMAP広さ
		SIF !PL_VISIBLE:LCOUNTX:LCOUNTY
			CONTINUE
		IF RLMAP_ENEMY:LCOUNTX:LCOUNTY
			TARGET = RLMAP_ENEMY:LCOUNTX:LCOUNTY
			IF CSTRRL:行動パターン == "中立"
				CALL COLUMNPRINT, 3, @"%CHARATU(CALLNAME:TARGET, 0)%", "lime"
				CALL COLUMNPRINTL, 3, @"=%NAME:TARGET%(中立)"
			ELSE
				CALL COLUMNPRINT, 3, @"%CHARATU(CALLNAME:TARGET, 0)%", "coral"
				CALL COLUMNPRINTL, 3, @"=%NAME:TARGET%"
			ENDIF
		ENDIF
	NEXT
NEXT

CALL COLUMNSHOW
;SEを鳴らすためのウェイトを入れる予定 オプションで変更可能にする
IF RLWAIT
	;PRINTL 
	TWAIT RLWAIT, 1
	;CLEARLINE 1
	RLWAIT = 0
ENDIF

@RLステータス表示, 対象
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC 対象
#DIMS DYNAMIC スキル一覧, 100
#DIMS DYNAMIC SPLITVAR, 2
#DIM DYNAMIC 分割数

TARGET = 対象

CALL COLUMNBGCOLOR, 4, "darkolivegreen"

CALL COLUMNLOGRESET, 4

CALL COLUMNPRINTL, 4, @"□名前 %NAME:TARGET% レベル:{CFLAGRL:レベル}"
CALL COLUMNPRINTL, 4, @"　最大HP:{CFLAGRL:MAXHP} 最大MP:{CFLAGRL:MAXMP}"
CALL COLUMNPRINTL, 4, @""
CALL COLUMNPRINTL, 4, @"□スキル"

SPLIT CSTRRL:スキル, "/", スキル一覧

分割数 = RESULT

FOR LCOUNT, 0, 分割数
	SPLIT スキル一覧:LCOUNT, "*", SPLITVAR
	CALL COLUMNPRINTL, 4, @"　%SPLITVAR:0% \@ RESULT > 1 ? Lv%SPLITVAR:1% #\@"
	CALL COLUMNPRINTL, 4, @"　- %スキル効果(SPLITVAR:0)%"
NEXT

CALL RLREDRAW

WAIT

CALL COLUMNLOGRESET, 4
CALL COLUMNBGCOLOR, 4, "0"

@RLアイテム詳細表示, 対象
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC 対象
#DIMS DYNAMIC スキル一覧, 100
#DIMS DYNAMIC SPLITVAR, 2
#DIM DYNAMIC 分割数

CALL COLUMNBGCOLOR, 4, "darkolivegreen"

CALL COLUMNLOGRESET, 4

CALL COLUMNPRINTL, 4, @"□アイテム情報"
CALL COLUMNPRINTL, 4, @"　%RLITEMDT(対象, "アイテム名")% レア度:%RLITEMDT(対象, "レア度")% 残り使用回数:%RLITEMDT(対象, "使用回数")%"
CALL COLUMNPRINTL, 4, @"　分類:%RLITEMDT(対象, "分類")% 重さ:%RLITEMDT(対象, "重さ")%"
CALL COLUMNPRINTL, 4, ""
CALL COLUMNPRINTL, 4, @"□性能"
CALL COLUMNPRINTL, 4, @"　ダイスロール:\@ RLITEMDT(対象, "ダイスロール") != "" ? %RLITEMDT(対象, "ダイスロール")% # 無し \@ 命中率:\@ RLITEMDT(対象, "命中率") != "" ? %RLITEMDT(対象, "命中率")% # 無し \@"
CALL COLUMNPRINTL, 4, @"　アイテムスキル:\@ RLITEMDT(対象, "アイテムスキル") != "" ? %RLITEMDT(対象, "アイテムスキル")% # 無し \@ アイテム効果:\@ RLITEMDT(対象, "アイテム効果") != "" ? %RLITEMDT(対象, "アイテム効果")% # 無し \@"
CALL COLUMNPRINTL, 4, ""
CALL COLUMNPRINTL, 4, @"　%RLITEMDT(対象, "説明")%"

CALL RLREDRAW

WAIT

CALL COLUMNLOGRESET, 4
CALL COLUMNBGCOLOR, 4, "0"

@RL詳細表示, X_POS, Y_POS
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS

IF RLMAP_ENEMY:X_POS:Y_POS
	CALL RLステータス表示, RLMAP_ENEMY:X_POS:Y_POS
ELSEIF RLMAP_ITEM:X_POS:Y_POS
	CALL RLアイテム詳細表示, RLMAP_ITEM:X_POS:Y_POS
ENDIF
