@RL_ASTER, STARTX, STARTY, GOALX, GOALY
#FUNCTION
#DIM DYNAMIC STARTX
#DIM DYNAMIC STARTY
#DIM DYNAMIC GOALX
#DIM DYNAMIC GOALY
#DIM DYNAMIC NODE, RLMAP_CONST, RLMAP_CONST
#DIM DYNAMIC NODE_COST, RLMAP_CONST, RLMAP_CONST, 2
#DIM DYNAMIC PARENTNODE, RLMAP_CONST, RLMAP_CONST, 2
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY
#DIM DYNAMIC NOW_POSX
#DIM DYNAMIC NOW_POSY
#DIM DYNAMIC CHILD_POSX
#DIM DYNAMIC CHILD_POSY
#DIM DYNAMIC OPENX
#DIM DYNAMIC OPENY
#DIM DYNAMIC MINCOST

VARSET ASTARROOT

PARENTNODE:STARTX:STARTY:0 = -1
PARENTNODE:STARTX:STARTY:1 = -1

NODE:STARTX:STARTY = 1
;0は実コスト
NODE_COST:STARTX:STARTY:0 = 0
;1は推定コスト
NODE_COST:STARTX:STARTY:1 = 座標距離判別(STARTX, STARTY, GOALX, GOALY)

;周囲9マスをOPEN
FOR OPENX, -1, 2
	FOR OPENY, -1, 2
		IF (OPENX != 0 || OPENY != 0) && GROUPMATCH(RLMAP:(STARTX+OPENX):(STARTY+OPENY), 1, 2)
			NODE:(STARTX+OPENX):(STARTY+OPENY) = 1
			;親ノードの実コスト+1
			NODE_COST:(STARTX+OPENX):(STARTY+OPENY):0 = NODE_COST:STARTX:STARTY:0+1
			;推定コスト
			NODE_COST:(STARTX+OPENX):(STARTY+OPENY):1 = 座標距離判別(STARTX+OPENX, STARTY+OPENY, GOALX, GOALY)
			;親ノードも設定
			PARENTNODE:(STARTX+OPENX):(STARTY+OPENY):0 = STARTX
			PARENTNODE:(STARTX+OPENX):(STARTY+OPENY):1 = STARTY
		ENDIF
	NEXT
NEXT

;ノードをCLOSE
NODE:STARTX:STARTY = -1


WHILE 座標距離判別(NOW_POSX, NOW_POSY, GOALX, GOALY) > 2
	MINCOST = __INT_MAX__
	;現在のOPENノードの中での最小コストを求める
	FOR LCOUNTX, 0, RLMAP_CONST
		FOR LCOUNTY, 0, RLMAP_CONST
			SIF NODE:LCOUNTX:LCOUNTY == 1
				MINCOST = MIN(MINCOST, NODE_COST:LCOUNTX:LCOUNTY:0+NODE_COST:LCOUNTX:LCOUNTY:1)
		NEXT
	NEXT

	FOR LCOUNTX, 0, RLMAP_CONST
		FOR LCOUNTY, 0, RLMAP_CONST
			;OPENノードかつ最低コストなら処理
			IF NODE:LCOUNTX:LCOUNTY == 1 && NODE_COST:LCOUNTX:LCOUNTY:0+NODE_COST:LCOUNTX:LCOUNTY:1 == MINCOST
				;推定コストが1ならルート確定
				IF NODE_COST:LCOUNTX:LCOUNTY:1 == 1
					NOW_POSX = LCOUNTX
					NOW_POSY = LCOUNTY
					DO
						ASTARROOT:(NODE_COST:NOW_POSX:NOW_POSY:0):0 = NOW_POSX
						ASTARROOT:(NODE_COST:NOW_POSX:NOW_POSY:0):1 = NOW_POSY
						CHILD_POSX = NOW_POSX
						CHILD_POSY = NOW_POSY
						NOW_POSX = PARENTNODE:CHILD_POSX:CHILD_POSY:0
						NOW_POSY = PARENTNODE:CHILD_POSX:CHILD_POSY:1
						SIF NOW_POSX == -1 || NOW_POSY == -1
							GOTO END_ASTER
					LOOP 1
				ENDIF
				;周囲9マスをOPEN
				FOR OPENX, -1, 2
					FOR OPENY, -1, 2
						IF (OPENX != 0 || OPENY != 0) && GROUPMATCH(RLMAP:(LCOUNTX+OPENX):(LCOUNTY+OPENY), 1, 2) && NODE:(LCOUNTX+OPENX):(LCOUNTY+OPENY) == 0
							NODE:(LCOUNTX+OPENX):(LCOUNTY+OPENY) = 1
							;親ノードの実コスト+1
							NODE_COST:(LCOUNTX+OPENX):(LCOUNTY+OPENY):0 = NODE_COST:LCOUNTX:LCOUNTY:0+1
							;推定コスト
							NODE_COST:(LCOUNTX+OPENX):(LCOUNTY+OPENY):1 = 座標距離判別(LCOUNTX+OPENX, LCOUNTY+OPENY, GOALX, GOALY)
							;親ノードも設定
							PARENTNODE:(LCOUNTX+OPENX):(LCOUNTY+OPENY):0 = LCOUNTX
							PARENTNODE:(LCOUNTX+OPENX):(LCOUNTY+OPENY):1 = LCOUNTY
						ENDIF
					NEXT
				NEXT
				;NODEをCLOSE
				NODE:LCOUNTX:LCOUNTY = -1
			ENDIF
		NEXT
	NEXT
WEND

$END_ASTER

RETURNF
