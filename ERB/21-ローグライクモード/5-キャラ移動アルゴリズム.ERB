@敵行動フェーズ
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY
#DIM DYNAMIC LCOUNTXE
#DIM DYNAMIC LCOUNTYE
#DIM DYNAMIC MOVEX
#DIM DYNAMIC MOVEY

;移動後のVISIBLEをPL_VISBLE_MOVEDに入れる
CALL PL視界生成, 1

;この時点でVISIBLE範囲はPLの移動前なので、移動で視界外に出ても敵は追従してくる
;ASTER実装により上の仕様は無かったことに
FOR LCOUNTX, 0, RLMAP広さ
	FOR LCOUNTY, 0, RLMAP広さ
		SIF RL_GAMEOVER
			RETURN
		IF RLMAP_ENEMY:LCOUNTX:LCOUNTY > 0 && !CFLAGRL:(RLMAP_ENEMY:LCOUNTX:LCOUNTY):移動済み
			TARGET = RLMAP_ENEMY:LCOUNTX:LCOUNTY
			;中立なら常にランダムウォーク
			SIF CSTRRL:行動パターン == "中立"
				GOTO ランダムウォーク
			;隣接してれば攻撃してくる
			IF 座標距離判別(LCOUNTX, LCOUNTY, PL:XPOS, PL:YPOS) == 1
				CALL RL攻撃, TARGET, PLAYER, 近接攻撃候補(TARGET)
				CONTINUE
			ELSEIF 遠距離攻撃候補(TARGET) != "" && PL_VISIBLE_MOVED:LCOUNTX:LCOUNTY && 遠距離攻撃可能(LCOUNTX, LCOUNTY, PL:XPOS, PL:YPOS)
				CALL RL攻撃, TARGET, PLAYER, 遠距離攻撃候補(TARGET)
				CONTINUE
			ENDIF
			;視界内かどうかで動きが変わる
			IF PL_VISIBLE_MOVED:LCOUNTX:LCOUNTY
				CFLAGRL:追跡中 = 1
				;SELECTCASE 座標距離判別, LCOUNTX, LCOUNTY, PL:XPOS, PL:YPOS
					;9ならちょうど視界から外れてるので視界に入るように動く
					;CASE 9
					;一旦行動パターンを単純にしてみる
						SELECTCASE 座標方向判別(LCOUNTX, LCOUNTY, PL:XPOS, PL:YPOS)
							CASE "左上"
								;既に敵が居たら時計回りにずらす
								IF RLMAP_ENEMY:(LCOUNTX-1):(LCOUNTY-1) > 0
									;その先にも居たら諦めてランダムウォークする
									IF RLMAP_ENEMY:(LCOUNTX):(LCOUNTY+1) > 0
										GOTO ランダムウォーク
									ELSE
										CALL 敵移動, TARGET, LCOUNTX, LCOUNTY+1
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY-1
								ENDIF
							CASE "上"
								;既に敵が居たら時計回りにずらす
								IF RLMAP_ENEMY:(LCOUNTX):(LCOUNTY-1) > 0
									;その先にも居たら諦めてランダムウォークする
									IF RLMAP_ENEMY:(LCOUNTX+1):(LCOUNTY-1) > 0
										GOTO ランダムウォーク
									ELSE
										CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY-1
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX, LCOUNTY-1
								ENDIF
							CASE "右上"
								;既に敵が居たら時計回りにずらす
								IF RLMAP_ENEMY:(LCOUNTX+1):(LCOUNTY-1) > 0
									;その先にも居たら諦めてランダムウォークする
									IF RLMAP_ENEMY:(LCOUNTX+1):(LCOUNTY) > 0
										GOTO ランダムウォーク
									ELSE
										CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY-1
								ENDIF
							CASE "左"
								;既に敵が居たら時計回りにずらす
								IF RLMAP_ENEMY:(LCOUNTX-1):(LCOUNTY) > 0
									;その先にも居たら諦めてランダムウォークする
									IF RLMAP_ENEMY:(LCOUNTX-1):(LCOUNTY+1) > 0
										GOTO ランダムウォーク
									ELSE
										CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY+1
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY
								ENDIF
							CASE "右"
								;既に敵が居たら時計回りにずらす
								IF RLMAP_ENEMY:(LCOUNTX+1):(LCOUNTY) > 0
									;その先にも居たら諦めてランダムウォークする
									IF RLMAP_ENEMY:(LCOUNTX+1):(LCOUNTY+1) > 0
										GOTO ランダムウォーク
									ELSE
										CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY+1
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY
								ENDIF
							CASE "左下"
								;既に敵が居たら時計回りにずらす
								IF RLMAP_ENEMY:(LCOUNTX-1):(LCOUNTY+1) > 0
									;その先にも居たら諦めてランダムウォークする
									IF RLMAP_ENEMY:(LCOUNTX-1):(LCOUNTY) > 0
										GOTO ランダムウォーク
									ELSE
										CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY+1
								ENDIF
							CASE "下"
								;既に敵が居たら時計回りにずらす
								IF RLMAP_ENEMY:(LCOUNTX):(LCOUNTY+1) > 0
									;その先にも居たら諦めてランダムウォークする
									IF RLMAP_ENEMY:(LCOUNTX-1):(LCOUNTY+1) > 0
										GOTO ランダムウォーク
									ELSE
										CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY+1
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX, LCOUNTY+1
								ENDIF
							CASE "右下"
								;既に敵が居たら時計回りにずらす
								IF RLMAP_ENEMY:(LCOUNTX+1):(LCOUNTY+1) > 0
									;その先にも居たら諦めてランダムウォークする
									IF RLMAP_ENEMY:(LCOUNTX-1):(LCOUNTY+1) > 0
										GOTO ランダムウォーク
									ELSE
										CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY+1
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY+1
								ENDIF
						ENDSELECT
					;CASEELSE

			ELSEIF CFLAGRL:追跡中
				CALLF RL_ASTER, LCOUNTX, LCOUNTY, PL:XPOS, PL:YPOS
				DEBUGPRINTFORML %NAME:TARGET% PL追跡中 PL座標({PL:XPOS},{PL:YPOS}) %CALLNAME:TARGET%座標({LCOUNTX},{LCOUNTY})
				FOR LCOUNT, 0, 3600
					SIF ASTERROOT:LCOUNT:0 == 0
						BREAK
					DEBUGPRINTFORM ({ASTERROOT:LCOUNT:0},{ASTERROOT:LCOUNT:1})→
				NEXT
				DEBUGPRINTFORML 
				CALL 敵移動, TARGET, ASTERROOT:1:0, ASTERROOT:1:1
			;視界外ならランダムウォーク
			ELSE
				;通路なら移動方向を決める
				IF RLMAP:LCOUNTX:LCOUNTY == 2
					IF CSTRRL:移動方向 == ""
						DO
							SELECTCASE RAND:4
								CASE 0
									IF GROUPMATCH(RLMAP:(LCOUNTX-1):LCOUNTY, 1, 2)
										CSTRRL:移動方向 = 左
										CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY
										BREAK
									ENDIF
								CASE 1
									IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY-1), 1, 2)
										CSTRRL:移動方向 = 上
										CALL 敵移動, TARGET, LCOUNTX, LCOUNTY-1
										BREAK
									ENDIF
								CASE 2
									IF GROUPMATCH(RLMAP:(LCOUNTX+1):LCOUNTY, 1, 2)
										CSTRRL:移動方向 = 右
										CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY
										BREAK
									ENDIF
								CASE 3
									IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY+1), 1, 2)
										CSTRRL:移動方向 = 下
										CALL 敵移動, TARGET, LCOUNTX, LCOUNTY+1
										BREAK
									ENDIF
							ENDSELECT
						LOOP 1
					ELSE
						SELECTCASE CSTRRL:移動方向
							CASE "左"
								;左に進めない場合は上か下に動く
								IF !GROUPMATCH(RLMAP:(LCOUNTX-1):LCOUNTY, 1, 2)
									FOR LCOUNT, 0, 1000
										SELECTCASE RAND:2
											CASE 0
												IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY-1), 1, 2)
													CSTRRL:移動方向 = 上
													CALL 敵移動, TARGET, LCOUNTX, LCOUNTY-1
													BREAK
												ENDIF
											CASE 1
												IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY+1), 1, 2)
													CSTRRL:移動方向 = 下
													CALL 敵移動, TARGET, LCOUNTX, LCOUNTY+1
													BREAK
												ENDIF
										ENDSELECT
									NEXT
									;万が一どちらにも動けなかったら来た道を戻る
									IF LCOUNT == 999
										CSTRRL:移動方向 = 右
										CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY
								ENDIF
							CASE "右"
								;右もほぼ同じ
								IF !GROUPMATCH(RLMAP:(LCOUNTX+1):LCOUNTY, 1, 2)
									FOR LCOUNT, 0, 1000
										SELECTCASE RAND:2
											CASE 0
												IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY-1), 1, 2)
													CSTRRL:移動方向 = 上
													CALL 敵移動, TARGET, LCOUNTX, LCOUNTY-1
													BREAK
												ENDIF
											CASE 1
												IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY+1), 1, 2)
													CSTRRL:移動方向 = 下
													CALL 敵移動, TARGET, LCOUNTX, LCOUNTY+1
													BREAK
												ENDIF
										ENDSELECT
									NEXT
									;万が一どちらにも動けなかったら来た道を戻る
									IF LCOUNT == 999
										CSTRRL:移動方向 = 左
										CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY
								ENDIF
							CASE "上"
								;上に進めない場合は左か右に動く
								IF !GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY-1), 1, 2)
									FOR LCOUNT, 0, 1000
										SELECTCASE RAND:2
											CASE 0
												IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY-1), 1, 2)
													CSTRRL:移動方向 = 左
													CALL 敵移動, TARGET, (LCOUNTX-1), LCOUNTY
													BREAK
												ENDIF
											CASE 1
												IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY+1), 1, 2)
													CSTRRL:移動方向 = 右
													CALL 敵移動, TARGET, (LCOUNTX+1), LCOUNTY
													BREAK
												ENDIF
										ENDSELECT
									NEXT
									;万が一どちらにも動けなかったら来た道を戻る
									IF LCOUNT == 999
										CSTRRL:移動方向 = 下
										CALL 敵移動, TARGET, LCOUNTX, LCOUNTY+1
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX, LCOUNTY-1
								ENDIF
							CASE "下"
								;下もほぼ同じ
								IF !GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY+1), 1, 2)
									FOR LCOUNT, 0, 1000
										SELECTCASE RAND:2
											CASE 0
												IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY-1), 1, 2)
													CSTRRL:移動方向 = 左
													CALL 敵移動, TARGET, LCOUNTX-1, LCOUNTY
													BREAK
												ENDIF
											CASE 1
												IF GROUPMATCH(RLMAP:LCOUNTX:(LCOUNTY+1), 1, 2)
													CSTRRL:移動方向 = 右
													CALL 敵移動, TARGET, LCOUNTX+1, LCOUNTY
													BREAK
												ENDIF
										ENDSELECT
									NEXT
									;万が一どちらにも動けなかったら来た道を戻る
									IF LCOUNT == 999
										CSTRRL:移動方向 = 上
										CALL 敵移動, TARGET, LCOUNTX, LCOUNTY-1
									ENDIF
								ELSE
									CALL 敵移動, TARGET, LCOUNTX, LCOUNTY+1
								ENDIF
						ENDSELECT
					ENDIF
				;ランダムウォーク
				ELSE
					$ランダムウォーク
					CSTRRL:移動方向 = 
					DO
						MOVEX = RAND:3-1
						MOVEY = RAND:3-1
						IF GROUPMATCH(RLMAP:(LCOUNTX+MOVEX):(LCOUNTY+MOVEY), 1, 2)
							CALL 敵移動, TARGET, LCOUNTX+MOVEX, LCOUNTY+MOVEY
							BREAK
						ENDIF
					LOOP 1
				ENDIF
			ENDIF
			CFLAGRL:移動済み = 1
		ENDIF
	NEXT
NEXT

@敵移動, TARGET, X_POS, Y_POS
#DIMS DYNAMIC 方向
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY

;一応確認はしてるけど移動不可能だったら何もせず終了
SIF !GROUPMATCH(RLMAP:X_POS:Y_POS, 1, 2)
	RETURN
;PLと同じマスなら攻撃が優先されるはずなので終了
SIF X_POS == PL:XPOS && Y_POS == PL:YPOS
	RETURN

FOR LCOUNTX, 0, RLMAP広さ
	FOR LCOUNTY, 0, RLMAP広さ
		IF RLMAP_ENEMY:LCOUNTX:LCOUNTY == TARGET
			SWAP RLMAP_ENEMY:LCOUNTX:LCOUNTY, RLMAP_ENEMY:X_POS:Y_POS
			;PRINTFORMW {TARGET} %CSTRRL:移動方向% {X_POS} {Y_POS}
			RETURN
		ENDIF
	NEXT
NEXT
