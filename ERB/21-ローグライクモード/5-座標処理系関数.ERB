@座標方向判別, X1, Y1, X2, Y2
#FUNCTIONS
#DIM DYNAMIC X1
#DIM DYNAMIC Y1
#DIM DYNAMIC X2
#DIM DYNAMIC Y2

; X→
;Y
;↓

;横に同じ
IF X1 == X2
	;縦も同じ
	IF Y1 == Y2
		RETURNF "同位置"
	;上にある
	ELSEIF Y1 > Y2
		RETURNF "上"
	;下にある
	ELSEIF Y1 < Y2
		RETURNF "下"
	ENDIF
;左にある
ELSEIF X1 > X2
	;縦が同じ
	IF Y1 == Y2
		RETURNF "左"
	;上にある
	ELSEIF Y1 > Y2
		RETURNF "左上"
	;下にある
	ELSEIF Y1 < Y2
		RETURNF "左下"
	ENDIF
;右にある
ELSEIF X1 < X2
	;縦が同じ
	IF Y1 == Y2
		RETURNF "右"
	;上にある
	ELSEIF Y1 > Y2
		RETURNF "右上"
	;下にある
	ELSEIF Y1 < Y2
		RETURNF "右下"
	ENDIF
ENDIF

RETURNF "何かおかしい"

;;;座標距離 壁は無視して単純なマス数
@座標距離判別, X1, Y1, X2, Y2
#FUNCTION
#DIM DYNAMIC X1
#DIM DYNAMIC Y1
#DIM DYNAMIC X2
#DIM DYNAMIC Y2

RETURNF MAX(ABS(X1-X2), ABS(Y1-Y2))

@直線判定, FROM_X, FROM_Y, DIST_X, DIST_Y
#FUNCTIONS
#DIM DYNAMIC FROM_X
#DIM DYNAMIC FROM_Y
#DIM DYNAMIC DIST_X
#DIM DYNAMIC DIST_Y

;左
IF FROM_X > DIST_X
	IF FROM_Y == DIST_Y
		RETURNF "左"
	ELSEIF ABS(FROM_X-DIST_X == FROM_Y-DIST_Y)
		;下
		IF FROM_Y > DIST_Y
			RETURNF "左下"
		;上
		ELSE
			RETURNF "左上"
		ENDIF
	ENDIF
;右
ELSEIF FROM_X < DIST_X
	IF FROM_Y == DIST_Y
		RETURNF "右"
	ELSEIF ABS(FROM_X-DIST_X == FROM_Y-DIST_Y)
		;下
		IF FROM_Y > DIST_Y
			RETURNF "右下"
		;上
		ELSE
			RETURNF "右上"
		ENDIF
	ENDIF
;上下
ELSEIF FROM_X == DIST_X
	IF FROM_Y > DIST_Y
		RETURNF "下"
	ELSE
		RETURNF "上"
	ENDIF
ENDIF
