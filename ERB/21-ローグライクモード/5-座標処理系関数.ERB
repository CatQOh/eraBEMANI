@座標方向判別, X1, Y1, X2, Y2
#FUNCTIONS
#DIM DYNAMIC X1
#DIM DYNAMIC Y1
#DIM DYNAMIC X2
#DIM DYNAMIC Y2

; X→
;Y
;↓

;横に同じ
IF X1 == X2
	;縦も同じ
	IF Y1 == Y2
		RETURNF "同位置"
	;上にある
	ELSEIF Y1 > Y2
		RETURNF "上"
	;下にある
	ELSEIF Y1 < Y2
		RETURNF "下"
	ENDIF
;左にある
ELSEIF X1 > X2
	;縦が同じ
	IF Y1 == Y2
		RETURNF "左"
	;上にある
	ELSEIF Y1 > Y2
		RETURNF "左上"
	;下にある
	ELSEIF Y1 < Y2
		RETURNF "左下"
	ENDIF
;右にある
ELSEIF X1 < X2
	;縦が同じ
	IF Y1 == Y2
		RETURNF "右"
	;上にある
	ELSEIF Y1 > Y2
		RETURNF "右上"
	;下にある
	ELSEIF Y1 < Y2
		RETURNF "右下"
	ENDIF
ENDIF

RETURNF "何かおかしい"

;;;座標距離 壁は無視して単純なマス数
@座標距離判別, X1, Y1, X2, Y2
#FUNCTION
#DIM DYNAMIC X1
#DIM DYNAMIC Y1
#DIM DYNAMIC X2
#DIM DYNAMIC Y2

RETURNF MAX(ABS(X1-X2), ABS(Y1-Y2))

@直線判定, FROM_X, FROM_Y, DIST_X, DIST_Y
#FUNCTIONS
#DIM DYNAMIC FROM_X
#DIM DYNAMIC FROM_Y
#DIM DYNAMIC DIST_X
#DIM DYNAMIC DIST_Y

;左
IF FROM_X > DIST_X
	IF FROM_Y == DIST_Y
		RETURNF "左"
	ELSEIF ABS(FROM_X-DIST_X == FROM_Y-DIST_Y)
		;下
		IF FROM_Y > DIST_Y
			RETURNF "左下"
		;上
		ELSE
			RETURNF "左上"
		ENDIF
	ENDIF
;右
ELSEIF FROM_X < DIST_X
	IF FROM_Y == DIST_Y
		RETURNF "右"
	ELSEIF ABS(FROM_X-DIST_X == FROM_Y-DIST_Y)
		;下
		IF FROM_Y > DIST_Y
			RETURNF "右下"
		;上
		ELSE
			RETURNF "右上"
		ENDIF
	ENDIF
;上下
ELSEIF FROM_X == DIST_X
	IF FROM_Y > DIST_Y
		RETURNF "下"
	ELSE
		RETURNF "上"
	ENDIF
ENDIF

;;;VISIBLE判定は別で行う
@遠距離攻撃可能, FROM_X, FROM_Y, DIST_X, DIST_Y
#FUNCTION
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC FROM_X
#DIM DYNAMIC FROM_Y
#DIM DYNAMIC DIST_X
#DIM DYNAMIC DIST_Y

;途中で敵が居たらダメ
SELECTCASE 直線判定(FROM_X, FROM_Y, DIST_X, DIST_Y)
	CASE "上"
		FOR LCOUNT, 1, 座標距離判別(FROM_X, FROM_Y, DIST_X, DIST_Y)
			SIF RLMAP_ENEMY:FROM_X:(DIST_Y-LCOUNT)
				RETURNF 0
		NEXT
		RETURNF 1
	CASE "下"
		FOR LCOUNT, 1, 座標距離判別(FROM_X, FROM_Y, DIST_X, DIST_Y)
			SIF RLMAP_ENEMY:FROM_X:(DIST_Y+LCOUNT)
				RETURNF 0
		NEXT
		RETURNF 1
	CASE "左"
		FOR LCOUNT, 1, 座標距離判別(FROM_X, FROM_Y, DIST_X, DIST_Y)
			SIF RLMAP_ENEMY:(FROM_X-LCOUNT):DIST_Y
				RETURNF 0
		NEXT
		RETURNF 1
	CASE "右"
		FOR LCOUNT, 1, 座標距離判別(FROM_X, FROM_Y, DIST_X, DIST_Y)
			SIF RLMAP_ENEMY:(FROM_X+LCOUNT):DIST_Y
				RETURNF 0
		NEXT
		RETURNF 1
	CASE "左上"
		FOR LCOUNT, 1, 座標距離判別(FROM_X, FROM_Y, DIST_X, DIST_Y)
			SIF RLMAP_ENEMY:(FROM_X-LCOUNT):(DIST_Y-LCOUNT)
				RETURNF 0
		NEXT
		RETURNF 1
	CASE "右上"
		FOR LCOUNT, 1, 座標距離判別(FROM_X, FROM_Y, DIST_X, DIST_Y)
			SIF RLMAP_ENEMY:(FROM_X+LCOUNT):(DIST_Y-LCOUNT)
				RETURNF 0
		NEXT
		RETURNF 1
	CASE "左下"
		FOR LCOUNT, 1, 座標距離判別(FROM_X, FROM_Y, DIST_X, DIST_Y)
			SIF RLMAP_ENEMY:(FROM_X-LCOUNT):(DIST_Y+LCOUNT)
				RETURNF 0
		NEXT
		RETURNF 1
	CASE "右下"
		FOR LCOUNT, 1, 座標距離判別(FROM_X, FROM_Y, DIST_X, DIST_Y)
			SIF RLMAP_ENEMY:(FROM_X+LCOUNT):(DIST_Y+LCOUNT)
				RETURNF 0
		NEXT
		RETURNF 1
ENDSELECT

;;;指定座標に置けるかどうか判別して置けなかったら周囲の空いてる座標を返す
@アイテムドロップ座標, X_POS, Y_POS
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS

SIF RLMAP_ITEM:X_POS:Y_POS == 0 && GROUPMATCH(RLMAP:X_POS:Y_POS, 1, 2)
	RETURN X_POS, Y_POS

;本当は左上→右下で判定したいけど処理が冗長になりそうなのでランダム 乱数次第でとんでもないところにいきそう
X_POS = RAND(X_POS-1, X_POS+2)
Y_POS = RAND(Y_POS-1, Y_POS+2)
RESTART

;マジで要エラー対策

;;;2キャラ間のマス数を返す
@相対距離, FROMID, DESTID
#FUNCTION
#DIM DYNAMIC FROMID
#DIM DYNAMIC DESTID
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY
#DIM DYNAMIC FROM_X
#DIM DYNAMIC FROM_Y
#DIM DYNAMIC DEST_X
#DIM DYNAMIC DEST_Y

;PLが含まれていればFROMをPLにする
SIF DESTID == PLAYER
	SWAP FROMID, DESTID

IF FROMID == PLAYER
	FROM_X = PL:XPOS
	FROM_Y = PL:YPOS
ELSE
	FOR LCOUNTX, 0, RLMAP広さ
		FOR LCOUNTY, 0, RLMAP広さ
			IF RLMAP_ENEMY:LCOUNTX:LCOUNTY == FROMID
				FROM_X = LCOUNTX
				FROM_Y = LCOUNTY
				GOTO ループ終了1
			ENDIF
		NEXT
	NEXT
ENDIF

$ループ終了1

;キャラの座標を移動ごとに記録するよりはこっちの処理のほうがいい……はず
FOR LCOUNTX, 0, RLMAP広さ
	FOR LCOUNTY, 0, RLMAP広さ
		IF RLMAP_ENEMY:LCOUNTX:LCOUNTY == DESTID
			DEST_X = LCOUNTX
			DEST_Y = LCOUNTY
			GOTO ループ終了2
		ENDIF
	NEXT
NEXT

$ループ終了2

RETURNF MAX(ABS(FROM_X-DEST_X), ABS(FROM_Y-DEST_Y))
