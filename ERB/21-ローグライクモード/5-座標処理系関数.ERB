@座標方向判別, X1, Y1, X2, Y2
#FUNCTIONS
#DIM DYNAMIC X1
#DIM DYNAMIC Y1
#DIM DYNAMIC X2
#DIM DYNAMIC Y2

; X→
;Y
;↓

;横に同じ
IF X1 == X2
	;縦も同じ
	IF Y1 == Y2
		RETURNF "同位置"
	;上にある
	ELSEIF Y1 > Y2
		RETURNF "上"
	;下にある
	ELSEIF Y1 < Y2
		RETURNF "下"
	ENDIF
;左にある
ELSEIF X1 > X2
	;縦が同じ
	IF Y1 == Y2
		RETURNF "左"
	;上にある
	ELSEIF Y1 > Y2
		RETURNF "左上"
	;下にある
	ELSEIF Y1 < Y2
		RETURNF "左下"
	ENDIF
;右にある
ELSEIF X1 < X2
	;縦が同じ
	IF Y1 == Y2
		RETURNF "右"
	;上にある
	ELSEIF Y1 > Y2
		RETURNF "右上"
	;下にある
	ELSEIF Y1 < Y2
		RETURNF "右下"
	ENDIF
ENDIF

RETURNF "何かおかしい"

;;;座標距離 壁は無視して単純なマス数
@座標距離判別, X1, Y1, X2, Y2
#FUNCTION
#DIM DYNAMIC X1
#DIM DYNAMIC Y1
#DIM DYNAMIC X2
#DIM DYNAMIC Y2

RETURNF MAX(ABS(X1-X2), ABS(Y1-Y2))
