@階段判定
#FUNCTION

SIF PL:XPOS == STAIR:XPOS && PL:YPOS == STAIR:YPOS
	RETURNF 1

RETURNF 0

@壁判定, X_POS, Y_POS
#FUNCTION
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS

SIF !INRANGE(X_POS, 0, RLMAP広さ-1) || !INRANGE(Y_POS, 0, RLMAP広さ-1)
	RETURNF 1

SIF GROUPMATCH(RLMAP:X_POS:Y_POS, 0, 3)
	RETURNF 1

RETURNF 0

;;;中立は判定に含めるか否か
@敵判定, X_POS, Y_POS
#FUNCTION
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS

SIF !INRANGE(X_POS, 0, RLMAP広さ-1) || !INRANGE(Y_POS, 0, RLMAP広さ-1)
	RETURNF 0

SIF RLMAP_ENEMY:X_POS:Y_POS > 0 && CSTRRL:(RLMAP_ENEMY:X_POS:Y_POS):行動パターン != "中立"
	RETURNF RLMAP_ENEMY:X_POS:Y_POS

RETURNF 0

@中立判定, X_POS, Y_POS
#FUNCTION
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS

SIF !INRANGE(X_POS, 0, RLMAP広さ-1) || !INRANGE(Y_POS, 0, RLMAP広さ-1)
	RETURNF 0

SIF RLMAP_ENEMY:X_POS:Y_POS > 0 && CSTRRL:(RLMAP_ENEMY:X_POS:Y_POS):行動パターン == "中立"
	RETURNF RLMAP_ENEMY:X_POS:Y_POS

RETURNF 0

@NPC判定, X_POS, Y_POS
#FUNCTION
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS

