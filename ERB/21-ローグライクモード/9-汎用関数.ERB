@通路判定, X_POS, Y_POS
#FUNCTION
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS
#DIM DYNAMIC 空きマス数

SIF GROUPMATCH(RLMAP:(X_POS-1):(Y_POS-1), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS):(Y_POS-1), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS+1):(Y_POS-1), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS-1):(Y_POS), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS+1):(Y_POS), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS-1):(Y_POS+1), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS):(Y_POS+1), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS+1):(Y_POS+1), 1, 2)
	空きマス数++

SIF 空きマス数 <= 2
	RETURNF 1

RETURNF 0

@TOALPHABET, NUM
#FUNCTIONS
#DIM DYNAMIC NUM

;小文字は61～7A 大文字は41～5A

SELECTCASE NUM
	CASE 0 TO 25
		RETURNF UNICODE(0x61+NUM)
	CASE 26 TO 51
		RETURNF UNICODE(0x41+NUM)
	CASEELSE
		;#; THROW TOALPHABET関数に想定外の数字({NUM})が渡された
ENDSELECT

@FROMALPHABET, ALP
#FUNCTION
#DIMS DYNAMIC ALP

;小文字は61～7A 大文字は41～5A

SELECTCASE ENCODETOUNI(ALP)
	CASE 0x61 TO 0x7A
		RETURNF ENCODETOUNI(ALP)-0x61
	CASE 0x41 TO 0x5A
		RETURNF ENCODETOUNI(ALP)-0x41+26
	CASEELSE
		RETURNF -1
		;#; THROW FROMALPHABET関数に想定外の文字(%ALP%)が渡された
ENDSELECT

@RLターン終了処理, TARGETID, 回復回数 = 1
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC TARGETID
#DIM DYNAMIC 回復回数
#DIM DYNAMIC 満腹度消費量
#DIM DYNAMIC 回復量

;満腹度低下
IF TARGETID == PLAYER
	満腹度消費量 = 20
	;+15%
	満腹度消費量 += RLスキル(TARGETID, "高燃費")*3
	;-25%
	満腹度消費量 -= RLスキル(TARGETID, "低燃費")*5
	;-15%
	満腹度消費量 -= RLスキル(TARGETID, "社畜")*3
	;-10%
	満腹度消費量 -= RLスキル(TARGETID, "サバイバル")*2
	IF CFLAGRL:TARGETID:満腹度 > 3000 && CFLAGRL:TARGETID:満腹度-満腹度消費量 <= 3000
		CALL RLLOG, "お腹が空いてきた"
	ELSEIF CFLAGRL:TARGETID:満腹度 > 1000 && CFLAGRL:TARGETID:満腹度-満腹度消費量 <= 1000
		CALL RLLOG, "そろそろ空腹で倒れそうだ"
	ELSEIF CFLAGRL:TARGETID:満腹度 > 10 && CFLAGRL:TARGETID:満腹度-満腹度消費量 <= 10
		CALL RLLOG, "空腹の限界だ！何か食べなくては……"
	ENDIF
	CFLAGRL:TARGETID:満腹度 -= 満腹度消費量
	SIF CFLAGRL:TARGETID:満腹度 < 0
		CFLAGRL:TARGETID:満腹度 = 0
ENDIF

;満腹度0だと自然回復しない
IF CFLAGRL:TARGETID:満腹度 > 0 || TARGETID != PLAYER
	;自然回復
	FOR LCOUNT, 0, 回復回数
		回復量 += CFLAGRL:TARGETID:MAXHP
	NEXT

	SIF RLスキル(TARGETID, "社畜")
		TIMES 回復量, 0.70
	;スキルレベル1につき5%
	SIF RLスキル(TARGETID, "サバイバル")
		回復量 += 回復量*RLスキル(TARGETID, "サバイバル")/20


	CFLAGRL:TARGETID:HP回復計算 += 回復量
	CFLAGRL:TARGETID:HP += CFLAGRL:TARGETID:HP回復計算/100
	CFLAGRL:TARGETID:HP回復計算 %= 100

	SIF CFLAGRL:TARGETID:HP > CFLAGRL:TARGETID:MAXHP
		CFLAGRL:TARGETID:HP = CFLAGRL:TARGETID:MAXHP
;しかも体力が減る
ELSEIF CFLAGRL:TARGETID:満腹度 == 0
	CFLAGRL:TARGETID:HP--
	IF CFLAGRL:TARGETID:HP <= 0
		CALL RLLOG, @"%NAME:PLAYER%は空腹で倒れた……"
		CALL RLLOG, "GAME OVER"
		RL_GAMEOVER = 1
		RETURN 0
	ENDIF
ENDIF

;;;テンキー1～9に対応した移動先の座標を取得
@進行座標, NUM
#DIM DYNAMIC NUM

SELECTCASE NUM
	CASE 7
		RETURN PL:XPOS-1, PL:YPOS-1
	CASE 8
		RETURN PL:XPOS, PL:YPOS-1
	CASE 9
		RETURN PL:XPOS+1, PL:YPOS-1
	CASE 4
		RETURN PL:XPOS-1, PL:YPOS
	CASE 5
		RETURN PL:XPOS, PL:YPOS
	CASE 6
		RETURN PL:XPOS+1, PL:YPOS
	CASE 1
		RETURN PL:XPOS-1, PL:YPOS+1
	CASE 2
		RETURN PL:XPOS, PL:YPOS+1
	CASE 3
		RETURN PL:XPOS+1, PL:YPOS+1
ENDSELECT

RETURN 0

;;;テンキー1～9に対応した視界内直線のNPC座標、距離を取得
@直線NPC座標, NUM
#DIM DYNAMIC NUM
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS

SELECTCASE NUM
	CASE 7
		FOR LCOUNT, 1, 10
			X_POS = PL:XPOS-LCOUNT
			Y_POS = PL:YPOS-LCOUNT
			SIF NPC判定(X_POS, Y_POS) && PL_VISIBLE:X_POS:Y_POS
				RETURN X_POS, Y_POS, LCOUNT
		NEXT
		RETURN -1
	CASE 8
		FOR LCOUNT, 1, 10
			X_POS = PL:XPOS
			Y_POS = PL:YPOS-LCOUNT
			SIF NPC判定(X_POS, Y_POS) && PL_VISIBLE:X_POS:Y_POS
				RETURN X_POS, Y_POS, LCOUNT
		NEXT
		RETURN -1
	CASE 9
		FOR LCOUNT, 1, 10
			X_POS = PL:XPOS+LCOUNT
			Y_POS = PL:YPOS-LCOUNT
			SIF NPC判定(X_POS, Y_POS) && PL_VISIBLE:X_POS:Y_POS
				RETURN X_POS, Y_POS, LCOUNT
		NEXT
		RETURN -1
	CASE 4
		FOR LCOUNT, 1, 10
			X_POS = PL:XPOS-LCOUNT
			Y_POS = PL:YPOS
			SIF NPC判定(X_POS, Y_POS) && PL_VISIBLE:X_POS:Y_POS
				RETURN X_POS, Y_POS, LCOUNT
		NEXT
		RETURN -1
	;？
	CASE 5
		RETURN 0
	CASE 6
		FOR LCOUNT, 1, 10
			X_POS = PL:XPOS+LCOUNT
			Y_POS = PL:YPOS
			SIF NPC判定(X_POS, Y_POS) && PL_VISIBLE:X_POS:Y_POS
				RETURN X_POS, Y_POS, LCOUNT
		NEXT
		RETURN -1
	CASE 1
		FOR LCOUNT, 1, 10
			X_POS = PL:XPOS-LCOUNT
			Y_POS = PL:YPOS+LCOUNT
			SIF NPC判定(X_POS, Y_POS) && PL_VISIBLE:X_POS:Y_POS
				RETURN X_POS, Y_POS, LCOUNT
		NEXT
		RETURN -1
	CASE 2
		FOR LCOUNT, 1, 10
			X_POS = PL:XPOS
			Y_POS = PL:YPOS+LCOUNT
			SIF NPC判定(X_POS, Y_POS) && PL_VISIBLE:X_POS:Y_POS
				RETURN X_POS, Y_POS, LCOUNT
		NEXT
		RETURN -1
	CASE 3
		FOR LCOUNT, 1, 10
			X_POS = PL:XPOS+LCOUNT
			Y_POS = PL:YPOS+LCOUNT
			SIF NPC判定(X_POS, Y_POS) && PL_VISIBLE:X_POS:Y_POS
				RETURN X_POS, Y_POS, LCOUNT
		NEXT
		RETURN -1
ENDSELECT

RETURN 0

@アイテム性能呼び出し, アイテム名
#FUNCTION
#DIMS DYNAMIC アイテム名

CALLF 武器性能, アイテム名
SIF RLITEMSPEC:分類 == ""
	CALLF アイテム性能, アイテム名

@RLステータスファイルチェック
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNT2
#DIM DYNAMIC 分割数
#DIMS DYNAMIC SPLITVAR, 100
#DIMS DYNAMIC SPLITVAR2, 2

FOR LCOUNT, 0, 9999
	SIF !EXISTCSV(LCOUNT)
		CONTINUE
	ADDCHARA LCOUNT
	TARGET = CHARANUM-1
	TRYCALLFORM RL_%CSVNAMERPS(NOF(TARGET))%
	IF CSTRRL:スキル != ""
		SPLIT CSTRRL:スキル, "/", SPLITVAR
		分割数 = RESULT
		FOR LCOUNT2, 0, 分割数
			SPLIT SPLITVAR:LCOUNT2, "*", SPLITVAR2
			SIF スキル効果(SPLITVAR2) == ""
				DEBUGPRINTFORML No.{LCOUNT} %NAME:TARGET% スキル「%SPLITVAR2%」のスキル定義無し
		NEXT
	ENDIF
	IF CSTRRL:攻撃方法 != ""
		SPLIT CSTRRL:攻撃方法, "/", SPLITVAR
		分割数 = RESULT
		FOR LCOUNT2, 0, 分割数
			VARSET RLITEMSPEC
			CALLF 武器性能(SPLITVAR:LCOUNT2)
			SIF RLITEMSPEC:分類 == ""
				CALLF アイテム性能(SPLITVAR:LCOUNT2)
			SIF RLITEMSPEC:分類 == ""
				DEBUGPRINTFORML No.{LCOUNT} %NAME:TARGET% 攻撃方法「%SPLITVAR:LCOUNT2%」の性能定義無し
		NEXT
	ENDIF
	IF CSTRRL:初期アイテム != ""
		SPLIT CSTRRL:初期アイテム, "/", SPLITVAR
		分割数 = RESULT
		FOR LCOUNT2, 0, 分割数
			VARSET RLITEMSPEC
			CALLF 武器性能(SPLITVAR:LCOUNT2)
			SIF RLITEMSPEC:分類 == ""
				CALLF アイテム性能(SPLITVAR:LCOUNT2)
			SIF RLITEMSPEC:分類 == ""
				DEBUGPRINTFORML No.{LCOUNT} %NAME:TARGET% 初期アイテム「%SPLITVAR:LCOUNT2%」の性能定義無し
		NEXT
	ENDIF
	IF CSTRRL:ドロップアイテム != ""
		SPLIT CSTRRL:ドロップアイテム, "/", SPLITVAR
		分割数 = RESULT
		FOR LCOUNT2, 0, 分割数
			VARSET RLITEMSPEC
			CALLF 武器性能(SPLITVAR:LCOUNT2)
			SIF RLITEMSPEC:分類 == ""
				CALLF アイテム性能(SPLITVAR:LCOUNT2)
			SIF RLITEMSPEC:分類 == ""
				DEBUGPRINTFORML No.{LCOUNT} %NAME:TARGET% ドロップアイテム「%SPLITVAR:LCOUNT2%」の性能定義無し
		NEXT
	ENDIF
NEXT
