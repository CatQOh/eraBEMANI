@階段判定
#FUNCTION

SIF PL:XPOS == STAIR:XPOS && PL:YPOS == STAIR:YPOS
	RETURNF 1

RETURNF 0

@壁判定, X_POS, Y_POS
#FUNCTION
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS

SIF !INRANGE(X_POS, 0, RLMAP広さ-1) || !INRANGE(Y_POS, 0, RLMAP広さ-1)
	RETURNF 1

SIF GROUPMATCH(RLMAP:X_POS:Y_POS, 0, 3)
	RETURNF 1

RETURNF 0

;;;中立は判定に含めるか否か
@敵判定, X_POS, Y_POS
#FUNCTION
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS

SIF !INRANGE(X_POS, 0, RLMAP広さ-1) || !INRANGE(Y_POS, 0, RLMAP広さ-1)
	RETURNF 0

SIF RLMAP_ENEMY:X_POS:Y_POS > 0 && CSTRRL:(RLMAP_ENEMY:X_POS:Y_POS):行動パターン != "中立"
	RETURNF RLMAP_ENEMY:X_POS:Y_POS

RETURNF 0

@中立判定, X_POS, Y_POS
#FUNCTION
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS

SIF !INRANGE(X_POS, 0, RLMAP広さ-1) || !INRANGE(Y_POS, 0, RLMAP広さ-1)
	RETURNF 0

SIF RLMAP_ENEMY:X_POS:Y_POS > 0 && CSTRRL:(RLMAP_ENEMY:X_POS:Y_POS):行動パターン == "中立"
	RETURNF RLMAP_ENEMY:X_POS:Y_POS

RETURNF 0

@NPC判定, X_POS, Y_POS
#FUNCTION
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS

SIF !INRANGE(X_POS, 0, RLMAP広さ-1) || !INRANGE(Y_POS, 0, RLMAP広さ-1)
	RETURNF 0

SIF RLMAP_ENEMY:X_POS:Y_POS > 0
	RETURNF RLMAP_ENEMY:X_POS:Y_POS

RETURNF 0

@RLスキル, ID, 対象スキル
#FUNCTION
#DIM DYNAMIC ID
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC 対象スキル
#DIMS DYNAMIC スキル名, 100
#DIMS DYNAMIC スキル分割, 2

SPLIT CSTRRL:ID:スキル, "/", スキル名

FOR LCOUNT, 0, VARSIZE("スキル名")
	SPLIT スキル名:LCOUNT, "*", スキル分割
	IF スキル分割:0 == 対象スキル
		IF スキル分割:1 != ""
			;#; SIF !ISNUMERIC(スキル分割:1)
			;#;	 THROW スキル文法ミス %NAME:ID% %スキル名:LCOUNT%
			RETURNF TOINT(スキル分割:1)
		ELSE
			RETURNF 1
		ENDIF
	ENDIF
NEXT

RETURNF 0

@RLアイテムスキル, スキル文字列, 対象スキル
#FUNCTION
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC スキル文字列
#DIMS DYNAMIC 対象スキル
#DIMS DYNAMIC スキル名, 100
#DIMS DYNAMIC スキル分割, 2

SPLIT スキル文字列, "/", スキル名

FOR LCOUNT, 0, VARSIZE("スキル名")
	SPLIT スキル名:LCOUNT, "*", スキル分割
	IF スキル分割:0 == 対象スキル
		IF スキル分割:1 != ""
			;#; SIF !ISNUMERIC(スキル分割:1)
			;#;	 THROW スキル文法ミス %スキル文字列% %スキル名:LCOUNT%
			RETURNF TOINT(スキル分割:1)
		ELSE
			RETURNF 1
		ENDIF
	ENDIF
NEXT

RETURNF 0

@通路判定, X_POS, Y_POS
#FUNCTION
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS
#DIM DYNAMIC 空きマス数

SIF GROUPMATCH(RLMAP:(X_POS-1):(Y_POS-1), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS):(Y_POS-1), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS+1):(Y_POS-1), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS-1):(Y_POS), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS+1):(Y_POS), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS-1):(Y_POS+1), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS):(Y_POS+1), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS+1):(Y_POS+1), 1, 2)
	空きマス数++

SIF 空きマス数 <= 2
	RETURNF 1

RETURNF 0

@TOALPHABET, NUM
#FUNCTIONS
#DIM DYNAMIC NUM

;小文字は61～7A 大文字は41～5A

SELECTCASE NUM
	CASE 0 TO 25
		RETURNF UNICODE(0x61+NUM)
	CASE 26 TO 51
		RETURNF UNICODE(0x41+NUM)
	CASEELSE
		;#; THROW TOALPHABET関数に想定外の数字({NUM})が渡された
ENDSELECT

@FROMALPHABET, ALP
#FUNCTION
#DIMS DYNAMIC ALP

;小文字は61～7A 大文字は41～5A

SELECTCASE ENCODETOUNI(ALP)
	CASE 0x61 TO 0x7A
		RETURNF ENCODETOUNI(ALP)-0x61
	CASE 0x41 TO 0x5A
		RETURNF ENCODETOUNI(ALP)-0x41+26
	CASEELSE
		RETURNF -1
		;#; THROW FROMALPHABET関数に想定外の文字(%ALP%)が渡された
ENDSELECT

@HP自然回復, TARGETID, 回復量 = 1
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC TARGETID
#DIM DYNAMIC 回復量

FOR LCOUNT, 0, 回復量
	CFLAGRL:TARGETID:HP回復計算 += CFLAGRL:TARGETID:MAXHP
NEXT
CFLAGRL:TARGETID:HP += CFLAGRL:TARGETID:HP回復計算/100
CFLAGRL:TARGETID:HP回復計算 %= 100

SIF CFLAGRL:TARGETID:HP > CFLAGRL:TARGETID:MAXHP
	CFLAGRL:TARGETID:HP = CFLAGRL:TARGETID:MAXHP

;;;テンキー1～9に対応した移動先の座標を取得
@進行座標, NUM
#DIM DYNAMIC NUM

SELECTCASE NUM
	CASE 7
		RETURN PL:XPOS-1, PL:YPOS-1
	CASE 8
		RETURN PL:XPOS, PL:YPOS-1
	CASE 9
		RETURN PL:XPOS+1, PL:YPOS-1
	CASE 4
		RETURN PL:XPOS-1, PL:YPOS
	CASE 5
		RETURN PL:XPOS, PL:YPOS
	CASE 6
		RETURN PL:XPOS+1, PL:YPOS
	CASE 1
		RETURN PL:XPOS-1, PL:YPOS+1
	CASE 2
		RETURN PL:XPOS, PL:YPOS+1
	CASE 3
		RETURN PL:XPOS+1, PL:YPOS+1
ENDSELECT

RETURN 0

;;;テンキー1～9に対応した視界内直線のNPC座標、距離を取得
@直線NPC座標, NUM
#DIM DYNAMIC NUM
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS

SELECTCASE NUM
	CASE 7
		FOR LCOUNT, 1, 10
			X_POS = PL:XPOS-LCOUNT
			Y_POS = PL:YPOS-LCOUNT
			SIF NPC判定(X_POS, Y_POS) && PL_VISIBLE:X_POS:Y_POS
				RETURN X_POS, Y_POS, LCOUNT
		NEXT
		RETURN -1
	CASE 8
		FOR LCOUNT, 1, 10
			X_POS = PL:XPOS
			Y_POS = PL:YPOS-LCOUNT
			SIF NPC判定(X_POS, Y_POS) && PL_VISIBLE:X_POS:Y_POS
				RETURN X_POS, Y_POS, LCOUNT
		NEXT
		RETURN -1
	CASE 9
		FOR LCOUNT, 1, 10
			X_POS = PL:XPOS+LCOUNT
			Y_POS = PL:YPOS-LCOUNT
			SIF NPC判定(X_POS, Y_POS) && PL_VISIBLE:X_POS:Y_POS
				RETURN X_POS, Y_POS, LCOUNT
		NEXT
		RETURN -1
	CASE 4
		FOR LCOUNT, 1, 10
			X_POS = PL:XPOS-LCOUNT
			Y_POS = PL:YPOS
			SIF NPC判定(X_POS, Y_POS) && PL_VISIBLE:X_POS:Y_POS
				RETURN X_POS, Y_POS, LCOUNT
		NEXT
		RETURN -1
	;？
	CASE 5
		RETURN 0
	CASE 6
		FOR LCOUNT, 1, 10
			X_POS = PL:XPOS+LCOUNT
			Y_POS = PL:YPOS
			SIF NPC判定(X_POS, Y_POS) && PL_VISIBLE:X_POS:Y_POS
				RETURN X_POS, Y_POS, LCOUNT
		NEXT
		RETURN -1
	CASE 1
		FOR LCOUNT, 1, 10
			X_POS = PL:XPOS-LCOUNT
			Y_POS = PL:YPOS+LCOUNT
			SIF NPC判定(X_POS, Y_POS) && PL_VISIBLE:X_POS:Y_POS
				RETURN X_POS, Y_POS, LCOUNT
		NEXT
		RETURN -1
	CASE 2
		FOR LCOUNT, 1, 10
			X_POS = PL:XPOS
			Y_POS = PL:YPOS+LCOUNT
			SIF NPC判定(X_POS, Y_POS) && PL_VISIBLE:X_POS:Y_POS
				RETURN X_POS, Y_POS, LCOUNT
		NEXT
		RETURN -1
	CASE 3
		FOR LCOUNT, 1, 10
			X_POS = PL:XPOS+LCOUNT
			Y_POS = PL:YPOS+LCOUNT
			SIF NPC判定(X_POS, Y_POS) && PL_VISIBLE:X_POS:Y_POS
				RETURN X_POS, Y_POS, LCOUNT
		NEXT
		RETURN -1
ENDSELECT

RETURN 0

