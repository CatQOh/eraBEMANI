@階段判定
#FUNCTION

SIF PL:XPOS == STAIR:XPOS && PL:YPOS == STAIR:YPOS
	RETURNF 1

RETURNF 0

@壁判定, X_POS, Y_POS
#FUNCTION
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS

SIF !INRANGE(X_POS, 0, RLMAP広さ-1) || !INRANGE(Y_POS, 0, RLMAP広さ-1)
	RETURNF 1

SIF GROUPMATCH(RLMAP:X_POS:Y_POS, 0, 3)
	RETURNF 1

RETURNF 0

;;;中立は判定に含めるか否か
@敵判定, X_POS, Y_POS
#FUNCTION
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS

SIF !INRANGE(X_POS, 0, RLMAP広さ-1) || !INRANGE(Y_POS, 0, RLMAP広さ-1)
	RETURNF 0

SIF RLMAP_ENEMY:X_POS:Y_POS > 0 && CSTRRL:(RLMAP_ENEMY:X_POS:Y_POS):行動パターン != "中立"
	RETURNF RLMAP_ENEMY:X_POS:Y_POS

RETURNF 0

@中立判定, X_POS, Y_POS
#FUNCTION
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS

SIF !INRANGE(X_POS, 0, RLMAP広さ-1) || !INRANGE(Y_POS, 0, RLMAP広さ-1)
	RETURNF 0

SIF RLMAP_ENEMY:X_POS:Y_POS > 0 && CSTRRL:(RLMAP_ENEMY:X_POS:Y_POS):行動パターン == "中立"
	RETURNF RLMAP_ENEMY:X_POS:Y_POS

RETURNF 0

@RLスキル, ID, 対象スキル
#FUNCTION
#DIM DYNAMIC ID
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC 対象スキル
#DIMS DYNAMIC スキル名, 100
#DIMS DYNAMIC スキル分割, 2

SPLIT CSTRRL:ID:スキル, "/", スキル名

FOR LCOUNT, 0, VARSIZE("スキル名")
	SPLIT スキル名:LCOUNT, "*", スキル分割
	IF スキル分割:0 == 対象スキル
		IF スキル分割:1 != ""
			;#; SIF !ISNUMERIC(スキル分割:1)
			;#;	 THROW スキル文法ミス %NAME:ID% %スキル名:LCOUNT%
			RETURNF TOINT(スキル分割:1)
		ELSE
			RETURNF 1
		ENDIF
	ENDIF
NEXT

RETURNF 0

@通路判定, X_POS, Y_POS
#FUNCTION
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS
#DIM DYNAMIC 空きマス数

SIF GROUPMATCH(RLMAP:(X_POS-1):(Y_POS-1), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS):(Y_POS-1), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS+1):(Y_POS-1), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS-1):(Y_POS), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS+1):(Y_POS), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS-1):(Y_POS+1), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS):(Y_POS+1), 1, 2)
	空きマス数++
SIF GROUPMATCH(RLMAP:(X_POS+1):(Y_POS+1), 1, 2)
	空きマス数++

SIF 空きマス数 <= 2
	RETURNF 1

RETURNF 0

@TOALPHABET, NUM
#FUNCTIONS
#DIM DYNAMIC NUM

;小文字は61～7A 大文字は41～5A

SELECTCASE NUM
	CASE 0 TO 25
		RETURNF UNICODE(0x61+NUM)
	CASE 26 TO 51
		RETURNF UNICODE(0x41+NUM)
	CASEELSE
		;#; THROW TOALPHABET関数に想定外の数字({NUM})が渡された
ENDSELECT

@FROMALPHABET, ALP
#FUNCTION
#DIMS DYNAMIC ALP

;小文字は61～7A 大文字は41～5A

SELECTCASE ENCODETOUNI(ALP)
	CASE 0x61 TO 0x7A
		RETURNF ENCODETOUNI(ALP)-0x61
	CASE 0x41 TO 0x5A
		RETURNF ENCODETOUNI(ALP)-0x41+26
	CASEELSE
		;#; THROW FROMALPHABET関数に想定外の文字(%ALP%)が渡された
ENDSELECT
