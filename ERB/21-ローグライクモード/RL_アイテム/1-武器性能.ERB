@武器性能, 武器名
#FUNCTION
#DIMS DYNAMIC 武器名

VARSET RLITEMSPEC

SELECTCASE 武器名
	CASE "刀"
		RLITEMSPEC:分類 = 刀剣
		RLITEMSPEC:ダイスロール = 2d10
		RLITEMSPEC:命中率 = 80
		RLITEMSPEC:使用回数 = 8
		RLITEMSPEC:重さ = 3
		RLITEMSPEC:アイテムスキル = 
		RLITEMSPEC:レア度 = 2
		RLITEMSPEC:説明 = 切れ味の良いオーソドックスな刀
	CASE "忍者刀"
		RLITEMSPEC:分類 = 短剣
		RLITEMSPEC:ダイスロール = 2d8
		RLITEMSPEC:命中率 = 90
		RLITEMSPEC:使用回数 = 6
		RLITEMSPEC:重さ = 2
		RLITEMSPEC:アイテムスキル = バックスタブ*1
		RLITEMSPEC:レア度 = 2
		RLITEMSPEC:説明 = 忍者が使う高品質な短剣。急所を攻撃すれば大ダメージが狙える
	CASE "ピストル"
		RLITEMSPEC:分類 = ハンドガン
		RLITEMSPEC:ダイスロール = 1d10
		RLITEMSPEC:命中率 = 70
		RLITEMSPEC:使用回数 = 12
		RLITEMSPEC:重さ = 3
		RLITEMSPEC:アイテムスキル = 
		RLITEMSPEC:レア度 = 2
		RLITEMSPEC:説明 = 一般的なハンドガン。軽いが威力は低い
	CASE "ライフル"
		RLITEMSPEC:分類 = ライフル
		RLITEMSPEC:ダイスロール = 1d16
		RLITEMSPEC:命中率 = 90
		RLITEMSPEC:使用回数 = 10
		RLITEMSPEC:重さ = 6
		RLITEMSPEC:アイテムスキル = 
		RLITEMSPEC:レア度 = 3
		RLITEMSPEC:説明 = 一般的なライフル。命中率も威力も高いが重い
	CASE "マシンガン"
		RLITEMSPEC:分類 = マシンガン
		RLITEMSPEC:ダイスロール = 1d8
		RLITEMSPEC:命中率 = 50
		RLITEMSPEC:使用回数 = 30
