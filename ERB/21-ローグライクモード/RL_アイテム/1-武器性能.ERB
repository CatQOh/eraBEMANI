@武器スキル説明, スキル名
#FUNCTIONS
#DIMS DYNAMIC スキル名

SELECTCASE スキル名
	CASE "バックスタブ"
		RETURNF "盲目状態、石化状態、魅了状態の敵にダメージ2倍 レベル2で3倍、レベル3で4倍"
	CASE "連射"
		RETURNF "射撃時に追加の弾を発射する レベルごとに+1"
ENDSELECT

@武器種逆引き, 武器名
#FUNCTIONS
#DIMS DYNAMIC 武器名

CALLF 武器性能, 武器名
SIF RLITEMSPEC:分類 == ""
	CALLF アイテム性能, 武器名

RETURNF RLITEMSPEC:分類


@近接遠距離逆引き, 武器名
#FUNCTIONS
#DIMS DYNAMIC 武器名

SELECTCASE 武器種逆引き(武器名)
	CASE "刀剣", "短剣", "鈍器"
		RETURNF "近接武器"
	CASE "ハンドガン", "ライフル", "マシンガン", "ショットガン", "弓", "重火器", "投擲"
		RETURNF "遠距離武器"
ENDSELECT
