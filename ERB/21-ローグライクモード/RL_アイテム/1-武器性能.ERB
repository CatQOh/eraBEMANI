@武器性能, 武器名
#DIMS DYNAMIC 武器名
#DIMS DYNAMIC 武器分類
#DIMS DYNAMIC ダイスロール
#DIMS DYNAMIC 武器説明
#DIM DYNAMIC 命中率
#DIMS DYNAMIC 武器スキル
#DIM DYNAMIC 使用回数
#DIM DYNAMIC 重さ
#DIM DYNAMIC 固定アーティファクト

SELECTCASE 武器名
	CASE "刀"
		武器分類 = 刀剣
		ダイスロール = 2d10
		命中率 = 80
		使用回数 = 8
		重さ = 3
		武器スキル = 
		武器説明 = 切れ味の良いオーソドックスな刀
	CASE "忍者刀"
		武器分類 = 短剣
		ダイスロール = 2d8
		命中率 = 90
		使用回数 = 6
		重さ = 2
		武器スキル = バックスタブ*1
		武器説明 = 忍者が使う高品質な短剣。急所を攻撃すれば大ダメージが狙える
	CASE "ピストル"
		武器分類 = ハンドガン
		ダイスロール = 1d10
		命中率 = 70
		使用回数 = 12
		重さ = 3
		武器スキル = 
		武器説明 = 一般的なハンドガン。軽いが威力は低い
	CASE "ライフル"
		武器分類 = ライフル
		ダイスロール = 1d16
		命中率 = 90
		使用回数 = 10
		重さ = 6
		武器スキル = 
		武器説明 = 一般的なライフル。命中率も威力も高いが重い
	CASE "マシンガン"
		武器分類 = マシンガン
		ダイスロール = 1d8
		命中率 = 50
		使用回数 = 30
		重さ = 10
		武器スキル = 連射*2
		武器説明 = 3連射できるマシンガン。瞬間火力は高いが命中率が低く非常に重い
ENDSELECT

@武器スキル説明, スキル名
#FUNCTIONS
#DIMS DYNAMIC スキル名

SELECTCASE スキル名
	CASE "バックスタブ"
		RETURNF "盲目状態、石化状態、魅了状態の敵にダメージ2倍 レベル2で3倍、レベル3で4倍"
	CASE "連射"
		RETURNF "射撃時に追加の弾を発射する レベルごとに+1"
ENDSELECT
