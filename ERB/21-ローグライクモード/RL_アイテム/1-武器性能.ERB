		RLITEMSPEC:ダイスロール = 2d9
		RLITEMSPEC:命中率 = 80
		RLITEMSPEC:使用回数 = 10
		RLITEMSPEC:重さ = 3
		RLITEMSPEC:アイテムスキル = 
		RLITEMSPEC:レア度 = 2
