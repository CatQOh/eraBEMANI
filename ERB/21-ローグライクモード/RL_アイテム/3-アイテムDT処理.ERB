VARSET 選択可能
表示数 = 0
次ページあり = 0

FOR LCOUNT, 0, 52
	SIF インベントリ:LCOUNT == 0
		CONTINUE
	SELECTCASE RLITEMDT(インベントリ:LCOUNT, "分類")
		CASE "使用アイテム"
			IF INRANGE(表示数, ページ数*20, ページ数*20+20)
				CALL COLUMNPRINTL, 4, @"　[%TOALPHABET(LCOUNT)%] %RLITEMDT(インベントリ:LCOUNT, "アイテム名")%"
				表示数++
			ELSE
				SIF 表示数 > ページ数*20+20
					次ページあり = 1
				表示数++
			ENDIF
			選択可能:LCOUNT = 1
	ENDSELECT
NEXT

CALL COLUMNPRINTL, 4, @"%RETURNSPACE(ページ数 > 0, "[4] 前ページ")% %RETURNSPACE(次ページあり, "[6] 次ページ")%"

CALL RLREDRAW

ONEINPUTS

;IF RESULTS == ">"
;	CALL COLUMNLOGRESET, 4
;	CALL COLUMNBGCOLOR, 4, "0"
;	RETURN 0
;ENDIF

SELECTCASE RESULTS
	CASE "4"
		IF ページ数 > 0
			ページ数--
			RESTART
		ENDIF
	CASE "6"
		IF 次ページあり
			ページ数++
			RESTART
		ENDIF
ENDSELECT

CHOOSE = FROMALPHABET(RESULTS)

IF CHOOSE == -1 || !選択可能:CHOOSE
	CALL COLUMNLOGRESET, 4
	CALL COLUMNBGCOLOR, 4, "0"
	RETURN 0
ENDIF

SELECTCASE RLITEMDT(インベントリ:CHOOSE, "アイテム効果")
	CASE "魔法の地図"
		CALL RLLOG, @"%RLITEMDT(インベントリ:CHOOSE, "アイテム名")%マップが探索済みになった(Xで見れる)"
		VARSET RLMAP_EXPLORED, 1
		CALL COLUMNLOGRESET, 4
		CALL COLUMNBGCOLOR, 4, "0"
		CALL RLREDRAW
		RETURN 1
	CASEELSE
		CALL RLLOG, "未実装です"
		VARSET RLMAP_EXPLORED, 1
		CALL COLUMNLOGRESET, 4
		CALL COLUMNBGCOLOR, 4, "0"
		CALL RLREDRAW
		RETURN 0
ENDSELECT

CALL COLUMNLOGRESET, 4
CALL COLUMNBGCOLOR, 4, "0"

CALL RLREDRAW

RETURN 1

@初期アイテム処理, 対象
#DIM DYNAMIC 対象
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC アイテム名, 100
#DIM DYNAMIC 分割数

SPLIT CSTRRL:対象:初期アイテム, "/", アイテム名

分割数 = RESULT

FOR LCOUNT, 0, 分割数
	CALL アイテム拾得_生成, アイテム名:LCOUNT
NEXT

IF 対象 == PLAYER
	PRINTL □追加で持っていく初期アイテムを選択してください
	IF アイテム名:0 == ""
		PRINTFORML 　%NAME:PLAYER%のデフォルトアイテム
		PRINTL 　　- 無し
		PRINTL 
	ELSE
		PRINTFORML 　- %NAME:PLAYER%のデフォルトアイテム
		FOR LCOUNT, 0, 分割数
			PRINTFORML 　　- %アイテム名:LCOUNT%
		NEXT
		PRINTL 
	ENDIF
	PRINTL 　[0] 刀+おにぎり(サムライ)
	PRINTL 　[1] バール+おにぎり(撲殺天使)
	PRINTL 　[2] ライフル+おにぎり(スナイパー)
	PRINTL 　[3] マシンガン+おにぎり(コマンドー)
	PRINTL 　[4] 弓+おにぎり(アーチャー)
	PRINTL 　[5] ピストル+ナイフ+おにぎり(兵士)
	PRINTL 　[6] ラーメン+おにぎり+バナナ(ランチセット)
	BINPUT
	SELECTCASE RESULT
		CASE 0
			CALL アイテム拾得_生成, "刀"
		CASE 1
			CALL アイテム拾得_生成, "バール"
		CASE 2
			CALL アイテム拾得_生成, "ライフル"
		CASE 3
			CALL アイテム拾得_生成, "マシンガン"
		CASE 4
			CALL アイテム拾得_生成, "弓"
		CASE 5
			CALL アイテム拾得_生成, "ピストル"
			CALL アイテム拾得_生成, "ナイフ"
		CASE 6
			CALL アイテム拾得_生成, "ラーメン"
			CALL アイテム拾得_生成, "バナナ"
	ENDSELECT
	CALL アイテム拾得_生成, "おにぎり"
ENDIF
