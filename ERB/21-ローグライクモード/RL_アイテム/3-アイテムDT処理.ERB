@RLアイテム生成
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC アイテム名
#DIM DYNAMIC RETURNID

アイテム名 = %RLWEAPON:(RAND:VARSIZE("RLWEAPON"))%

CALLF 武器性能, アイテム名

RETURNID = DT_ROW_ADD("RLITEMLIST")

DT_CELL_SET "RLITEMLIST", DT_ROW_LENGTH("RLITEMLIST")-1, "アイテム名", アイテム名

;アイテム名は上で処理してるので1から始める
FOR LCOUNT, 1, VARSIZE("RLITEMSPEC")
	IF ISNUMERIC(RLITEMSPEC:LCOUNT)
		DT_CELL_SET "RLITEMLIST", DT_ROW_LENGTH("RLITEMLIST")-1, ERDNAME(RLITEMSPEC, LCOUNT), TOINT(RLITEMSPEC:LCOUNT)
	ELSE
		DT_CELL_SET "RLITEMLIST", DT_ROW_LENGTH("RLITEMLIST")-1, ERDNAME(RLITEMSPEC, LCOUNT), RLITEMSPEC:LCOUNT
	ENDIF
NEXT

RETURN RETURNID

@RLITEMDT, ROWID, COLUMNNAME
#FUNCTIONS
#DIM DYNAMIC ROWID
#DIMS DYNAMIC COLUMNNAME

SELECTCASE DT_COLUMN_EXIST("RLITEMLIST", COLUMNNAME)
	CASE 5
		RETURNF DT_CELL_GETS("RLITEMLIST", ROWID, COLUMNNAME, 1)
	CASEELSE
		RETURNF TOSTR(DT_CELL_GET("RLITEMLIST", ROWID, COLUMNNAME, 1))
ENDSELECT

@アイテム拾得, X_POS, Y_POS
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS

インベントリ:FINDELEMENT(インベントリ, 0) = RLMAP_ITEM:X_POS:Y_POS

CALL RLLOG, @"%RLITEMDT(RLMAP_ITEM:X_POS:Y_POS, "アイテム名")%を拾った"

RLMAP_ITEM:X_POS:Y_POS = 0

@インベントリ一覧
#DIM DYNAMIC LCOUNT

CALL COLUMNBGCOLOR, 4, "darkolivegreen"

CALL COLUMNPRINTL, 4, "□インベントリ一覧"

FOR LCOUNT, 0, 52
	SIF インベントリ:LCOUNT == 0
		BREAK
	CALL COLUMNPRINTL, 4, @"　[%TOALPHABET(LCOUNT)%] %RLITEMDT(インベントリ:LCOUNT, "アイテム名")%"
NEXT

CALL RLREDRAW

ONEINPUTS

CALL COLUMNLOGRESET, 4
CALL COLUMNBGCOLOR, 4, "0"

@近接武器一覧
#DIM DYNAMIC LCOUNT

CALL COLUMNBGCOLOR, 4, "darkolivegreen"

CALL COLUMNPRINTL, 4, "□近接武器一覧"

FOR LCOUNT, 0, 52
	SIF インベントリ:LCOUNT == 0
		BREAK
	SELECTCASE RLITEMDT(インベントリ:LCOUNT, "分類")
		CASE "刀剣", "短剣", "鈍器"
			CALL COLUMNPRINTL, 4, @"　[%TOALPHABET(LCOUNT)%] %RLITEMDT(インベントリ:LCOUNT, "アイテム名")%"
	ENDSELECT
NEXT

CALL RLREDRAW

