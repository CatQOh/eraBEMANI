@RLアイテム生成
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC アイテム名
#DIM DYNAMIC RETURNID

IF RAND:2 == 0
	アイテム名 = %RLWEAPON:(RAND:VARSIZE("RLWEAPON"))%
ELSE
	アイテム名 = %RLITEM:(RAND:VARSIZE("RLITEM"))%
ENDIF

CALLF 武器性能, アイテム名
SIF RLITEMSPEC:分類 == ""
	CALLF アイテム性能, アイテム名

;#;SIF RLITEMSPEC:分類 == ""
;#; THROW %アイテム名%の性能定義無し

SIF RLITEMSPEC:ドロップ専用 == "1"
	RESTART

RETURNID = DT_ROW_ADD("RLITEMLIST")

DT_CELL_SET "RLITEMLIST", DT_ROW_LENGTH("RLITEMLIST")-1, "アイテム名", アイテム名

;アイテム名は上で処理してるので1から始める
FOR LCOUNT, 1, VARSIZE("RLITEMSPEC")
	IF ISNUMERIC(RLITEMSPEC:LCOUNT)
		DT_CELL_SET "RLITEMLIST", DT_ROW_LENGTH("RLITEMLIST")-1, ERDNAME(RLITEMSPEC, LCOUNT), TOINT(RLITEMSPEC:LCOUNT)
	ELSE
		DT_CELL_SET "RLITEMLIST", DT_ROW_LENGTH("RLITEMLIST")-1, ERDNAME(RLITEMSPEC, LCOUNT), RLITEMSPEC:LCOUNT
	ENDIF
NEXT

RETURN RETURNID

@RLITEMDT, ROWID, COLUMNNAME
#FUNCTIONS
#DIM DYNAMIC ROWID
#DIMS DYNAMIC COLUMNNAME

SELECTCASE DT_COLUMN_EXIST("RLITEMLIST", COLUMNNAME)
	CASE 5
		RETURNF DT_CELL_GETS("RLITEMLIST", ROWID, COLUMNNAME, 1)
	CASEELSE
		RETURNF TOSTR(DT_CELL_GET("RLITEMLIST", ROWID, COLUMNNAME, 1))
ENDSELECT

@アイテム拾得, X_POS, Y_POS
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS

インベントリ:FINDELEMENT(インベントリ, 0) = RLMAP_ITEM:X_POS:Y_POS

CALL RLLOG, @"%RLITEMDT(RLMAP_ITEM:X_POS:Y_POS, "アイテム名")%を拾った"

RLMAP_ITEM:X_POS:Y_POS = 0

@アイテム拾得_生成, アイテム名
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC アイテム名
#DIM DYNAMIC RETURNID

CALLF 武器性能, アイテム名
SIF RLITEMSPEC:分類 == ""
	CALLF アイテム性能, アイテム名

;#;SIF RLITEMSPEC:分類 == ""
;#; THROW %アイテム名%の性能定義無し

RETURNID = DT_ROW_ADD("RLITEMLIST")

DT_CELL_SET "RLITEMLIST", DT_ROW_LENGTH("RLITEMLIST")-1, "アイテム名", アイテム名

;アイテム名は上で処理してるので1から始める
FOR LCOUNT, 1, VARSIZE("RLITEMSPEC")
	IF ISNUMERIC(RLITEMSPEC:LCOUNT)
		DT_CELL_SET "RLITEMLIST", DT_ROW_LENGTH("RLITEMLIST")-1, ERDNAME(RLITEMSPEC, LCOUNT), TOINT(RLITEMSPEC:LCOUNT)
	ELSE
		DT_CELL_SET "RLITEMLIST", DT_ROW_LENGTH("RLITEMLIST")-1, ERDNAME(RLITEMSPEC, LCOUNT), RLITEMSPEC:LCOUNT
	ENDIF
NEXT

インベントリ:FINDELEMENT(インベントリ, 0) = RETURNID

@インベントリ一覧
#DIM DYNAMIC LCOUNT

CALL COLUMNBGCOLOR, 4, "darkolivegreen"

CALL COLUMNPRINTL, 4, "□インベントリ一覧 [>] 戻る"

FOR LCOUNT, 0, 52
	SIF インベントリ:LCOUNT == 0
		BREAK
	CALL COLUMNPRINTL, 4, @"　[%TOALPHABET(LCOUNT)%] %RLITEMDT(インベントリ:LCOUNT, "アイテム名")%"
NEXT

CALL RLREDRAW

ONEBINPUTS

IF RESULTS == ">"
	CALL COLUMNLOGRESET, 4
	CALL COLUMNBGCOLOR, 4, "0"
	RETURN 0
ENDIF

CALL COLUMNLOGRESET, 4
CALL COLUMNBGCOLOR, 4, "0"

@近接武器一覧
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC CHOOSE
#DIM DYNAMIC ATTACK_X
#DIM DYNAMIC ATTACK_Y
#DIM DYNAMIC 攻撃方向

CALL COLUMNBGCOLOR, 4, "darkolivegreen"

CALL COLUMNPRINTL, 4, "□近接武器一覧 [>] 戻る"

FOR LCOUNT, 0, 52
	SIF インベントリ:LCOUNT == 0
		BREAK
	SELECTCASE RLITEMDT(インベントリ:LCOUNT, "分類")
		CASE "刀剣", "短剣", "鈍器"
			CALL COLUMNPRINTL, 4, @"　[%TOALPHABET(LCOUNT)%] %RLITEMDT(インベントリ:LCOUNT, "アイテム名")%(%RLITEMDT(インベントリ:LCOUNT, "ダイスロール")% 残り%RLITEMDT(インベントリ:LCOUNT, "使用回数")%回)"
	ENDSELECT
NEXT

CALL RLREDRAW

ONEBINPUTS

IF RESULTS == ">"
	CALL COLUMNLOGRESET, 4
	CALL COLUMNBGCOLOR, 4, "0"
	RETURN 0
ENDIF

CHOOSE = FROMALPHABET(RESULTS)

CALL RLLOG, @"%RLITEMDT(インベントリ:CHOOSE, "アイテム名")%でどこを攻撃する？(テンキーで入力)"

CALL COLUMNLOGRESET, 4
CALL COLUMNBGCOLOR, 4, "0"

CALL RLREDRAW

ONEINPUT

CALL 進行座標, RESULT

IF RESULT == 0
	CALL RLLOG, "無効な入力です"
	RETURN 0
ENDIF

ATTACK_X = RESULT
ATTACK_Y = RESULT:1

IF 敵判定(ATTACK_X, ATTACK_Y)
	CALL RL攻撃, PLAYER, 敵判定(ATTACK_X, ATTACK_Y), インベントリ:CHOOSE
ELSEIF 中立判定(ATTACK_X, ATTACK_Y)
	CALL RLLOG, @"%CALLNAME:中立判定(ATTACK_X, ATTACK_Y)%は攻撃したら敵対するだろう 本当に攻撃する？ [y] Yes [n] No"
	CALL RLREDRAW
	ONEINPUTS
	SELECTCASE RESULTS
		CASE "y", "Y"
			CSTRRL:中立判定(ATTACK_X, ATTACK_Y):行動パターン = 近接攻撃
			CALL RL攻撃, PLAYER, 敵判定(ATTACK_X, ATTACK_Y), インベントリ:CHOOSE
			SIF 敵判定(ATTACK_X, ATTACK_Y)
				CALL RLLOG, @"%CALLNAME:敵判定(ATTACK_X, ATTACK_Y)%は逆上した！"
		CASEELSE
			CALL RLLOG, "攻撃を中断した"
			RETURN 0
	ENDSELECT
ELSE
	CALL RLLOG, "そこには誰も居ない"
	RETURN 0
ENDIF

RETURN 1

