@RLアイテム生成, アイテム名, ドロップ判定
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC アイテム名
#DIM DYNAMIC RETURNID
#DIM DYNAMIC ドロップ判定
#DIM DYNAMIC レア度判定

IF !ドロップ判定
	;5段階 抽選の仕様上高レア度アイテムの生成率は下記の数値より低い
	SELECTCASE RAND:100
		CASE 0 TO 49
			レア度判定 = 1
		CASE 50 TO 74
			レア度判定 = 2
		CASE 75 TO 87
			レア度判定 = 3
		CASE 88 TO 96
			レア度判定 = 4
		CASE 97 TO 99
			レア度判定 = 5
	ENDSELECT

	IF RAND:2 == 0
		アイテム名 = %RLWEAPON:(RAND:VARSIZE("RLWEAPON"))%
	ELSE
		アイテム名 = %RLITEM:(RAND:VARSIZE("RLITEM"))%
	ENDIF
ENDIF

CALLF 武器性能, アイテム名
SIF RLITEMSPEC:分類 == ""
	CALLF アイテム性能, アイテム名

;#;SIF RLITEMSPEC:分類 == ""
;#; THROW %アイテム名%の性能定義無し

SIF RLITEMSPEC:ドロップ専用 == "1" && !ドロップ判定
	RESTART
SIF TOINT(RLITEMSPEC:レア度) > レア度判定 && !ドロップ判定
	RESTART

RETURNID = DT_ROW_ADD("RLITEMLIST")

DT_CELL_SET "RLITEMLIST", DT_ROW_LENGTH("RLITEMLIST")-1, "アイテム名", アイテム名

;アイテム名は上で処理してるので1から始める
FOR LCOUNT, 1, VARSIZE("RLITEMSPEC")
	IF ISNUMERIC(RLITEMSPEC:LCOUNT)
		DT_CELL_SET "RLITEMLIST", DT_ROW_LENGTH("RLITEMLIST")-1, ERDNAME(RLITEMSPEC, LCOUNT), TOINT(RLITEMSPEC:LCOUNT)
	ELSE
		DT_CELL_SET "RLITEMLIST", DT_ROW_LENGTH("RLITEMLIST")-1, ERDNAME(RLITEMSPEC, LCOUNT), RLITEMSPEC:LCOUNT
	ENDIF
NEXT

RETURN RETURNID

@RLITEMDT, ROWID, COLUMNNAME
#FUNCTIONS
#DIM DYNAMIC ROWID
#DIMS DYNAMIC COLUMNNAME

SELECTCASE DT_COLUMN_EXIST("RLITEMLIST", COLUMNNAME)
	CASE 5
		RETURNF DT_CELL_GETS("RLITEMLIST", ROWID, COLUMNNAME, 1)
	CASEELSE
		RETURNF TOSTR(DT_CELL_GET("RLITEMLIST", ROWID, COLUMNNAME, 1))
ENDSELECT

@アイテム拾得, X_POS, Y_POS
#DIM DYNAMIC X_POS
#DIM DYNAMIC Y_POS
#DIM DYNAMIC 空きインベントリ

空きインベントリ = FINDELEMENT(インベントリ, 0)

IF RLMAP_ITEM:X_POS:Y_POS == 0
	CALL RLLOG, "空気を拾った"
	RETURN 0
ENDIF

IF 空きインベントリ == -1
	CALL RLLOG, "これ以上アイテムを持てない"
	RETURN 0
ENDIF

インベントリ:FINDELEMENT(インベントリ, 0) = RLMAP_ITEM:X_POS:Y_POS

CALL RLLOG, @"%RLITEMDT(RLMAP_ITEM:X_POS:Y_POS, "アイテム名")%を拾った(%TOALPHABET(空きインベントリ)%)"

RLMAP_ITEM:X_POS:Y_POS = 0

RETURN 1

@アイテム拾得_生成, アイテム名
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC アイテム名
#DIM DYNAMIC RETURNID

CALLF 武器性能, アイテム名
SIF RLITEMSPEC:分類 == ""
	CALLF アイテム性能, アイテム名

;#;SIF RLITEMSPEC:分類 == ""
;#; THROW %アイテム名%の性能定義無し

RETURNID = DT_ROW_ADD("RLITEMLIST")

DT_CELL_SET "RLITEMLIST", DT_ROW_LENGTH("RLITEMLIST")-1, "アイテム名", アイテム名

