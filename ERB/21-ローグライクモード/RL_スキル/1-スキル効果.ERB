@スキル効果, スキル名
#FUNCTIONS
#DIMS DYNAMIC スキル名

SELECTCASE スキル名
	CASE "格闘"
		RETURNF "格闘攻撃のダイスが増える レベルごとに1増加"
	CASE "剣術"
		RETURNF "刀剣武器によりダイス面がレベルごとに4増加"
	CASE "精密射撃（ライフル）"
		RETURNF "ライフルの命中率がレベルごとに10%増加 ダイス面がレベルごとに2増加"
	CASE "早撃ち（ライフル）"
		RETURNF "ライフルで追加射撃を行うことがある レベルごとに25%の確率"
	CASE "霊力"
		RETURNF "霊体へのダメージ2倍"
	CASE "封印魔法"
		RETURNF "敵の魔法を封じる魔法攻撃を使える"
	CASE "投擲"
		RETURNF "アイテム当適時の命中率がレベルごとに10%増加 ダイス面がレベルごとに2増加"
	CASE "頑丈"
		RETURNF "レベルごとにダメージを2軽減 1未満にはならない"
	CASE ""
		RETURNF ""
ENDSELECT
