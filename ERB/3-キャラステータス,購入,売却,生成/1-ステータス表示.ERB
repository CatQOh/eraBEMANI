#DIM DYNAMIC 前のキャラ = -1
#DIMS DYNAMIC 呼び方
;#DIM DYNAMIC ロストキャラ表示

;処女が主人のドラゴンとなっている場合は、現在のドラゴンの名前を入れて後で戻す
IF CSTR:処女 == "主人のドラゴン"
	CSTR:処女 = %CSTR:MASTER:ドラゴン%
	ドラゴンに処女:0 = 1
ENDIF
IF CSTR:性転換処女 == "主人のドラゴン"
	CSTR:性転換処女 = %CSTR:MASTER:ドラゴン%
	ドラゴンに処女:1 = 1
ENDIF

CALL 基本情報

;IF ORIGIN || マニュアル表示
IF INRANGE(NOF(TARGET), 1, 9999)
	CALL MCOLUMNDRAWLINE
	CALL MCOLUMNPRINTL, @"□%I18N("キャラマニュアル")%"
	FOR LCOUNT, 0, 100
		SIF CSTR:LCOUNT == ""
			BREAK
		CALL MANUALPRINT, @"　%CSTR:LCOUNT%", 1
		SIF COLUMNLOG:0:(COLUMN:0:LINE) != ""
			CALL MCOLUMNPRINTL, ""
	NEXT
	CALL MCOLUMNPRINTL, @"　%I18N("登場作品")%：「%CSTR:登場作品%」\@ CSTR:登場作品２ != "" ? 「%CSTR:登場作品２%」 #\@\@ CSTR:登場作品３ != "" ? 「%CSTR:登場作品３%」 #\@", "", 1
	CALL MCOLUMNDRAWLINE
	CALL MCOLUMNPRINT, @"□%I18N("担当楽曲・出演曲")%"
	SIF TFLAG:担当曲非表示 == -1
		TFLAG:担当曲非表示 = STRLENS(CSVCSTRF(NOF(TARGET), "担当曲")) > 1000 ? 1 # 0
	IF TFLAG:担当曲非表示
		CALL MCOLUMNPRINTL, @"　[100]%I18N("表示する")%"
	ELSE
		CALL MCOLUMNPRINTL, @"　[100]%I18N("非表示にする")%"
		CALL 担当曲表示, NOF(TARGET), 1
	ENDIF
ENDIF
;ENDIF
IF CFLAG:キャラロスト
	CALL MCOLUMNDRAWLINE
	CALL CHECKDRAWLINE
	PRINTFORML □%I18N("キャラロストの原因")%
	CALL PASELIL, @"　%CSTR:ロスト詳細%"
ENDIF

CALL MCOLUMNDRAWLINE

CALL MCOLUMNPRINTL, @"□ %I18N("その他情報")%"
IF パートナー != "" && パートナー == CHARANAMEF(TARGET)
	IF LANGUAGE == "ENG"
		CALL MCOLUMNPRINTL, @"　Became %CALLNAME:MASTER%`s parter on %ゲーム開始日()%"
	ELSE
		CALL MCOLUMNPRINTL, @"　%ゲーム開始日()%に%CALLNAME:MASTER%のパートナーになった"
	ENDIF
ELSEIF ゲームモード() == "新婚モード"
	IF NOF(TARGET) >= 10000
		IF LANGUAGE == "ENG"
			SELECTCASE SEX(TARGET)
				CASE 0
					呼び方 = child
				CASE 1
					呼び方 = son
				CASE 2
					呼び方 = daughter
			ENDSELECT
			CALL MCOLUMNPRINTL, @"　A %呼び方% was born \@ CFLAG:近親交配 ? with inbreeding # in between \@ %CSVNAMEF(CFLAG:血縁コード/100000)% and %CSVNAMEF(CFLAG:血縁コード%100000)%"
		ELSE
			SELECTCASE SEX(TARGET)
				CASE 0
					呼び方 = 子
				CASE 1
					呼び方 = 息子
				CASE 2
					呼び方 = 娘
			ENDSELECT
			CALL MCOLUMNPRINTL, @"　%CSVNAMEF(CFLAG:血縁コード/100000)%と%CSVNAMEF(CFLAG:血縁コード%100000)%の\@ CFLAG:近親交配 ? 近親交配で # 間に \@産まれた%呼び方%だ"
		ENDIF
	ELSEIF FINDCHARA(CFLAG:嫁, 1) >= 0
		IF LANGUAGE == "ENG"
			IF TARGET == MASTER
				CALL MCOLUMNPRINTL, @"　%ゲーム開始日()% is married to %CALLNAME:FINDCHARA(CFLAG:嫁, 1)%"
			ELSE
				CALL MCOLUMNPRINTL, @"　%ゲーム開始日()% is married to %CALLNAME:MASTER%"
			ENDIF
		ELSE
			IF TARGET == MASTER
				CALL MCOLUMNPRINTL, @"　%ゲーム開始日()%に%CALLNAME:FINDCHARA(CFLAG:嫁, 1)%と結婚した"
			ELSE
				CALL MCOLUMNPRINTL, @"　%ゲーム開始日()%に%CALLNAME:MASTER%と結婚した"
			ENDIF
		ENDIF
	ENDIF
ELSE
	IF TARGET == MASTER
		IF LANGUAGE == "ENG"
			CALL MCOLUMNPRINTL, @"　Got lost in this world in %ゲーム開始日()%"
			CALL MCOLUMNPRINTL, @"　Currently trainer with {CHARANUM-1} slaves."
			SIF FLAG:周回数 >= 2
				CALL MCOLUMNPRINTL, @"　Total {FLAG:周回数} time when enjoying with %CALLNAME:MASTER% in this world"
			SIF FLAG:累計恋慕
				CALL MCOLUMNPRINTL, @"　Fallen in love {FLAG:累計恋慕} times with %HIM_HER(MASTER)%"
			SIF FLAG:累計淫乱
				CALL MCOLUMNPRINTL, @"　Fallen in lust {FLAG:累計淫乱} times with %HIM_HER(MASTER)%"
			SIF FLAG:累計服従
				CALL MCOLUMNPRINTL, @"　submited %HIMSELF_HERSELF(TARGET)% to %CALLNAME:MASTER% {FLAG:累計服従} times"
		ELSE
			CALL MCOLUMNPRINTL, @"　%ゲーム開始日()%にこの世界へと迷いこむ"
			CALL MCOLUMNPRINTL, @"　現在は{CHARANUM-1}人の奴隷を扱う調教師"
			SIF FLAG:周回数 >= 2
				CALL MCOLUMNPRINTL, @"　{FLAG:周回数}周目のゲームであり、この世界を積極的に楽しんでいる"
			SIF FLAG:累計恋慕
				CALL MCOLUMNPRINTL, @"　累計{FLAG:累計恋慕}人の奴隷の心を奪った"
			SIF FLAG:累計淫乱
				CALL MCOLUMNPRINTL, @"　累計{FLAG:累計淫乱}人の奴隷を肉欲に溺れさせた"
			SIF FLAG:累計服従
				CALL MCOLUMNPRINTL, @"　累計{FLAG:累計服従}人の奴隷が%CALLNAME:MASTER%に服従した"
		ENDIF
	ELSE
		IF NOF(TARGET) == 0
			IF LANGUAGE == "ENG"
				CALL MCOLUMNPRINTL, @"　%HE_SHE(TARGET)% is a weirdo who volunteered to become a slave after hearing that %CALLNAME:MASTER% would be a rookie trainer."
			ELSE
				CALL MCOLUMNPRINTL, @"　%CALLNAME:MASTER%が調教師を始めたと聞いて、自ら奴隷になりたいと志願してきた変人である"
			ENDIF
		ELSEIF NOF(TARGET) >= 10000 && !CFLAG:人工物
		IF LANGUAGE == "ENG"
			SELECTCASE SEX(TARGET)
				CASE 0
					呼び方 = child
				CASE 1
					呼び方 = son
				CASE 2
					呼び方 = daughter
			ENDSELECT
				CALL MCOLUMNPRINTL, @"　A %呼び方% was born \@ CFLAG:近親交配 ? with inbreeding # in between \@ %CSVNAMEF(CFLAG:血縁コード/100000)% and %CSVNAMEF(CFLAG:血縁コード%100000)%"
			ELSE
				SELECTCASE SEX(TARGET)
					CASE 0
						呼び方 = 子
					CASE 1
						呼び方 = 息子
					CASE 2
						呼び方 = 娘
				ENDSELECT
				CALL MCOLUMNPRINTL, @"　%CSVNAMEF(CFLAG:血縁コード/100000)%と%CSVNAMEF(CFLAG:血縁コード%100000)%の\@ CFLAG:近親交配 ? 近親交配で # 間に \@産まれた%呼び方%だ"
			ENDIF
		ELSEIF CFLAG:人工物
			IF LANGUAGE == "ENG"
				CALL MCOLUMNPRINTL, @"　Created in Year{BUYY:0} Month{BUYM:0} Day{BUYD:0}"
			ELSE
				CALL MCOLUMNPRINTL, @"　{BUYY:0}年{BUYM:0}月{BUYD:0}日に作成"
			ENDIF
		ELSEIF TALENT:TARGET:隠しキャラ
			IF LANGUAGE == "ENG"
				CALL MCOLUMNPRINTL, @"　Joins in Year{BUYY:0} Month{BUYM:0} Day{BUYD:0}"
			ELSE
				CALL MCOLUMNPRINTL, @"　{BUYY:0}年{BUYM:0}月{BUYD:0}日に加入"
			ENDIF
		ELSE
			IF LANGUAGE == "ENG"
				CALL MCOLUMNPRINTL, @"　Being bought at Year{BUYY:0} Month{BUYM:0} Day{BUYD:0}"
			ELSE
				CALL MCOLUMNPRINTL, @"　{BUYY:0}年{BUYM:0}月{BUYD:0}日に購入"
			ENDIF
		ENDIF
	ENDIF
ENDIF
IF CFLAG:嫁
	IF LANGUAGE == "ENG"
		CALL MCOLUMNPRINTL, @"　Currently a %CALLNAME:MASTER%`s wife"
	ELSE
		CALL MCOLUMNPRINTL, @"　現在は%CALLNAME:MASTER%の嫁である"
	ENDIF
ELSEIF CFLAG:淫魔
	IF LANGUAGE == "ENG"
		CALL MCOLUMNPRINTL, @"　Currently a %CALLNAME:MASTER%`s familiar."
	ELSE
		CALL MCOLUMNPRINTL, @"　現在は%CALLNAME:MASTER%の使い魔である"
	ENDIF
ELSEIF CFLAG:傀儡
	IF LANGUAGE == "ENG"
		CALL MCOLUMNPRINTL, @"　Currently a puppet under %CALLNAME:MASTER%'s control"
	ELSE
		CALL MCOLUMNPRINTL, @"　現在は%CALLNAME:MASTER%の支配下に置ける傀儡である"
	ENDIF
ENDIF

SIF SEX(TARGET) == 0
	CALL MCOLUMNPRINTL, @"　%I18N("性別は無いようだ")%"

;以下血統の表示
;フラグと性別が合ってない場合は合わせる
IF CFLAG:兄弟 && SEX(TARGET) == 2
	CFLAG:姉妹 = CFLAG:兄弟
	CFLAG:兄弟 = 0
ENDIF
IF CFLAG:姉妹 && SEX(TARGET) == 1
	CFLAG:兄弟 = CFLAG:姉妹
	CFLAG:姉妹 = 0
ENDIF

IF CFLAG:血縁コード && NOF(TARGET) < 10000
	FOR LCOUNT, 0, 10000
		IF EXISTCSV(LCOUNT) && CSVCFLAG(LCOUNT, GETNUM(CFLAG, "血縁コード")) == CFLAG:血縁コード
			続柄記録用 = CSVCFLAG(LCOUNT, GETNUM(CFLAG, "続柄"))
			IF LCOUNT == NOF(TARGET) && 続柄記録用 < 1000
				兄弟姉妹性別:続柄記録用 = SEX(TARGET)
				CONTINUE
			ENDIF
			SELECTCASE 続柄記録用
				;祖父母の場合
				CASE IS >= 2000
					;家族構成:20=祖父 21=祖母
					家族構成:(20+続柄記録用%10) = LCOUNT
				;父母の場合
				CASE IS >= 1000
					;家族構成:10=父 11=母
					家族構成:(10+続柄記録用%10) = LCOUNT
				;兄弟姉妹の場合
				CASEELSE
					家族構成:続柄記録用 = LCOUNT
					兄弟姉妹数++
					SELECTCASE CSVTALENT(LCOUNT, GETNUM(TALENT, "性別"))
						CASE 1
							兄弟姉妹性別:続柄記録用 = 1
						CASE 2
							兄弟姉妹性別:続柄記録用 = 2
					ENDSELECT
			ENDSELECT
			家族人数++
		ENDIF
	NEXT
	
	;子供の場合は家族構成に表示中のキャラも入れる
	IF CFLAG:続柄 < 1000
		家族構成:(CFLAG:続柄) = NOF(TARGET)
		兄弟姉妹数++
	ENDIF
	
	SELECTCASE 家族人数
		CASE 1
			FOR LCOUNT, 0, VARSIZE("家族構成")
				IF 家族構成:LCOUNT != 0
					SIF 家族構成:LCOUNT == NOF(TARGET)
						CONTINUE
					家族番号簡易版 = 家族構成:LCOUNT
					;祖父母の場合
					IF LANGUAGE == "ENG"
						IF CFLAG:続柄 >= 2000
							立場 = \@ SEX(TARGET) == 1 ? grandfather # grandmother \@
						ELSEIF CFLAG:続柄 >= 1000
							立場 = \@ SEX(TARGET) == 1 ? Father # Mother \@
						ELSE
							SELECTCASE LCOUNT
								;祖父母が居る場合
								CASE IS >= 20
									立場 = grandchild
								;父母が居る場合
								CASE IS >= 10
									立場 = \@ SEX(TARGET) == 1 ? son # daughter \@
								CASEELSE
									;兄、姉が居る場合
									IF LCOUNT < CFLAG:続柄
										立場 = \@ SEX(TARGET) == 1 ? younger brother # younger sister \@
									;兄、姉が居る場合
									ELSE
										立場 = \@ SEX(TARGET) == 1 ? older brother # big sister \@
									ENDIF
							ENDSELECT
						ENDIF
					ELSE
						IF CFLAG:続柄 >= 2000
							立場 = \@ SEX(TARGET) == 1 ? 祖父 # 祖母 \@
						ELSEIF CFLAG:続柄 >= 1000
							立場 = \@ SEX(TARGET) == 1 ? 父親 # 母親 \@
						ELSE
							SELECTCASE LCOUNT
								;祖父母が居る場合
								CASE IS >= 20
									立場 = 孫
								;父母が居る場合
								CASE IS >= 10
									立場 = \@ SEX(TARGET) == 1 ? 息子 # 娘 \@
								CASEELSE
									;兄、姉が居る場合
									IF LCOUNT < CFLAG:続柄
										立場 = \@ SEX(TARGET) == 1 ? 弟 # 妹 \@
									;兄、姉が居る場合
									ELSE
										立場 = \@ SEX(TARGET) == 1 ? 兄 # 姉 \@
									ENDIF
							ENDSELECT
						ENDIF
					ENDIF
					BREAK
				ENDIF
			NEXT
			IF LANGUAGE == "ENG"
				CALL MCOLUMNPRINTL, @"　Corresponds to %CSVNAME(家族番号簡易版)%/'s %立場%"
			ELSE
				CALL MCOLUMNPRINTL, @"　%CSVNAME(家族番号簡易版)%の%立場%にあたる"
			ENDIF
		CASE IS >= 2
			;家族の中で最高齢の人、もしくは兄弟姉妹の一番下を探す
			FOR LCOUNT, 29, -1, -1
				IF 家族構成:LCOUNT != 0
					尊属 = LCOUNT
					BREAK
				ENDIF
			NEXT
			;3人以上の兄弟姉妹なら兄弟姉妹の表記を考える
			IF 兄弟姉妹数 >= 3
				;今のところ3兄弟、3姉妹までなのでそれにだけ対応
				;ちなみにCONV_NOは英数字→漢数字変換関数
				立場 = %CONV_NO(兄弟姉妹数)%
				SELECTCASE 兄弟姉妹性別:1
					;一番上がお兄ちゃん
					CASE 1
						IF LANGUAGE == "ENG"
							立場 += "Older brother"
							;妹が入れば「兄妹」いなければ「兄弟」
							IF MATCH(兄弟姉妹性別, 2)
								立場 += "Younger sister"
							ELSE
								立場 += "Younger brother"
							ENDIF
						ELSE
							立場 += "兄"
							;妹が入れば「兄妹」いなければ「兄弟」
							IF MATCH(兄弟姉妹性別, 2)
								立場 += "妹"
							ELSE
								立場 += "弟"
							ENDIF
						ENDIF
					;一番上がお姉ちゃん
					CASE 2
						IF LANGUAGE == "ENG"
							立場 += "sister"
							;妹が入れば「姉妹」いなければ「姉弟」
							IF MATCH(兄弟姉妹性別, 2)
								立場 += "younger sister"
							ELSE
								立場 += "younger brother"
							ENDIF
						ELSE
							立場 += "姉"
							;妹が入れば「姉妹」いなければ「姉弟」
							IF MATCH(兄弟姉妹性別, 2)
								立場 += "妹"
							ELSE
								立場 += "弟"
							ENDIF
						ENDIF
				ENDSELECT
				IF LANGUAGE == "ENG"
					立場 += @"/'s {CFLAG:続柄} number、"
				ELSE
					立場 += @"の{CFLAG:続柄}番目であり、"
				ENDIF
				SELECTCASE CFLAG:続柄
					;一番上
					CASE 1
						FOR LCOUNT, 2, 兄弟姉妹数+1
							SIF LCOUNT > 2
								立場 +=  "、"
							立場 += @"%CSVNAME(家族構成:LCOUNT)%"
						NEXT
						IF LANGUAGE == "ENG"
							立場 += @"/'s \@ SEX(TARGET) == 1 ? older brother # big sister \@"
						ELSE
							立場 += @"の\@ SEX(TARGET) == 1 ? 兄 # 姉 \@"
						ENDIF
					;中間
					CASE IS < 兄弟姉妹数
						FOR LCOUNT, 1, CFLAG:続柄
							SIF LCOUNT > 1
								立場 += "、"
							立場 += @"%CSVNAME(家族構成:LCOUNT)%"
						NEXT
						IF LANGUAGE == "ENG"
							立場 += @"/'s \@ SEX(TARGET) == 1 ? younger brother # younger sister \@、"
						ELSE
							立場 += @"の\@ SEX(TARGET) == 1 ? 弟 # 妹 \@、"
						ENDIF
						FOR LCOUNT, CFLAG:続柄+1, 兄弟姉妹数+1
							SIF LCOUNT > CFLAG:続柄+1
								立場 += "、"
							立場 += @"%CSVNAME(家族構成:LCOUNT)%"
						NEXT
						IF LANGUAGE == "ENG"
							立場 += @"/'s \@ SEX(TARGET) == 1 ? older brother # big sister \@"
						ELSE
							立場 += @"の\@ SEX(TARGET) == 1 ? 兄 # 姉 \@"
						ENDIF
					;一番下
					CASE IS == 尊属
						FOR LCOUNT, 1, 兄弟姉妹数
							SIF LCOUNT > 1
								立場 += "、"
							立場 += @"%CSVNAME(家族構成:LCOUNT)%"
						NEXT
						IF LANGUAGE == "ENG"
							立場 += @"/'s \@ SEX(TARGET) == 1 ? younger brother # younger sister \@"
						ELSE
							立場 += @"の\@ SEX(TARGET) == 1 ? 弟 # 妹 \@"
						ENDIF
				ENDSELECT
			ELSEIF 兄弟姉妹数 >= 2
				IF LANGUAGE == "ENG"
					IF CFLAG:続柄 == 1
						立場 = %CSVNAME(家族構成:2)%'s\@ SEX(TARGET) == 1 ? older brother # sister \@
					ELSE
						立場 = %CSVNAME(家族構成:1)%の\@ SEX(TARGET) == 1 ? younger brother # younger sister \@
					ENDIF
				ELSE
					IF CFLAG:続柄 == 1
						立場 = %CSVNAME(家族構成:2)%の\@ SEX(TARGET) == 1 ? 兄 # 姉 \@
					ELSE
						立場 = %CSVNAME(家族構成:1)%の\@ SEX(TARGET) == 1 ? 弟 # 妹 \@
					ENDIF
				ENDIF
			ENDIF
			;子供の場合
			IF CFLAG:続柄 < 1000
				SELECTCASE 尊属
					;兄弟姉妹しか居ない場合
					CASE IS < 10
						IF LANGUAGE == "ENG"
							CALL MCOLUMNPRINTL, @"　corresponds to %立場%"
						ELSE
							CALL MCOLUMNPRINTL, @"　%立場%にあたる"
						ENDIF
					;父母が居る場合
					CASE IS < 20
						CALL MCOLUMNPRINT, @"　"
						IF LANGUAGE == "ENG"
							SIF 兄弟姉妹数 >= 2
								CALL MCOLUMNPRINT, @"%立場% 、"
							SIF 家族構成:10
								CALL MCOLUMNPRINT, @"%CSVNAME(家族構成:10)%"
							SIF 家族構成:10 && 家族構成:11
								CALL MCOLUMNPRINT, @" and"
							SIF 家族構成:11
								CALL MCOLUMNPRINT, @"%CSVNAME(家族構成:11)%"
							SIF 父親 && 母親
								CALL MCOLUMNPRINT, @"couple "
							CALL MCOLUMNPRINTL, @" \@ SEX(TARGET) == 1 ? son # daughter \@ relative"
						ELSE
							SIF 兄弟姉妹数 >= 2
								CALL MCOLUMNPRINT, @"%立場%で、"
							SIF 家族構成:10
								CALL MCOLUMNPRINT, @"%CSVNAME(家族構成:10)%"
							SIF 家族構成:10 && 家族構成:11
								CALL MCOLUMNPRINT, @"と"
							SIF 家族構成:11
								CALL MCOLUMNPRINT, @"%CSVNAME(家族構成:11)%"
							SIF 父親 && 母親
								CALL MCOLUMNPRINT, @"夫妻"
							CALL MCOLUMNPRINTL, @"の\@ SEX(TARGET) == 1 ? 息子 # 娘 \@にあたる"
						ENDIF
					;祖父母が居る場合
					CASE IS < 30
						CALL MCOLUMNPRINT, @"　"
						IF LANGUAGE == "ENG"
							SIF 兄弟姉妹数 >= 2
								CALL MCOLUMNPRINT, @"%立場% "
							;さすがに親も居れば情報量を減らす
							IF 家族構成:10 || 家族構成:11
								SIF 家族構成:10
									CALL MCOLUMNPRINT, @"%CSVNAME(家族構成:10)%"
								SIF 家族構成:10 && 家族構成:11
									CALL MCOLUMNPRINT, @" and "
								SIF 家族構成:11
									CALL MCOLUMNPRINT, @"%CSVNAME(家族構成:11)%"
								SIF 父親 && 母親
									CALL MCOLUMNPRINT, @" couple "
								CALL MCOLUMNPRINT, @" \@ SEX(TARGET) == 1 ? son # daughter \@、"
							ENDIF
							SIF 家族構成:20
								CALL MCOLUMNPRINT, @"%CSVNAME(家族構成:20)%"
							SIF 家族構成:20 && 家族構成:21
								CALL MCOLUMNPRINT, @" and "
							SIF 家族構成:21
								CALL MCOLUMNPRINT, @"%CSVNAME(家族構成:21)%"
							CALL MCOLUMNPRINTL, @" is the grandson of "
						ELSE
							SIF 兄弟姉妹数 >= 2
								CALL MCOLUMNPRINT, @"%立場%で"
							;さすがに親も居れば情報量を減らす
							IF 家族構成:10 || 家族構成:11
								SIF 家族構成:10
									CALL MCOLUMNPRINT, @"%CSVNAME(家族構成:10)%"
								SIF 家族構成:10 && 家族構成:11
									CALL MCOLUMNPRINT, @"と"
								SIF 家族構成:11
									CALL MCOLUMNPRINT, @"%CSVNAME(家族構成:11)%"
								SIF 父親 && 母親
									CALL MCOLUMNPRINT, @"夫妻"
								CALL MCOLUMNPRINT, @"の\@ SEX(TARGET) == 1 ? 息子 # 娘 \@及び、"
							ENDIF
							SIF 家族構成:20
								CALL MCOLUMNPRINT, @"%CSVNAME(家族構成:20)%"
							SIF 家族構成:20 && 家族構成:21
								CALL MCOLUMNPRINT, @"と"
							SIF 家族構成:21
								CALL MCOLUMNPRINT, @"%CSVNAME(家族構成:21)%"
							CALL MCOLUMNPRINTL, @"の孫にあたる"
						ENDIF
				ENDSELECT
			;親の場合
			ELSEIF CFLAG:続柄 < 2000
				;息子、娘を表示
				CALL MCOLUMNPRINT, @"　"
				FOR LCOUNT, 1, 10
					SIF 家族構成:LCOUNT == 0
						BREAK
					SIF LCOUNT > 1
						CALL MCOLUMNPRINT, @"、"
					CALL MCOLUMNPRINT, @"%CSVNAME(家族構成:LCOUNT)%"
				NEXT
				IF LANGUAGE == "ENG"
					CALL MCOLUMNPRINTL, @"/'\@ SEX(TARGET) == 1 ? Father # Mother \@"
				ELSE
					CALL MCOLUMNPRINTL, @"\@ SEX(TARGET) == 1 ? 父親 # 母親 \@にあたる"
				ENDIF
			;祖父母の場合
			ELSEIF CFLAG:続柄 < 3000
				;孫を表示
				CALL MCOLUMNPRINT, @"　"
				FOR LCOUNT, 1, 10
					SIF 家族構成:LCOUNT == 0
						BREAK
					SIF LCOUNT > 1
						CALL MCOLUMNPRINT, @"、"
					CALL MCOLUMNPRINT, @"%CSVNAME(家族構成:LCOUNT)%"
				NEXT
				IF LANGUAGE == "ENG"
					CALL MCOLUMNPRINTL, @"の\@ SEX(TARGET) == 1 ? grandfather # grandmother \@"
				ELSE
					CALL MCOLUMNPRINTL, @"の\@ SEX(TARGET) == 1 ? 祖父 # 祖母 \@にあたる"
				ENDIF
			ENDIF
	ENDSELECT
ENDIF

IF CFLAG:クローン番号 && LANGUAGE == "ENG"
	CALL MCOLUMNPRINTL, @"　is a {CFLAG:クローン番号} \@ EXISTCSV(NOF(TARGET)) ? special clone #\@ clone of %CSVNAMEF(CFLAG:複製)%"
ELSEIF CFLAG:クローン番号
	CALL MCOLUMNPRINTL, @"　%CSVNAMEF(CFLAG:複製)%の{CFLAG:クローン番号}体目の\@ EXISTCSV(NOF(TARGET)) ? クローンとして作られた特別な #\@クローンだ"
ENDIF


;体型と痛み耐性
IF TALENT:スライム
	SIF CFLAG:タグ色
		SETCOLOR CFLAG:タグ色
	IF LANGUAGE == "ENG"
		CALL MCOLUMNPRINT, @"　Has an amorphous slime body。"
	ELSE
		CALL MCOLUMNPRINT, @"　不定形なスライムの体をしている。"
	ENDIF
	IF (NOF(TARGET) < 10000 && CSTR:種族 == CSVCSTR(NOF(TARGET), GETNUM(CSTR, "種族"))) || CFLAG:複製 || CFLAG:人工物
		IF TALENT:MASTER:溶ける快
			IF LANGUAGE == "ENG"
				SELECTCASE CFLAG:スライム度
					CASE 1 TO 199
						CALL MCOLUMNPRINT, @"　%HE_SHE(TARGET)% can be said that %HE_SHE(TARGET)% is still petite as a slime."
					CASE 200 TO 499
						CALL MCOLUMNPRINT, @"　Can %HE_SHE(TARGET)% say that %HE_SHE(TARGET)% have grown to a certain extent?"
					CASE 500 TO 999
						CALL MCOLUMNPRINT, @"　Signs of evolution are beginning to appear"
					CASE IS >= 1000
						CALL MCOLUMNPRINT, @"　The day will soon come when %HE_SHE(TARGET)% will become a higher-ranking slime."
				ENDSELECT
			ELSE
				SELECTCASE CFLAG:スライム度
					CASE 1 TO 199
						CALL MCOLUMNPRINT, @"　まだまだスライムとしては未熟とも言える"
					CASE 200 TO 499
						CALL MCOLUMNPRINT, @"　それなりに育ってきたと言えるか"
					CASE 500 TO 999
						CALL MCOLUMNPRINT, @"　進化の兆しが見えつつある"
					CASE IS >= 1000
						CALL MCOLUMNPRINT, @"　スライムとしてより上位の存在となる日も近いだろう"
				ENDSELECT
			ENDIF
		ENDIF
	ELSE
		IF TALENT:MASTER:溶ける快
			IF LANGUAGE == "ENG"
				SELECTCASE CFLAG:スライム度
					CASE 1 TO 99
						CALL MCOLUMNPRINT, @"　Is is not used to it yet and %HIS_HER(TARGET)% movements seem a little awkward."
					CASE 100 TO 299
						CALL MCOLUMNPRINT, @"　Looks like %HE_SHE(TARGET)% is starting to get used to the slime body."
					CASE 300 TO 499
						CALL MCOLUMNPRINT, @"　%HE_SHE(TARGET)% seems like it is getting used to his current body."
					CASE 500 TO 699
						CALL MCOLUMNPRINT, @"　%HE_SHE(TARGET)% guess that %HE_SHE(TARGET)% is gotten used to it a lot, and the discomfort in this body seems to be fading away."
					CASE 700 TO 899
						CALL MCOLUMNPRINT, @"　%HE_SHE(TARGET)% is already become accustomed to this body."
					CASE 900 TO 1049
						CALL MCOLUMNPRINT, @"　%HE_SHE(TARGET)% is even started to think that is current body looks more natural."
					CASE 1050 TO 1199
