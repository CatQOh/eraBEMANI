;奴隷売却の処理
@CHARA_SELL, 金額取得
#DIM DYNAMIC LTARGET
#DIM DYNAMIC LASSI, 2
#DIM DYNAMIC PRICE
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC 金額取得
#DIMS DYNAMIC 追加情報
#DIM DYNAMIC 倍率
#DIM DYNAMIC 口上補正あり

;金額取得の引数を渡されたらそのキャラの金額を取得する
IF 金額取得
	SKIPDISP 1
	LTARGET = TARGET
	TARGET = 金額取得
	GOTO 計算
ENDIF

DRAWLINE
PRINTFORML □%I18N("誰を売りますか")%？
FOR PAGING, 0, CHARANUM
	追加情報 = 
	IF GROUPMATCH(PAGING, ASSI, ASSI:1)
		追加情報 = (助手)
	;ELSEIF ISASSI:PAGING
	;	追加情報 = (元助手)
	ELSEIF CFLAG:PAGING:助手可能
		追加情報 = (助手可)
	ENDIF
	CALL PAGING, 売却可能(PAGING), @"%追加情報%", "SELL SLAVE"
NEXT

SELECTCASE RESULT
	CASE -1
		RETURN 0
	CASE 0 TO CHARANUM
		;売却処理
		LTARGET = TARGET
		LASSI = ASSI
		LASSI:1 = ASSI:1
		TARGET = RESULT
ENDSELECT

SIF TARGET == MASTER
	RESTART

$計算
CALL 売却額計算
PRICE = RESULT

SETCOLOR 100, 150, 250
PRINTFORML %I18N("能力価格")% = {PRICE}
RESETCOLOR

PRINTL 

CALL 売却額補正計算
倍率 = RESULT

PRINTFORML %I18N("素質倍率")% = {倍率}\%
;補正値はどんなに低くても最低30%
IF 倍率 < 30
	PRINTFORM %I18N("最低保証")% 30\%
	倍率 = 30
ENDIF 
;補正値の適用
PRICE *= 倍率
PRICE /= 100

SETCOLOR 100, 150, 250
PRINTFORML %I18N("能力価格")%×%I18N("素質補正")% = {PRICE}
RESETCOLOR

PRINTL 
倍率 = 100
IF TALENT:崩壊
	PRINTFORML %I18N("崩壊", "TALENT")% -20\%
	倍率 -= 20
ENDIF
IF TALENT:妊娠
	PRINTFORML %I18N("妊娠", "TALENT")% -30\%
	倍率 -= 30
ENDIF
IF TALENT:狂気
	PRINTFORML %I18N("狂気", "TALENT")% -30\%
	倍率 -= 30
ENDIF
IF TALENT:即落ち
	PRINTFORML %I18N("即落ち", "TALENT")% -80\%
	倍率 -= 80
ENDIF

IF CSTR:眷属主 != "" && CSTR:種族 != "ヴァンパイア"
	PRINTFORML %I18N("眷属化")% -20\%
	倍率 -= 20
ENDIF

IF CFLAG:眷属化した人数 && CSTR:種族 != "ヴァンパイア"
	PRINTFORML %I18N("眷属主")% -{20*CFLAG:眷属化した人数}\%
	倍率 -= 20*CFLAG:眷属化した人数
ENDIF

IF CFLAG:生殖力強化 == 1
	PRINTFORML %I18N("不妊治療中")% -10\%
	倍率 -= 10
ENDIF

IF CFLAG:卵管結紮 == 1
	PRINTFORML %I18N("不妊手術済み")% -10\%
	倍率 -= 10
ENDIF
FOR LCOUNT, GETNUM(CSTR, "右腕の印"), GETNUM(CSTR, "胴体の印")+1
	IF CSTR:LCOUNT != ""
		SELECTCASE CSTRNAME:LCOUNT
			CASE "右腕の印", "左腕の印", "右足の印", "左足の印"
				PRINTFORML %CSTRNAME:LCOUNT% -10\%
				倍率 -= 10
			CASE "背中の印"
				PRINTFORML %CSTRNAME:LCOUNT% -15\%
				倍率 -= 15
			CASE "胴体の印"
				PRINTFORML %CSTRNAME:LCOUNT% -20\%
				倍率 -= 20
		ENDSELECT
	ENDIF
NEXT

IF CFLAG:人工物 && CSTR:種族 != "機械"
	IF LANGUAGE == "ENG"
		PRINTL Created by human transmutation -50%
	ELSE
		PRINTL 人体錬成によって作られた -50%
	ENDIF
	倍率 -= 50
ENDIF

SIF 倍率 != 100
	PRINTFORML %I18N("特殊素質補正")% = {倍率}\%

IF 倍率 < 10
	PRINTFORML %I18N("最低保証")%10\%
	倍率 = 10
ENDIF

PRICE *= 倍率
PRICE /= 100

IF 倍率 != 100
	SETCOLOR 100, 150, 250
	PRINTFORML %I18N("価格")%×%I18N("特殊素質補正")% = {PRICE}
	RESETCOLOR
ENDIF

;難易度処理
SELECTCASE FLAG:難易度
	CASE -1
		PRINTFORML %I18N("難易度")%:BEGINNER ×120%
		TIMES PRICE , 1.20
	CASE 1
		PRINTFORML %I18N("難易度")%:NORMAL ×100%
		TIMES PRICE , 1.00
	CASE 2
		PRINTFORML %I18N("難易度")%:HYPER ×80%
		TIMES PRICE , 0.80
	CASE 3
		PRINTFORML %I18N("難易度")%:ANOTHER ×60%
		TIMES PRICE , 0.60
	CASE 4
		PRINTFORML %I18N("難易度")%:LEGGENDARIA ×200%
		TIMES PRICE , 2.00
ENDSELECT
SETCOLOR 100, 150, 250
PRINTFORML %I18N("価格")%×%I18N("難易度")%%I18N("補正")% = {PRICE}
RESETCOLOR
;価格×種族補正
SELECTCASE CSTR:種族
	;人間,人間(？),獣
	CASE "人間", "人間(？)", "獣"
		倍率 = 100
	;宇宙人,獣人,人魚,ヴァンパイア
	CASE "宇宙人", "獣人", "人魚", "ヴァンパイア"
		倍率 = 120
	;改造人間,機械,精霊,妖精
	CASE "改造人間", "機械", "精霊", "妖精"
		倍率 = 110
	;天使,鳳凰
	CASE "天使", "鳳凰"
		倍率 = 140
	;悪魔,魔術師
	CASE "悪魔", "魔術師"
		倍率 = 130
	;神
	CASE "神"
		倍率 = 150
	;ゾンビ
	CASE "ゾンビ"
		倍率 = 95
	;スライム
	CASE "スライム"
		倍率 = 90
	;表記ゆれがあった場合
	CASEELSE
		倍率 = 100
ENDSELECT

IF 倍率 != 100
	PRINTL 
	SETCOLOR 100, 150, 250
	PRINTFORML %I18N("価格")%×%I18N("種族")%(%CSTR:種族%)%I18N("補正")%:{倍率}\% = {PRICE*倍率/100}
	RESETCOLOR
	PRICE *= 倍率
	PRICE /= 100
ENDIF
PRINTL 

SETCOLOR 100, 150, 250
IF LANGUAGE == "ENG"
	CALL PASELIL, @"%I18N("価格")%:{PRICE}＄＋ Price modifier:{CFLAG:価格}＄ = {PRICE+CFLAG:価格}＄"
ELSE
	CALL PASELIL, @"価格:{PRICE}＄＋元の価格:{CFLAG:価格}＄ = {PRICE+CFLAG:価格}＄"
ENDIF
RESETCOLOR
PRICE += CFLAG:価格

;元助手
;IF ISASSI:TARGET == 1
;	PRINTFORML 助手経験あり -50\%
;	TIMES PRICE , 0.50
;ENDIF

IF 金額取得
	TARGET = LTARGET
	SKIPDISP 0
	RETURN PRICE
ENDIF

TRYCALLFORM 売却額補正_%CSVNAMERPS(NO:TARGET)%
IF RESULT
	PRICE = RESULT
	口上補正あり = 1
ENDIF

;売却確認
PRINTFORM %NAME:TARGET%は
SETCOLOR 50, 150, 250
CALL PASELI, @"{PRICE}＄"
RESETCOLOR
IF LANGUAGE == "ENG"
	PRINTFORM %NAME:TARGET% is can be sold for 
	SETCOLOR 50, 150, 250
	CALL PASELI, @"{PRICE}＄"
	PRINTFORML \@ 口上補正あり ? (mouth correction) #\@
	PRINTFORML Would you confirm to sell %HIM_HER(TARGET)%？
ELSE
	PRINTFORM %NAME:TARGET%は
	SETCOLOR 50, 150, 250
	CALL PASELI, @"{PRICE}＄"
	PRINTFORML で売れそうです\@ 口上補正あり ? (口上補正) #\@
	PRINTL 売却しますか？
ENDIF
PRINTFORML [0] %I18N("はい")%
PRINTFORML [1] %I18N("いいえ")%
CFLAG:売却寸止め = 1
BINPUT

SELECTCASE RESULT
	CASE 0
		CFLAG:売却額 = PRICE
		;売却時のイベント口上
		CALL KOJO_MESSAGE_EVENT, "売却時"
		IF RESULT == 1
			TARGET = LTARGET
			RESTART
		ENDIF
		SIF PRICE >= 1000000
			CALL 実績解除, "100-???-???"
		SIF PRICE >= 2000000
			CALL 実績解除, "100-200-???"
		SIF PRICE >= 4000000
			CALL 実績解除, "100-200-400"
		SELECTCASE 月齢
			CASE 2300 TO 2599
				SIF FALLTYPE(TARGET) == 1
					CALL 実績解除, "下弦の月に願うは君への罰"
		ENDSELECT
		SELECTCASE CHARANAMEF(TARGET)
			;実績「Σかリアンを素数価格で売却する」
			CASE "Σ", "リアン"
				SIF ISPRIME(PRICE)
					CALL 実績解除, "I only Divide Me"
			;実績:オトベアを売り飛ばす
			CASE "オトベア"
				CALL 実績解除, "お前よりくまモンの方がいい！"
		ENDSELECT
		IF !CSVTALENT(NOF(MASTER), GETNUM(TALENT, "子供好き"))
			IF TALENT:体格 <= 2
				FLAG:小児性愛スコア += 3
				IF FLAG:小児性愛スコア >= 10 && !TALENT:MASTER:子供好き
					IF LANGUAGE == "ENG"
						PRINTFORMW By continuous training, %CALLNAME:MASTER% develops new horisonts of %HIS_HER(MASTER)% own desires
						PRINTFORMW %CALLNAME:MASTER% got [%I18N("子供好き", "TALENT")%] trait
					ELSE
						PRINTFORMW 度重なる児童人身売買で、%CALLNAME:MASTER%は子供に対して異常な性的嗜好を持つようになった
						PRINTFORMW %CALLNAME:MASTER%は[子供好き]を得た
					ENDIF
					TALENT:MASTER:子供好き = 1
				ENDIF
				CALL SETMIN(FLAG:小児性愛スコア, 20)
			ELSE
				FLAG:小児性愛スコア -= 2
				IF FLAG:小児性愛スコア < 10 && TALENT:MASTER:子供好き
					IF LANGUAGE == "ENG"
						PRINTFORMW Without training some spiecies for a while
						PRINTFORMW %CALLNAME:MASTER% is got [%I18N("子供好き", "TALENT")%] trait
					ELSE
						PRINTFORMW %CALLNAME:MASTER%はしばらく児童の人身売買から離れていたせいか、子供に対する執着が薄れたようだ
						PRINTFORMW %CALLNAME:MASTER%は[子供好き]を失った
					ENDIF
					TALENT:MASTER:子供好き = 0
				ENDIF
				CALL SETMAX(FLAG:小児性愛スコア, -20)
			ENDIF
		ENDIF
		IF LANGUAGE == "ENG"
			CALL PAYMENT, PRICE, @"%NAME:TARGET% is sold"
			CALL プレイログ記録, @"%NAME:TARGET% is sold"
			CSTR:ロスト要因 = 売却
			CSTR:ロスト詳細 = has been sold for {PRICE}＄
		ELSE
			CALL PAYMENT, PRICE, @"%NAME:TARGET%売却"
			CALL プレイログ記録, @"%NAME:TARGET%売却"
			CSTR:ロスト要因 = 売却
			CSTR:ロスト詳細 = {PRICE}＄の価格で売却された
		ENDIF
		CALL CLEAR_CHARA, TARGET
	CASE 1
		TARGET = LTARGET
		RESTART
ENDSELECT

@CLEAR_CHARA, 対象, キャラ消去, 死, 加工
#DIM DYNAMIC LTARGET
#DIM DYNAMIC LASSI, 2
#DIM DYNAMIC 死
#DIM DYNAMIC 加工
#DIM DYNAMIC 対象
#DIM DYNAMIC キャラ消去

;アイドルユニットに属していた場合、そのユニットは解散
SIF CFLAG:対象:ユニット番号
	CALL BREAKUP, CFLAG:対象:ユニット番号
;監禁室を外す
SIF CFLAG:対象:監禁
	監禁室使用状況:(CFLAG:対象:監禁) = 

CFLAG:対象:居住 = 0
IF !キャラ消去
	CALL 配属解除, 対象, 1
	CALL CLEAR_FLAG, 対象
ENDIF

IF キャラ消去
	DELCHARA 対象
ELSE
	CFLAG:対象:キャラロスト = 1
ENDIF
IF キャラ消去
	LTARGET = TARGET
	LASSI = ASSI
	LASSI:1 = ASSI:1
	SIF 対象 == LTARGET
		TARGET = -1
	SIF 対象 == LASSI
		ASSI = -1
	SIF 対象 == LASSI:1
		ASSI:1 = -1
	SIF 対象 < LTARGET
		TARGET--
	SIF 対象 < LASSI
		ASSI--
	SIF 対象 < LASSI:1
		ASSI:1--
	SIF !引き継ぎ処理中
		CALLF メモリ解放, "キャラ消去"
ELSE
	SIF TARGET == 対象
		TARGET = -1
	SIF ASSI == 対象
		ASSI = -1
	SIF ASSI:1 == 対象
		ASSI:1 = -1
ENDIF

IF 死
	SIF GROUPMATCH(TFLAG:捕食相手, 父親取得(対象), 母親取得(対象))
		RETURN
	[IF RELEASE_ORIGIN]
	[ELSE]
		IF CHARANAMEF(対象) == "ハート" && TRANCERACE:対象:0 == ""
			;（主人死亡が面倒なので）主人マッドラットでハートが死んだ時何も起きない不具合が潜在的にあるはず 後で
			;マッドラットが先に死んだ際の処理をどうするかはアイデアがない
			IF !CCB:GETNO("マッドラット")
				PRINTFORML ハートの死により、その心臓の持ち主もどこかで死亡したようだ
				CCB:GETNO("マッドラット") = 1
			ELSEIF GETCHARANAME("マッドラット") > 0
				PRINTFORML マッドラットは心臓が停止し、死亡しました
				CSTR:GETCHARANAME("マッドラット"):ロスト要因 = 死亡
				CSTR:GETCHARANAME("マッドラット"):ロスト詳細 = 心臓が停止した
				CALL CLEAR_CHARA, GETCHARANAME("マッドラット"), 0, 1
			ENDIF
		ENDIF
	[ENDIF]
	殺害人数++
	SIF 殺害人数 >= 10
		CALL 実績解除, "DEATH BRINGER"
	IF (GETCHARA(父親取得(対象)) > 0 && !加工 && CSTR:GETCHARA(父親取得(対象)):配属 != "博物館") || (GETCHARA(母親取得(対象)) > 0 && !加工 && CSTR:GETCHARA(母親取得(対象)):配属 != "博物館")
		;博物館で加工した場合はそっちで処理済みなので計算しない
		IF LANGUAGE == "ENG"
				PRINTFORM Do you want to tell 
			SIF GETCHARA(父親取得(対象)) > 0 && !加工 && CSTR:GETCHARA(父親取得(対象)):配属 != "博物館"
				PRINTFORM %CALLNAME:GETCHARA(父親取得(対象))%
			SIF GETCHARA(父親取得(対象)) > 0 && !加工 && CSTR:GETCHARA(父親取得(対象)):配属 != "博物館" && GETCHARA(母親取得(対象)) > 0 && !加工 && CSTR:GETCHARA(母親取得(対象)):配属 != "博物館"
				PRINT and 
			SIF GETCHARA(母親取得(対象)) > 0 && !加工 && CSTR:GETCHARA(母親取得(対象)):配属 != "博物館"
				PRINTFORM %CALLNAME:GETCHARA(母親取得(対象))%
			PRINTFORML about %CALLNAME:対象%'s death？
		ELSE
			SIF GETCHARA(父親取得(対象)) > 0 && !加工 && CSTR:GETCHARA(父親取得(対象)):配属 != "博物館"
				PRINTFORM %CALLNAME:GETCHARA(父親取得(対象))%
			SIF GETCHARA(父親取得(対象)) > 0 && !加工 && CSTR:GETCHARA(父親取得(対象)):配属 != "博物館" && GETCHARA(母親取得(対象)) > 0 && !加工 && CSTR:GETCHARA(母親取得(対象)):配属 != "博物館"
				PRINT と
			SIF GETCHARA(母親取得(対象)) > 0 && !加工 && CSTR:GETCHARA(母親取得(対象)):配属 != "博物館"
				PRINTFORM %CALLNAME:GETCHARA(母親取得(対象))%
			PRINTFORML に%CALLNAME:対象%の死を伝えますか？
		ENDIF
		PRINTFORML [0] - %I18N("はい")%
		PRINTFORML [1] - %I18N("いいえ")%
		BINPUT
		IF RESULT == 0
			死亡キャラ = 対象
			SIF GETCHARA(父親取得(対象)) > 0 && !加工 && CSTR:GETCHARA(父親取得(対象)):配属 != "博物館"
				CALL 崩壊処理, GETCHARA(父親取得(対象)), "子供の死"
			SIF GETCHARA(母親取得(対象)) > 0 && !加工 && CSTR:GETCHARA(母親取得(対象)):配属 != "博物館"
				CALL 崩壊処理, GETCHARA(母親取得(対象)), "子供の死"
		ENDIF
	ENDIF
ENDIF

@売却額計算
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC PRICE
#DIM DYNAMIC 基礎値
#DIM DYNAMIC 初期値

;ABLによる基礎値計算
FOR LCOUNT, 0, VARSIZE("ABL")
	IF EXISTCSV(NOF(TARGET))
		初期値 = CSVABL(NOF(TARGET), LCOUNT)
	ELSE
		初期値 = 0
	ENDIF
	;栽培技能は最低初期値1
	SIF ABLNAME:LCOUNT == "栽培技能" && 初期値 < 1
		初期値 = 1
	SELECTCASE ABLNAME:LCOUNT
		;従順、欲望、技巧、奉仕精神、露出癖のテーブル
		CASE "従順", "欲望", "技巧", "奉仕精神", "露出癖"
			SELECTCASE ABL:LCOUNT-初期値
				CASE 0
					基礎値 = 0
				CASE 1
					基礎値 = 1000
				CASE 2
					基礎値 = 1500
				CASE 3
					基礎値 = 2500
				CASE 4
					基礎値 = 4000
				CASE 5
					基礎値 = 6000
				CASE 6
					基礎値 = 8500
				CASE 7
					基礎値 = 11500
				CASE 8
