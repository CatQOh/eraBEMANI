				CASE 9
					基礎値 = 48000
				CASEELSE
					基礎値 = 50000
			ENDSELECT
		;メス度のテーブル
		;売却額が低くなりがちな男キャラ専用ステータスなので高い
		CASE "メス度"
			SELECTCASE ABL:メス度
				CASE 0
					基礎値 = 0
				CASE 1
					基礎値 = 5000
				CASE 2
					基礎値 = 7000
				CASE 3
					基礎値 = 10000
				CASE 4
					基礎値 = 14000
				CASE 5
					基礎値 = 20000
				CASE 6
					基礎値 = 28000
				CASE 7
					基礎値 = 40000
				CASE 8
					基礎値 = 55000
				CASE 9
					基礎値 = 75000
				CASEELSE
					基礎値 = 100000
			ENDSELECT
	ENDSELECT
	IF ABL:LCOUNT > 0
		IF 初期値
			PRINTFORML %I18N(ABLNAME:LCOUNT,"ABL")%LV{ABL:LCOUNT}-%I18N("初期")%%ABLNAME:LCOUNT%LV{初期値}=LV{ABL:LCOUNT-初期値} +{基礎値}
		ELSE
			PRINTFORML %I18N(ABLNAME:LCOUNT,"ABL")%LV{ABL:LCOUNT} +{基礎値}
		ENDIF
	ENDIF
	PRICE += 基礎値
NEXT

RETURN PRICE

