;子供の自動命名関連の処理

;-------------------------
;ランダム名を生成する関数
;引数 生成パターン(1:カタカナ 2:ひらがな 3:漢字)
;-------------------------
@ランダム命名, 命名パターン
#FUNCTIONS
#DIM DYNAMIC 命名パターン
#DIMS DYNAMIC 命名候補

;カタカナパターン
SELECTCASE 命名パターン
	CASE 1
		;1/4の確率で文節が3になる
		IF RAND:4 == 0
			命名候補 += 命名_カタカナ_1()
			命名候補 += 命名_カタカナ_2()
			命名候補 += 命名_カタカナ_3()
		ELSE
			命名候補 += 命名_カタカナ_1()
			命名候補 += 命名_カタカナ_3()
		ENDIF
	CASE 2
		;1/4の確率で文節が3になる
		IF RAND:4 == 0
			命名候補 += 命名_ひらがな_1()
			命名候補 += 命名_ひらがな_2()
			命名候補 += 命名_ひらがな_3()
		ELSE
			命名候補 += 命名_ひらがな_1()
			命名候補 += 命名_ひらがな_3()
		ENDIF
	CASE 3
		;20%の確率で前置詞追加
		SIF RAND:5 == 0
			命名候補 += 命名_漢字_前置詞()

		SELECTCASE RAND(1, 101)
			CASE 1 TO 8
				;前置＋語尾パターン(8%)
				命名候補 += 命名_漢字_前置詞()
				命名候補 += 命名_漢字_語尾()
			;固＋固＋固パターン(7%)
			CASE 9 TO 15
				命名候補 += 命名_漢字_固有名詞()
				命名候補 += 命名_漢字_固有名詞()
				命名候補 += 命名_漢字_固有名詞()
			;固＋固パターン(30%)
			CASE 16 TO 45
				命名候補 += 命名_漢字_固有名詞()
				命名候補 += 命名_漢字_固有名詞()
			;固＋語尾パターン(30%)
			CASE 46 TO 75
				命名候補 += 命名_漢字_固有名詞()
				命名候補 += 命名_漢字_固有名詞()
			;固＋固＋語尾パターン(25%)
			CASE 76 TO 100
				命名候補 += 命名_漢字_固有名詞()
				命名候補 += 命名_漢字_固有名詞()
				命名候補 += 命名_漢字_語尾()
		ENDSELECT
ENDSELECT

;#;SIF 命名候補 == ""
;#;	THROW 空の名前が生成されました

RETURNF 命名候補

