@PRICE_VIDEO
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC 価格
#DIM DYNAMIC 補正

FOR LCOUNT, 0, TFLAG:ビデオ撮影回数
	価格 += ビデオポイント(ビデオ撮影内容:LCOUNT)
NEXT

補正 = 100
SIF TALENT:無関心
	補正 -= 30
SIF TALENT:感情乏しい
	補正 -= 30
SIF TALENT:恥じらい
	補正 += 10

;ロリ巨乳・トランジスタグラマーだとさらにボーナスが付く
IF TALENT:体格 == 1 || TALENT:小人体型
	SELECTCASE TALENT:バストサイズ
		;絶壁
		CASE 1
			補正 += 25
		;貧乳
		CASE 2
			補正 += 30
		;普乳
		CASE 3
			補正 += 40
		;巨乳
		CASE 4
			補正 += 55
		;豊乳
		CASE 5
			補正 += 75
		;爆乳
		CASE IS >= 6
			補正 += 100
	ENDSELECT
ELSEIF TALENT:体格 == 2
	SELECTCASE TALENT:バストサイズ
		;絶壁
		CASE 1
			補正 += 15
		;貧乳
		CASE 2
			補正 += 18
		;普乳
		CASE 3
			補正 += 24
		;巨乳
		CASE 4
			補正 += 33
		;豊乳
		CASE 5
			補正 += 45
		;爆乳
		CASE IS >= 6
			補正 += 63
	ENDSELECT
ELSE
	SELECTCASE TALENT:バストサイズ
		;絶壁
		CASE 1
			補正 += 5
		;貧乳
		CASE 2
			補正 += 7
		;普乳
		CASE 3
			補正 += 11
		;巨乳
		CASE 4
			補正 += 17
		;豊乳
		CASE 5
			補正 += 25
		;爆乳
		CASE IS >= 6
			補正 += 35
	ENDSELECT
ENDIF

SIF TALENT:動物耳
	補正 += 5
SIF TALENT:尻尾
	補正 += 5
SIF TALENT:ファーリー
	補正 += 10
SIF TALENT:人気
	補正 += 20
SIF TALENT:謎の魅力
	補正 += 30
SIF TALENT:魅力
	補正 += 20

IF 腕欠損(TARGET) == 2 && 脚欠損(TARGET) == 2
	;両手両足欠損の補正
ELSE
	SELECTCASE 腕欠損(TARGET)
		CASE 1
			;片腕欠損の補正
		CASE 2
			;両腕欠損の補正
	ENDSELECT
	SELECTCASE 脚欠損(TARGET)
		CASE 1
			;片脚欠損の補正
		CASE 2
			;両脚欠損の補正
	ENDSELECT
ENDIF
;被写経験に応じて売却額上昇
;淫乱・淫魔なら映像になることを意識するため売却額が伸びる
IF TALENT:淫乱 || TALENT:淫魔
	SELECTCASE EXP:被写経験
		CASE IS >= EXPLV:10
			補正 += 325
		CASE IS >= EXPLV:9
			補正 += 275
		CASE IS >= EXPLV:8
			補正 += 220
		CASE IS >= EXPLV:7
			補正 += 180
		CASE IS >= EXPLV:6
			補正 += 155
		CASE IS >= EXPLV:5
			補正 += 125
		CASE IS >= EXPLV:4
			補正 += 100
		CASE IS >= EXPLV:3
			補正 += 80
		CASE IS >= EXPLV:2
			補正 += 65
		CASE IS >= EXPLV:1
			補正 += 55
		CASEELSE
			補正 += 50
	ENDSELECT
	SIF TALENT:淫魔
		補正 += 50
ELSE
	SELECTCASE EXP:被写経験
		CASE IS >= EXPLV:10
			補正 += 73
		CASE IS >= EXPLV:9
			補正 += 61
		CASE IS >= EXPLV:8
			補正 += 50
		CASE IS >= EXPLV:7
			補正 += 40
		CASE IS >= EXPLV:6
			補正 += 31
		CASE IS >= EXPLV:5
			補正 += 23
		CASE IS >= EXPLV:4
			補正 += 16
		CASE IS >= EXPLV:3
			補正 += 10
		CASE IS >= EXPLV:2
			補正 += 5
		CASE IS >= EXPLV:1
			補正 += 1
		CASEELSE
			補正 -= 2
	ENDSELECT
ENDIF

;撮影者を見る
;主人
SELECTCASE TFLAG:ビデオ撮影者
	CASE 1
		;撮影技能を見る
		SELECTCASE ABL:MASTER:撮影技能
			CASE 0
				補正 -= 20
			CASE 1
				補正 -= 10
			CASE 3
				補正 += 10
			CASE 4
				補正 += 30
			CASE IS >= 5
				補正 += 50
		ENDSELECT
	;助手
	CASE 2
		;撮影技能を見る
		SELECTCASE ABL:ASSI:撮影技能
			CASE 0
				補正 -= 20
			CASE 1
				補正 -= 10
			CASE 3
				補正 += 10
			CASE 4
				補正 += 30
			CASE IS >= 5
				補正 += 50
		ENDSELECT
ENDSELECT

;倍率処理
SIF 補正 < 1
	補正 = 1

価格 *= 補正
価格 /= 100

;難易度処理
SELECTCASE FLAG:難易度
	;BEGINNER
	CASE -1
		TIMES 価格 , 1.20
	;NORMAL
	CASE 1
		TIMES 価格 , 1.00
	;HYPER
	CASE 2
		TIMES 価格 , 0.80
	;ANOTHER
	CASE 3
		TIMES 価格 , 0.60
	;LEGGENDARIA
	CASE 4
		TIMES 価格 , 0.05
ENDSELECT

;ゲイビデオならボーナスが付く
SIF SEX(MASTER) == SEX(TARGET)
	TIMES 価格 , 1.10
SIF ASSI > 0 && SEX(ASSI) == SEX(TARGET)
	TIMES 価格 , 1.10

;霊体の撮影なら価格は0になる
SIF TALENT:霊体
	価格 = 0

TFLAG:ビデオ価格 += 価格
TFLAG:ビデオ撮影回数 = 0

@SELL_VIDEO
#DIM DYNAMIC 加算額
#DIM DYNAMIC 所持ビデオ本数

;調教時に録画したビデオの売却
;撮影中のまま売却まで来た場合はテープの数を減らす
;テープの減数は撮影後処理のため、さらにビデオの値段および経験もここで処理をする
IF TEQUIP:ビデオカメラ
	ITEM:ビデオテープ--
	CALL PRICE_VIDEO
ENDIF

;録画してなければ終了
SIF TFLAG:ビデオ価格 == 0
	RETURN 0

DRAWLINE

