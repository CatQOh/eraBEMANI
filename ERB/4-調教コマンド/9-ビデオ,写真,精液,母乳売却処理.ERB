@SELL_PICTURE
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNT2
#DIM DYNAMIC 総額
#DIM DYNAMIC 保持, 10
#DIM DYNAMIC 総枚数
#DIM DYNAMIC 売却枚数

;売れる写真が無ければ関数終了
SIF !写真価格:0
	RETURN 0
FOR LCOUNT, 0, 50
	SIF PICS:(NOF(TARGET)):LCOUNT != ""
		総枚数++
NEXT

CALL LOOP_CLEARLINE

DRAWLINE
;PRINTL 撮影した写真を売却します
		SELECTCASE LANGUAGE
			CASE "ENG"
				PRINTL □Photos taken this time
			CASEELSE
				PRINTL □今回撮影した写真
		ENDSELECT
FOR LCOUNT, 0, 10
	SIF !写真価格:LCOUNT
		BREAK
		SELECTCASE LANGUAGE
			CASE "ENG"
				PRINTFORM {LCOUNT+1, 2}th photo.%写真内容:LCOUNT% [{LCOUNT}] 
			CASEELSE
				PRINTFORM {LCOUNT+1, 2}枚目.%写真内容:LCOUNT% [{LCOUNT}] 
		ENDSELECT
	SIF 総枚数 < 50
		PRINTFORM \@ 保持:LCOUNT ? 保持 # 売却 \@
	PRINTL 
	SELECTCASE LANGUAGE
		CASE "ENG"
			CALL PASELIL, @"       Sales amount:{写真価格:LCOUNT}＄"
		CASEELSE
			CALL PASELIL, @"       売却額:{写真価格:LCOUNT}＄"
	ENDSELECT
NEXT
IF 総枚数 == 50
	SELECTCASE LANGUAGE
		CASE "ENG"
			PRINTL Photo has been sold because there is no space in the album.
		CASEELSE
			PRINTL アルバムに空きが無いため売却します
	ENDSELECT
	GOTO SELL
ENDIF
DRAWLINE
SELECTCASE LANGUAGE
	CASE "ENG"
		PRINT 　[10] Confirm [11] Sell everything
		SIF 総枚数 < 40
			PRINT [12] Keep all
	CASEELSE
		PRINT 　[10] 決定 [11] 全て売却 
		SIF 総枚数 < 40
			PRINT [12] 全て保持
ENDSELECT
PRINTL 
BINPUT
SELECTCASE RESULT
	CASE 11
		VARSET 保持
	CASE 12
		SIF 総枚数 >= 40
			CONTINUE
		VARSET 保持, 1
	CASE 0 TO 9
		IF !保持:RESULT && SUMARRAY(保持)+総枚数 >= 50
			SELECTCASE LANGUAGE
				CASE "ENG"
					PRINTW Up to 50 items can be stored per person.
				CASEELSE
					PRINTW 保管できるのは一人につき50枚までです
			ENDSELECT
			RESTART
		ENDIF
		INVERTBIT 保持:RESULT, 0
		RESTART
ENDSELECT
売却枚数 = 0
FOR LCOUNT, 0, 10
	IF !保持:LCOUNT
		総額 += 写真価格:LCOUNT
		売却枚数++
	ENDIF
NEXT
IF 総額
	$SELL
	SELECTCASE LANGUAGE
		CASE "ENG"
			CALL PASELIL, @"Sold for a total of ＄{総額}"
			CALL PAYMENT, 総額, @"%NAME:TARGET%の写真売却"
		CASEELSE
			CALL PASELIL, @"計{総額}＄で売れました"
			CALL PAYMENT, 総額, @"%NAME:TARGET%の写真売却"
	ENDSELECT
	人気度:(NOF(TARGET)) += 売却枚数
	WAIT
	CALL KOJO_MESSAGE_EVENT, "写真売却時"
ENDIF

IF SUMARRAY(保持)
	SELECTCASE LANGUAGE
		CASE "ENG"
			PRINTFORML Saved {10-MATCH(写真内容, "")} photos
		CASEELSE
			PRINTFORML {10-MATCH(写真内容, "")}枚の写真を保管しました
	ENDSELECT
	FOR LCOUNT, 0, 10
		IF 保持:LCOUNT
			;二次元配列でFINDELEMENTは使えないので手作業
			FOR LCOUNT2, 0, 50
				IF PICS:(NOF(TARGET)):LCOUNT2 == ""
					PIC:(NOF(TARGET)):LCOUNT2 = 写真価格:LCOUNT
					PICS:(NOF(TARGET)):LCOUNT2 = %写真内容:LCOUNT%
					BREAK
				ENDIF
			NEXT
		ENDIF
	NEXT
ENDIF

