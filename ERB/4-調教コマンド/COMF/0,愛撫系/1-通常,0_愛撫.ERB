;-------------------------------------------------
;愛撫
;-------------------------------------------------
@USERCOM_ABLE_愛撫
#FUNCTION
コマンド実行条件 += I18N("ゲーセンではトイレじゃないと実行できない/")
SIF TEQUIP:ゲームセンター && !TEQUIP:トイレ
	COMRESULT = 0
コマンド実行条件 += I18N("対象がペニスバンド装着中は実行不可/")
SIF TEQUIP:ペニスバンド
	COMRESULT = 0
IF MOD:STS
	コマンド実行条件 += I18N("実行者に腕がないと実行できない/")
	SIF 腕欠損(PLAYER) == 2
		COMRESULT = 0
ENDIF


RETURNF COMRESULT

@COM_愛撫
PRINTFORML %I18N("愛撫", "TRAIN")%
CALL KOJO_MESSAGE_COM

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
LOSEBASE:体力 += 5
LOSEBASE:気力 += 50

DOWNBASE:MASTER:体力 += 30
DOWNBASE:MASTER:気力 += 20

IF !TALENT:去勢済み && SEX(TARGET)
	SOURCE:快C = 30
	SOURCE:快B = 30
ELSE
	SOURCE:快B = 40
ENDIF
SOURCE:情愛 = 30
SOURCE:性行動 = 30
SOURCE:露出 = 10
SOURCE:不潔 = 30
SOURCE:反感 = 10

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:抑圧 || TALENT:抵抗
	SOURCE:鬱屈 += 20

;装飾効果加算
SOURCE:快C += 装飾効果加算量(SOURCE:快C, TARGET, "陰核")
SOURCE:苦痛 += 装飾効果加算量(SOURCE:快C, TARGET, "陰核")
SOURCE:快C += 装飾効果加算量(SOURCE:快C, TARGET, "陰茎")
SOURCE:苦痛 += 装飾効果加算量(SOURCE:快C, TARGET, "陰茎")
;-------------------------------------------------
;絶頂チェック
;-------------------------------------------------
CALL SOURCE_CHECK_CVAB

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
CALL SAMEN_CHECK_T, 0

CALL SAMEN_SHOOT_T, 0, NOWEX:射精

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;汚臭鈍感
SIF TALENT:汚臭鈍感
	SOURCE:不潔 /= 4
;汚臭敏感
SIF TALENT:汚臭敏感
	SOURCE:不潔 *= 3
;プライド高い
SIF TALENT:プライド高い
	SOURCE:不潔 *= 2

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL EXPUP_BASE, 1, 1

RETURN 1

