						酒名 = ウォッカトニック
					CASE 4
						製法 = ハイボール
						酒名 = ウォッカリッキー
					CASE 5
						製法 = カクテル
						酒名 = ブラックルシアン
						材料:0 = GETNUM(ITEM, "カルーア")
					CASE 6
						製法 = カクテル
						酒名 = モスコミュール
						SIF レシピ判定("ライムジュース") != 2
