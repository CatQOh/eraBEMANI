			CASE 3 TO 7
				SELECTCASE RESULT
					CASE 3
						製法 = カクテル
						酒名 = カルーアミルク
					CASE 4
						製法 = ハイボール
						酒名 = カルーアソーダ
					CASE 5
						製法 = カクテル
						酒名 = ブラックルシアン
						材料:0 = GETNUM(ITEM, "アブソルート")
					CASE 6
						製法 = 母乳割り
						酒名 = カルーア母乳
