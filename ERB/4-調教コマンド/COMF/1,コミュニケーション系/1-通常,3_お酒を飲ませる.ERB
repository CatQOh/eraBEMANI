			PRINTFORMW You are stopped serving alcohol
		ELSE
			PRINTFORMW お酒を飲ませるのを止めました
		ENDIF
		RETURN 0
ENDSELECT

$判定

CALL ALC_ORDER, ALC, 製法, お酒

PRINTFORM  = {RESULT}
SELECTCASE RESULT
	CASE IS < 0
		PRINT  < 
	CASE IS > 0
		PRINT  > 
	CASEELSE
		PRINT  = 
ENDSELECT
PRINTFORM %I18N("実効値")%0
WAIT

TFLAG:GETNUM(TFLAG, "お酒") = お酒
TFLAG:アルコール度数 = ALC

;実行できない お酒は特殊の地の文
IF RESULT < 0
	CALL KOJO_MESSAGE_EVENT, "飲酒拒否時"
	RETURN 0
ELSE
	SIF GETNUM(ITEM, 酒名) >= 0 && お酒 >= 0
		ITEM:お酒--
	SELECTCASE 製法
		CASE "ハイボール"
			ITEM:炭酸水--
		CASE "コーラ割り"
			ITEM:コーラ--
		CASE "ジンジャー割り"
			ITEM:ジンジャーエール--
		CASE "トニック割り"
			ITEM:トニックウォーター--
		CASE "レモン割り"
			SIF レシピ判定("レモンジュース") != 2
				ITEM:レモンジュース--
		CASE "ライム割り"
			SIF レシピ判定("ライムジュース") != 2
				ITEM:ライムジュース--
		CASE "精液割り"
			リソース:精液 -= 100
		CASE "母乳割り"
			リソース:母乳 -= 100
		CASE "粘液混ぜ"
			リソース:粘液 -= 100
		CASE "カクテル"
			FOR LCOUNT, 0, VARSIZE("材料")
				SIF 材料:LCOUNT
					ITEM:(材料:LCOUNT)--
			NEXT
	ENDSELECT
ENDIF

;-------------------------------------------------
;実行決定
;-------------------------------------------------
CALL KOJO_MESSAGE_COM

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
LOSEBASE:体力 += 20
LOSEBASE:気力 += 50

SOURCE:中毒 = 500
SOURCE:露出 = 50
SOURCE:欲情 = 100
SOURCE:恭順 = 100
SOURCE:逸脱 = 300
SOURCE:反感 = 300

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
IF TALENT:下戸
	CFLAG:酔 += ALC*2
ELSEIF TALENT:酒豪
	CFLAG:酔 += ALC/2
ELSE
	CFLAG:酔 += ALC
ENDIF

;各種メリットは酔い上限突き抜けてない場合にのみ発動
IF CFLAG:酔 > 100
	CFLAG:酔 = 100
ELSE
	;自家製の酒はボーナスなし
	IF お酒 >= 0
		SELECTCASE ITEMNAME:お酒
			;皆伝は音ゲーマーが飲むとボーナス
			CASE "皆伝"
				SIF TALENT:音ゲーマー
					TEQUIP:お酒ボーナス++
			;魔王は悪魔か小悪魔が飲むとボーナス
			CASE "魔王"
				SIF CSTR:種族 == "悪魔" || TALENT:小悪魔
					TEQUIP:お酒ボーナス++
			;アルパカは獣、獣人、ファーリーが飲むとボーナス
			CASE "アルパカ"
				SIF CSTR:種族 == "獣" || CSTR:種族 == "獣人" || TALENT:ファーリー
					TEQUIP:お酒ボーナス++
			;倉吉はひなビタキャラが飲むとボーナス
			CASE "倉吉"
				SELECTCASE CHARANAMEF(TARGET)
					CASE "山形 まり花", "和泉 一舞", "春日 咲子", "霜月 凛", "芽兎 めう", "東雲 夏陽", "東雲 心菜", "星見 日向", "久領堤 纒"
						TEQUIP:お酒ボーナス++
						;実績：ひなビタキャラにピュアモルトウイスキー倉吉を飲ませる
						CALL 実績解除, "地元のお酒めう！"
				ENDSELECT
			;スペリオールは人魚が飲むとボーナス
			CASE "スペリオール"
				SIF CSTR:種族 == "人魚"
					TEQUIP:お酒ボーナス++
			;ジンのボーナスが思いつかない 誰か助けて
			CASE "ジン"
			;アブソルートは特段ボーナスは無いが、ウォッカの特徴として二日酔いしにくい
			CASE "アブソルート"
				IF TALENT:下戸
					TEQUIP:ウォッカ += ALC*2
				ELSEIF TALENT:酒豪
					TEQUIP:ウォッカ += ALC/2
				ELSE
					TEQUIP:ウォッカ += ALC
				ENDIF
			;カルーアは飲みやすいが獣人と獣に飲ませると大ダメージ
			CASE "カルーア"
				IF CSTR:種族 == "獣人"
					LOSEBASE:体力 += 300
					LOSEBASE:気力 += 300
				ELSEIF CSTR:種族 == "獣"
					LOSEBASE:体力 += 500
					LOSEBASE:気力 += 500
				ENDIF
			;お屠蘇 アイテム必要無いので特にボーナスも無い
			CASE "お屠蘇"
		ENDSELECT
		;精液割りは精液中毒LV3以上でボーナス
		SIF 製法 == "精液割り" && ABL:精液中毒 >= 3
			TEQUIP:お酒ボーナス++
		;無理のない範囲で飲ませるとストレス低下
		IF TALENT:酒豪
			SIF CFLAG:酔 <= 80
				CFLAG:ストレス値 -= ALC/5
		ELSEIF TALENT:下戸
			SIF CFLAG:酔 <= 20
				CFLAG:ストレス値 -= ALC/3
		ELSE
			SIF CFLAG:酔 <= 50
				CFLAG:ストレス値 -= ALC/5
		ENDIF
	ENDIF
ENDIF

;粘液混ぜを飲ませるとそこそこのスライム浸食、深化が発生、泥酔してると効力が落ちる。酔い上限を超えてても起きる
IF 製法 == "粘液混ぜ"
	IF (TALENT:下戸 && CFLAG:酔 >= 20) || CFLAG:酔 >= 50
		CALL スライム度増加, 0, TARGET, RAND(0, 2), RAND(3, 6)
	ELSE
		CALL スライム度増加, 0, TARGET, RAND(2, 5), RAND(30, 60)
	ENDIF
ENDIF

;-------------------------------------------------
;絶頂チェック
;-------------------------------------------------
CALL SOURCE_CHECK_CVAB

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
CALL SAMEN_CHECK_T, 0

CALL SAMEN_SHOOT_T, 0, NOWEX:射精

SIF 製法 == "精液割り"
	CALL EXPUP, "精液経験", 2

RETURN 1

;-------------------------------------------------
;お酒ボーナスの処理
;-------------------------------------------------
@EQUIP_COM_お酒を飲ませる
SOURCE:欲情 += TEQUIP:お酒ボーナス*30
SOURCE:恭順 += TEQUIP:お酒ボーナス*30

;依存度補正がお酒ボーナス最大のメリット
TFLAG:依存度補正 += TEQUIP:お酒ボーナス

;-------------------------------------------------
;お酒を飲ませるコマンドのCOM_ORDERは特殊
;-------------------------------------------------
@ALC_ORDER, ALC, 製法, お酒
#DIM DYNAMIC ALC
#DIMS DYNAMIC 製法
#DIM DYNAMIC お酒
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC 実効値, 2

IF TALENT:下戸
	PRINTFORM -%I18N("アルコール度数")%{ALC}\%({ALC*2})
	実効値 -= ALC*2
ELSEIF !TALENT:酒豪
	PRINTFORM -%I18N("アルコール度数")%{ALC}\%({ALC})
	実効値 -= ALC
ENDIF

実効値:1 = 0

IF TALENT:快感に素直
	実効値:1 = CFLAG:酔*3/2
ELSEIF TALENT:快感の否定
	実効値:1 = CFLAG:酔/2
ELSE
	実効値:1 = CFLAG:酔
ENDIF

IF 実効値:1 >= 5 && TALENT:下戸
	PRINTFORM +%I18N("酒が回っている")%({実効値:1/5})
	実効値 += 実効値:1/5
ELSEIF 実効値:1 >= 3
	PRINTFORM +%I18N("酒が回っている")%({実効値:1/3})
	実効値 += 実効値:1/3
ENDIF

IF CFLAG:二日酔い
	PRINTFORM -%I18N("二日酔い")%(5)
	実効値 -= 5
ENDIF

IF 陥落(TARGET)
	PRINTFORM +%I18N("陥落")%(5)
	実効値 += 5
ENDIF

IF GETPALAMLV(PALAM:恭順, 10)
	PRINTFORM +%I18N("恭順", "PALAM")%({GETPALAMLV(PALAM:恭順, 10)})
	実効値 += GETPALAMLV(PALAM:恭順, 10)
ENDIF

IF 製法 == "ビール" && !TALENT:酒豪 && (TALENT:児童 || TALENT:下戸)
	IF LANGUAGE == "ENG"
		PRINT -Beer is bitter and impossible(10)
	ELSE
		PRINT -ビールは苦くて無理(10)
	ENDIF
	実効値 -= 10
	SELECTCASE 酒名
		CASE "シャンディガフ", "パナシェ", "ビアスプリッツァー"
			IF LANGUAGE == "ENG"
				PRINT +Reduces the bitterness of beer(5)
			ELSE
				PRINT +ビールの苦さを軽減(5)
			ENDIF
			実効値 += 5
	ENDSELECT
ENDIF

IF !TALENT:下戸
	SELECTCASE 製法
		CASE "ハイボール", "ビール", "コーラ割り", "ジンジャー割り", "レモン割り", "ライム割り", "トニック割り", "カクテル"
			IF FLAG:気温 >= 200
				IF LANGUAGE == "ENG"
					PRINTFORM +High temperature & cold drinks({(FLAG:気温-190)/10})
				ELSE
					PRINTFORM +高気温&冷飲料({(FLAG:気温-190)/10})
				ENDIF
				実効値 += (FLAG:気温-190)/10
			ENDIF
		CASE "お湯割り", "熱燗"
			IF FLAG:気温 <= 100
				IF LANGUAGE == "ENG"
					PRINTFORM +Low temperature & hot drinks({(110-FLAG:気温)/10})
				ELSE
					PRINTFORM +低気温&温飲料({(110-FLAG:気温)/10})
				ENDIF
				実効値 += (110-FLAG:気温)/10
			ENDIF
	ENDSELECT
ENDIF

SELECTCASE 製法
	CASE "精液割り"
		IF ABL:精液中毒 < 3
			PRINTFORM -%I18N("精液中毒", "ABL")%LV{ABL:精液中毒}({(3-ABL:精液中毒)*3})
			実効値 -= (3-ABL:精液中毒)*3
		ELSEIF ABL:精液中毒 > 3
			PRINTFORM +%I18N("精液中毒", "ABL")%LV{ABL:精液中毒}({(ABL:精液中毒-3)*3})
			実効値 += (ABL:精液中毒-3)*3
		ENDIF
	CASE "母乳割り"
		IF LANGUAGE == "ENG"
			PRINT -Breastmilk split(3)
		ELSE
			PRINT -母乳割り(3)
		ENDIF
		実効値 -= 3
	CASE "粘液混ぜ"
		IF CSTR:種族 == "スライム"
			IF LANGUAGE == "ENG"
				PRINT +Slime and mucus jelly(8)
			ELSE
				PRINT +スライムに粘液ゼリー(8)
			ENDIF
			実効値 += 8
		ELSE
			IF LANGUAGE == "ENG"
				PRINT +Mucus jelly that tastes like sweets(3)
			ELSE
				PRINT +スイーツ感覚の粘液ゼリー(3)
			ENDIF
			実効値 += 3
		ENDIF
	CASE "ハイボール"
		IF LANGUAGE == "ENG"
			PRINT +highball is delicious(3)
		ELSE
			PRINT +ハイボールは美味しい(3)
		ENDIF
		実効値 += 3
	CASE "コーラ割り", "ジンジャー割り", "トニック割り", "レモン割り", "ライム割り"
		IF LANGUAGE == "ENG"
			PRINT +Easy to drink cocktails(5)
		ELSE
			PRINT +飲みやすいカクテル(5)
		ENDIF
		実効値 += 5
	CASE "カクテル"
		IF LANGUAGE == "ENG"
			PRINT +Delicious cocktails(7)
		ELSE
			PRINT +美味しいカクテル(7)
		ENDIF
		実効値 += 7
ENDSELECT

;PLAYERの料理技能
IF ABL:PLAYER:料理技能 > 0 && 製法 != ""
	IF LANGUAGE == "ENG"
		PRINTFORML +%CALLNAME:PLAYER%`s cooking skills ({ABL:PLAYER:料理技能})
	ELSE
		PRINTFORML +%CALLNAME:PLAYER%の料理技能({ABL:PLAYER:料理技能})
	ENDIF
	実効値 += ABL:PLAYER:料理技能
ENDIF

