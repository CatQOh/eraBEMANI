;-------------------------------------------------
;お酒を飲ませる
;-------------------------------------------------
@USERCOM_ABLE_お酒を飲ませる
#FUNCTION
#DIM DYNAMIC LCOUNT
;ゲーセンに居る場合はできない
IF LANGUAGE == "ENG"
	コマンド実行条件 += "You can`t go to an arcade without a food court./"
ELSE
	コマンド実行条件 += "ゲーセンではフードコートが無いと不可/"
ENDIF
SIF TEQUIP:ゲームセンター && !GC:フードコート
	COMRESULT = 0
;上級売春中は不可
コマンド実行条件 += I18N("上級売春中は実行不可/")
SIF 上級売春中
	COMRESULT = 0
;拘束中はダメ
コマンド実行条件 += I18N("拘束中は実行できない/")
SIF TEQUIP:アイマスク || TEQUIP:縄 || TEQUIP:ボールギャグ || TEQUIP:触手
	COMRESULT = 0
;アニマルだと無理
コマンド実行条件 += I18N("対象が[|0|]の場合は実行できない/", ,I18N("アニマル", "TALENT"))
SIF TALENT:アニマル
	COMRESULT = 0

;妊娠中は飲ませされない
IF LANGUAGE == "ENG"
	コマンド実行条件 += "Cannot be executed while the target is pregnant/"
ELSE
	コマンド実行条件 += I18N("対象が妊娠中は実行できない/")
ENDIF
SIF TALENT:妊娠
	COMRESULT = 0

;機械と無機物は飲めない
コマンド実行条件 += I18N("対象が[無機物]or[機械]だと実行できない/")
SIF TALENT:無機物 || CSTR:種族 == "機械"
	COMRESULT = 0

コマンド実行条件 += I18N("睡眠中は実行できない/")
SIF TEQUIP:睡眠
	COMRESULT = 0
IF MOD:STS
	コマンド実行条件 += I18N("屍姦中は実行できない/")
	SIF CFLAG:死亡
		COMRESULT = 0
ENDIF

;お酒持ってないとダメ ただしお正月はお屠蘇があるのでおｋ
;コマンド実行条件 += "お酒アイテムが必要/"
;IF MONTH == 1 && DAYS == 1
;	RETURNF COMRESULT
;ELSEIF COMRESULT
;	SIF SUMARRAY(ITEM, 250, 300) == 0
;		COMRESULT = 0
;	;SIF レシピ判定("自家醸造日本酒") == 2 || レシピ判定("自家製ワイン") == 2 || レシピ判定("自家製ウイスキー") == 2 || レシピ判定("自家醸造ビール") == 2
;	;	LOCAL = 1
;ENDIF

RETURNF COMRESULT

@COM_お酒を飲ませる
#DIM DYNAMIC ALC
#DIM DYNAMIC お酒
#DIMS DYNAMIC 製法
#DIM DYNAMIC 材料, 3
#DIM DYNAMIC LCOUNT

VARSET 材料, 0

IF TEQUIP:ゲームセンター
	IF LANGUAGE == "ENG"
		CALL PASELIL, @"What would you like to order？(300＄ each)"
		PRINTL [1] Draft beer
		PRINTL [2] High ball
		PRINTL [3] Lemon sour
		PRINTL [100] let's stop after all
	ELSE
		CALL PASELIL, @"何を注文しますか？(各300＄)"
		PRINTL [1] 生ビール
		PRINTL [2] ハイボール
		PRINTL [3] レモンサワー
		PRINTL [100] やっぱりやめる
	ENDIF
	BINPUT
	SELECTCASE RESULT
		CASE 1
			酒名 = 生ビール
			製法 = ビール
			ALC = 5
		CASE 2
			酒名 = ハイボール
			製法 = ハイボール
			ALC = 7
		CASE 3
			酒名 = レモンサワー
			製法 = カクテル
			ALC = 3
		CASE 100
			IF LANGUAGE == "ENG"
				PRINTFORMW Serving alcohol was cancelled
			ELSE
				PRINTFORMW お酒を飲ませるのを止めました
			ENDIF
			RETURN 0
	ENDSELECT
	GOTO 判定
ENDIF
PRINTFORML %I18N("何を飲ませますか")%？
IF LANGUAGE == "ENG"
	SIF ITEM:スーパードライ || ITEM:一番搾り || ITEM:プレミアムモルツ || ITEM:ヱビス || ITEM:ほろよい || ITEM:ストロングゼロ
		PRINTL [1] Canned drinks
	SIF ITEM:皆伝; || レシピ判定("自家醸造日本酒") == 2
		PRINTL [2] All stories(Japanese Sake)
	SIF ITEM:アルパカ; || レシピ判定("自家製ワイン") == 2
		PRINTL [3] Alpaca(wine)
	SIF ITEM:魔王
		PRINTL [4] Demon King(Shochu)
	SIF ITEM:倉吉; || レシピ判定("自家製ウイスキー") == 2
		PRINTL [5] Kurayoshi(whiskey)
	SIF ITEM:スペリオール
		PRINTL [6] Superior(rum)
	SIF ITEM:ビーフィーター
		PRINTL [7] Beefeater(gin)
	SIF ITEM:アブソルート
		PRINTL [8] Absolute(Vodka)
	SIF ITEM:カルーア
		PRINTL [9] Kahlua
	SIF MONTH == 1 && DAYS == 1
		PRINTL [10] Otoso(Alc.2%)
	SIF レシピ判定("自家醸造日本酒") == 2
		PRINTL [11] Homemade sake
	SIF レシピ判定("自家製ワイン") == 2
		PRINTL [12] Homemade wine
	SIF レシピ判定("自家製ウイスキー") == 2
		PRINTL [13] Homemade whiskey

	;SIF ITEM:スピリタス
	;	PRINTL [10] スピリタス
	PRINTL [100] Better to stop after all
ELSE
	SIF ITEM:スーパードライ || ITEM:一番搾り || ITEM:プレミアムモルツ || ITEM:ヱビス || ITEM:ほろよい || ITEM:ストロングゼロ
		PRINTL [1] 缶飲料類
	SIF ITEM:皆伝; || レシピ判定("自家醸造日本酒") == 2
		PRINTL [2] 皆伝(日本酒)
	SIF ITEM:アルパカ; || レシピ判定("自家製ワイン") == 2
		PRINTL [3] アルパカ(ワイン)
	SIF ITEM:魔王
		PRINTL [4] 魔王(焼酎)
	SIF ITEM:倉吉; || レシピ判定("自家製ウイスキー") == 2
		PRINTL [5] 倉吉(ウイスキー)
	SIF ITEM:スペリオール
		PRINTL [6] スペリオール(ラム)
	SIF ITEM:ビーフィーター
		PRINTL [7] ビーフィーター(ジン)
	SIF ITEM:アブソルート
		PRINTL [8] アブソルート(ウォッカ)
	SIF ITEM:カルーア
		PRINTL [9] カルーア
	SIF MONTH == 1 && DAYS == 1
		PRINTL [10] お屠蘇(Alc.2%)
	SIF レシピ判定("自家醸造日本酒") == 2
		PRINTL [11] 自家醸造日本酒
	SIF レシピ判定("自家製ワイン") == 2
		PRINTL [12] 自家製ワイン
	SIF レシピ判定("自家製ウイスキー") == 2
		PRINTL [13] 自家製ウイスキー

	;SIF ITEM:スピリタス
	;	PRINTL [10] スピリタス
	PRINTL [100] やっぱりやめる
ENDIF
SIF ISSKIP()
	RETURN
BINPUT
SELECTCASE RESULT
	CASE 1
		IF LANGUAGE == "ENG"
			PRINTL Which drink do you want to serve？
			SIF ITEM:スーパードライ
				PRINTL [0] Superdry(Alc.5%)
			SIF ITEM:一番搾り
				PRINTL [1] Ichiban Shibori(Alc.5%)
			SIF ITEM:プレミアムモルツ
				PRINTL [2] Premium Malt`s(Alc.5%)
			SIF ITEM:ヱビス
				PRINTL [3] Yebisu(Alc.5%)
			SIF ITEM:ほろよい
				PRINTL [4] Horoyoi(Alc.3%)
			SIF ITEM:ストロングゼロ
				PRINTL [5] Strong zero(Alc.9%)
			SIF レシピ判定("自家醸造ビール") == 2
				PRINTL [6] Home brewed beer(Alc.5%)
		ELSE
			PRINTFORML %I18N("何を飲ませますか")%？
			SIF ITEM:スーパードライ
				PRINTL [0] スーパードライ(Alc.5%)
			SIF ITEM:一番搾り
				PRINTL [1] 一番搾り(Alc.5%)
			SIF ITEM:プレミアムモルツ
				PRINTL [2] プレミアムモルツ(Alc.5%)
			SIF ITEM:ヱビス
				PRINTL [3] ヱビス(Alc.5%)
			SIF ITEM:ほろよい
				PRINTL [4] ほろよい(Alc.3%)
			SIF ITEM:ストロングゼロ
				PRINTL [5] ストロングゼロ(Alc.9%)
			SIF レシピ判定("自家醸造ビール") == 2
				PRINTL [6] 自家醸造ビール(Alc.5%)
		ENDIF
		BINPUT
		SELECTCASE RESULT
			CASE 0 TO 3, 6
				IF RESULT == 6
					お酒 = -1
				ELSE
					お酒 = RESULT+250
				ENDIF
				IF ITEM:ジンジャーエール || ITEM:レモンジュース || ITEM:アルパカ || レシピ判定("レモンジュース") == 2 || ITEM:トマトジュース || レシピ判定("トマトジュース") == 2 || レシピ判定("自家製ワイン")
					IF LANGUAGE == "ENG"
						IF お酒 == -1
							PRINTL How do you serve home-brewed beer？
						ELSE
							PRINTFORML Do you want to serve %I18N(ITEMNAME:お酒)%？
						ENDIF
						PRINTL [1] As it is(Alc.5%)
						SIF ITEM:ジンジャーエール
							PRINTL [2] Shandygaff(Alc.3%)
						SIF ITEM:レモンジュース || レシピ判定("レモンジュース") == 2
							PRINTL [3] Panache(Alc.3%)
						SIF ITEM:アルパカ || レシピ判定("自家製ワイン") == 2
							PRINTL [4] Beer spritzer(Alc.8%)
						SIF ITEM:トマトジュース || レシピ判定("トマトジュース") == 2
							PRINTL [5] Red eye(Alc.3%)
					ELSE
						IF お酒 == -1
							PRINTL 自家醸造ビールをどのように飲ませますか？
						ELSE
							PRINTFORML %ITEMNAME:お酒%をどのように飲ませますか？
						ENDIF
						PRINTL [1] そのまま(Alc.5%)
						SIF ITEM:ジンジャーエール
							PRINTL [2] シャンディガフ(Alc.3%)
						SIF ITEM:レモンジュース || レシピ判定("レモンジュース") == 2
							PRINTL [3] パナシェ(Alc.3%)
						SIF ITEM:アルパカ || レシピ判定("自家製ワイン") == 2
							PRINTL [4] ビアスプリッツァー(Alc.8%)
						SIF ITEM:トマトジュース || レシピ判定("トマトジュース") == 2
							PRINTL [5] レッドアイ(Alc.3%)
					ENDIF
					BINPUT
					SELECTCASE RESULT
						CASE 1
							IF お酒 == -1
								酒名 = 自家醸造ビール
							ELSE
								酒名 = %ITEMNAME:(RESULT+250)%
							ENDIF
							製法 = ビール
							ALC = 5
						CASE 2
							製法 = ビール
							酒名 = シャンディガフ
							材料:0 = GETNUM(ITEM, "ジンジャーエール")
							ALC = 3
						CASE 3
							製法 = ビール
							酒名 = パナシェ
							SIF レシピ判定("レモンジュース") != 2
								材料:0 = GETNUM(ITEM, "レモンジュース")
							ALC = 3
						CASE 4
							製法 = ビール
							酒名 = ビアスプリッツァー
							SIF レシピ判定("自家製ワイン") != 2
								材料:0 = GETNUM(ITEM, "アルパカ")
							ALC = 8
						CASE 5
							製法 = ビール
							酒名 = レッドアイ
							SIF レシピ判定("トマトジュース") != 2
								材料:0 = GETNUM(ITEM, "トマトジュース")
							ALC = 3
					ENDSELECT
				ELSE
					酒名 = %ITEMNAME:(RESULT+250)%
					製法 = ビール
					ALC = 5
				ENDIF
			CASE 4
				お酒 = RESULT+250
				酒名 = ほろよい
				ALC = 3
			CASE 5
				お酒 = RESULT+250
				酒名 = ストロングゼロ
				ALC = 9
			;CASE 6
			;	酒名 = 自家醸造ビール
		ENDSELECT
	CASE 2, 11
		IF LANGUAGE == "ENG"
			IF RESULT == 11
				お酒 = -1
				PRINTL How do you serve home-brewed sake？
			ELSE
				お酒 = GETNUM(ITEM, "皆伝")
				PRINTL How do you serve a Kaiden drink？
			ENDIF
			PRINTL [1] As is(Alc.12%)
			PRINTL [2] Hot sake(Alc.12%)
			SIF ITEM:ライムジュース || レシピ判定("ライムジュース") == 2
				PRINTL [3] Samurai rock(Alc.3～10%)
		ELSE
			IF RESULT == 11
				お酒 = -1
				PRINTL 自家醸造日本酒をどのように飲ませますか？
			ELSE
				お酒 = GETNUM(ITEM, "皆伝")
				PRINTL 皆伝をどのように飲ませますか？
			ENDIF
			PRINTL [1] そのまま(Alc.12%)
			PRINTL [2] 熱燗(Alc.12%)
			SIF ITEM:ライムジュース || レシピ判定("ライムジュース") == 2
				PRINTL [3] サムライロック(Alc.3～10%)
		ENDIF
		BINPUT
		SELECTCASE RESULT
			CASE 1
				IF お酒 == -1
					酒名 = 自家醸造日本酒
				ELSE
					酒名 = 皆伝
				ENDIF
				ALC = 12
			CASE 2
				IF お酒 == -1
					酒名 = 自家醸造日本酒の熱燗
				ELSE
					酒名 = 皆伝の熱燗
				ENDIF
				製法 = 熱燗
				ALC = 12
			CASE 3
				製法 = ライム割り
				酒名 = サムライロック
				PRINTFORML %I18N("アルコール度数を決めてください")%(3～10\%)
				CALL TWO_DIGIT, 10, "%", 3
				ALC = RESULT
		ENDSELECT
	CASE 3, 12
		IF RESULT == 12
			お酒 = -1
			酒名 = 自家製ワイン
		ELSE
			お酒 = GETNUM(ITEM, "アルパカ")
			酒名 = アルパカ
		ENDIF
		ALC = 12
	CASE 4
		お酒 = GETNUM(ITEM, "魔王")
		IF LANGUAGE == "ENG"
			PRINTL How do you make the Demon King drink？
			PRINTL [1] Water split(Alc.5～20%)
			PRINTL [2] Warm water(Alc.5～20%)
			PRINTL [3] Rock(Alc.22%)
			PRINTL [4] Straight(Alc.25%)
			SIF ITEM:炭酸水
				PRINTL [5] Shochu highball(Alc.5～20%)
			SIF ITEM:コーラ
				PRINTL [6] Shochu coke(Alc.5～20%)
			SIF ITEM:ジンジャーエール
				PRINTL [7] Shochu ginger(Alc.5～20%)
			SIF リソース:精液 >= 100
				PRINTL [8] semen split(Alc.5～20%)
			SIF リソース:母乳 >= 100
				PRINTL [9] Breast milk split(Alc.5～20%)
		ELSE
			PRINTL 魔王をどのように飲ませますか？
			PRINTL [1] 水割り(Alc.5～20%)
			PRINTL [2] お湯割り(Alc.5～20%)
			PRINTL [3] ロック(Alc.22%)
			PRINTL [4] ストレート(Alc.25%)
			SIF ITEM:炭酸水
				PRINTL [5] 焼酎ハイボール(Alc.5～20%)
			SIF ITEM:コーラ
				PRINTL [6] 焼酎コーク(Alc.5～20%)
			SIF ITEM:ジンジャーエール
				PRINTL [7] 焼酎ジンジャー(Alc.5～20%)
			SIF リソース:精液 >= 100
				PRINTL [8] 精液割り(Alc.5～20%)
			SIF リソース:母乳 >= 100
				PRINTL [9] 母乳割り(Alc.5～20%)
		ENDIF
		BINPUT
		SELECTCASE RESULT
			CASE 1, 2, 5, 6, 7, 8, 9
				SELECTCASE RESULT
					CASE 1
						製法 = 水割り
						酒名 = 焼酎の水割り
					CASE 2
						製法 = お湯割り
						酒名 = 焼酎のお湯割り
					CASE 5
						製法 = ハイボール
						酒名 = 焼酎ハイボール
					CASE 6
						製法 = コーラ割り
						酒名 = 焼酎コーク
					CASE 7
						製法 = ジンジャー割り
						酒名 = 焼酎ジンジャー
					CASE 8
						製法 = 精液割り
						酒名 = ザーメンサワー
					CASE 9
						製法 = 母乳割り
						酒名 = 母乳サワー
					CASE 10
						製法 = 粘液混ぜ
						酒名 = 焼酎ゼリー
				ENDSELECT
				PRINTFORML %I18N("アルコール度数を決めてください")%(5～20\%)
				CALL TWO_DIGIT, 20, "%", 5
				ALC = RESULT
			CASE 3
				酒名 = 焼酎のロック
				ALC = 22
			CASE 4
				酒名 = 焼酎のストレート
				ALC = 25
		ENDSELECT
	CASE 5, 13
		IF RESULT == 13
			お酒 = -1
			IF LANGUAGE == "ENG"
				PRINTL How do you drink homemade whiskey?
			ELSE
				PRINTL 自家製ウイスキーをどのように飲ませますか？
			ENDIF
		ELSE
			お酒 = GETNUM(ITEM, "倉吉")
			IF LANGUAGE == "ENG"
				PRINTL How do you make Kurayoshi drink?
			ELSE
				PRINTL 倉吉をどのように飲ませますか？
			ENDIF
		ENDIF
		IF LANGUAGE == "ENG"
			PRINTL [1] Water split(Alc.9～35%)
			PRINTL [2] Warm water(Alc.9～35%)
			PRINTL [3] Rock(Alc.37%)
			PRINTL [4] Straight(Alc.40%)
			SIF ITEM:炭酸水
				PRINTL [5] Highball(Alc.9～35%)
			SIF ITEM:コーラ
				PRINTL [6] Coke high(Alc.9～35%)
			SIF ITEM:ジンジャーエール
				PRINTL [7] Ginger high(Alc.9～35%)
			SIF リソース:精液 >= 100
				PRINTL [8] Semen highball(Alc.9～35%)
			SIF リソース:母乳 >= 100
				PRINTL [9] Breast milk highball(Alc.9～35%)
			SIF リソース:粘液 >= 100
				PRINTL [10] Whiskey jelly(Alc.9～35%)
		ELSE
			PRINTL [1] 水割り(Alc.9～35%)
			PRINTL [2] お湯割り(Alc.9～35%)
			PRINTL [3] ロック(Alc.37%)
			PRINTL [4] ストレート(Alc.40%)
			SIF ITEM:炭酸水
				PRINTL [5] ハイボール(Alc.9～35%)
			SIF ITEM:コーラ
				PRINTL [6] コークハイ(Alc.9～35%)
			SIF ITEM:ジンジャーエール
				PRINTL [7] ジンジャーハイ(Alc.9～35%)
			SIF リソース:精液 >= 100
				PRINTL [8] ザーメンハイボール(Alc.9～35%)
			SIF リソース:母乳 >= 100
				PRINTL [9] 母乳ハイボール(Alc.9～35%)
			SIF リソース:粘液 >= 100
				PRINTL [10] ウイスキージュレ(Alc.9～35%)
		ENDIF
		BINPUT
		SELECTCASE RESULT
			CASE 1, 2, 5, 6, 7, 8, 9, 10
				SELECTCASE RESULT
					CASE 1
						製法 = 水割り
						酒名 = ウイスキーの水割り
					CASE 2
						製法 = お湯割り
						酒名 = ウイスキーのお湯割り
					CASE 5
						製法 = ハイボール
						酒名 = ハイボール
					CASE 6
						製法 = コーラ割り
						酒名 = コークハイ
					CASE 7
						製法 = ジンジャー割り
						酒名 = ジンジャーハイ
					CASE 8
						製法 = 精液割り
						酒名 = ザーメンハイボール
					CASE 9
						製法 = 母乳割り
						酒名 = 母乳ハイボール
					CASE 10
						製法 = 粘液混ぜ
						酒名 = ウイスキージュレ
				ENDSELECT
				PRINTFORML %I18N("アルコール度数を決めてください")%(9～35\%)
				CALL TWO_DIGIT, 35, "%", 9
				ALC = RESULT
			CASE 3
				IF お酒 == -1
					酒名 = 自家製ウイスキーのロック
				ELSE
					酒名 = 倉吉のロック
				ENDIF
				ALC = 37
			CASE 4
				IF お酒 == -1
					酒名 = 自家製ウイスキーのストレート
				ELSE
					酒名 = 倉吉のストレート
				ENDIF
				ALC = 40
		ENDSELECT
	CASE 6
		お酒 = GETNUM(ITEM, "スペリオール")
		IF LANGUAGE == "ENG"
			PRINTL How do you serve a Superior？
			PRINTL [1] Straight(Alc.40%)
			PRINTL [2] rock(Alc.37%)
			SIF ITEM:コーラ
				PRINTL [3] Cuba river(Alc.9～35%)
			SIF ITEM:ライムジュース || レシピ判定("ライムジュース") == 2
				PRINTL [4] Daiquiri(Alc.20～35%)
			SIF ITEM:トニックウォーター
