					CALL TWO_DIGIT, 35, "%", 9
				ENDIF
				ALC = RESULT
		ENDSELECT
	CASE 9
		お酒 = GETNUM(ITEM, "カルーア")
		IF LANGUAGE == "ENG"
			PRINTL How do you serve kahlua？
			PRINTL [1] Straight(Alc.20%)
			PRINTL [2] Rock(Alc.18%)
			;牛乳は生活必需品だから常にある（暴論）
			PRINTL [3] Kahlua milk(Alc.5～15%)
			SIF ITEM:炭酸水
				PRINTL [4] Kahlua soda(Alc.5～15%)
			SIF ITEM:アブソルート
				PRINTL [5] Black Russian(Alc.25～37%)
			SIF リソース:母乳 >= 100
				PRINTL [6] Kahlua breast milk(Alc.5～15%)
			SIF リソース:粘液 >= 100
				PRINTL [7] Karou jelly(Alc.5～15%)
		ELSE
			PRINTL カルーアをどのように飲ませますか？
			PRINTL [1] ストレート(Alc.20%)
			PRINTL [2] ロック(Alc.18%)
			;牛乳は生活必需品だから常にある（暴論）
			PRINTL [3] カルーアミルク(Alc.5～15%)
			SIF ITEM:炭酸水
				PRINTL [4] カルーアソーダ(Alc.5～15%)
			SIF ITEM:アブソルート
				PRINTL [5] ブラックルシアン(Alc.25～37%)
			SIF リソース:母乳 >= 100
