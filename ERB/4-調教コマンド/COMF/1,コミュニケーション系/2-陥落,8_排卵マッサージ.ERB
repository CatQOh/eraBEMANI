;-------------------------------------------------
;排卵マッサージ
;-------------------------------------------------
@USERCOM_ABLE_排卵マッサージ
#FUNCTION
コマンド実行条件 += I18N("ゲーセンでは実行不可/")
SIF TEQUIP:ゲームセンター
	COMRESULT = 0
;一回の調教で一回まで
コマンド実行条件 += I18N("1回の調教で1回まで/")
SIF TFLAG:排卵マッサージ
	COMRESULT = 0
;既に妊娠してるとできない
コマンド実行条件 += I18N("対象が妊娠中は実行できない/")
SIF TALENT:妊娠 || TALENT:妊娠確定
	COMRESULT = 0
;奴隷が恋慕か親愛で実行者が主人でないとダメ
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"Target must have [%I18N("恋慕", "TALENT")%][%I18N("親愛", "TALENT")%] and it cannot be executed unless the executor is the master./"
ELSE
	コマンド実行条件 += "[恋慕][親愛]かつ実行者が主人じゃないと実行できない/"
ENDIF
SIF FALLTYPE(TARGET) != 1 || PLAYER != MASTER
	COMRESULT = 0
;拘束中はダメ
コマンド実行条件 += I18N("拘束中は実行できない/")
SIF TEQUIP:アイマスク || TEQUIP:縄 || TEQUIP:ボールギャグ || TEQUIP:触手
	COMRESULT = 0
;生殖機能が無いとダメ
IF LANGUAGE == "ENG"
	コマンド実行条件 += "Cannot be executed if the target does not have reproductive function (♀)/"
ELSE
	コマンド実行条件 += "対象に生殖機能(♀)が無いと実行できない/"
ENDIF
SIF !生殖機能♀(TARGET)
	COMRESULT = 0
;アニマルはダメ
コマンド実行条件 += I18N("対象が[|0|]の場合は実行できない/", ,I18N("アニマル", "TALENT"))
SIF TALENT:アニマル
	COMRESULT = 0
コマンド実行条件 += I18N("睡眠中は実行できない/")
SIF TEQUIP:睡眠
	COMRESULT = 0
IF MOD:STS
	コマンド実行条件 += I18N("屍姦中は実行できない/")
	SIF CFLAG:死亡
		COMRESULT = 0
ENDIF
IF MOD:STS
	コマンド実行条件 += "実行者に腕がないと実行できない/"
	SIF 腕欠損(PLAYER) == 2
		COMRESULT = 0
ENDIF

RETURNF COMRESULT

@COM_排卵マッサージ
PRINTFORML %I18N("排卵マッサージ", "TRAIN")%
CALL KOJO_MESSAGE_COM

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
LOSEBASE:体力 += 5
LOSEBASE:気力 += 10

SOURCE:情愛 = 1000
SOURCE:性行動 = 100
SOURCE:達成 = 300

;-------------------------------------------------
;絶頂チェック
;-------------------------------------------------
CALL SOURCE_CHECK_CVAB

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
CALL SAMEN_CHECK_T

CALL SAMEN_SHOOT_T, 0, NOWEX:射精

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL EXPUP, "愛情経験", 3

CALL EXPUP, "医療経験", 1, PLAYER

;排卵マッサージフラグ お風呂だと上がりやすい
IF TEQUIP:お風呂場
	;最大が10
	SIF CFLAG:排卵マッサージ <= 9
		CFLAG:排卵マッサージ += 2
	SIF CFLAG:排卵マッサージ > 10
		CFLAG:排卵マッサージ = 10
ELSE
	;最大が7
	SIF CFLAG:排卵マッサージ <= 6
		CFLAG:排卵マッサージ++
ENDIF

TFLAG:排卵マッサージ = 1

RETURN 1
