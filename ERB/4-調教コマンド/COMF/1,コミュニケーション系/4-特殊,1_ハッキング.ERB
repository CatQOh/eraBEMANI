;-------------------------------------------------
;ハッキング
;-------------------------------------------------
@USERCOM_ABLE_ハッキング
#FUNCTION
;対象が機械じゃないとダメ
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"Cannot be executed unless target have [%I18N("機械", "TALENT")%]/"
ELSE
	コマンド実行条件 += "対象が[機械]じゃないと実行できない/"
ENDIF
SIF CSTR:種族 != "機械"
	COMRESULT = 0
;PLAYERが工作技能LV3以上無いとダメ
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"%I18N("工作技能", "ABL")%LV3 or above is required./"
ELSE
	コマンド実行条件 += "実行者の工作技能LV3以上必要/"
ENDIF
SIF ABL:PLAYER:工作技能 < 3
	COMRESULT = 0

RETURNF COMRESULT

@COM_ハッキング
#DIM DYNAMIC スキル
;あえてスキルキャップは無し
スキル = ABL:PLAYER:工作技能
;ナニニシマスカ？
IF LANGUAGE == "ENG"
	PRINTL what do you do with hacking？
	PRINTL [1] - Apply overload (great pain effect)
ELSE
	PRINTL ハッキングで何をしますか？
	PRINTL [1] - 過電流を掛ける（苦痛効果大）
ENDIF
IF スキル >= 5
	IF LANGUAGE == "ENG"
		IF PENIS(TARGET)
			PRINTL [2] - Activate ejaculation protocol
		ELSEIF SEX(TARGET) == 2
			PRINTL [2] - Activate C orgasm protocol
		ENDIF
		PRINTL [3] - Activate B orgasm protocol
	ELSE
		IF PENIS(TARGET)
			PRINTL [2] - 射精の信号を送る
		ELSEIF SEX(TARGET) == 2
			PRINTL [2] - Ｃ絶頂の信号を送る
		ENDIF
		PRINTL [3] - Ｂ絶頂の信号を送る
	ENDIF
ENDIF
IF スキル >= 7
	IF LANGUAGE == "ENG"
		SIF VAGINA(TARGET)
			PRINTL [4] - Activate V orgasm protocol
		PRINTL [5] - Sodomize orgasm protocol activate
	ELSE
		SIF VAGINA(TARGET)
			PRINTL [4] - Ｖ絶頂の信号を送る
		PRINTL [5] - Ａ絶頂の信号を送る
	ENDIF
ENDIF
IF !CFLAG:死亡 && !TEQUIP:睡眠
	IF LANGUAGE == "ENG"
		SIF スキル >= 9
			PRINTL [6] - Primary slave drive (ignoring command execution judgment)
		SIF スキル >= 10 && MOD:STS
			PRINTL [7] - Activate self-destruction（Subject will die）
	ELSE
		SIF スキル >= 9
			PRINTL [6] - 従属プログラムを実行（コマンド実行判定無視）
		SIF スキル >= 10 && MOD:STS
			PRINTL [7] - 自爆命令を実行（キャラロスト）
	ENDIF
ENDIF
IF LANGUAGE == "ENG"
	SIF NOF(TARGET) < 10000
		PRINTFORML [8] - Analyze configuration information (\@ 分析データ:(NOF(TARGET)) ? Analysis data has been obtained # Get analytics data for replication \@）
ELSE
	SIF NOF(TARGET) < 10000
		PRINTFORML [8] - 構成情報を分析する（\@ 分析データ:(NOF(TARGET)) ? 分析データは入手済み # 複製用の分析データを入手 \@）
ENDIF
PRINTFORML [0] - %I18N("キャンセル")%

SIF ISSKIP()
	RETURN
BINPUT
SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE 1
		;機械は苦痛を1/10にするので大きめの値にする
		LOSEBASE:体力 += 200
		LOSEBASE:気力 += 300
		SOURCE:苦痛 = スキル*20000
		SOURCE:屈従 = スキル*500
		ハッキング命令 = 過電流
	CASE 2
		LOSEBASE:体力 += 50
		LOSEBASE:気力 += 50
		IF PENIS(TARGET)
			BASE:射精 += スキル*(MAXBASE:射精/5)
			ハッキング命令 = 射精
		ELSE
			PALAM:快Ｃ += スキル*2000
			ハッキング命令 = Ｃ絶頂
		ENDIF
	CASE 3
		LOSEBASE:体力 += 50
		LOSEBASE:気力 += 50
		PALAM:快Ｂ += スキル*2000
		ハッキング命令 = Ｂ絶頂
	CASE 4
		LOSEBASE:体力 += 80
		LOSEBASE:気力 += 50
		PALAM:快Ｖ += スキル*2000
		ハッキング命令 = Ｖ絶頂
	CASE 5
		LOSEBASE:体力 += 80
		LOSEBASE:気力 += 50
		PALAM:快Ａ += スキル*2000
		ハッキング命令 = Ａ絶頂
	CASE 6
		TFLAG:実行判定無視 = 10000
		ハッキング命令 = 従属
	CASE 7
		IF LANGUAGE == "ENG"
			PRINTL Execute the self-destruct command. Are you sure?
		ELSE
			PRINTL 自爆命令を実行します。本当によろしいですか？
		ENDIF
		PRINTFORML [0] - %I18N("はい")%
		PRINTFORML [1] - %I18N("いいえ")%
		BINPUT
		SELECTCASE RESULT
			CASE 0
				LOSEBASE:体力 = POWER(RAND(5, 9), RAND(15, 21))
				ハッキング命令 = 自爆
				リソース:マテリアル += 3
			CASE 1
				RETURN 0
		ENDSELECT
	CASE 8
		SIF !分析データ:(NOF(TARGET))
			分析データ:(NOF(TARGET)) = 1
		ハッキング命令 = 分析
ENDSELECT

;ハッキングするとものすごく不快感を感じる
IF ハッキング命令 != "自爆"
	SOURCE:不潔 = 2000
	SOURCE:逸脱 = 2000
	SOURCE:反感 = 2000
ENDIF


PRINTFORML ハッキング（%ハッキング命令%）
CALL KOJO_MESSAGE_COM

SIF ハッキング命令 == "自爆"
	RETURN 1

;-------------------------------------------------
;絶頂チェック
;-------------------------------------------------
CALL SOURCE_CHECK_CVAB

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
CALL SAMEN_CHECK_T, 0

CALL SAMEN_SHOOT_T, 0, NOWEX:射精

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL EXPUP_BASE, 0, 3

RETURN 1
