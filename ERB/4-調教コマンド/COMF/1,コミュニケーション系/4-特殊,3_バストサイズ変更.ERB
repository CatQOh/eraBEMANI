@USERCOM_ABLE_バストサイズ変更
#FUNCTION
;溶ける快のみ行える
コマンド実行条件 += "実行者か対象に[溶ける快]が必要/"
SIF !TALENT:溶ける快 && !TALENT:PLAYER:溶ける快
	COMRESULT = 0
コマンド実行条件 += I18N("睡眠中は実行できない/")
SIF TEQUIP:睡眠
	COMRESULT = 0
IF MOD:STS
	コマンド実行条件 += I18N("屍姦中は実行できない/")
	SIF CFLAG:死亡
		COMRESULT = 0
ENDIF

RETURNF COMRESULT

@COM_バストサイズ変更

PRINTFORML □%I18N("誰が行いますか？")%
SIF TALENT:溶ける快
	PRINTFORML 　[1] %CALLNAME:TARGET%(%バストサイズ(TALENT:バストサイズ)%)
SIF TALENT:PLAYER:溶ける快
	PRINTFORML 　[2] %CALLNAME:PLAYER%(%バストサイズ(TALENT:PLAYER:バストサイズ)%)
PRINTFORML 　[0] %I18N("キャンセル")%


SIF ISSKIP()
	RETURN
BINPUT
SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE 1
		IF TALENT:溶ける快
			PRINTFORML %I18N("どの程度の大きさにしますか")%？
			PRINTFORML [1] - %I18N("絶壁", "TALENT")%
			PRINTFORML [2] - %I18N("貧乳", "TALENT")%
			PRINTFORML [3] - %I18N("並乳", "TALENT")%
			PRINTFORML [4] - %I18N("巨乳", "TALENT")%
			PRINTFORML [5] - %I18N("豊乳", "TALENT")%
			PRINTFORML [6] - %I18N("爆乳", "TALENT")%
			IF MOD:バストサイズ限界突破
				PRINTFORML [7] - %I18N("爆乳", "TALENT")%+1
				PRINTFORML [8] - %I18N("爆乳", "TALENT")%+2
				PRINTFORML [9] - %I18N("爆乳", "TALENT")%+3
			ENDIF
			PRINTFORML [0] - %I18N("戻る")%
			BINPUT
			SELECTCASE RESULT
				CASE 0
					RETURN 0
				CASE 1 TO 9
					TALENT:バストサイズ = RESULT
					RETURN 1
			ENDSELECT
		ENDIF
	CASE 2
		IF TALENT:PLAYER:溶ける快
			PRINTFORML %I18N("どの程度の大きさにしますか")%？
			PRINTFORML [1] - %I18N("絶壁", "TALENT")%
			PRINTFORML [2] - %I18N("貧乳", "TALENT")%
			PRINTFORML [3] - %I18N("並乳", "TALENT")%
			PRINTFORML [4] - %I18N("巨乳", "TALENT")%
			PRINTFORML [5] - %I18N("豊乳", "TALENT")%
			PRINTFORML [6] - %I18N("爆乳", "TALENT")%
			IF MOD:バストサイズ限界突破
				PRINTFORML [7] - %I18N("爆乳", "TALENT")%+1
				PRINTFORML [8] - %I18N("爆乳", "TALENT")%+2
				PRINTFORML [9] - %I18N("爆乳", "TALENT")%+3
			ENDIF
			PRINTFORML [0] - %I18N("戻る")%
			BINPUT
			SELECTCASE RESULT
				CASE 0
					RETURN 0
				CASE 1 TO 9
					TALENT:PLAYER:バストサイズ = RESULT
					RETURN 1
			ENDSELECT
		ENDIF
ENDSELECT
