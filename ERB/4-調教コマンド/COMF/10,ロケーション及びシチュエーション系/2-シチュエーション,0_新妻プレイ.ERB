;-------------------------------------------------
;新妻プレイ
;-------------------------------------------------
@USERCOM_ABLE_新妻プレイ
#FUNCTION
#DIM DYNAMIC 条件確定

;ゲーセンに居る場合はできない
コマンド実行条件 += I18N("ゲーセンでは実行不可/")
SIF TEQUIP:ゲームセンター
	COMRESULT = 0
;上級売春中は不可
コマンド実行条件 += I18N("上級売春中は実行不可/")
SIF 上級売春中
	COMRESULT = 0
;奴隷が恋慕か親愛でないとダメ
コマンド実行条件 += I18N("対象に[|0|]が必要/", , I18N("恋慕", "TALENT") + "][" + I18N("親愛", "TALENT"))
SIF !TALENT:恋慕 && !TALENT:親愛
	COMRESULT = 0
;解除はいつでも可能
SIF TEQUIP:エプロン && COMRESULT
	条件確定 = 1

;アイテム｢エプロン｣を持っていないとダメ
コマンド実行条件 += I18N("アイテム[|0|]が必要/", ,I18N("エプロン"))
SIF !ITEM:エプロン
	COMRESULT = 0
;助手じゃダメ
コマンド実行条件 += I18N("実行者が主人じゃないと実行できない/")
SIF PLAYER != MASTER
	COMRESULT = 0
;従順が3以上ないとダメ
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"Requires targets LV3 %I18N("従順", "ABL")% or higher/"
ELSE
	コマンド実行条件 += "対象の従順LV3以上が必要/"
ENDIF
SIF ABL:従順 < 3
	COMRESULT = 0
;野外プレイ中はダメ
コマンド実行条件 += I18N("野外プレイ中は実行できない/")
SIF TEQUIP:野外プレイ
	COMRESULT = 0
;羞恥プレイ中はダメ
コマンド実行条件 += I18N("羞恥プレイ中は実行できない/")
SIF TEQUIP:羞恥プレイ
	COMRESULT = 0
;お風呂場プレイ中はダメ
コマンド実行条件 += I18N("お風呂場では実行できない/")
SIF TEQUIP:お風呂場
	COMRESULT = 0
;触手調教中はダメ
コマンド実行条件 += I18N("触手召喚中は実行できない/")
SIF TEQUIP:触手
	COMRESULT = 0
;アニマルだと無理
コマンド実行条件 += I18N("対象が[|0|]の場合は実行できない/", ,I18N("アニマル", "TALENT"))
SIF TALENT:アニマル
	COMRESULT = 0
コマンド実行条件 += I18N("睡眠中は実行できない/")
SIF TEQUIP:睡眠
	COMRESULT = 0
IF MOD:STS
	コマンド実行条件 += I18N("屍姦中は実行できない/")
	SIF CFLAG:死亡
		COMRESULT = 0
ENDIF

IF 条件確定
	COMRESULT = 1
	RETURNF 1
ENDIF
RETURNF COMRESULT

@COM_新妻プレイ
PRINTFORML %I18N("新妻プレイ", "TRAIN")%
CALL KOJO_MESSAGE_COM

;着脱の処理
INVERTBIT TEQUIP:エプロン, 0

;-------------------------------------------------
;絶頂チェック
;-------------------------------------------------
CALL SOURCE_CHECK_CVAB

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
CALL SAMEN_CHECK_T, 0

CALL SAMEN_SHOOT_T, 0, NOWEX:射精

RETURN 1

;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM_新妻プレイ
;助手調教時は、エプロンを解除して関数終了
IF PLAYER != MASTER
	TEQUIP:エプロン = 0
	RETURN 0
ENDIF
IF LANGUAGE == "ENG"
	PRINTL ＜Apron play＞
ELSE
	PRINTL ＜新妻プレイ中＞
ENDIF

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
LOSEBASE:体力 += 0
LOSEBASE:気力 += 0

SOURCE:情愛 += 1000
SOURCE:恭順 += 5000
SOURCE:逸脱 += 500

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL EXPUP, "愛情経験", 1

RETURN 1
