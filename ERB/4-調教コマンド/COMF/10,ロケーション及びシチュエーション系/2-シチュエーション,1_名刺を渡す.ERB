;-------------------------------------------------
;名刺を渡す
;-------------------------------------------------
@USERCOM_ABLE_名刺を渡す
#FUNCTION
;上級売春中じゃないとできない
IF LANGUAGE == "ENG"
	コマンド実行条件 += "Can only be performed during advanced prostitution/"
ELSE
	コマンド実行条件 += "上級売春中にのみ実行可能/"
ENDIF
SIF 上級売春中 == 0
	COMRESULT = 0
;名刺が無い場合はできない
IF LANGUAGE == "ENG"
	コマンド実行条件 += "You can give your business card to up to 5 people at once (and keep them as regulars)/"
ELSE
	コマンド実行条件 += "一度に名刺を渡せる(常連としてキープできる)相手は5人まで/"
ENDIF
SIF CFLAG:MASTER:名刺 == 0
	COMRESULT = 0
;既に常連客候補の場合はできない
IF LANGUAGE == "ENG"
	コマンド実行条件 += "You cannot give your business card to someone who already has it/"
ELSE
	コマンド実行条件 += "既に名刺を持っている相手には渡せない/"
ENDIF
SIF CFLAG:常連客候補
	COMRESULT = 0

RETURNF COMRESULT

@COM_名刺を渡す
PRINTFORML %I18N("名刺を渡す", "TRAIN")%
CALL KOJO_MESSAGE_COM

;名刺の枚数が減る
CFLAG:MASTER:名刺--
CFLAG:常連客候補 = 1

RETURN 1

