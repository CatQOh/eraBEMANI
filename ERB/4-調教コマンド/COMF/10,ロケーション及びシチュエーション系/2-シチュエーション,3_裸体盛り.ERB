;-------------------------------------------------
;裸体盛り
;-------------------------------------------------
@USERCOM_ABLE_裸体盛り
#FUNCTION
#DIM DYNAMIC 条件確定

;ゲーセンに居る場合はできない
コマンド実行条件 += I18N("ゲーセンでは実行不可/")
SIF TEQUIP:ゲームセンター
	COMRESULT = 0
;上級売春中は不可
コマンド実行条件 += I18N("上級売春中は実行不可/")
SIF 上級売春中
	COMRESULT = 0
;露出癖5以上が条件
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"Requires target`s %I18N("露出癖", "TRAIN")% LV5 or higher/"
ELSE
	コマンド実行条件 += "対象の露出癖LV5以上必要/"
ENDIF
SIF ABL:露出癖 < 5
	COMRESULT = 0

;お風呂場プレイ中はダメ
コマンド実行条件 += I18N("お風呂場では実行できない/")
SIF TEQUIP:お風呂場
	COMRESULT = 0
;野外プレイ中は不可
IF LANGUAGE == "ENG"
	コマンド実行条件 += "Not available for outdoors play/"
ELSE
	コマンド実行条件 += "野外プレイでは実行不可/"
ENDIF
SIF TEQUIP:野外プレイ
	COMRESULT = 0
;触手調教中はダメ
コマンド実行条件 += I18N("触手召喚中は実行できない/")
SIF TEQUIP:触手
	COMRESULT = 0
;アニマルだと無理
コマンド実行条件 += I18N("対象が[|0|]の場合は実行できない/", ,I18N("アニマル", "TALENT"))
SIF TALENT:アニマル
	COMRESULT = 0
;素材が必要
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"Requires 2 types of [%I18N("魚")%] ingredients/"
ELSE
	コマンド実行条件 += "材料[魚]が2種類必要/"
ENDIF
SIF 材料判定("魚介類*2") < 2
	COMRESULT = 0
IF MOD:STS
	コマンド実行条件 += I18N("屍姦中は実行できない/")
	SIF CFLAG:死亡
		COMRESULT = 0
ENDIF

IF 条件確定
	COMRESULT = 1
	RETURNF 1
ENDIF
RETURNF COMRESULT

@COM_裸体盛り
#DIM DYNAMIC LCOUNT
SELECTCASE SEX(TARGET)
	CASE 0
		PRINTFORML %I18N("裸体盛り", "TRAIN")%
	CASE 1
		IF LANGUAGE == "ENG"
			PRINTL Male body platter
		ELSE
			PRINTL 男体盛り
		ENDIF
	CASE 2
		IF LANGUAGE == "ENG"
			PRINTL Female body platter
		ELSE
			PRINTL 女体盛り
		ENDIF
ENDSELECT

;脱衣処理
FOR LCOUNT, 0, 7
	TEQUIP:LCOUNT = 0
NEXT

CALL KOJO_MESSAGE_COM

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
LOSEBASE:体力 += 100
LOSEBASE:気力 += 200

SOURCE:露出 += 1500
SOURCE:屈従 += 500
SOURCE:逸脱 += 2000
SOURCE:反感 += 2000
SOURCE:不潔 += 3000

;-------------------------------------------------
;絶頂チェック
;-------------------------------------------------
CALL SOURCE_CHECK_CVAB

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
CALL SAMEN_CHECK_T, 0

CALL SAMEN_SHOOT_T, 0, NOWEX:射精
IF LANGUAGE == "ENG"
	PRINTL What do you do with this naked body?
	PRINTL [0] - Enjoy it here (training continues)
	PRINTL [1] - Everyone enjoys the delicious food (training completed)
ELSE
	PRINTL この裸体盛りをどうしますか？
	PRINTL [0] - この場で美味しくいただく（調教続行）
	PRINTL [1] - みんなで美味しくいただく（調教終了）
ENDIF
SIF ISSKIP()
	RETURN
BINPUT
SELECTCASE RESULT
	CASE 0
		IF LANGUAGE == "ENG"
			PRINTFORMW You decided to finish %CALLNAME:TARGET%`s naked body and continue training……
		ELSE
			PRINTFORMW %CALLNAME:TARGET%の裸体盛りを平らげ、調教を続行することにした……
		ENDIF
	CASE 1
		TFLAG:裸体盛り = 1
		TFLAG:料理 = 5
ENDSELECT

RETURN 1
