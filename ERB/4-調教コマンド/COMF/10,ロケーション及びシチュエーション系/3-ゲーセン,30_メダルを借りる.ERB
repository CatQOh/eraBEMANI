;-------------------------------------------------
;メダルを借りる
;-------------------------------------------------
@USERCOM_ABLE_メダルを借りる
#FUNCTION
;ゲーセンに居ないとダメ
コマンド実行条件 += I18N("ゲームセンターでのみ実行可能/")
SIF !TEQUIP:ゲームセンター
	COMRESULT = 0
;トイレに居るとダメ
コマンド実行条件 += I18N("トイレに居る場合は実行できない/")
SIF TEQUIP:トイレ
	COMRESULT = 0
;筐体あるか確認
IF LANGUAGE == "ENG"
	コマンド実行条件 += "It cannot be executed unless there is a coin exchange machine at the game center./"
ELSE
	コマンド実行条件 += "ゲーセンにメダル両替機を置いてないと実行できない/"
ENDIF
SIF !EXISTGAMES("メダル両替機")
	COMRESULT = 0

RETURNF COMRESULT

@COM_メダルを借りる

IF LANGUAGE == "ENG"
	PRINTL How many coins would you like to exchange？
	CALL PASELIL, @"[10] - 10 coins(100＄)"
	CALL PASELIL, @"[35] - 35 coins(300＄)"
	CALL PASELIL, @"[70] - 70 coins(500＄)"
	CALL PASELIL, @"[200] - 200 coins(1000＄)"
	PRINTL [0] - don`t exchange
ELSE
	PRINTL メダルを何枚借りますか？
	CALL PASELIL, @"[10] - 10枚(100＄)"
	CALL PASELIL, @"[35] - 35枚(300＄)"
	CALL PASELIL, @"[70] - 70枚(500＄)"
	CALL PASELIL, @"[200] - 200枚(1000＄)"
	PRINTL [0] - 借りない
ENDIF

SIF ISSKIP()
	RETURN
BINPUT
SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE 10
		IF MONEY < 100
			PRINTFORMW %I18N("所持金が足りません")%
		ELSE
			PRINTFORMW %I18N("メダルを|0|枚借りました", , "10")%
			メダル += 10
			CALL PAYMENT, -100, "メダル借入"
			RETURN 0
		ENDIF
	CASE 35
		IF MONEY < 300
			PRINTFORMW %I18N("所持金が足りません")%
		ELSE
			PRINTFORMW %I18N("メダルを|0|枚借りました", , "35")%
			メダル += 35
			CALL PAYMENT, -300, "メダル借入"
			RETURN 0
		ENDIF
	CASE 70
		IF MONEY < 500
			PRINTFORMW %I18N("所持金が足りません")%
		ELSE
			PRINTFORMW %I18N("メダルを|0|枚借りました", , "70")%
			メダル += 70
			CALL PAYMENT, -500, "メダル借入"
			RETURN 0
		ENDIF
	CASE 200
		IF MONEY < 1000
			PRINTFORMW %I18N("所持金が足りません")%
		ELSE
			PRINTFORMW %I18N("メダルを|0|枚借りました", , "200")%
			メダル += 200
			CALL PAYMENT, -1000, "メダル借入"
			RETURN 0
		ENDIF
ENDSELECT

RESTART
