@USERCOM_ABLE_ゾンビ化蘇生
#FUNCTION
;STS導入してないとそもそも表示されない
SIF !MOD:STS
	RETURNF 0

コマンド実行条件 += I18N("対象が死んでる場合に実行可能/")
SIF !CFLAG:死亡 || TEQUIP:仮死薬
	COMRESULT = 0
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"Requires %I18N("ネクロマンサー", "TALENT")% to execute/"
ELSE
	コマンド実行条件 += "実行者にネクロマンサーが必要/"
ENDIF
SIF !TALENT:PLAYER:ネクロマンサー
	COMRESULT = 0

RETURNF COMRESULT

@COM_ゾンビ化蘇生
#DIM DYNAMIC 増加量
IF LANGUAGE == "ENG"
	PRINTFORML %CALLNAME:TARGET% will revive as a zombie. Are you sure? (Training ends)
ELSE
	PRINTFORML %CALLNAME:TARGET%の死体をゾンビとして蘇生します。よろしいですか？(調教は終了します)
ENDIF
PRINTFORML [0] - %I18N("はい")%
PRINTFORML [1] - %I18N("いいえ")%

BINPUT
SIF RESULT
	RETURN 0

CALL KOJO_MESSAGE_COM

TALENT:ゾンビ = 2
CFLAG:死亡 = 0
CFLAG:キャラロスト = 0
IF LANGUAGE == "ENG"
	CALL プレイログ記録, @"%NAME:TARGET%`s corpse has been resurrected as a zombie"
ELSE
	CALL プレイログ記録, @"%NAME:TARGET%の死体をゾンビとして蘇生"
ENDIF
JUMP 調教終了
