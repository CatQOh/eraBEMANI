;-------------------------------------------------
;バイブ
;-------------------------------------------------
@USERCOM_ABLE_バイブ
#FUNCTION
#DIM DYNAMIC 条件確定

;ゲーセンに居る場合はトイレじゃないとできない
コマンド実行条件 += I18N("ゲーセンではトイレじゃないと実行できない/")
SIF TEQUIP:ゲームセンター && !TEQUIP:トイレ
	COMRESULT = 0
;性器が露出してないとダメ
コマンド実行条件 += I18N("性器が露出していないと実行できない/")
SIF !性器露出(TARGET)
	COMRESULT = 0
;触手調教中はダメ
コマンド実行条件 += I18N("触手召喚中は実行できない/")
SIF TEQUIP:触手
	COMRESULT = 0

;解除はいつでも可能
SIF TEQUIP:バイブ && COMRESULT
	条件確定 = 1
;上級売春中はアイテム無いとダメ
コマンド実行条件 += I18N("アイテム[|0|]が必要/", , I18N("バイブ", "TRAIN"))
IF 上級売春中
	SIF !BRITEM:バイブ
		COMRESULT = 0
ELSE
	;アイテムを持っていないとダメ
	SIF ITEM:バイブ <= 0
		COMRESULT = 0
	IF LANGUAGE == "ENG"
		コマンド実行条件 += "Cannot use vibrator if C is already in use (If there is a penis, it will work as a normal vibrator)）/"
	ELSE
		コマンド実行条件 += "クリバイブ改造時はＣ使用中だと実行できない（ペニスありなら通常のバイブとして機能）/"
	ENDIF
	SIF !PENIS(TARGET) && アイテム改造:バイブ == "クリバイブ" && Ｃ使用中(TARGET)
		COMRESULT = 0
ENDIF
;アイテム使用中は不可
コマンド実行条件 += I18N("対象がV使用中は実行できない/")
SIF Ｖ使用中(TARGET)
	COMRESULT = 0
;ヴァギナ無いとダメ
コマンド実行条件 += I18N("対象に女性器が必要/")
SIF !VAGINA(TARGET)
	COMRESULT = 0
;調教対象が小人体型の場合は主人が禁断の知識持ちじゃないとダメ
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"If the target is [%I18N("小人体型", "TALENT")%], the performer needs [%I18N("禁断の知識")%]/"
	コマンド実行条件 += @"　Or it can be executed if the vibrator is modified to [%I18N("細いバイブ")%]/"
ELSE
	コマンド実行条件 += "対象が[小人体型]の場合は実行者に[禁断の知識]が必要/"
	コマンド実行条件 += "　もしくはバイブを[細いバイブ]に改造していると実行可能/"
ENDIF
SIF TALENT:小人体型 && !TALENT:MASTER:禁断の知識 && アイテム改造:バイブ != "細いバイブ"
	COMRESULT = 0
;お風呂場中は防水じゃないとダメ
コマンド実行条件 += I18N("お風呂場で使用するには|0|防水加工が必要/", ,I18N("バイブに"))
SIF TEQUIP:お風呂場 && アイテム改造:バイブ != "防水バイブ"
	COMRESULT = 0

;処女で、従順4以下・レズっ気4以下の女性ASSIの場合バイブはできない（サドならＯＫ）
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"If the target is a virgin and the executor is an assistant (%I18N("女性")%),  %I18N("従順")%level 5 or above and lesbianism level 5 or above or [%I18N("サド")%] are required."
ELSE
	コマンド実行条件 += "対象が処女で実行者が助手(女性)の場合、従順LV5以上とレズっ気LV5以上or[サド]が必要/"
ENDIF
IF TALENT:処女 && PLAYER != MASTER
	SIF SEX(PLAYER) == 2 && (ABL:PLAYER:従順 <= 4 || ABL:PLAYER:レズっ気 <= 4) && !TALENT:PLAYER:サド
		COMRESULT = 0
ENDIF
;潤滑不足で、従順3以下のASSIの場合バイブはできない（サドならＯＫ）
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"If the target is less than 5%I18N("潤滑", "PALAM")% and the executor is an assistant, %I18N("従順", "ABL")%LV3 or [%I18N("サド", "TALENT")%] is required./"
ELSE
	コマンド実行条件 += @"対象が潤滑{PALAMLV:2}未満で実行者が助手の場合、従順LV3or[サド]が必要/"
ENDIF
IF PALAM:潤滑 < PALAMLV:2 && PLAYER != MASTER
	SIF ABL:PLAYER:従順 <= 3 && !TALENT:PLAYER:サド
		COMRESULT = 0
ENDIF

IF 条件確定
	COMRESULT = 1
	RETURNF 1
ENDIF
RETURNF COMRESULT

@COM_バイブ
#DIM DYNAMIC 増加量
;-------------------------------------------------
;特殊派生処理
;-------------------------------------------------
IF TEQUIP:触手
	PRINTFORML %I18N("触手挿入")%
	SELECTCOM = GETNUM(TRAINNAME, "触手挿入")
ELSE
	PRINTFORML %I18N("バイブ")%
ENDIF
CALL KOJO_MESSAGE_COM

;V経験を伴うコマンドのフラグ(処女膜再生対応)
TFLAG:膣コマンド = 1

;着脱の処理
INVERTBIT TEQUIP:バイブ, 0

;-------------------------------------------------
;射精ゲージチェック（奴隷）
;-------------------------------------------------
増加量 = 150
;改造済みだと変化
IF !TEQUIP:触手
	SELECTCASE アイテム改造:バイブ
		CASE "強力なバイブ"
			増加量 += 100
		CASE "細いバイブ"
			増加量 -= 100
	ENDSELECT
ENDIF

CALL 射精ゲージ増加, 射精ゲージ計算_Ｖ道具(増加量), TARGET

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
LOSEBASE:体力 += 40
LOSEBASE:気力 += 100

DOWNBASE:MASTER:体力 += 30
DOWNBASE:MASTER:気力 += 20

SOURCE:快V = 300
SOURCE:苦痛 = 50
SOURCE:露出 = 20
SOURCE:逸脱 = 40
SOURCE:反感 = 100

IF !TEQUIP:触手
	SELECTCASE アイテム改造:バイブ
		CASE "強力なバイブ"
			SOURCE:快V += 100
		CASE "細いバイブ"
			LOSEBASE:体力 -= 30
			LOSEBASE:気力 -= 70
			SOURCE:快V -= 200
			SOURCE:苦痛 -= 40
			SOURCE:逸脱 -= 30
			SOURCE:反感 -= 70
		CASE "太いバイブ"
			SOURCE:V拡張 = 200
		CASE "クリバイブ"
			SIF !PENIS(TARGET)
				SOURCE:快C = 200
	ENDSELECT
ENDIF

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:抑圧 || TALENT:抵抗
	SOURCE:鬱屈 += 40

;処女だった場合は、苦痛のソースと反発のソースを追加する
IF TALENT:処女
	SOURCE:苦痛 += 2000
	SOURCE:反感 += 3000
ENDIF

;再生処女だった場合は、苦痛のソースと反発のソースを追加する
IF TALENT:再生処女
	SOURCE:苦痛 += 500
	SOURCE:反感 += 1000
ENDIF

CALL 特殊ソース処理_Ｖ
SIF SOURCE:V拡張
	CALL 特殊ソース処理_Ｖ拡張

;[衝動的]持ちは3分の1でアイテム破壊する（調教終了後に修復）
IF ((TALENT:衝動的 && !特質("しつけ")) || (TALENT:PLAYER:衝動的 && !特質("しつけ", PLAYER))) && RAND:3 == 0 && !TEQUIP:触手
	TFLAG:アイテム破壊 = 1
	ITEM:バイブ = -1
	TEQUIP:バイブ = 0
ENDIF

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;触手挿入なら、触手体液が膣内に付く
IF TEQUIP:触手
	SETBIT STAIN:膣内, 5
	SETBIT STAIN:ヴァギナ, 5
ENDIF

;異常経験
IF TALENT:処女 && TEQUIP:触手
	IF LANGUAGE == "ENG"
		PRINTL ＜Virginity loss by tentacle＞
	ELSE
		PRINTL ＜触手処女喪失＞
	ENDIF
	CALL EXPUP, "異常経験", 2
ELSEIF TALENT:処女
	IF LANGUAGE == "ENG"
		PRINTL ＜Virginity loss by vibrator＞
	ELSE
		PRINTL ＜バイブ処女喪失＞
	ENDIF
	CALL EXPUP, "異常経験", 1
ENDIF

;-------------------------------------------------
;絶頂チェック
;-------------------------------------------------
CALL SOURCE_CHECK_CVAB

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
CALL SAMEN_CHECK_T, 4

CALL SAMEN_SHOOT_T, 4, NOWEX:射精

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL EXPUP_BASE, 2, 1

IF !TEQUIP:触手 && アイテム改造:バイブ == "太いバイブ"
	IF !EXP:Ｖ拡張経験 && !EXP:Ａ拡張経験
		PRINTFORML ＜%I18N("初Ｖ拡張")%＞
		CALL EXPUP, "異常経験", 1
	ENDIF
	CALL EXPUP, "Ｖ拡張経験", 2
ENDIF

RETURN 1

;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM_バイブ
#DIM DYNAMIC 増加量

;バイブ挿入中
;V経験を伴うコマンドのフラグ(処女膜再生対応)
TFLAG:膣コマンド = 1

IF TEQUIP:触手
	IF LANGUAGE == "ENG"
		PRINTL ＜Tentacles inserted＞
	ELSE
		PRINTL ＜触手挿入中＞
	ENDIF
ELSE
	IF LANGUAGE == "ENG"
		PRINTL ＜Vibrator inserted＞
	ELSE
		PRINTL ＜バイブ挿入中＞
	ENDIF
ENDIF

LOSEBASE:体力 += 15
LOSEBASE:気力 += 30

SOURCE:快V += 150
SOURCE:露出 += 10
SOURCE:逸脱 += 20
SOURCE:反感 += 30

IF !TEQUIP:触手
	SELECTCASE アイテム改造:バイブ
		CASE "強力なバイブ"
			SOURCE:快V += 50
		CASE "細いバイブ"
			LOSEBASE:体力 -= 10
			LOSEBASE:気力 -= 20
			SOURCE:快V -= 100
			SOURCE:逸脱 -= 10
			SOURCE:反感 -= 20
		CASE "太いバイブ"
			SOURCE:V拡張 += 50
		CASE "クリバイブ"
			SIF !PENIS(TARGET)
				SOURCE:快C += 100
	ENDSELECT
ENDIF

;-------------------------------------------------
;射精ゲージチェック（奴隷）
;-------------------------------------------------
増加量 = 70
IF !TEQUIP:触手
	SELECTCASE アイテム改造:バイブ
		CASE "強力なバイブ"
			増加量 += 30
		CASE "細いバイブ"
			増加量 -= 40
	ENDSELECT
ENDIF

CALL 射精ゲージ増加, 射精ゲージ計算_Ｖ道具(増加量), TARGET

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:抑圧 || TALENT:抵抗
	SOURCE:鬱屈 += 20

CALL 特殊ソース処理_Ｖ道具, 25, 20
SIF SOURCE:V拡張
	CALL 特殊ソース処理_Ｖ道具拡張, 30, 20, 10

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;バイブ出し入れ時は経験+1
SELECTCASE SELECTCOMS
	CASE "自慰", "指挿入れ"
		CALL EXPUP, "Ｖ経験", 2
	CASEELSE
		CALL EXPUP, "Ｖ経験", 1
ENDSELECT

SIF アイテム改造:バイブ == "太いバイブ" && !TEQUIP:触手
	CALL EXPUP, "Ｖ拡張経験", 1

;触手経験加算
SIF TEQUIP:触手
	TENTACLE++

RETURN 1
