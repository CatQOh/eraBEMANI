;-------------------------------------------------
;ペニスバンド
;-------------------------------------------------
@USERCOM_ABLE_ペニスバンド
#FUNCTION
#DIM DYNAMIC 条件確定

;ゲーセンに居る場合はトイレじゃないとできない
コマンド実行条件 += I18N("ゲーセンではトイレじゃないと実行できない/")
SIF TEQUIP:ゲームセンター && !TEQUIP:トイレ
	COMRESULT = 0
;上級売春中はアイテム無いとダメ
コマンド実行条件 += I18N("アイテム[|0|]が必要/", , I18N("ペニスバンド", "TRAIN"))
IF 上級売春中
	SIF !BRITEM:ペニスバンド
		COMRESULT = 0
ELSE
	;アイテムを持っていないとダメ
	SIF ITEM:ペニスバンド <= 0
		COMRESULT = 0
ENDIF

;解除はいつでも可能
SIF FINDCHARA(TEQUIP:ペニスバンド, 1) >= 0 && COMRESULT
	条件確定 = 1

;触手調教中はダメ
コマンド実行条件 += I18N("触手召喚中は実行できない/")
SIF TEQUIP:触手
	COMRESULT = 0
;装着判定
IF LANGUAGE == "ENG"
	コマンド実行条件 += "Characters that already have male genitalia, are using V, have a dwarf body shape, or are animal characters cannot be used./"
	コマンド実行条件 += "Cannot be equipped when using urethral items./"
ELSE
	コマンド実行条件 += "既に男性器がある、V使用中、小人体型、アニマルのキャラは使用できない/"
	コマンド実行条件 += "尿道系アイテム使用時は装備不可/"
ENDIF
SIF !ペニバン装着判定(TARGET) && !ペニバン装着判定(TMASTER) && !ペニバン装着判定(ASSI)
	COMRESULT = 0


IF 条件確定
	COMRESULT = 1
	RETURNF 1
ENDIF
RETURNF COMRESULT

@COM_ペニスバンド

IF FINDCHARA(TEQUIP:ペニスバンド, 1) >= 0
	IF LANGUAGE == "ENG"
		PRINTL strap on band release
	ELSE
		PRINTL ペニスバンド解除
	ENDIF
	CALL KOJO_MESSAGE_COM
	TEQUIP:FINDCHARA(TEQUIP:ペニスバンド, 1):ペニスバンド = 0
ELSE
	IF LANGUAGE == "ENG"
		PRINTL Who should wear a strap-on？
	ELSE
		PRINTL 誰にペニスバンドを装着させますか？
	ENDIF
	SIF ペニバン装着判定(TMASTER)
		PRINTFORML [1] - %CALLNAME:TMASTER%
	SIF ペニバン装着判定(TARGET)
		PRINTFORML [2] - %CALLNAME:TARGET%
	SIF ペニバン装着判定(ASSI)
		PRINTFORML [3] - %CALLNAME:ASSI%
	PRINTFORML [0] - %I18N("やめる")%
	SIF ISSKIP()
		RETURN
	BINPUT
	SELECTCASE RESULT
		CASE 0
			RETURN 0
		CASE 1
			IF ペニバン装着判定(TMASTER)
				TFLAG:ペニバン着用者 = TMASTER
				CALL KOJO_MESSAGE_COM
				TEQUIP:TMASTER:ペニスバンド = 1
				IF OVER_GENITAL(TMASTER) != ""
					IF CFLAG:TMASTER:挿入可
						TEQUIP:TMASTER:下半身下着 = 0
					ELSE
						TEQUIP:TMASTER:下半身下着 = 0
						TEQUIP:TMASTER:下半身上着 = 0
						TEQUIP:TMASTER:全身上着 = 0
					ENDIF
				ENDIF
			ENDIF
		CASE 2
			IF ペニバン装着判定(TARGET)
				TFLAG:ペニバン着用者 = TARGET
				CALL KOJO_MESSAGE_COM
				TEQUIP:ペニスバンド = 1
				IF OVER_GENITAL(TARGET) != ""
					IF CFLAG:挿入可
						TEQUIP:下半身下着 = 0
					ELSE
						TEQUIP:下半身下着 = 0
						TEQUIP:下半身上着 = 0
						TEQUIP:全身上着 = 0
					ENDIF
				ENDIF
			ENDIF
		CASE 3
			IF ペニバン装着判定(ASSI)
				TFLAG:ペニバン着用者 = ASSI
				CALL KOJO_MESSAGE_COM
				TEQUIP:ASSI:ペニスバンド = 1
				IF OVER_GENITAL(ASSI) != ""
					IF CFLAG:ASSI:挿入可
						TEQUIP:ASSI:下半身下着 = 0
					ELSE
						TEQUIP:ASSI:下半身下着 = 0
						TEQUIP:ASSI:下半身上着 = 0
						TEQUIP:ASSI:全身上着 = 0
					ENDIF
				ENDIF
			ENDIF
	ENDSELECT
ENDIF

RETURN 1

@ペニバン装着判定, 装着者
#FUNCTION
#DIM DYNAMIC 装着者

;-1なら不可
SIF 装着者 == -1
	RETURNF 0

;ペニスあるとダメ
SIF PENIS(装着者)
	RETURNF 0
;Ｖ使用中はダメ
SIF Ｖ使用中(装着者)
	RETURNF 0
;小人体型も無理
SIF TALENT:装着者:小人体型
	RETURNF 0
;アニマルも無理
SIF TALENT:装着者:アニマル
	RETURNF 0
SIF TEQUIP:装着者:尿道カテーテル
	RETURNF 0
SIF TEQUIP:装着者:尿道ポッキー
	RETURNF 0
SIF TEQUIP:装着者:尿道スライム
	RETURNF 0
SIF TEQUIP:装着者:睡眠
	RETURNF 0
SIF CFLAG:装着者:死亡
	RETURNF 0

RETURNF 1
