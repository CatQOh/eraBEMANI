@USERCOM_ABLE_ライブ配信
#FUNCTION
#DIM DYNAMIC 条件確定

;ゲーセンに居る場合はできない
コマンド実行条件 += I18N("ゲーセンでは実行不可/")
SIF TEQUIP:ゲームセンター
	COMRESULT = 0
;上級売春中は不可
コマンド実行条件 += I18N("上級売春中は実行不可/")
SIF 上級売春中
	COMRESULT = 0
;普通に撮影中も無理
IF LANGUAGE == "ENG"
	コマンド実行条件 += "Cannot be executed while recording with a video camera/"
ELSE
	コマンド実行条件 += "ビデオカメラによる撮影中は実行できない/"
ENDIF
SIF TEQUIP:ビデオカメラ
	COMRESULT = 0
;マジックミラー撮影中はダメ
コマンド実行条件 += I18N("マジックミラーによる撮影中は実行できない/")
SIF TEQUIP:羞恥プレイ && アイテム改造:大鏡 == "マジックミラー"
	COMRESULT = 0
;解除はいつでも可能
SIF TEQUIP:ライブ配信 && COMRESULT
	条件確定 = 1

;ビデオカメラ持っていないとダメ
コマンド実行条件 += I18N("アイテム[|0|]が必要/", ,I18N("ビデオカメラ", "TRAIN"))
SIF !ITEM:ビデオカメラ
	COMRESULT = 0
;主人か助手の撮影技能3以上必要
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"Master or assistant`s %I18N("撮影技能")% is must be LV3 or higher/"
ELSE
	コマンド実行条件 += "主人もしくは助手の撮影技能Lv3以上が必要/"
ENDIF
IF ABL:MASTER:撮影技能 < 3
	IF ASSI > 0
		SIF ABL:ASSI:撮影技能 < 3
			COMRESULT = 0
	ELSE
		COMRESULT = 0
	ENDIF
ENDIF

IF 条件確定
	COMRESULT = 1
	RETURNF 1
ENDIF
RETURNF COMRESULT

@COM_ライブ配信
;撮影者の処理
IF !TEQUIP:ライブ配信
	IF ABL:MASTER:撮影技能 >= 3 && (ASSI > 0 && ABL:ASSI:撮影技能 >= 3)
		IF LANGUAGE == "ENG"
			PRINTL Select a photographer. Changes cannot be made midway
			PRINTL （If you want to change the photographer, finish recording first）
		ELSE
			PRINTL 撮影者を選択してください　途中変更はできません
			PRINTL （撮影者を変更する場合、一度撮影を終了してください）
		ENDIF
		PRINTFORML [0] %CALLNAME:MASTER%
		PRINTFORML [1] %CALLNAME:ASSI%
		PRINTFORML [2] %I18N("やめる")%
		SIF ISSKIP()
			RETURN
		BINPUT
		SELECTCASE RESULT
			CASE 0
				TFLAG:ビデオ撮影者 = 1
			IF LANGUAGE == "ENG"
				PRINTFORML The photographer is now %CALLNAME:MASTER%
			ELSE
				PRINTFORML 撮影者は%CALLNAME:MASTER%です
			ENDIF

			CASE 1
				TFLAG:ビデオ撮影者 = 2
				IF LANGUAGE == "ENG"
					PRINTFORML The photographer is now %CALLNAME:ASSI%
				ELSE
					PRINTFORML 撮影者は%CALLNAME:ASSI%です
				ENDIF
			CASE 2
				RETURN 0
		ENDSELECT
	ELSEIF ABL:MASTER:撮影技能 >= 3
		TFLAG:ビデオ撮影者 = 1
		IF LANGUAGE == "ENG"
			PRINTFORML The photographer is now %CALLNAME:MASTER%
		ELSE
			PRINTFORML 撮影者は%CALLNAME:ASSI%です
		ENDIF
	ELSE
