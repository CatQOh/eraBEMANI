@実効値判定, 実効値, 基準値
#DIM DYNAMIC 実効値
#DIM DYNAMIC 基準値

;合計を表示
PRINTFORM  = {実効値}

SELECTCASE 実効値
	CASE IS < 基準値
		PRINT  < 
	CASE IS > 基準値
		PRINT  > 
	CASEELSE
		PRINT  = 
ENDSELECT
PRINTFORM  %I18N("実行値")%{基準値}

WAIT

;実行できない
IF 実効値 < 基準値
	CALL KOJO_MESSAGE_EVENT, "コマンド拒否時"
	RETURN 0
ELSE
	RETURN 1
ENDIF
