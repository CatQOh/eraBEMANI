		CASE "親愛"
			SELECTCASE SELECTCOMS
				CASE "膣を犯す（ドラゴン）", "アナルを犯す（ドラゴン）", "ペットに犯させる"
				CASEELSE
					SIF PLAYER == MASTER
						実効値:1 = 20
			ENDSELECT
		CASE "恋慕"
			SELECTCASE SELECTCOMS
				CASE "膣を犯す（ドラゴン）", "アナルを犯す（ドラゴン）", "ペットに犯させる"
				CASEELSE
					SIF PLAYER == MASTER
						実効値:1 = 15
			ENDSELECT
		CASE "恥じらい"
			実効値:1 = -2
		CASE "快感の否定"
			SIF FALLTYPE(TARGET) != 2
				実効値:1 = -5
		CASE "男嫌い"
