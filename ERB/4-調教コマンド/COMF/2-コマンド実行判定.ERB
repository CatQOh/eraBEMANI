	;尿
	SIF GETBIT(STAIN:PLAYER:ペニス, 7)
		実効値:1 += 4

	SIF !TALENT:汚れ無視
		実効値:1 /= 3
	SIF TALENT:潔癖症
		実効値:1 *= 2

	;汚れあり
	IF 実効値:1
		実効値 -= 実効値:1
