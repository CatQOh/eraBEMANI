	実効値 += ABL:性交中毒*2
	PRINTFORM +%I18N("性交中毒", "ABL")%LV{ABL:性交中毒}({ABL:性交中毒*2})
ENDIF
;快楽刻印
IF MARK:快楽刻印
	実効値 += MARK:快楽刻印*3
	PRINTFORM +%I18N("快楽刻印", "MARK")%LV{MARK:快楽刻印}({MARK:快楽刻印*3})
ENDIF

CALL COM_ORDER_欲情, 0
実効値 += RESULT

FOR LCOUNT, 0, VARSIZE("TALENT")
	実効値:1 = 0
	SIF !TALENT:LCOUNT
		CONTINUE
	SELECTCASE TALENTNAME:LCOUNT
		CASE "恥じらい"
			SIF SELECTCOMS == "逆レイプ"
				CONTINUE
			実効値:1 = -7
		CASE "快感の否定"
			SIF FALLTYPE(TARGET) != 2
				実効値:1 = -10
		CASE "貞操観念"
			SIF SELECTCOMS == "逆レイプ"
				CONTINUE
			SIF FALLTYPE(TARGET) != 1 || PLAYER != MASTER
				実効値:1 = -10
		CASE "貞操無頓着"
			SIF SELECTCOMS == "逆レイプ"
				CONTINUE
			実効値:1 = 3
		CASE "男嫌い"
			SIF SEX(PLAYER) == 1 && (FALLTYPE(TARGET) != 1 || PLAYER != MASTER)
				実効値:1 = -12
		CASE "女嫌い"
			SIF SEX(PLAYER) == 2 && (FALLTYPE(TARGET) != 1 || PLAYER != MASTER)
				実効値:1 = -12
		CASE "インキュバス"
			実効値:1 = 20
	ENDSELECT
	IF 実効値:1
		PRINTFORM \@SIGN(実効値:1) == 1 ? + # - \@%TALENTNAME:LCOUNT%({ABS(実効値:1)})
		実効値 += 実効値:1
	ENDIF
NEXT

;媚薬
IF TEQUIP:媚薬
	実効値 += 6
	PRINTFORM +%I18N("媚薬", "TRAIN")%(6)
ENDIF

IF PENIS(TARGET) && !TEQUIP:コンドーム && !TEQUIP:搾精コンドーム
	IF ゲームモード() == "学園モード"
		実効値 -= 10
		PRINTFORM -%I18N("ゴム無し")%(10)
	ELSEIF !陥落(TARGET)
		実効値 -= 10
		PRINTFORM -%I18N("ゴム無し")%(10)
	ENDIF
ENDIF

IF SELECTCOMS != "逆レイプ"
	実効値:1 = 0
	SELECTCASE SELECTCOMS
		CASE "正常位させる", "後背位させる"
			;アナルの汚れ
			SIF GETBIT(STAIN:PLAYER:ヴァギナ, 3)
				実効値:1 += 6
			;尿
			SIF GETBIT(STAIN:PLAYER:ヴァギナ, 7)
				実効値:1 += 3
		CASE "正常位アナルさせる", "後背位アナルさせる"
			;尿
			SIF GETBIT(STAIN:PLAYER:アナル, 7)
				実効値:1 += 3
	ENDSELECT

	SIF TALENT:汚れ無視
		実効値:1 /= 3
	SIF TALENT:潔癖症
		実効値:1 *= 2

	;汚れあり
	IF 実効値:1
		実効値 -= 実効値:1
		IF TALENT:汚れ無視
			PRINTFORM -%I18N("汚れあり")%、%I18N("汚れ無視", "TALENT")%
		ELSEIF TALENT:潔癖症
			PRINTFORM -%I18N("汚れあり")%、%I18N("潔癖症", "TALENT")%
		ELSE
			PRINTFORM -%I18N("汚れあり")%
		ENDIF
		PRINTFORM ({実効値:1})
	ENDIF
ENDIF

RETURN 実効値

