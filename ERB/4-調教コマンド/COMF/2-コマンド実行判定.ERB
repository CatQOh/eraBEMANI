@COM_ORDER
#DIM DYNAMIC 実効値, 2

IF OPTION:口上表示 && !CFLAG:口上非表示 && EXISTFUNCTION(@"COM_ORDER_%SELECTCOMS%_%CSVNAMERPS(NO:TARGET)%")
	CALLFORM COM_ORDER_%SELECTCOMS%_%CSVNAMERPS(NO:TARGET)%
	IF RESULT
		実効値 += RESULT
		PRINTFORM \@ SIGN(RESULT) == 1 ? + # - \@口上補正({RESULT})
	ENDIF
ENDIF

IF ABL:従順
	実効値 += ABL:従順*4
	PRINTFORM +%I18N("従順", "ABL")%LV{ABL:従順}({ABL:従順*4})
ENDIF
IF ABL:マゾっ気
	実効値 += ABL:マゾっ気*2
	PRINTFORM +%I18N("マゾっ気", "ABL")%LV{ABL:マゾっ気}({ABL:マゾっ気*2})
ENDIF

;レズ調教
IF SEX(PLAYER) == 2 && SEX(TARGET) == 2
	IF ABL:レズっ気
		実効値 += ABL:レズっ気*3
		PRINTFORM +%I18N("レズっ気", "ABL")%LV{ABL:レズっ気}({ABL:レズっ気*3})
	ENDIF
	IF ABL:レズ中毒
		実効値 += ABL:レズ中毒*3
		PRINTFORM +%I18N("レズ中毒", "ABL")%LV{ABL:レズ中毒}({ABL:レズ中毒*3})
	ENDIF
	IF TALENT:両刀
		実効値 += 10
		PRINTFORM +%I18N("両刀", "TALENT")%(10)
	ENDIF
	IF TALENT:好奇心
		実効値 += 7
		PRINTFORM +%I18N("好奇心", "TALENT")%(7)
	ENDIF
	IF TALENT:保守的
		実効値 -= 13
		PRINTFORM -%I18N("保守的", "TALENT")%(13)
	ENDIF
;ゲイ調教
ELSEIF SEX(PLAYER) == 1 && SEX(TARGET) == 1
	IF ABL:ホモっ気
		実効値 += ABL:ホモっ気*3
		PRINTFORM +%I18N("ホモっ気", "ABL")%LV{ABL:ホモっ気}({ABL:ホモっ気*3})
	ENDIF
	IF ABL:ゲイ中毒
		実効値 += ABL:ゲイ中毒*3
		PRINTFORM +%I18N("ゲイ中毒", "ABL")%LV{ABL:ゲイ中毒}({ABL:ゲイ中毒}*3)
	ENDIF
	IF TALENT:両刀
		実効値 += 10
		PRINTFORM +%I18N("両刀")%(10)
	ENDIF
	IF TALENT:好奇心
		実効値 += 7
		PRINTFORM +%I18N("好奇心", "TALENT")%(7)
	ENDIF
	IF TALENT:保守的
		実効値 -= 13
		PRINTFORM -%I18N("保守的", "TALENT")%(13)
	ENDIF
ELSE
	IF TALENT:好奇心
		実効値 += 5
		PRINTFORM +%I18N("好奇心", "TALENT")%(5)
	ENDIF
	IF TALENT:保守的
		実効値 -= 10
		PRINTFORM -%I18N("保守的", "TALENT")%(10)
	ENDIF
ENDIF

;刻印チェック
IF MARK:苦痛刻印
	実効値 += MARK:苦痛刻印*5
	PRINTFORM +%I18N("苦痛刻印", "MARK")%LV{MARK:苦痛刻印}({MARK:苦痛刻印*5})
ENDIF

;プライド
IF TALENT:プライド高い
	実効値:1 = 4
ELSEIF TALENT:プライド低い
	実効値:1 = 1
ELSE
	実効値:1 = 2
ENDIF

;屈服刻印および反発刻印とプライド
IF MARK:屈服刻印
	実効値 += MARK:屈服刻印*3*実効値:1
	PRINTFORM +%I18N("屈服刻印", "MARK")%LV{MARK:屈服刻印}({MARK:屈服刻印*3*実効値:1})
ENDIF
IF MARK:反発刻印
	実効値 -= MARK:反発刻印*2*実効値:1
	PRINTFORM -%I18N("反発刻印", "MARK")%LV{MARK:反発刻印}({MARK:反発刻印*2*実効値:1})
ENDIF

実効値:1 = GETPALAMLV(PALAM:恭順, 5)
IF 実効値:1
	実効値 += 実効値:1*3
	PRINTFORM +%I18N("恭順", "PALAM")%LV{実効値:1}({実効値:1*3})
ENDIF

;PALAM:恐怖
実効値:1 = GETPALAMLV(PALAM:恐怖, 5)
IF 実効値:1
	実効値 += 実効値:1*3
	PRINTFORM +%I18N("恐怖", "PALAM")%LV{実効値:1}({実効値:1*3})
ENDIF

IF TALENT:服従
	実効値 += 10
	PRINTFORM +%I18N("服従", "TALENT")%(10)
ENDIF
IF TALENT:隷属
	実効値 += 20
	PRINTFORM +%I18N("隷属", "TALENT")%(20)
ENDIF
IF TALENT:反抗的 && !陥落(TARGET)
	実効値 -= 5
	PRINTFORM -%I18N("反抗的", "TALENT")%(5)
ENDIF
IF TALENT:気丈
	実効値 -= 5
	PRINTFORM -%I18N("気丈", "TALENT")%(5)
ENDIF
IF TALENT:素直
	実効値 += 5
	PRINTFORM +%I18N("素直", "TALENT")%(5)
ENDIF
IF TALENT:プライド高い
	実効値 -= 15
	PRINTFORM -%I18N("プライド高い", "TALENT")%(15)
ENDIF
IF TALENT:プライド低い
	実効値 += 5
	PRINTFORM +%I18N("プライド低い", "TALENT")%(5)
ENDIF
IF TALENT:ツンデレ
	IF ABL:従順 < 4
		実効値 -= 7
		PRINTFORM -%I18N("ツンデレ", "TALENT")%(7)
	ELSE
		実効値 += 7
		PRINTFORM +%I18N("ツンデレ", "TALENT")%(7)
	ENDIF
ENDIF
IF TALENT:目立ちたがり
	実効値 += 2
	PRINTFORM +%I18N("目立ちたがり", "TALENT")%(2)
ENDIF
IF TALENT:抑圧
	実効値 -= 10
	PRINTFORM -%I18N("抑圧", "TALENT")%(10)
ENDIF
IF TALENT:抵抗
	実効値 -= 12
	PRINTFORM -%I18N("抵抗", "TALENT")%(12)
ENDIF
IF TALENT:弱味
	実効値 += 12
	PRINTFORM +%I18N("弱味", "TALENT")%(12)
ENDIF
IF TALENT:弱気
	実効値 += 8
	PRINTFORM +%I18N("弱気", "TALENT")%(8)
ENDIF
IF TALENT:強気
	実効値 -= 8
	PRINTFORM -%I18N("強気", "TALENT")%(8)
ENDIF
IF TALENT:即落ち
	実効値 += 10
	PRINTFORM +%I18N("即落ち", "TALENT")%(10)
ENDIF
IF TALENT:妄信
	実効値 += 8
	PRINTFORM +%I18N("妄信", "TALENT")%(8)
ENDIF
IF TALENT:寂しがり屋 && ASSI > 0
	実効値 += 6
	PRINTFORM +%I18N("寂しがり屋", "TALENT")%(6)
ENDIF
IF TALENT:同族嫌悪 && CSTR:種族 == CSTR:PLAYER:種族
	実効値 -= 10
	PRINTFORM -%I18N("同族嫌悪", "TALENT")%(10)
ENDIF

IF TALENT:男好き && SEX(PLAYER) == 1
	実効値 += 5
	PRINTFORM +%I18N("男好き", "TALENT")%(5)
ENDIF
IF TALENT:女好き && SEX(PLAYER) == 2
	実効値 += 5
	PRINTFORM +%I18N("女好き", "TALENT")%(5)
ENDIF
IF TALENT:男嫌い && SEX(PLAYER) == 1
	実効値 -= 10
	PRINTFORM -%I18N("男嫌い", "TALENT")%(10)
ENDIF
IF TALENT:女嫌い && SEX(PLAYER) == 2
	実効値 -= 10
	PRINTFORM -%I18N("女嫌い", "TALENT")%(10)
ENDIF
IF TALENT:サボり魔
	実効値 -= 3
	PRINTFORM -%I18N("サボり魔", "TALENT")%(3)
ENDIF
IF TALENT:子供好き && TALENT:PLAYER:体格 <= 2
	実効値 += 3
	PRINTFORM +%I18N("子供好き", "TALENT")%(3)
ENDIF
SELECTCASE CFLAG:スライム度
	CASE 1 TO 10
		実効値 += 3
		PRINTFORM +%I18N("スライム侵食")%Lv1(3)
	CASE 11 TO 20
		実効値 += 5
		PRINTFORM +%I18N("スライム侵食")%Lv2(5)
	CASE 21 TO 30
		実効値 += 7
		PRINTFORM +%I18N("スライム侵食")%Lv3(7)
	CASE 31 TO 1499
		実効値 += 7
		PRINTFORM +%I18N("スライム", "TALENT")%(9)
	CASE IS >= 1500
		実効値 += 15
		PRINTFORM +%I18N("溶ける快", "TALENT")%(15)
ENDSELECT

;調教者の能力、素質
IF ABL:PLAYER:サドっ気
	実効値 += ABL:PLAYER:サドっ気*2
	PRINTFORM +%CALLNAME:PLAYER%%I18N("の")%%I18N("サドっ気", "ABL")%LV{ABL:PLAYER:サドっ気}({ABL:PLAYER:サドっ気*2})
ENDIF
IF TALENT:PLAYER:魅惑
	実効値 += 6
	PRINTFORM +%CALLNAME:PLAYER%%I18N("魅惑", "TALENT")%(6)
ENDIF
IF TALENT:PLAYER:謎の魅力
	実効値 += 8
	PRINTFORM +%CALLNAME:PLAYER%%I18N("の")%%I18N("謎の魅力", "TALENT")%(8)
ENDIF
IF TALENT:PLAYER:サド
	実効値 += 3
	PRINTFORM +%CALLNAME:PLAYER%%I18N("が")%%I18N("サド", "TALENT")%(3)
ENDIF
IF TALENT:PLAYER:強気
	実効値 += 5
	PRINTFORM +%CALLNAME:PLAYER%%I18N("が")%%I18N("強気", "TALENT")%(5)
ENDIF
IF TALENT:PLAYER:弱気
	実効値 -= 5
	PRINTFORM -%CALLNAME:PLAYER%%I18N("が")%%I18N("弱気", "TALENT")%(5)
ENDIF

;助手の素質
IF ASSI >= 0 && TALENT:ASSI:鼓舞
	実効値 += 2
	PRINTFORM +%CALLNAME:ASSI%%I18N("が")%%I18N("鼓舞", "TALENT")%(2)
ENDIF
IF ASSI >= 0 && TALENT:ASSI:ハイテンション
	実効値 += 2
	PRINTFORM +%CALLNAME:ASSI%%I18N("が")%%I18N("ハイテンション", "TALENT")%(2)
ENDIF

;アニマルは依存度（なつき度）が足りないと猛反発
IF TALENT:アニマル
	SELECTCASE CFLAG:依存度
		CASE IS <= 0
			IF LANGUAGE == "ENG"
				PRINTFORM -No familiarity(100)
			ELSE
				PRINTFORM -なつき度皆無(100)
			ENDIF
			実効値 -= 100
		CASE IS <= 100
			IF LANGUAGE == "ENG"
				PRINTFORM -Don't miss it(70)
			ELSE
				PRINTFORM -懐いていない(70)
			ENDIF
			実効値 -= 70
		CASE IS <= 300
			IF LANGUAGE == "ENG"
				PRINTFORM -On guard(50)
			ELSE
				PRINTFORM -警戒している(50)
			ENDIF
			実効値 -= 50
		CASE IS <= 500
			IF LANGUAGE == "ENG"
				PRINTFORM -Not likes it(30)
			ELSE
				PRINTFORM -好かれていない(30)
			ENDIF
			実効値 -= 30
		CASE IS <= 700
			IF LANGUAGE == "ENG"
				PRINTFORM -Don`t hates it(10)
			ELSE
				PRINTFORM -嫌いじゃない(10)
			ENDIF
			実効値 -= 10
		CASE IS <= 1000
			IF LANGUAGE == "ENG"
				PRINTFORM -Equal(3)
			ELSE
				PRINTFORM -対等(3)
			ENDIF
			実効値 -= 3
		CASE IS <= 1300
			IF LANGUAGE == "ENG"
				PRINTFORM +Curious about it(5)
			ELSE
				PRINTFORM +気になる相手(5)
			ENDIF
			実効値 += 5
		CASE IS <= 1500
			IF LANGUAGE == "ENG"
				PRINTFORM +Someone who loves me(10)
			ELSE
				PRINTFORM +可愛がってくれる相手(10)
			ENDIF
			実効値 += 10
		CASE IS <= 2000
			IF LANGUAGE == "ENG"
				PRINTFORM +owner(15)
			ELSE
				PRINTFORM +飼い主(15)
			ENDIF
			実効値 += 15
		CASE IS <= 3000
			IF LANGUAGE == "ENG"
				PRINTFORM +Beloved owner(30)
			ELSE
				PRINTFORM +大好きな飼い主(30)
			ENDIF
			実効値 += 30
		CASEELSE
			IF LANGUAGE == "ENG"
				PRINTFORM +Master♥(50)
			ELSE
				PRINTFORM +ご主人様♥(50)
			ENDIF
			実効値 += 50
	ENDSELECT
ENDIF

;酔
IF CFLAG:酔
	実効値 += CFLAG:酔/10+1
	IF LANGUAGE == "ENG"
		PRINTFORM +Drunk ({CFLAG:酔/10+1})
	ELSE
		PRINTFORM +酔({CFLAG:酔/10+1})
	ENDIF
ENDIF

;相性チェック
SELECTCASE 相性値(TARGET, PLAYER)
	CASE 0 TO 30
		実効値 -= 10
		IF LANGUAGE == "ENG"
			PRINTFORM -Worst compatibility(10)
		ELSE
			PRINTFORM -相性最悪(10)
		ENDIF
	CASE 30 TO 70
		実効値 -= 6
		IF LANGUAGE == "ENG"
			PRINTFORM -Bad compatibility(6)
		ELSE
			PRINTFORM -相性悪い(6)
		ENDIF
	CASE 70 TO 99
		実効値 -= 3
		IF LANGUAGE == "ENG"
			PRINTFORM -Not very compatible(3)
		ELSE
			PRINTFORM -相性いまいち(3)
		ENDIF
	CASE 101 TO 130
		実効値 += 3
		IF LANGUAGE == "ENG"
			PRINTFORM +Slightly compatible(3)
		ELSE
			PRINTFORM +相性ややよい(3)
		ENDIF
	CASE 130 TO 170
		実効値 += 6
		IF LANGUAGE == "ENG"
			PRINTFORM +Good compatibility(6)
		ELSE
			PRINTFORM +相性よい(6)
		ENDIF
	CASE IS >= 170
		実効値 += 10
		IF LANGUAGE == "ENG"
			PRINTFORM +Perfect compatibility(10)
		ELSE
			PRINTFORM +相性最高(10)
		ENDIF
ENDSELECT

IF ゲームモード() == "学園モード"
	IF SIGN(好感度合計(TARGET)) == 1
		実効値 += 好感度合計(TARGET)/100
		PRINTFORM +好感度({好感度合計(TARGET)/100})
	ENDIF
	IF CFLAG:インモラル > 0
		実効値 += CFLAG:インモラル
		PRINTFORM +%I18N("インモラル")%({CFLAG:インモラル})
	ELSEIF CFLAG:インモラル < 0
		実効値 += CFLAG:インモラル
		PRINTFORM -%I18N("モラル")%({ABS(CFLAG:インモラル)})
	ENDIF
ENDIF

IF TFLAG:ヒートストローク && FLAG:気温 >= 200
	実効値 += (FLAG:気温-200)/10+1
	IF LANGUAGE == "ENG"
		PRINTFORM +Heatstroke({(FLAG:気温-200)/10+1})
	ELSE
		PRINTFORM +ヒートストローク({(FLAG:気温-200)/10+1})
	ENDIF
ENDIF
IF TFLAG:ホワイトアウト && FLAG:気温 <= 200
	実効値 += ABS((FLAG:気温-200)/10+1)
	IF LANGUAGE == "ENG"
	ELSE
	PRINTFORM +White Out({ABS((FLAG:気温-200)/10+1)})
	ENDIF
ENDIF
IF TFLAG:メタリックマインド
	実効値 -= 15
	IF LANGUAGE == "ENG"
	ELSE
	PRINTFORM -iron will(15)
	ENDIF
ENDIF

IF 特質("意志薄弱")
	実効値 += 特質("意志薄弱")
	PRINTFORM +意志薄弱({特質("意志薄弱")})
ENDIF

RETURN 実効値

@COM_ORDER_欲情, タイプ
#DIM DYNAMIC 実効値, 3
#DIM DYNAMIC タイプ
;欲情Lv(最大で5)に対して、以下のタイプによって別々に変動する
;タイプ0...[衝動的]で×1.5, [冷静]で×0.5, 最後に×3
;タイプ1...[衝動的]で+2, [冷静]で×0.75

IF タイプ == 0
	実効値:1 = GETPALAMLV(PALAM:欲情, 5)
	実効値:2 = 実効値:1
	SIF TALENT:衝動的
		TIMES 実効値:2 , 1.50
	SIF TALENT:冷静
		TIMES 実効値:2 , 0.50
	IF 実効値:2
		実効値 += 実効値:2*3
		PRINTFORM +%I18N("欲情")%LV{実効値:1}({実効値:2*3})
	ENDIF
	RETURN 実効値:2*3
ELSEIF タイプ == 1
	実効値:1 = GETPALAMLV(PALAM:欲情, 5)
	実効値:2 = 実効値:1
	SIF TALENT:衝動的
		実効値:2 += 2
	SIF TALENT:冷静
		TIMES 実効値:2 , 0.75
	IF 実効値:2
		実効値 += 実効値:2
		PRINTFORM +%I18N("欲情")%LV{実効値:1}({実効値:2})
	ENDIF
	RETURN 実効値:2
ENDIF

