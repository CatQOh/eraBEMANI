@USERCOM_ABLE_恐怖を煽る
#FUNCTION
;ゲーセンに居る場合はできない
コマンド実行条件 += I18N("ゲーセンでは実行不可/")
SIF TEQUIP:ゲームセンター
	COMRESULT = 0
;上級売春中は方針がSMで客がマゾじゃないとダメ
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"During extreme act of prostitution, the management policy is SM and the customer must have [%I18N("マゾ", "TALENT")%]/"
ELSE
	コマンド実行条件 += "上級売春中は経営方針がSMで客に[マゾ]が必要/"
ENDIF
SIF 上級売春中 && (BR:方針 != 3 || !TALENT:マゾ)
	COMRESULT = 0
;従順4未満のASSIの場合鞭はできない（サドならＯＫ）
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"If the executor is an assistant, the assistant must be [%I18N("サド")%] or at least %I18N("従順")%LV3/"
ELSE
	コマンド実行条件 += "実行者が助手の場合、助手に[サド]or従順LV3以上必要/"
ENDIF
IF PLAYER != MASTER
	SIF ABL:PLAYER:従順 < 3 && !TALENT:PLAYER:サド
		COMRESULT = 0
ENDIF
;お風呂場プレイ中はダメ
コマンド実行条件 += I18N("お風呂場では実行できない/")
SIF TEQUIP:お風呂場
	COMRESULT = 0
;新妻プレイ中はダメ
コマンド実行条件 += I18N("エプロン使用中は実行できない/")
SIF TEQUIP:エプロン
	COMRESULT = 0

コマンド実行条件 += I18N("睡眠中は実行できない/")
SIF TEQUIP:睡眠
	COMRESULT = 0
IF MOD:STS
	コマンド実行条件 += I18N("屍姦中は実行できない/")
	SIF CFLAG:死亡
		COMRESULT = 0
ENDIF

RETURNF COMRESULT

@COM_恐怖を煽る
PRINTFORML %I18N("恐怖を煽る", "TRAIN")%
CALL KOJO_MESSAGE_COM

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
LOSEBASE:体力 += 10
LOSEBASE:気力 += 80

DOWNBASE:MASTER:体力 += 20
DOWNBASE:MASTER:気力 += 20

SOURCE:恐怖 = 300
SOURCE:逸脱 = 100
SOURCE:反感 = 500
SOURCE:欲情 = ABL:マゾっ気*20

;-------------------------------------------------
;絶頂チェック
;-------------------------------------------------
CALL SOURCE_CHECK_CVAB

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
CALL SAMEN_CHECK_T, 0

CALL SAMEN_SHOOT_T, 0, NOWEX:射精

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL EXPUP_BASE, 1, 2

RETURN 1
