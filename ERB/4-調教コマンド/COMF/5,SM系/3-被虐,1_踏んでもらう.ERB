;-------------------------------------------------
;踏んでもらう
;-------------------------------------------------
@USERCOM_ABLE_踏んでもらう
#FUNCTION
;ゲーセンに居る場合はできない
コマンド実行条件 += I18N("ゲーセンでは実行不可/")
SIF TEQUIP:ゲームセンター
	COMRESULT = 0
;上級売春中は方針がSMか狂気じゃないとダメ
IF LANGUAGE == "ENG"
	コマンド実行条件 += "During extreme prostitution, the management policy cannot be implemented unless you are SMor crazy./"
ELSE
	コマンド実行条件 += "上級売春中は経営方針がSMor狂気じゃないと実行できない/"
ENDIF
SIF 上級売春中 && !GROUPMATCH(3, 4)
	COMRESULT = 0
;サド、もしくはサドっ気3以上必要
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"Target needs to be at least %I18N("サドっ気", "TALENT")%LV3 or [%I18N("サドっ気", "TALENT")%]/"
ELSE
	コマンド実行条件 += "対象にサドっ気LV3以上or[サド]が必要/"
ENDIF
SIF ABL:サドっ気 < 3 && !TALENT:サド
	COMRESULT = 0
;足使用不可だとできない
IF MOD:STS
	IF LANGUAGE == "ENG"
		コマンド実行条件 += @"Cannot be executed if the target is [%I18N("足使用不可", "TALENT")%] or missing both legs./"
	ELSE
		コマンド実行条件 += "対象が[足使用不可]or両足欠損だと実行できない/"
	ENDIF
	SIF TALENT:足使用不可
		COMRESULT = 0
	SIF 脚欠損(TARGET)  == 2
		COMRESULT = 0
ELSE
	コマンド実行条件 += I18N("対象が[足使用不可]だと実行できない/")
	SIF TALENT:足使用不可
		COMRESULT = 0
ENDIF
;拘束中はダメ
コマンド実行条件 += I18N("縄で縛ってるときは実行できない/")
SIF TEQUIP:縄
	COMRESULT = 0
;触手調教中はダメ
コマンド実行条件 += I18N("触手召喚中は実行できない/")
SIF TEQUIP:触手
	COMRESULT = 0
;助手の場合はマゾかマゾっ気3以上必要
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"If the executor is an assistant, the assistant must have at least %I18N("マゾっ気", "ABL")%LV3 or [%I18N("マゾ", "TALENT")%]/"
ELSE
	コマンド実行条件 += "実行者が助手の場合、助手にマゾっ気LV3以上or[マゾ]が必要/"
ENDIF
IF PLAYER != MASTER
	SIF ABL:PLAYER:マゾっ気 < 3 && !TALENT:マゾ
		COMRESULT = 0
ENDIF
;アニマルだと無理
コマンド実行条件 += I18N("対象が[|0|]の場合は実行できない/", ,I18N("アニマル", "TALENT"))
SIF TALENT:アニマル
	COMRESULT = 0
コマンド実行条件 += I18N("睡眠中は実行できない/")
SIF TEQUIP:睡眠
	COMRESULT = 0
IF MOD:STS
	コマンド実行条件 += I18N("屍姦中は実行できない/")
	SIF CFLAG:死亡
		COMRESULT = 0
ENDIF

RETURNF COMRESULT

@COM_踏んでもらう
PRINTFORML %I18N("踏んでもらう", "TRAIN")%
CALL KOJO_MESSAGE_COM

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
LOSEBASE:体力 += 40
LOSEBASE:気力 += 40

DOWNBASE:MASTER:体力 += 80
DOWNBASE:MASTER:気力 += 60

SOURCE:性行動 = 250
SOURCE:達成 = 100
SOURCE:中毒 = 250
SOURCE:逸脱 = 200
SOURCE:反感 = 100
SOURCE:不潔 = 150

;-------------------------------------------------
;絶頂チェック
;-------------------------------------------------
CALL SOURCE_CHECK_CVAB

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
CALL SAMEN_CHECK_T, 0

CALL SAMEN_SHOOT_T, 0, NOWEX:射精

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL EXPUP_BASE, 1, 1

CALL EXPUP, "嗜虐快楽経験", 3
CALL EXPUP, "調教経験", 3

RETURN 1
