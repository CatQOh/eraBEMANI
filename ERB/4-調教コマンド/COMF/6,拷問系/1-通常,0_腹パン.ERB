;-------------------------------------------------
;腹パン
;-------------------------------------------------
@USERCOM_ABLE_腹パン
#FUNCTION
;ゲーセンに居る場合はできない
コマンド実行条件 += I18N("ゲーセンでは実行不可/")
SIF TEQUIP:ゲームセンター
	COMRESULT = 0
;上級売春中は方針がSMで客がマゾじゃないとダメ
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"During extreme act of prostitution, the management policy is SM and the customer must have [%I18N("マゾ", "TALENT")%]/"
ELSE
	コマンド実行条件 += "上級売春中は経営方針がSMで客に[マゾ]が必要/"
ENDIF
SIF 上級売春中 && (BR:方針 != 3 || !TALENT:マゾ)
	COMRESULT = 0
;妊娠中は調教者がサドもしくは禁断の知識持ちじゃないとできない
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"If the target is pregnant, the executor is the master and requires [%I18N("サド", "TALENT")%] or [%I18N("禁断の知識", "TALENT")%]/"
ELSE
	コマンド実行条件 += "対象が妊娠中の場合、実行者が主人で[サド]or[禁断の知識]が必要/"
ENDIF
IF TALENT:妊娠
	SIF PLAYER != MASTER
		COMRESULT = 0
	SIF !TALENT:MASTER:サド && !TALENT:MASTER:禁断の知識
		COMRESULT = 0
ENDIF
;アニマルだと無理
コマンド実行条件 += I18N("対象が[|0|]の場合は実行できない/", ,I18N("アニマル", "TALENT"))
SIF TALENT:アニマル
	COMRESULT = 0
コマンド実行条件 += I18N("睡眠中は実行できない/")
SIF TEQUIP:睡眠
	COMRESULT = 0
IF MOD:STS
	コマンド実行条件 += I18N("実行者に腕がないと実行できない/")
	SIF 腕欠損(PLAYER) == 2
		COMRESULT = 0
ENDIF

RETURNF COMRESULT

@COM_腹パン
PRINTFORML %I18N("腹パン", "TRAIN")%
CALL KOJO_MESSAGE_COM

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
IF TALENT:妊娠 && RAND:4 == 0
	;消費体力、気力
	LOSEBASE:体力 += 3500
	LOSEBASE:気力 += 5000
	SOURCE:苦痛 = 30000
	SOURCE:恐怖 = 6000
	SOURCE:屈従 = 500
	SOURCE:逸脱 = 10000
	SOURCE:反感 = 10000
	SETCOLOR 255 , 0 , 0
		FONTBOLD
			PRINTFORMW %I18N("流産")%
		FONTREGULAR
	RESETCOLOR
	TFLAG:流産 = 1
	TALENT:妊娠 = 0
ELSE
	;消費体力、気力
	LOSEBASE:体力 += 150
	LOSEBASE:気力 += 100

	SIF 陥落(TARGET)
		SOURCE:情愛 = 100
	SOURCE:苦痛 = 1000
	SOURCE:恐怖 = 1000
	SOURCE:屈従 = 150
	SOURCE:逸脱 = 500
	SOURCE:反感 = 1500
ENDIF

SIF TALENT:肋骨除去済み
	SOURCE:苦痛 += 1000

DOWNBASE:MASTER:体力 += 60
DOWNBASE:MASTER:気力 += 40

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;苦痛のパラメータによる苦痛のソース増加は先に処理しておく
SOURCE:苦痛 += GETPALAMLV(PALAM:苦痛, 4)*(SOURCE:苦痛/2)

;-------------------------------------------------
;絶頂チェック
;-------------------------------------------------
CALL SOURCE_CHECK_CVAB

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
CALL SAMEN_CHECK_T, 0

CALL SAMEN_SHOOT_T, 0, NOWEX:射精

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL EXPUP_BASE, 1, 4

RETURN 1
