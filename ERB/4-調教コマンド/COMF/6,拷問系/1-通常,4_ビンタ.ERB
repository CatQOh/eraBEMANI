;-------------------------------------------------
;ビンタ ( ‘д‘⊂彡☆))Д´) ﾊﾟｰﾝ
;-------------------------------------------------
@USERCOM_ABLE_ビンタ
#FUNCTION
;ゲーセンに居る場合はできない
コマンド実行条件 += I18N("ゲーセンでは実行不可/")
SIF TEQUIP:ゲームセンター
	COMRESULT = 0
;上級売春中は方針がSMで客がマゾじゃないとダメ
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"During extreme act of prostitution, the management policy is SM and the customer must have [%I18N("マゾ", "TALENT")%]/"
ELSE
	コマンド実行条件 += "上級売春中は経営方針がSMで客に[マゾ]が必要/"
ENDIF
SIF 上級売春中 && (BR:方針 != 3 || !TALENT:マゾ)
	COMRESULT = 0
;サドじゃないとできない
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"Executor must have [%I18N("サド", "TALENT")%] trait/"
ELSE
	コマンド実行条件 += "実行者に[サド]が必要/"
ENDIF
SIF !TALENT:PLAYER:サド
	COMRESULT = 0
;アニマルだと無理
コマンド実行条件 += I18N("対象が[|0|]の場合は実行できない/", ,I18N("アニマル", "TALENT"))
SIF TALENT:アニマル
	COMRESULT = 0
コマンド実行条件 += I18N("睡眠中は実行できない/")
SIF TEQUIP:睡眠
	COMRESULT = 0
IF MOD:STS
	コマンド実行条件 += I18N("実行者に腕がないと実行できない/")
	SIF 腕欠損(PLAYER) == 2
		COMRESULT = 0
ENDIF

RETURNF COMRESULT

@COM_ビンタ
PRINTL ビンタ
CALL KOJO_MESSAGE_COM

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
LOSEBASE:体力 += 60
LOSEBASE:気力 += 30

DOWNBASE:MASTER:体力 += 40
DOWNBASE:MASTER:気力 += 30

SOURCE:苦痛 = 600
SOURCE:恐怖 = 700
SOURCE:中毒 = 50
SOURCE:欲情 = 50
SOURCE:屈従 = 200
SOURCE:鬱屈 = 200
SOURCE:逸脱 = 150
SOURCE:反感 = 1000

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;苦痛のパラメータによる苦痛のソース増加は先に処理しておく
SOURCE:苦痛 += GETPALAMLV(PALAM:苦痛, 4)*(SOURCE:苦痛/2)

;-------------------------------------------------
;絶頂チェック
;-------------------------------------------------
CALL SOURCE_CHECK_CVAB

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
CALL SAMEN_CHECK_T, 0

CALL SAMEN_SHOOT_T, 0, NOWEX:射精

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL EXPUP_BASE, 1, 3

RETURN 1
