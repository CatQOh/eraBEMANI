@USERCOM_ABLE_尿道針挿入
#FUNCTION
コマンド実行条件 += I18N("小スカMODが必要/")
SIF !MOD:SCAT2
	COMRESULT = 0
;ゲーセンに居る場合はできない
コマンド実行条件 += I18N("ゲーセンでは実行不可/")
SIF TEQUIP:ゲームセンター
	COMRESULT = 0
コマンド実行条件 += I18N("対象が[|0|]の場合は実行できない/", ,I18N("アニマル", "TALENT"))
SIF TALENT:アニマル
	COMRESULT = 0
コマンド実行条件 += I18N("上級売春中は実行不可/")
SIF 上級売春中
	COMRESULT = 0
コマンド実行条件 += I18N("アイテム[|0|]が必要/", , I18N("針", "TRAIN"))
SIF !ITEM:針
	COMRESULT = 0
;ASSIの場合、従順4以上かサドじゃないとできない。
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"If the executor is an assistant, the assistant must be [%I18N("サド", "TALENT")%] or having at least %I18N("従順","ABL")%LV4 ./"
ELSE
	コマンド実行条件 += "実行者が助手の場合、助手に[サド]or従順LV4以上必要/"
ENDIF
IF PLAYER != MASTER
	SIF ABL:PLAYER:従順 < 4 && !TALENT:PLAYER:サド
	COMRESULT = 0
ENDIF

;触手調教中はダメ
コマンド実行条件 += I18N("触手召喚中は実行できない/")
SIF TEQUIP:触手
	COMRESULT = 0
;新妻プレイ中はダメ
コマンド実行条件 += I18N("エプロン使用中は実行できない/")
SIF TEQUIP:エプロン
	COMRESULT = 0
コマンド実行条件 += I18N("睡眠中は実行できない/")
SIF TEQUIP:睡眠
	COMRESULT = 0
コマンド実行条件 += I18N("尿道使用中は実行不可/")
SIF Ｕ使用中(TARGET)
	COMRESULT = 0
IF MOD:STS
	コマンド実行条件 += I18N("実行者に腕がないと実行できない/")
	SIF 腕欠損(PLAYER) == 2
		COMRESULT = 0
ENDIF

RETURNF COMRESULT

@COM_尿道針挿入
#DIM DYNAMIC 増加量

PRINTFORML %I18N("尿道針挿入", "TRAIN")%
CALL KOJO_MESSAGE_COM

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
LOSEBASE:体力 += 250
LOSEBASE:気力 += 200

SOURCE:苦痛 = 3000
SOURCE:恐怖 = 4000
SOURCE:逸脱 = 3000
SOURCE:反感 = 5000

;-------------------------------------------------
;絶頂チェック
;-------------------------------------------------
CALL SOURCE_CHECK_CVAB

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
CALL SAMEN_CHECK_T, 0

CALL SAMEN_SHOOT_T, 0, NOWEX:射精

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL EXPUP_BASE, 1, 4

CALL EXPUP, "尿道経験", 1
CALL EXPUP, "医療経験", 1, PLAYER

RETURN 1
