@USERCOM_ABLE_触手挿入
#FUNCTION
;触手ないとダメ
コマンド実行条件 += I18N("触手召喚中じゃないと実行できない/")
SIF !TEQUIP:触手
	COMRESULT = 0
;ヴァギナ無いとダメ
コマンド実行条件 += I18N("対象に女性器が必要/")
SIF !VAGINA(TARGET)
	COMRESULT = 0

RETURNF COMRESULT

@COM_触手挿入
JUMP COM_バイブ

