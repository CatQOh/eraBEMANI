;-------------------------------------------------
;触手浣腸
;-------------------------------------------------
@USERCOM_ABLE_触手浣腸
#FUNCTION

;腸洗浄済みだとダメ
コマンド実行条件 += I18N("対象が既に腸洗浄を行っていた場合は実行できない/")
SIF TFLAG:腸洗浄済み
	COMRESULT = 0

;無機物はダメ
IF LANGUAGE == "ENG"
	コマンド実行条件 += @"Cannot be executed if the target is [%I18N("無機物")%]/"
ELSE
	コマンド実行条件 += "対象が[無機物]だと実行できない/"
ENDIF
SIF TALENT:無機物
	COMRESULT = 0
;触手ないとダメ
コマンド実行条件 += I18N("触手召喚中じゃないと実行できない/")
SIF !TEQUIP:触手
	COMRESULT = 0
;アナル触手中は不可
IF LANGUAGE == "ENG"
	コマンド実行条件 += "Cannot be used with anal tentacles/"
ELSE
	コマンド実行条件 += "アナル触手との併用はできない/"
ENDIF
SIF TEQUIP:アナルバイブ
	COMRESULT = 0
IF MOD:STS
	コマンド実行条件 += I18N("屍姦中は実行できない/")
	SIF CFLAG:死亡
		COMRESULT = 0
ENDIF

RETURNF COMRESULT

@COM_触手浣腸
JUMP COM_浣腸器
