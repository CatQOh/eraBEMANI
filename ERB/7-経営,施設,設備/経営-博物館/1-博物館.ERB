@博物館
#DIM DYNAMIC 改装費用
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC 名前文字数
#DIMS DYNAMIC COLORNAME

SIF MU:広さ < 10
	MU:広さ = 10

改装費用 = POWER(MU:広さ, 3)*1000

DRAWLINE
PRINTL □博物館の運営をします
PRINTL 　博物館に展示できるオブジェは、魔法「ジュエリーストーム(レベル5)」やキャラを加工して作成できます
CALL PASELIL, @"　現在の名声:{MU:名声} 昨日の収入:{MU:収入}＄ 現在の所持金:{MONEY}＄"
PRINTL □配属中のスタッフ
IF CMATCH(CSTR:配属, "博物館")
	FOR LCOUNT, 0, CHARANUM
		SIF CSTR:LCOUNT:配属 == "博物館"
			CALL SETMAX(名前文字数, STRLENS(NAME:LCOUNT))
	NEXT
	FOR LCOUNT, 0, CHARANUM
		IF CSTR:LCOUNT:配属 == "博物館"
			PRINTFORM 　%NAME:LCOUNT, 名前文字数, LEFT% 
			IF !CFLAG:LCOUNT:配属完了
				SETCOLORBYNAME gray
				PRINT 【配属準備中】
			ENDIF
			PRINTFORM 医療技能:{ABL:LCOUNT:医療技能} 
			PRINTFORM 工作技能:{ABL:LCOUNT:工作技能} 
			SIF 統率者("博物館") && !TALENT:LCOUNT:統率
				PRINT 統率者ボーナス+1 
			SIF 特質("ワーカホリック", LCOUNT)
				PRINTFORM [ワーカホリック+{特質("ワーカホリック", LCOUNT)/10}]
			CALL ISTALENT, LCOUNT, "ネクロマンサー"
			CALL ISTALENT, LCOUNT, "潔癖症"
			CALL ISTALENT, LCOUNT, "汚れ無視"
			CALL ISTALENT, LCOUNT, "倒錯的"
			CALL ISTALENT, LCOUNT, "禁断の知識"
			CALL ISTALENT, LCOUNT, "戦士"
			PRINTL 
			RESETCOLOR
		ENDIF
	NEXT
ELSE
	CALL PRINTCOLORL, "　[無し]", "gray"
ENDIF

PRINTL 
PRINTL 　[1] - 作品を展示する
PRINTL 　[2] - 作品を作る・廃棄する
IF MU:広さ >= 30
	PRINTL 　[-] - 博物館の広さは最大です
ELSE
	CALL PASELIL, @"　[3] - 博物館を改装する（現在の広さ:{MU:広さ} 改装費用:{改装費用}＄）"
ENDIF
PRINTL 　[4] - キャラを配属する
PRINTL 　[5] - 客層を確認する
PRINTL 　[8] - 収蔵品目録を確認する
PRINTL 　[9] - 博物館マニュアル
DRAWLINE
PRINTPLAIN 　MUSEUM　
PRINTL [0] - 戻る

BINPUT
SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE 1
		CALL 博物館_MAP
	CASE 2
		CALL 博物館_CREATE
		;何もしないで戻ってきた場合
		SIF RESULT == 0
			RESTART
		;作品を作ったらターンエンド
		JUMP ターン終了
	CASE 3
		IF MONEY < 改装費用
			PRINTW 改装費用が足りません
			RESTART
		ENDIF
		CALL PAYMENT, -改装費用, "博物館改築"
		MU:広さ++
	CASE 4
		CALL STRATEGY_PERSONAL, "博物館"
	CASE 5
		CALL カテゴリ計算用
		FOR LCOUNT, 0, VARSIZE("博物館客層")
			SIF ERDNAME(博物館客層, LCOUNT) == ""
				BREAK
			PRINTFORM %ERDNAME(博物館客層, LCOUNT), 14%:
			SELECTCASE ERDNAME(博物館客層, LCOUNT)
				CASE "剥製"
					COLORNAME = red
				CASE "白骨死体"
					COLORNAME = ivory
				CASE "ホルマリン漬け"
					COLORNAME = yellowgreen
				CASE "透明標本"
					COLORNAME = cyan
				CASEELSE
					COLORNAME = silver
			ENDSELECT
			HTML_PRINT IMGTOTAG(GBAR(博物館客層:LCOUNT, 100, 10, COLORNAME, "gray", @"{博物館客層:LCOUNT}/100", "black")), 1
			PRINTL 
		NEXT
		WAIT
	CASE 8
		CALL 博物館_収蔵品
	CASE 9
		PRINTL □博物館経営について
		PRINTL 　博物館は作成したオブジェを展示して収益を得られる経営要素です
		PRINTL 　レベル5魔法「ジュエリーストーム」や、キャラを物理的に加工して展示することが可能です
		PRINTL 　上記の手段でオブジェ化したキャラは、売却時と同じくロスト扱いになるのでご注意ください
		PRINTL 　オブジェにはそれぞれ集客力のパラメータがあります。長期間同じものを置いていると客が飽きて集客力が下がります
		PRINTL 　展示していないオブジェは徐々に集客力が回復していきます。こまめに展示物を変えましょう
		PRINTL 　オブジェ配置画面で、"実用"を許可することによって、来客数に応じてオブジェが汚されることがありますが、収入への影響はありません
		PRINTL 　また、クローン個体をオブジェ化したものを、オリジナル含め複数体展示した場合、贋作として価値が半減します。注意しましょう
		WAIT
ENDSELECT
RESTART

@博物館_MAP
#DIM DYNAMIC ページ数
#DIM DYNAMIC 次ページあり
#DIM DYNAMIC 処理数
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY
#DIM DYNAMIC XRES
#DIM DYNAMIC YRES
#DIM DYNAMIC ID
#DIM DYNAMIC 設置済み, 1000
#DIMS DYNAMIC HTML用
#DIMS DYNAMIC 作品表示色
#DIM 表示モード

CALL LOOP_CLEARLINE

VARSET 設置済み
FOR LCOUNTY, 0, MU:広さ
	HTML用 = 
	FOR LCOUNTX, 0, MU:広さ
		ID = 博物館マップ:LCOUNTY:LCOUNTX
		IF ID > 0 && MUSEUM:ID:種類 == ""
			博物館マップ:LCOUNTY:LCOUNTX = 0
			ID = 0
		ENDIF
		IF ID > 0
			IF !表示モード
				作品表示色 = %MUSEUM:ID:色%
			ELSE
				SELECTCASE TOINT(MUSEUM:ID:集客力)
					CASE IS >= 125
						作品表示色 = 0x0040FF
					CASE IS >= 100
						作品表示色 = 0x0088FF
					CASE IS >= 75
						作品表示色 = 0x00BEFF
					CASE IS >= 50
						作品表示色 = 0x00A0BA
					CASE IS >= 25
						作品表示色 = 0x5A808B
					CASEELSE
						作品表示色 = 0x5C6666
				ENDSELECT
			ENDIF
			HTML用 += SET_TOOLTIPBUTTON("■", @"{LCOUNTX*100+LCOUNTY}", @"%MUSEUM:ID:名前% 価値:%MUSEUM:ID:価値% \@ MUSEUM:ID:種類 == "性具" ? 耐久度:%MUSEUM:ID:耐久度%\% # 集客力:%MUSEUM:ID:集客力%\% \@ \@ MU:実用 ? 汚された回数:%MUSEUM:ID:汚れ% #\@", 作品表示色)
			設置済み:ID = 1
		ELSE
			HTML用 += SET_TOOLTIPBUTTON("■", @"{LCOUNTX*100+LCOUNTY}", "未設置")
		ENDIF
	NEXT
	HTML_PRINT HTML用
NEXT

CALL カテゴリ計算用

PRINT 　各種類の割合　
FOR LCOUNT, 0, VARSIZE("博物館客層")
	SIF ERDNAME(博物館客層, LCOUNT) == ""
		BREAK
	PRINTFORM %ERDNAME(博物館客層, LCOUNT)%:{RESULT:LCOUNT}\% 
NEXT
PRINTL 

DRAWLINE
PRINTPLAIN 　MUSEUM MAP　
PRINTFORML [-1] 戻る [-2] 全て片付ける [-3] 実用の許可/不許可(現在:\@ MU:実用 ? 許可 # 不許可 \@) [-4] 表示モード(現在:\@ 表示モード ? 集客力 # 種別 \@)

INPUT

SELECTCASE RESULT
	CASE -1
		RETURN
	CASE -2
		VARSET 博物館マップ
		RESTART
	CASE -3
		INVERTBIT MU:実用, 0
		RESTART
	CASE -4
		INVERTBIT 表示モード, 0
		RESTART
	CASEELSE
		XRES = RESULT/100
		YRES = RESULT%100
		SIF !INRANGE(XRES, 0, MU:広さ-1) || !INRANGE(YRES, 0, MU:広さ-1)
			RESTART
		ID = 博物館マップ:YRES:XRES
		IF ID
			PRINTFORML %MUSEUM:ID:名前%が設置されています。どうしますか？
			PRINTL [0] - 別の物に置き換える
			PRINTL [1] - 片付ける
			PRINTL [2] - 何もしない
			BINPUT
			SELECTCASE RESULT
				CASE 0
					GOTO SELECT_OBJECT
				CASE 1
					博物館マップ:YRES:XRES = 0
			ENDSELECT
			RESTART
		ENDIF
		$SELECT_OBJECT
		処理数 = 0
		PRINTL □何を設置しますか？
		FOR LCOUNT, 1, 1000
			IF MUSEUM:LCOUNT:種類 != "" && !設置済み:LCOUNT
				IF 処理数 >= ページ数*20+20
					次ページあり = 1
					BREAK
				ENDIF
				処理数++
				SIF ページ数*20 >= 処理数
					CONTINUE
				IF MUSEUM:LCOUNT:廃棄済み == "1"
					SETCOLORBYNAME gray
					CALL PASELI, @"　[--] %MUSEUM:LCOUNT:名前% 価値:%MUSEUM:LCOUNT:価値%＄ 廃棄済み \@ MUSEUM:LCOUNT:汚れ != "0" ? 汚された回数:%MUSEUM:LCOUNT:汚れ+" "% #\@"
					PRINT 色:
					CALL PRINTCOLORL, "■", MUSEUM:LCOUNT:色
				ELSE
					CALL PASELI, @"　[{LCOUNT, 2}] %MUSEUM:LCOUNT:名前% 価値:%MUSEUM:LCOUNT:価値%＄ \@ MUSEUM:LCOUNT:種類 == "性具" ? 耐久度:%MUSEUM:LCOUNT:耐久度%\% # 集客力:%MUSEUM:LCOUNT:集客力%\% \@ \@ MUSEUM:LCOUNT:汚れ != "0" ? 汚された回数:%MUSEUM:LCOUNT:汚れ +" " % #\@"
					PRINT 色:
					CALL PRINTCOLORL, "■", MUSEUM:LCOUNT:色
				ENDIF
			ENDIF
		NEXT
		DRAWLINE
		PRINTPLAIN 　OBJECT　
		CALL PRINTSPACE, ページ数, @"[-1] %I18N("前ページ")% "
		PRINTFORM [0] %I18N("戻る")% 
		CALL PRINTSPACE, 次ページあり, @"[-9] %I18N("次ページ")% "
		PRINTL 
		BINPUT
		SELECTCASE RESULT
			CASE 0
				RESTART
			CASE -1
				ページ数--
				GOTO SELECT_OBJECT
			CASE -9
				ページ数++
				次ページあり = 0
				GOTO SELECT_OBJECT
			CASEELSE
				ID = RESULT
				博物館マップ:YRES:XRES = ID
				RESTART
		ENDSELECT
ENDSELECT

@博物館_CREATE
#DIM DYNAMIC 対象, 2
#DIM DYNAMIC 作品価値
#DIM DYNAMIC 空き変数
#DIM DYNAMIC 空き変数カウント
#DIM DYNAMIC 妊娠フラグ
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNT2
#DIM DYNAMIC 処理数
#DIM DYNAMIC ページ数
#DIM DYNAMIC 次ページあり
#DIMS DYNAMIC 加工方法
#DIM DYNAMIC 加工技術
#DIMS DYNAMIC 加工者
#DIM DYNAMIC LCOUNTX
#DIM DYNAMIC LCOUNTY
#DIM DYNAMIC ID
#DIMS DYNAMIC 性器種別
#DIM DYNAMIC 解体後価値比重, 4
#DIM DYNAMIC 解体後価値比重合計
#DIM DYNAMIC 解体後部位数

PRINTL □博物館用の作品を作ります 鉱物は魔法コマンドから作成してください
PRINT 　[1] - キャラを
CALL PRINTCOLOR, "加工", "red"
PRINTL する
;PRINTL 　[2] - 既存の作品を組み合わせる
PRINTL 　[3] - 既存の作品を解体する
PRINTL 　[4] - リソースから作成する
PRINTL 　[5] - 作品を破棄する
PRINTL 　[0] - 戻る

BINPUT
SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE 1
		CALL 博物館_CREATE_CORPSE
		SIF RESULT == -1
			RESTART
		RETURN RESULT
	;CASE 2
	;	GOTO JOIN_CORPSE
	CASE 3
		GOTO DESTRUCT_CORPSE
	CASE 4
		GOTO CREATE_CORPSE_BY_RESOURCE
	CASE 5
		GOTO DISPOSE_CORPSE
ENDSELECT

[SKIPSTART]
$JOIN_CORPSE
PRINTL □同じ種類の2つの作品を組み合わせます 何を組み合わせますか？
処理数 = 0
ページ数 = 0
FOR LCOUNT, 1, 1000
	SIF !GROUPMATCH(MUSEUM:LCOUNT:種類, "剥製", "白骨死体", "ホルマリン漬け", "透明標本")
		CONTINUE
	IF 処理数 < ページ数*10
		処理数++
		CONTINUE
	ENDIF
	PRINTFORML 　[{LCOUNT, 2}] %MUSEUM:LCOUNT:種類%
NEXT
[SKIPEND]

$DESTRUCT_CORPSE
PRINTL □作品を解体して展示物にできます 何を解体しますか？
処理数 = 0
FOR LCOUNT, 1, 1000
	;人形の解体は一旦まだ
	SIF !GROUPMATCH(MUSEUM:LCOUNT:種類, "剥製", "白骨死体", "ホルマリン漬け", "透明標本")
		CONTINUE
	SIF MUSEUM:LCOUNT:廃棄済み == "1"
		CONTINUE
	IF 処理数 > ページ数*10+10
		次ページあり = 1
		BREAK
	ENDIF
	IF 処理数 <= ページ数*10
		処理数++
		CONTINUE
	ENDIF
	PRINTFORML 　[{LCOUNT, 2}] %MUSEUM:LCOUNT:名前%
	処理数++
NEXT
DRAWLINE
PRINTPLAINFORM 　解体　
CALL PRINTSPACE, ページ数, @"[-1] %I18N("前ページ")% "
PRINTFORM [0] %I18N("戻る")% 
CALL PRINTSPACE, 次ページあり, @"[-9] %I18N("次ページ")% "
PRINTL 

BINPUT
SELECTCASE RESULT
	CASE -1
		ページ数--
		GOTO DESTRUCT_CORPSE
	CASE 0
		RESTART
	CASE -9
		ページ数++
		GOTO DESTRUCT_CORPSE
ENDSELECT

対象 = RESULT

PRINTFORML %MUSEUM:対象:名前%を解体して展示物にします。よろしいですか？
PRINTFORML [0] - %I18N("はい")%
PRINTFORML [1] - %I18N("いいえ")%

BINPUT
SIF RESULT == 1
	GOTO DESTRUCT_CORPSE

STRFIND MUSEUM:対象:名前, "妊娠した"
SIF RESULT != -1 && MUSEUM:対象:種類 != "白骨死体"
	妊娠フラグ = 1

解体後価値比重合計 = 0
解体後部位数 = 0
FOR LCOUNT, 0, 4
	SELECTCASE LCOUNT
		CASE 0
			解体後価値比重:LCOUNT = 2
			解体後価値比重合計 += 2
		CASE 1
			IF 妊娠フラグ
				解体後価値比重:LCOUNT = 10
				解体後価値比重合計 += 10
			ELSE
				解体後価値比重:LCOUNT = 2
				解体後価値比重合計 += 2
			ENDIF
		CASE 2
			解体後価値比重:LCOUNT = 2 - 腕欠損(GETCHARA(TOINT(MUSEUM:対象:キャラナンバー)))
			解体後価値比重合計 += 2 - 腕欠損(GETCHARA(TOINT(MUSEUM:対象:キャラナンバー)))
		CASE 3
			解体後価値比重:LCOUNT = 2 - 脚欠損(GETCHARA(TOINT(MUSEUM:対象:キャラナンバー)))
			解体後価値比重合計 +=2 - 脚欠損(GETCHARA(TOINT(MUSEUM:対象:キャラナンバー)))
	ENDSELECT
	SIF 解体後価値比重:LCOUNT
		解体後部位数++
NEXT

FOR LCOUNT2, 1, VARSIZE("MUSEUM", 1)
	IF MUSEUM:LCOUNT2:種類 == ""
		空き変数カウント++
		IF 空き変数カウント == 解体後部位数
			空き変数 = LCOUNT2 - 解体後部位数 +1
			BREAK
		ENDIF
	ELSE
		空き変数カウント = 0
	ENDIF
NEXT

FOR LCOUNT, 0, 4
	SIF 解体後価値比重:LCOUNT == 0
		CONTINUE
	MUSEUM:空き変数:種類 = 部位/
	MUSEUM:空き変数:名前 = %CSVNAMEF(TOINT(MUSEUM:対象:キャラナンバー))%
	STRFIND MUSEUM:対象:名前, "(スライム)"
	SIF RESULT != -1
		MUSEUM:空き変数:名前 += "(スライム)"
	MUSEUM:空き変数:名前 += "の"
	SELECTCASE LCOUNT
		CASE 0
			MUSEUM:空き変数:名前 += "頭"
			MUSEUM:空き変数:種類 += "頭"
		CASE 1
			IF 妊娠フラグ
				SELECTCASE MUSEUM:対象:種類
					CASE "透明標本"
						MUSEUM:空き変数:名前 += "胎児が入った"
					CASEELSE
						MUSEUM:空き変数:名前 += "お腹の膨らんだ"
				ENDSELECT
			ENDIF
			MUSEUM:空き変数:名前 += "胴体"
			MUSEUM:空き変数:種類 += "胴体"
		CASE 2
			SELECTCASE TALENT:GETCHARA(TOINT(MUSEUM:対象:キャラナンバー)):上肢切断
				CASE 0
					MUSEUM:空き変数:名前 += "腕"
					MUSEUM:空き変数:種類 += "腕"
				CASE 1
					MUSEUM:空き変数:名前 += "左腕"
					MUSEUM:空き変数:種類 += "左腕"
				CASEELSE
					MUSEUM:空き変数:名前 += "右腕"
					MUSEUM:空き変数:種類 += "右腕"
			ENDSELECT
		CASE 3
			IF GETCHARANAME(CSVNAMEF(TOINT(MUSEUM:対象:キャラナンバー)),1) > 0 && TALENT:GETCHARANAME(CSVNAMEF(TOINT(MUSEUM:対象:キャラナンバー)),1):足使用不可 == 1
				MUSEUM:空き変数:名前 += "尾"
			ELSEIF TALENT:GETCHARA(TOINT(MUSEUM:対象:キャラナンバー)):足使用不可 == 1
				MUSEUM:空き変数:名前 += "尾"
			ELSE
				SELECTCASE TALENT:GETCHARA(TOINT(MUSEUM:対象:キャラナンバー)):下肢切断
					CASE 0
						MUSEUM:空き変数:名前 += "足"
					CASE 1
						MUSEUM:空き変数:名前 += "左足"
					CASEELSE
						MUSEUM:空き変数:名前 += "右足"
				ENDSELECT
			ENDIF
			SELECTCASE TALENT:GETCHARA(TOINT(MUSEUM:対象:キャラナンバー)):下肢切断
				CASE 0
					MUSEUM:空き変数:種類 += "足"
				CASE 1
					MUSEUM:空き変数:種類 += "左足"
				CASEELSE
					MUSEUM:空き変数:種類 += "右足"
			ENDSELECT
	ENDSELECT
	SELECTCASE MUSEUM:対象:種類
		CASE "白骨死体"
			MUSEUM:空き変数:名前 += "(白骨)"
		CASE "ホルマリン漬け"
			MUSEUM:空き変数:名前 += "(液浸標本)"
		CASE "透明標本"
			MUSEUM:空き変数:名前 += "(透明標本)"
		CASE "人形"
			MUSEUM:空き変数:名前 += "パーツ"
	ENDSELECT

	MUSEUM:空き変数:価値 = {TOINT(MUSEUM:対象:価値) * 解体後価値比重:LCOUNT * 4 / 解体後価値比重合計 / 5}

	MUSEUM:空き変数:キャラナンバー = %MUSEUM:対象:キャラナンバー%
	MUSEUM:空き変数:色 = %MUSEUM:対象:色%
	MUSEUM:空き変数:血縁コード = %MUSEUM:対象:血縁コード%
	MUSEUM:空き変数:オリジナルナンバー = 0
	MUSEUM:空き変数:集客力 = 100
	MUSEUM:空き変数:汚れ = 0
	MUSEUM:空き変数:価値減少 = %MUSEUM:対象:価値減少%
	空き変数++
NEXT

PRINTFORMW %MUSEUM:対象:1%を解体しました
FOR LCOUNT, 0, 20
	MUSEUM:対象:LCOUNT '= ""
NEXT

RETURN 1

$CREATE_CORPSE_BY_RESOURCE
PRINTL □リソースから作品を作成できます。何を使いますか？
FOR LCOUNT, 0, VARSIZE("性器リソース", 2)
	SIF ERDNAME(性器リソース, LCOUNT, 2) == ""
		CONTINUE
	PRINTFORML 　[{LCOUNT}] - %ERDNAME(性器リソース, LCOUNT, 2)%
NEXT
DRAWLINE
PRINTPLAIN 　リソース　
PRINTL [10] - 戻る
BINPUT

SIF RESULT == 10
	RESTART

性器種別 = %ERDNAME(性器リソース, RESULT, 2)%

CALL 性器一覧, 性器種別

SIF RESULT == -1
	GOTO CREATE_CORPSE_BY_RESOURCE

対象 = RESULT

PRINTFORM %CSVNAMEF(対象)%の%性器種別%を加工して

SELECTCASE 性器種別
	CASE "男性器"
		PRINT ディルド
	CASE "女性器", "臀部", "乳房"
		PRINT オナホ
ENDSELECT

PRINTL のオブジェクトを作成します。よろしいですか？
PRINTFORML [0] - %I18N("はい")%
PRINTFORML [1] - %I18N("いいえ")%

BINPUT
SIF RESULT == 1
	GOTO CREATE_CORPSE_BY_RESOURCE

