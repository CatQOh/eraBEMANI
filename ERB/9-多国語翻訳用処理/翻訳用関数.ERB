@SPLIT_G(STRINGS, STRINGS:1 = ":")
#FUNCTIONS
#LOCALSSIZE 200

VARSET LOCALS

LOCAL = RESULT

SPLIT STRINGS, STRINGS:1, LOCALS

LOCAL:1 = RESULT
RESULT = LOCAL

RETURNF LOCALS:(RAND:(LOCAL:1))
[SKIPEND]

;--------------------------------------------------------
;returns a specified part of a split string
;--------------------------------------------------------
@SPLIT_SINGLE(STRINGS:0, LOCALE:0 = 0, STRINGS:1 = ":")
#FUNCTIONS
#DIM LOCALE, 2
#DIMS STRINGS, 2
#DIMS DYNAMIC strSplit, 30

LOCALE:1 = RESULT

SPLIT STRINGS:0, STRINGS:1, strSplit

RESULT = LOCALE:1

RETURNF strSplit:(LOCALE:0)

;--------------------------------------------------------
;modified the function in STR_BODY to be less restrictive (string:string:string, matching string, matching string, etc)
;works similarly to GROUPMATCH, but with : split strings
;--------------------------------------------------------
@SPLIT_CHECK(STRINGS:0, STRINGS:1 = "NULL", STRINGS:2 = "NULL", STRINGS:3 = "NULL", STRINGS:4 = "NULL", STRINGS:5 = "NULL", STRINGS:6 = "NULL", STRINGS:7 = "NULL", STRINGS:8 = "NULL", STRINGS:9 = "NULL")
#FUNCTION
#DIMS STRINGS, 11
RETURNF STRCOUNT(STRINGS:0, "(^|:)(" + STRINGS:1 + "|" + STRINGS:2 + "|" + STRINGS:3 + "|" + STRINGS:4 + "|" + STRINGS:5 + "|" + STRINGS:6 + "|" + STRINGS:7 + "|" + STRINGS:8 + "|" + STRINGS:9 + ")($|:)")

;customize the splitter
@SPLIT_CHECK_C(STRINGS:0, STRINGS:1 = ":", STRINGS:2 = "NULL", STRINGS:3 = "NULL", STRINGS:4 = "NULL", STRINGS:5 = "NULL", STRINGS:6 = "NULL", STRINGS:7 = "NULL", STRINGS:8 = "NULL", STRINGS:9 = "NULL", STRINGS:10 = "NULL")
#FUNCTION
#DIMS STRINGS, 11
RETURNF STRCOUNT(STRINGS:0, "(^|" + "\\" + STRINGS:1 + ")(" + STRINGS:2 + "|" + STRINGS:3 + "|" + STRINGS:4 + "|" + STRINGS:5 + "|" + STRINGS:6 + "|" + STRINGS:7 + "|" + STRINGS:8 + "|" + STRINGS:9 + "|" + STRINGS:10 + ")($|" + "\\" + STRINGS:1 + ")")

@ON_OFF(LOCALE)
#FUNCTIONS
#DIM LOCALE
IF LANGUAGE == "ENG"
	IF LOCALE == 1
		RETURNF "On"
	ELSE
	RETURNF "Off"
	ENDIF
ELSE
	IF LOCALE == 1
		RETURNF "オン"
	ELSE
	RETURNF "オフ"
	ENDIF
ENDIF

@YES_NO(LOCALE)
#FUNCTIONS
#DIM LOCALE
IF LANGUAGE == "ENG"
	IF LOCALE == 1
		RETURNF "Yes"
	ELSE
	RETURNF "No"
	ENDIF
ELSE
	IF LOCALE == 1
		RETURNF "はい"
	ELSE
	RETURNF "いいえ"
	ENDIF
ENDIF
