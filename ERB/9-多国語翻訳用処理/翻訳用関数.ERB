;LOCALE, who it is
;LOCALE:1, if it's His/Her or his/her
@HE_SHE(LOCALE, LOCALE:1)
#FUNCTIONS
#DIM DYNAMIC LOCALE, 2
#DIMS OUTPUT
OUTPUT '= @"%SEX(LOCALE) == 1?"He"#"She"%"
SIF !LOCALE:1
	OUTPUT = %TOLOWER(OUTPUT)%
RESULT = LOCALE
RETURNF OUTPUT

