;汎用会話コマンド
;-------------------------------------------------
@SCHOOL_ハヤト_何気ない会話
IF !CFLAG:面識
	IF CSTR:PLAYER:在校 == CSTR:在校
		PRINTFORML 「はじめまして、君が新入生？」
		PRINTFORMW 「僕はハヤト。\@名前あり() ? %CALLNAME:PLAYER%って言うの？これからもよろしく！ # 同級生同士、よろしくね！\@」
	ELSE
		PRINTFORMW %CALLNAME:PLAYER%からの呼びかけに、スケートボードで駆け抜けていたハヤトは器用に速度を落としつつ、足を止めた
		SELECTCASE 小中高(CSTR:PLAYER:在校)
			;他校生で高校
			CASE "高"
				PRINTFORML 「こちらこそ初めまして、ハヤトと言います。\@名前あり() ? %CALLNAME:PLAYER%さんの事 # 他校生でも\@先輩と呼ばせてください」
				PRINTFORMW 「えっ、タメ口でも構わないんですか？……確かに敬語だとよそよそしくて分かるかも。ラピストリア学園に通ってるので宜しくお願いします、先輩！」
			;他校生で同学年
			CASE "中"
				PRINTFORML 「はじめまして、見掛けない制服だなぁ…君、他校生？」
				PRINTFORMW 「そっかぁ、僕ハヤトって言うんだ。君が%CSTR:PLAYER:在校%に通ってるって事は…通学路も途中まで一緒？、いつでも会えそうだね！」
			;他校生で年下
			CASE "小"
				PRINTFORML 「おっとと……初めまして！僕に声掛けるなんて珍しいね」
				PRINTFORMW 「僕はハヤト。ラピストリア学園に通ってる中学生だよ、宜しく！」
		ENDSELECT
	ENDIF
ELSE
	SELECTCASE CSTR:PLAYER:現在地
		CASE CSTR:PLAYER:在校
			PRINTDATAW
				DATALIST
				DATA 「次の授業は…と、参考書持ってる？忘れてたなら貸すよ」
				DATAFORM 「そっかぁ、\@名前あり() ? %CALLNAME:PLAYER% # 君\@も勉強熱心だから心配無用だね」
				ENDLIST
				DATAFORM 「\@好感度:友情 >= 700 ? 昼休みのドッジボール、楽しみだね！一緒にチーム組もうよ！ # 君って体育の授業に出てる時、あまり乗り気じゃなさそうな顔するんだもん。もしかして苦手科目？\@」
			ENDDATA
		CASE "ゆうマート"
			SELECTCASE バイト先
				CASE "ゲームセンター"
					PRINTFORML 「え、\@小中高(CSTR:PLAYER:在校) == "高" ? 先輩 # 君\@がゲーセンでアルバイトしてるの？」
					PRINTFORMW 「接客や景品補充とか、色々やるんだ…機械に詳しい人ってどうしてるんだろう。業者がやってくれるから良いんだ、へぇ～」
				CASE "ジョニーズ","星龍華" ,"ビストローバー", "紅海灘宮", "ボルテ軒"
					PRINTFORMW 「\@小中高(CSTR:PLAYER:在校) == "高" ? 先輩って #\@飲食店でアルバイトしてるんだね。オーダー担当もカッコ良さそう」
				CASE "クラブレジデント", "On the FMスタジオ"
					PRINTFORML 「クラブハウスのバイトかぁ～。裏方業務だから大変そう」
					PRINTFORMW 「人混みの中で仕事するのもキツい、でも報酬は結構高い……う～ん、確かにそれも言えてる…」
				;バイトしてない、上記以外のバイト先
				CASEELSE
					PRINTDATAW
						DATA 「おススメ商品結構あるよね～、ミノタウロスバーガーとか。一度食べると病みつきになっちゃうよ」
						DATAFORM 「\@バイト先 != "" ? 君のバイト先も結構大変そうだけど、話を聞いてるといろんな経験も出来るから良いよね。また今度聞かせて # \@」
						DATAFORM 「\@小中高(CSTR:PLAYER:在校) == "高" ? 先輩も来てたんだ。公園の帰り道に軽く寄れる場所だけど…コンビニなのに人多くない？ # やぁ、ここのコンビニは限定品目当てに来る人が多いみたい。SNSで話題になるからかな？\@」
						DATAFORM 「\@好感度合計(GETCHARANAME("パイン")) >= 100 ? アイドル女子学生？…なんだかすごそうな子と友達になってるんだ。今度紹介してよ # 年上の友達？今のところはリュータ先輩達かな\@」
					ENDDATA
			ENDSELECT
		CASE "ゲームセンター"
			IF 小中高(CSTR:PLAYER:在校) == "高"
				PRINTDATAW
					DATA 「僕、家でテレビゲームとか全然やらないから多分…ゲーセンのゲームを分かっていないかもしれない。ごめんね先輩」
					DATAFORM 「\@TALENT:恋慕 ? 先輩、あそこにホッケーゲームあったよ。やろうよ！ # 先輩はどんなゲームが好き？僕は全身動かせる体感ゲームがいいな\@」
					;DATAFORM 「\@好感度合計(GETCHARANAME("グレイ")) >= 100 ?  # \@」
				ENDDATA
			ELSE
				PRINTDATAW
					DATA 「DDRならたまにやってるよ。身体慣らしにもなるし」
					DATAFORM 「\@TALENT:恋慕 ? ねぇねぇ、あのゲーム一緒にやろうよ！前から気になってたんだ！ # 音ゲー中心に色々とね、他の機種にも目移りしちゃうよね\@」
					DATA 「時々格ゲーの方から奇声上げる人いるから、煩くて困るよ。店長も『以前よりは大分マシ』って言ってたけど…あまり変わらないなー」
				ENDDATA
			ENDIF
		CASE "雀喫茶ローシャンテ"
			IF 同行者 == TARGET
				PRINTDATAW
					DATA 「い、今の見た？向こう側の雀卓がメイドに変わってる…」
					DATA 「僕も麻雀が打てるようになれるといいんだけど…何々、『麻雀初めの書』？」
					DATA 「老若男女問わず皆、真剣に打ってるんだね」
				ENDDATA
			ENDIF
	ENDSELECT
ENDIF

@SCHOOL_ハヤト_踏み込んだ会話_成功


@SCHOOL_ハヤト_踏み込んだ会話_失敗
IF !CFLAG:面識
	SELECTCASE 小中高(CSTR:PLAYER:在校)
		CASE "高"
			PRINTL 「えっと……すみません、どちら様ですか？」
			IF 名前あり()
				PRINTFORMW 「%CALLNAME:PLAYER%さんか、いくら年上だからって急に聞かれても困るんだ。それじゃ」
			ELSE
				PRINTFORMW 「僕の事気になるからって、いきなり踏み込まれると困るなぁ…」
			ENDIF
		CASEELSE
			PRINTFORML 「何、急に変な事聞いてきて…ところで君は誰？」
			IF 名前あり()
				PRINTFORMW 「……%CALLNAME:PLAYER%は僕の何処が気になるのか知らないけれど、やめてよね。そういうの」
			ELSE
				PRINTFORMW 「\@CSTR:PLAYER:在校 == CSTR:在校 ? 僕目当てに嗅ぎ付けてきたみたいだけど、今は何も話したくない。 # 他校生か。これ以上はあまり話せないや、\@じゃあね」
			ENDIF
	ENDSELECT
ENDIF

@SCHOOL_ハヤト_品の無い会話_成功
IF !CFLAG:面識 && CFLAG:インモラル >= 30
	PRINTFORML 「あは、初めてなのにそういうの好きなの？下ネタ寄りのギャグじゃなかったんだけどなー」
	PRINTFORMW 「僕はハヤト。続きは今度聞かせてね……\@小中高(CSTR:PLAYER:在校) == "高" ? 先輩 #\@」
ELSE
	IF 好感度:既成事実 || CFLAG:インモラル >= 30
		SELECTCASE SEX(PLAYER)
			CASE 1
				PRINTDATAW
					DATA 「手でするよりオナホで扱くと気持ち良いよね。後処理面倒そうだけどわかるな～」
					DATAFORM 「\@ABL:Ａ感覚 >= 4 ? 実は僕、アナルに慣れてるせいか弄ってたら声出ちゃうんだ…家で弄るのも命がけでさ… # 君、エロ漫画持って来たの？僕じゃ絶対買えない本だから羨ましいな。えっ……読んでいいの？ありがとう！\@」
					DATA 「うぅ、今の話題……エロ過ぎて我慢出来なくなっちゃう……」
				ENDDATA
			CASE 2
				PRINTDATAW
					DATAFORM 「\@TALENT:恋慕 ? 経血は鉄の味がするから舐めるのやめた方がいい？大丈夫だよ。だって君の匂いがするもん # 下はいつもぬるぬるって訳じゃないんだ。あと…生理の話はちょっと苦手だな…だって、痛そうだし\@」
					DATAFORM 「\@小中高(CSTR:PLAYER:在校) == "高" ? お、おねショタは恥ずかしいよ…それじゃ僕が弟キャラみたいじゃないか # 性器の形は気にしてたら気持ち良くないよ。ヒダがあるか無いかなんてさ\@」
					DATA 「そ、その話されたら……益々興奮してきちゃうよ」
				ENDDATA
		ENDSELECT
	ELSE
		PRINTDATAW
			DATAFORM ハヤトは俯きながら%CALLNAME:PLAYER%の話を聞いていた…
			DATA 生々しい話題に戸惑いつつも猥談を聞くハヤト。その内容を彼は理解してくれるだろうか…
			DATA 赤っ恥な性愛の話題に付いていけない様子のハヤトは適当に相槌を打っている…
		ENDDATA
	ENDIF
ENDIF

@SCHOOL_ハヤト_品の無い会話_失敗
IF !CFLAG:面識
	PRINTFORML 「ちょっと何なの、変なこと言われても困るよ……」
	PRINTFORMW ハヤトは嫌気を感じて%CALLNAME:PLAYER%から離れていった…
ELSE
	PRINTDATAW
		DATA 「やめてよね、そんな話されても恥ずかしいだけ」
		DATA 「あまり話したくないな、そういうの」
		DATA 「…それはセクハラって言うんだよ」
	ENDDATA
ENDIF

