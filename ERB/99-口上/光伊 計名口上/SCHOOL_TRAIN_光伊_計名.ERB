;-------------------------------------------------
;@SCHOOL_KOJO_SHOOT（X1をキャラ番号に置換）
;PLAYERの射精をトリガーにした口上
;-------------------------------------------------
@SCHOOL_KOJO_SHOOT_光伊_計名
;地の文表示関数 地の文を表示させたくない場合はコメントアウト
TRYCALL SHOOT_MESSAGE

SIF OPTION:口上表示 == 0
	RETURN 0

;-------------------------------------------------
;調教者の射精時のテキスト
;どこに射精した、という変数を削除したため、コマンドで分岐するのが確実で安心です
;分からない場合は既存の口上を参考にするとわかりやすいかもです
;SELECTCOMS = "実行したコマンド名"
;-------------------------------------------------
;PRINTFORML 

;-------------------------------------------------
;@SCHOOL_KOJO_EX関係（X1をキャラ番号に置換）
;奴隷の絶頂をトリガーにした口上
;-------------------------------------------------
@SCHOOL_KOJO_EX_光伊_計名
;地の文表示関数 地の文表示させたくない場合はコメントアウト
TRYCALL EX_MESSAGE

SIF OPTION:口上表示 == 0
	RETURN 0
;-------------------------------------------------
;奴隷の絶頂時のテキスト FEXを使用
;-------------------------------------------------
;-------------------------------------------------
;C絶頂
;-------------------------------------------------
IF NOWEX:Ｃ絶頂
	;初めて
	IF FEX:0 == 0
		;PRINTFORML 
		FEX:0 = 1
	;二回目以降
	ELSE
		;PRINTFORML 
	ENDIF
ENDIF

;-------------------------------------------------
;A絶頂
;-------------------------------------------------
IF NOWEX:Ａ絶頂
	SELECTCASE SELECTCOMS
		CASE "正常位アナル", "後背位アナル", "騎乗位アナル", "下着ずらし挿入アナル"
			SELECTCASE RAND:2
				CASE 0
					SELECTCASE ABL:Ａ感覚
						CASE IS <= 3
							PRINTFORML 「うぅっ…んぁああっ！」
							PRINTFORMW 不慣れなアナルでも絶頂を迎えたケイナ。しかし両脚はガクガク震えていた…
						CASE IS >= 4
							PRINTFORML 「んぁああっ、イイっ、も…いっちゃう……！」
							PRINTFORMW 開発されきったアナルで絶頂したケイナは、引き抜かれた%CALLNAME:PLAYER%のペニスを物足りなさそうに見つめていた…
					ENDSELECT
				CASE 1
					PRINTDATAW
						DATAFORM ペニスが引き抜かれ、絶頂を迎えたばかりのアナルは%CALLNAME:PLAYER%に見せつけるようにぽっかり開いている…
						DATAFORM 満たされたケイナは声を\@GROUPMATCH(行為場所, "トイレ", "青姦") ? 押し殺し # 断続的に漏らし\@、快楽に震えながら余韻に浸っていた…
						DATA 「あーっ、あぁあああっ…！」
						DATA 「や、らぁ……だめぇ……！」
						DATA 「あうっ、んぁっ…はぁああっ！」
					ENDDATA
			ENDSELECT
		CASE "前立腺刺激", "アナル愛撫"
			SELECTCASE ABL:Ａ感覚
				CASE IS <= 4
					PRINTDATAW
						DATAFORM 「あっ、そないに\@TEQUIP:アナルバイブ ? 抜き差し # 指動か\@したら…うぅっ！」
						DATAFORM 「\@ABL:Ａ感覚 < 2 ? なんか…来そう…っ… # はぁん…っ、ひぁ……！\@」
						DATA 「はぁあ、あ…いく……っ」
					ENDDATA
				CASE IS >= 5
					PRINTDATAW
						DATA ケイナは絶頂に身をよじらせながら悶えている…
						DATA 腸壁を抉られ達したケイナの表情は快感に蕩けている…
						DATA 「あぁ…ああっ！」
						DATA 「きもち、い…んんっ！」
						DATA 「ひぁん、い…くっ」
					ENDDATA
			ENDSELECT
	ENDSELECT
ENDIF

;-------------------------------------------------
;B絶頂
;-------------------------------------------------
IF NOWEX:Ｂ絶頂
	;初めて
	IF FEX:3 == 0
		;PRINTFORML 
		FEX:3 = 1
	;二回目以降
	ELSE
		;PRINTFORML 
	ENDIF
ENDIF

;-------------------------------------------------
;射精 大量射精時にはNOWEX:射精に2以上が代入される
;-------------------------------------------------
;射精している
IF NOWEX:射精
	SELECTCASE SELECTCOMS
		CASE "後背位させる", "正常位させる"
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「あ…あぁ、イクっ、ぁああ…！」
					PRINTFORMW ケイナのペニスが脈打ちながら\@TEQUIP:コンドーム ? 避妊具越し # 彼女の膣内\@に射精した…
				CASE 1
					PRINTFORMW ケイナは声を押し殺して、%CALLNAME:PLAYER%を\@SELECTCOMS == "後背位させる" ? 臀部を掴みながら # 抱きしめる姿勢のまま\@膣内で果てた…
			ENDSELECT
		CASE "後背位アナルさせる", "正常位アナルさせる"
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「っ…うぅ……出る…」
					PRINTFORMW ケイナは%CALLNAME:PLAYER%の頭部を優しく撫でながら、初々しいアナルに吐精した…
				CASE 1
					PRINTDATAW
						DATAFORM 射精した後は%CALLNAME:PLAYER%を気遣う様子が見られた…
						DATAFORM ペニスでの快楽に飲まれたケイナは、\@TEQUIP:コンドーム ? 避妊具 # 直腸\@の中で射精している…
						DATA 「あぁ…っ、出してもうた…っ……」
						DATA  ケイナの陰茎が自分のアナルで脈打っているのがよくわかる…
					ENDDATA
			ENDSELECT
	ENDSELECT
ENDIF

;-------------------------------------------------
;潮噴き 調教対象にペニスがある場合のみ
;-------------------------------------------------
IF NOWEX:潮噴き
	;PRINTFORML 
ENDIF

;-------------------------------------------------
;@SCHOOL_KOJO_AFTER関係（X1をキャラ番号に置換）
;調教後の変化をトリガーにした口上
;-------------------------------------------------
@SCHOOL_KOJO_AFTER_光伊_計名
;地の文表示関数 地の文表示させたくない場合はコメントアウト
TRYCALL AFTER_MESSAGE
SIF OPTION:口上表示 == 0
	RETURN 0
;-------------------------------------------------
;調教後のテキスト
;-------------------------------------------------
;-------------------------------------------------
;@SCHOOL_KOJO_PALAM関係（X1をキャラ番号に置換）
;パラメータ変化をトリガーにした口上
;-------------------------------------------------
@SCHOOL_KOJO_PALAM_光伊_計名
;地の文表示関数 地の文表示させたくない場合はコメントアウト
TRYCALL PALAM_MESSAGE
SIF OPTION:口上表示 == 0
	RETURN 0
;-------------------------------------------------
;パラメータ変化時のテキスト
;-------------------------------------------------
;-------------------------------------------------
;初めて潤滑がLV4になった
;-------------------------------------------------
IF PALAM:潤滑+UP:潤滑 > PALAMLV:4 && FPALAM:0 == 0
	;ローションを使った場合
	IF SELECTCOMS == "ローション"
		PRINTFORML 
	;それ以外
	ELSE
		PRINTFORML 
	ENDIF
	FPALAM:0 = 1
ENDIF

;-------------------------------------------------
;初めて欲情がLV3になった
;-------------------------------------------------
IF PALAM:欲情+UP:欲情 > PALAMLV:3 && FPALAM:1 == 0
	;媚薬を使った場合
	IF SELECTCOMS == "媚薬"
		PRINTFORML 
	;それ以外
	ELSE
		PRINTFORML 
	ENDIF
	FPALAM:1 = 1
ENDIF

